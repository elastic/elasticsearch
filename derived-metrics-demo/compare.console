# Derived metrics vs. the original data stream, side by side.
#
# Paste this whole file into Kibana → Dev Tools. Each pair asks the same question twice: once of the
# derived metrics (a few hundred documents) and once of the source stream (everything ever written).
# The answers should agree.
#
# FIRST: pick a comparison window and replace WINDOW_START and WINDOW_END everywhere.
#
#     ./demo.sh window 5
#
# The window must be CLOSED (ending at least a flush interval + grace period ago, so the last
# interval has actually been emitted) and ALIGNED to 10s (derived documents are stamped at the start
# of their interval). `./demo.sh window` gives you both.
#
# WHY THE NUMBERS ARE CLOSE BUT NOT IDENTICAL
#
# Derived metrics bucket by INGEST time — when the write reached the shard. The source stream's
# @timestamp is EVENT time — whatever the client put in the document. A document written at
# 17:42:09.998 with an @timestamp of 17:42:09.990 can land in the 17:42:10 derived bucket and the
# 17:42:00 source bucket. Over a multi-minute window only the documents straddling each boundary
# differ, which measures at roughly 0.1%. Expect agreement, not equality.


# =================================================================================================
# 1. DOCUMENT COUNT.  Expect agreement within ~0.1%.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "ingest.docs.count"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS docs = SUM(metric.value), documents_scanned = COUNT(*)
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS docs = COUNT(*), documents_scanned = COUNT(*)
  """
}


# =================================================================================================
# 2. 5xx ERRORS.  A counter with a range predicate, versus the same predicate applied at query time.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "http.errors"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS errors = SUM(metric.value)
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
        AND http.response.status_code >= 500
    | STATS errors = COUNT(*)
  """
}


# =================================================================================================
# 3. RESPONSE BYTES.  A counter whose value comes from a field rather than a constant.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "http.response.bytes"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS bytes = SUM(metric.value)
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS bytes = SUM(http.response.body.bytes)
  """
}


# =================================================================================================
# 4. A MAX GAUGE.  Exact: the maximum of per-interval maxima is the maximum.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "queue.depth.max"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS peak = MAX(metric.value)
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS peak = MAX(queue.depth)
  """
}


# =================================================================================================
# 5. AN AVG GAUGE.  The one reduction that is NOT self-contained. Three queries, not two.
#
# Averaging per-interval averages weights every interval equally, so a quiet 20 docs/s interval
# counts as much as a 4000 docs/s spike. In this demo the busy intervals are also the slow ones, so
# the naive answer comes out far too low — around 131ms against a true 186ms.
#
# Weighting by ingest.docs.count on the same series fixes it, because that metric carries exactly
# the same dimensions and so lines up bucket for bucket. This needs no histogram: an average is
# recoverable from a sum and a count. Percentiles are what would need a histogram.
# =================================================================================================

# 5a. Naive, and wrong.
POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "event.duration.avg"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS avg_ms = ROUND(AVG(metric.value) / 1000000, 2)
  """
}

# 5b. Weighted by the document count of the same series.
POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name IN ("event.duration.avg", "ingest.docs.count")
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS avg_v = MAX(CASE(metric.name == "event.duration.avg", metric.value, null)),
            cnt   = MAX(CASE(metric.name == "ingest.docs.count",  metric.value, null))
        BY bucket = BUCKET(@timestamp, 10 second),
           svc = dimensions.service.name,
           reg = dimensions.cloud.region
    | WHERE avg_v IS NOT NULL AND cnt IS NOT NULL
    | STATS avg_ms = ROUND(SUM(avg_v * cnt) / SUM(cnt) / 1000000, 2)
  """
}

# 5c. Ground truth.
POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS avg_ms = ROUND(AVG(event.duration) / 1000000, 2)
  """
}


# =================================================================================================
# 6. RATE PER SERVICE.  Same shape from both sides, one bucket per 10s.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "ingest.docs.rate"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS docs_per_sec = ROUND(SUM(metric.value), 1)
        BY bucket = BUCKET(@timestamp, 10 second), service = dimensions.service.name
    | SORT bucket DESC, service
    | LIMIT 25
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS docs_per_sec = ROUND(TO_DOUBLE(COUNT(*)) / 10, 1)
        BY bucket = BUCKET(@timestamp, 10 second), service = service.name
    | SORT bucket DESC, service
    | LIMIT 25
  """
}


# =================================================================================================
# 7. REQUESTS BY METHOD.  A per-metric dimension the global dimensions do not carry.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE metric.name == "http.requests"
        AND @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS requests = SUM(metric.value) BY method = dimensions.http.request.method
    | SORT method
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS requests = COUNT(*) BY method = http.request.method
    | SORT method
  """
}


# =================================================================================================
# 8. WHAT IT COST.  How many documents each side had to touch to answer any of the above.
#
# This is the whole argument for the feature. Both numbers describe the same window.
# =================================================================================================

POST /_query?format=txt
{
  "query": """
    FROM derived-metrics-logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS derived_documents = COUNT(*)
  """
}

POST /_query?format=txt
{
  "query": """
    FROM logs-derived-demo-default
    | WHERE @timestamp >= "WINDOW_START" AND @timestamp < "WINDOW_END"
    | STATS source_documents = COUNT(*)
  """
}

# Tunables for the derived metrics demo. Override any of these in your shell before running demo.sh.

# Local Elasticsearch, started from source by ./gradlew run.
: "${ES_PORT:=9200}"
# The Kibana container has to reach Elasticsearch, so ES binds beyond loopback. See the README.
: "${ES_BIND_HOST:=0.0.0.0}"
# basic or trial. Trial unlocks Graph, Watcher and the rest of Kibana.
#
# Machine learning is switched off explicitly alongside it. Under a trial licence ES creates a
# default ELSER inference endpoint and deploys the model, which means downloading it and indexing it
# in chunks — hundreds of megabytes through a dev node's heap. On the default heap that OOMs the node
# within minutes, and it has nothing to do with what this demo is showing.
: "${ES_LICENSE:=trial}"
: "${ES_USER:=elastic-admin}"
: "${ES_PASSWORD:=elastic-password}"

# Kibana. The tag must match the version in build-tools-internal/version.properties.
: "${KIBANA_PORT:=5601}"
: "${KIBANA_IMAGE:=docker.elastic.co/kibana/kibana:9.6.0-SNAPSHOT}"
: "${KIBANA_CONTAINER:=derived-metrics-demo-kibana}"
# Capped so the container cannot take the machine down with it.
: "${KIBANA_MEMORY:=2g}"
: "${KIBANA_HEAP_MB:=1024}"
# How the Kibana container addresses the host. host.docker.internal works on Docker Desktop.
: "${ES_HOST_FROM_CONTAINER:=host.docker.internal}"

# The source data stream that derived metrics are configured on.
: "${DATA_STREAM:=logs-derived-demo-default}"
: "${INDEX_TEMPLATE:=derived-demo-source@template}"
# The interval derived metrics are accumulated at; it is part of the destination stream name.
: "${DEFAULT_INTERVAL:=10s}"

# A second source stream that receives exactly the same documents but configures far fewer metrics
# and no dimensions. Same input, different configuration, so the difference in derived documents is
# entirely down to the configuration.
: "${LEAN_DATA_STREAM:=logs-derived-lean-default}"
: "${LEAN_INDEX_TEMPLATE:=derived-demo-lean@template}"

# Derived metrics flush cadence. Lower than the defaults so the demo reacts quickly.
: "${FLUSH_INTERVAL:=1s}"
: "${FLUSH_GRACE_PERIOD:=2s}"

# Load generator. See loadgen.py for the shape of the rate schedule.
: "${LOAD_PROFILE:=cycle}"

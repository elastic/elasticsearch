# =============================================================================
# 2. Terms vs phrase. Two words -> two separate tags.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "connection pool")
    | HIGHLIGHT "connection pool" ON note
    | KEEP id, highlight_note
  """
}

# Quote the query and it becomes a phrase: one tag pair around the whole span.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "pool")
    | HIGHLIGHT "\"connection pool\"" ON note
    | KEEP id, highlight_note
  """
}


# =============================================================================
# 3. Fuzzy. Both search terms are misspelled; the correct spelling gets tagged.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | HIGHLIGHT "conection~ OR certifcate~" ON note
    | WHERE highlight_note IS NOT NULL
    | KEEP id, highlight_note
  """
}


# =============================================================================
# 4. Regex and wildcards in one query.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | HIGHLIGHT "/re(tr|try).*/ OR dedup*" ON note, fix
    | WHERE highlight_note IS NOT NULL OR highlight_fix IS NOT NULL
    | KEEP id, highlight_note, highlight_fix
  """
}


# =============================================================================
# 5. The search-UI shape: score, sort, page, then highlight only that page.
#    Row two shows a null title - no match there, so no echoed text.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents METADATA _score
    | WHERE QSTR("note:(pool OR certificate) OR title:timeouts")
    | SORT _score DESC
    | LIMIT 3
    | HIGHLIGHT QSTR("note:(pool OR certificate) OR title:timeouts") ON title, note
        WITH { "pre_tags": ["["], "post_tags": ["]"] }
    | KEEP _score, highlight_title, highlight_note
  """
}


# =============================================================================
# 6. KQL, for parity with the Kibana search bar.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE KQL("note: (cache and latency)")
    | HIGHLIGHT KQL("note: (cache and latency)") ON note
    | KEEP id, highlight_note
  """
}

# Full-text functions also compose with AND / OR / NOT.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH_PHRASE(note, "connection pool")
    | HIGHLIGHT MATCH_PHRASE(note, "connection pool") OR MATCH(fix, "breaker")
        ON note, fix
    | KEEP id, highlight_note, highlight_fix
  """
}


###############################################################################
# Sections 7-10: highlighting columns that are not in the index.
# The _search highlighter cannot do any of these.
###############################################################################


# =============================================================================
# 7. A field parsed out of a raw log line by GROK. "msg" is not in the mapping.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | GROK log "level=%{WORD:level} svc=%{WORD:service} msg=%{GREEDYDATA:msg}"
    | HIGHLIGHT "exhausted OR handshake OR mismatch" ON msg
    | WHERE highlight_msg IS NOT NULL
    | KEEP id, level, highlight_msg
  """
}


# =============================================================================
# 8. An aggregation result. Rows here are groups, not documents.
#    checkout grouped two titles but only one matched, so one snippet returns.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | STATS n = COUNT(*), titles = VALUES(title) BY svc
    | WHERE n > 1
    | HIGHLIGHT "checkout OR indexer OR shard" ON titles
    | KEEP svc, n, highlight_titles
  """
}


# =============================================================================
# 9. A column pulled in from another index by LOOKUP JOIN.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "certificate OR pool")
    | LOOKUP JOIN teams ON svc
    | HIGHLIGHT "\"connection pool\" OR \"certificate rotation\"" ON charter
    | KEEP id, team, highlight_charter
  """
}


# =============================================================================
# 10. A synthetic document stitched together by EVAL, highlighted across
#     the seam between the original fields.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "pool")
    | EVAL doc = CONCAT(title, ". ", note, " ", fix)
    | HIGHLIGHT "\"connection pool\" OR breaker" ON doc
        WITH { "fragment_size": 40, "number_of_fragments": 3 }
    | KEEP id, highlight_doc
  """
}


# =============================================================================
# 11. Two highlighters in one pass. _search allows one config per field;
#     HIGHLIGHT is just a pipeline stage, so stack as many as you like.
#     Here: what broke, and what fixed it, with different tags.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-01"
    | HIGHLIGHT prefix = "cause_" "pool OR exhausted"
        ON note WITH { "pre_tags": ["("], "post_tags": [")"] }
    | HIGHLIGHT prefix = "fix_" "breaker OR raised"
        ON fix  WITH { "pre_tags": ["{"], "post_tags": ["}"] }
    | KEEP cause_note, fix_fix
  """
}


# =============================================================================
# 12. An empty prefix rewrites the source column in place instead of adding
#     a new one. Markdown bold as the tags.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-01"
    | HIGHLIGHT prefix = "" "pool OR breaker" ON note, fix
        WITH { "pre_tags": ["**"], "post_tags": ["**"] }
    | KEEP id, note, fix
  """
}


# =============================================================================
# 13. HTML-safe output. The document text is escaped, the highlight tags
#     stay live: a user-supplied <b> goes inert, <em> still renders.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      ROW review = "The <b>best</b> tent ever. Survived a storm & rain."
    | HIGHLIGHT "tent OR storm" ON review WITH { "encoder": "html" }
    | KEEP highlight_review
  """
}


# =============================================================================
# 14. Fragments. sentence (the default) gives readable snippets.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-01"
    | HIGHLIGHT "pool" ON note
        WITH { "fragment_size": 30, "number_of_fragments": 2 }
    | KEEP highlight_note
  """
}

# The word scanner gives tight ones.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-01"
    | HIGHLIGHT "pool" ON note
        WITH { "fragment_size": 30, "number_of_fragments": 2, "boundary_scanner": "word" }
    | KEEP highlight_note
  """
}


# =============================================================================
# 15. Fragment order. none (the default) keeps document order.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      ROW snippet = ["fast search", "fast and fast results"]
    | HIGHLIGHT "fast" ON snippet WITH { "order": "none" }
    | KEEP highlight_snippet
  """
}

# score puts the densest snippet first.

POST /_query?format=txt
{
  "query": """
      ROW snippet = ["fast search", "fast and fast results"]
    | HIGHLIGHT "fast" ON snippet WITH { "order": "score" }
    | KEEP highlight_snippet
  """
}


# =============================================================================
# 16. Non-matching fields are null by default. no_match_size returns leading
#     text instead - useful when you always need something to render.
#     It is a minimum, not a cap: text runs on to the next boundary.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | HIGHLIGHT "kubernetes" ON title WITH { "no_match_size": 20 }
    | KEEP id, highlight_title
    | LIMIT 3
  """
}


# =============================================================================
# 17. Analyzers. The word "retry" appears nowhere in INC-02; the text says
#     "retried" and "Retries". With the default standard analyzer: nothing.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-02"
    | HIGHLIGHT "retry" ON note, fix
    | KEEP highlight_note, highlight_fix
  """
}

# One option later, the english analyzer stems both sides of the comparison.
# HIGHLIGHT re-analyzes with "standard" by default, not the mapping analyzer,
# so set this explicitly for language or custom analyzed fields.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-02"
    | HIGHLIGHT "retry" ON note, fix WITH { "analyzer": "english" }
    | KEEP highlight_note, highlight_fix
  """
}


# =============================================================================
# 18. Multivalued fields. Each value is highlighted on its own; phrases and
#     fragment boundaries never cross a value boundary.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE id == "INC-01"
    | HIGHLIGHT "capacity OR database" ON tags
    | KEEP id, highlight_tags
  """
}

# It survives MV_EXPAND too. Full-text functions must come before MV_EXPAND,
# hence the WHERE first.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "cache pool")
    | MV_EXPAND tags
    | HIGHLIGHT "cach* OR databas*" ON tags, note
    | WHERE highlight_tags IS NOT NULL
    | KEEP id, highlight_tags, highlight_note
  """
}


# =============================================================================
# 19. Parity with the _search highlighter: same unified highlighter underneath.
#     This returns exactly the section 2 snippet, character for character.
# =============================================================================

GET /incidents/_search?filter_path=hits.hits.highlight
{
  "query":     { "match": { "note": "connection pool" } },
  "highlight": { "fields": { "note": {} } }
}


###############################################################################
# 20. Inferred queries and fields.
#
# BUILD REQUIREMENT: needs a build reporting the capability below. On older
# builds the query and the ON clause are both mandatory and these four
# requests fail to parse. Run this first and check for "supported": true.
###############################################################################

GET /_capabilities?method=POST&path=/_query&capabilities=highlight_implicit_query_and_fields

# Bare HIGHLIGHT reuses the WHERE MATCH predicate and derives note from it.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "connection pool")
    | HIGHLIGHT
    | KEEP id, highlight_note
  """
}

# Separate WHERE commands are OR-ed for highlighting while both still filter.
# Only INC-02 passes both, and title and note both come back tagged.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "certificate")
    | WHERE MATCH(title, "rotation")
    | HIGHLIGHT
    | KEEP id, highlight_title, highlight_note
  """
}

# ON * expands to every text and keyword column in scope: id, svc, title,
# note, fix, tags and log. Columns without a match come back null.

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | WHERE MATCH(note, "certificate")
    | HIGHLIGHT ON *
    | KEEP highlight_*
  """
}

# A query with no ON falls back to all text/keyword columns: find this
# string anywhere. Matches land in fix (INC-02) and log (INC-01, 06, 07).

POST /_query?format=txt
{
  "query": """
      FROM incidents
    | HIGHLIGHT "exhausted OR mismatch OR backoff"
    | KEEP id, highlight_fix, highlight_log
  """
}


###############################################################################
# WITH options
#
#   pre_tags                 string or 1-element array   default <em>
#   post_tags                string or 1-element array   default </em>
#   encoder                  default | html              default "default"
#                            (case-sensitive, unlike the rest)
#   analyzer                 built-in or plugin name     default standard
#                            (analyzers defined in index settings are not available)
#   number_of_fragments      integer >= 0                default 5
#                            (0 returns the whole value, unfragmented)
#   fragment_size            integer >= 0                default 100
#   no_match_size            integer >= 0                default 0 -> null
#   boundary_scanner         sentence | word             default sentence
#   boundary_scanner_locale  BCP 47 tag, e.g. en-US      default root locale
#   order                    none | score                default none
#   max_analyzed_offset      positive integer, or -1     default -1
#                            (hard ceiling of 1M chars per value regardless)
#
# Values must be constants: literals or query parameters, never columns.
#
# Also worth knowing:
#   - Fields must be text or keyword. semantic_text works and is treated as
#     text, but matching is lexical: a pure vector hit with no keyword
#     overlap highlights to null.
#   - When both the query and ON are written, every field the query names must
#     appear in ON. Derived queries skip that check.
#   - A query with no positive clause (NOT MATCH(...)) has nothing to
#     highlight and returns null unless no_match_size is set.
#   - Multivalued keyword fields load from doc values, so they arrive sorted
#     and deduplicated. Snippet order can differ from the _search API.
###############################################################################


# =============================================================================
# 21. Cleanup.
# =============================================================================

DELETE /incidents

DELETE /teams

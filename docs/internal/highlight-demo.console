###############################################################################
# ES|QL HIGHLIGHT - demo
#
# Paste the whole file into Kibana -> Dev Tools -> Console and run top to
# bottom. Section 1 builds the dataset; everything after it is independent.
#
#   HIGHLIGHT [prefix = "<prefix>"] [<query>] [ON <field> [, <field>...]]
#             [WITH { "option": value }]
###############################################################################


# =============================================================================
# 0. ROW, no index.
# =============================================================================

POST /_query?format=txt
{
  "query": """
      ROW content = "The quick brown fox jumps over the lazy dog."
    | HIGHLIGHT "fox" ON content
    | KEEP highlight_content
  """
}


# =============================================================================
# 1. Setup: eight short incident notes plus a lookup index of owning teams.
#    The two DELETEs 404 on a first run. That is fine.
# =============================================================================

DELETE /incidents

DELETE /teams

PUT /incidents
{
  "mappings": {
    "properties": {
      "id":    { "type": "keyword" },
      "svc":   { "type": "keyword" },
      "title": { "type": "text"    },
      "note":  { "type": "text"    },
      "fix":   { "type": "text"    },
      "tags":  { "type": "keyword" },
      "log":   { "type": "keyword" }
    }
  }
}

PUT /teams
{
  "settings": { "index.mode": "lookup" },
  "mappings": {
    "properties": {
      "svc":     { "type": "keyword" },
      "team":    { "type": "keyword" },
      "charter": { "type": "text"    }
    }
  }
}

POST /_bulk?refresh=true
{"index":{"_index":"incidents","_id":"1"}}
{"id":"INC-01","svc":"checkout","title":"Checkout timeouts at peak","note":"The connection pool was exhausted. Requests queued behind the connection pool.","fix":"Raised the connection pool and added a circuit breaker.","tags":["database","capacity"],"log":"level=ERROR svc=checkout msg=connection pool exhausted"}
{"index":{"_index":"incidents","_id":"2"}}
{"id":"INC-02","svc":"payments","title":"Payment failures after cert rotation","note":"An expired certificate broke TLS. The gateway retried too fast.","fix":"Rotated certificates. Retries now use backoff.","tags":["tls","certificates"],"log":"level=FATAL svc=payments msg=tls handshake timeout"}
{"index":{"_index":"incidents","_id":"3"}}
{"id":"INC-03","svc":"indexer","title":"Indexer fell twelve hours behind","note":"A poison message caused a crash loop. Nobody noticed the lag.","fix":"Added a dead letter queue and a lag alert.","tags":["kafka","monitoring"],"log":"level=ERROR svc=indexer msg=deserialization failure"}
{"index":{"_index":"incidents","_id":"4"}}
{"id":"INC-04","svc":"auth","title":"Login latency from a cold cache","note":"A deploy flushed the session cache. Latency rose tenfold.","fix":"Deploys now warm the cache first.","tags":["cache","deploy"],"log":"level=WARN svc=auth msg=cache miss ratio elevated"}
{"index":{"_index":"incidents","_id":"5"}}
{"id":"INC-05","svc":"notify","title":"Duplicate order emails","note":"A retry loop sent duplicate emails. No payment was affected.","fix":"Made the send path idempotent with a deduplication key.","tags":["idempotency"],"log":"level=WARN svc=notify msg=duplicate send detected"}
{"index":{"_index":"incidents","_id":"6"}}
{"id":"INC-06","svc":"inventory","title":"Stock drift after migration","note":"The sync job read the old replica. Stock levels drifted.","fix":"Repointed the job and added reconciliation.","tags":["migration","data-quality"],"log":"level=ERROR svc=inventory msg=row count mismatch"}
{"index":{"_index":"incidents","_id":"7"}}
{"id":"INC-07","svc":"checkout","title":"Cart totals rounded wrong","note":"Currency conversion rounded too early. Yen orders were off.","fix":"Moved rounding to the final total.","tags":["billing"],"log":"level=INFO svc=checkout msg=rounding mismatch currency=JPY"}
{"index":{"_index":"incidents","_id":"8"}}
{"id":"INC-08","svc":"indexer","title":"Shard count reduced","note":"Routine capacity work. No customer impact.","fix":"Shrink ran in the maintenance window.","tags":["capacity","planned"],"log":"level=INFO svc=indexer msg=shrink complete shards=30"}


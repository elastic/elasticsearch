    {
      "params" : [
        {
          "name" : "r",
          "type" : "scalar",
          "optional" : false,
          "description" : "Ratio value (0 ≤ r ≤ 1)."
        },
        {
          "name" : "v",
          "type" : "instant_vector",
          "optional" : false,
          "description" : "Instant vector input."
        }
      ],
      "variadic" : false,
      "returnType" : "instant_vector"
    }
  ],
  "examples" : [
    "limit_ratio(0.5, http_requests_total)"
  ],
  "snapshot_only" : false
}

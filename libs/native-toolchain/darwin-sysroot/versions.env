# Pinned versions for the open-source Darwin sysroot. Bump here only.

# Apple open-source components. This is a coherent set: the tags are the submodule
# pins of apple-oss-distributions/distribution-macOS on branch rel/macOS-15, which is
# how Apple publishes "the components that make up one macOS release". Libm is not in
# that manifest and has not changed since 2002.
LIBC_TAG=Libc-1698.140.3
XNU_TAG=xnu-11417.140.69
LIBM_TAG=Libm-2026
LIBPTHREAD_TAG=libpthread-536
LIBPLATFORM_TAG=libplatform-349.140.6
LIBMALLOC_TAG=libmalloc-715.140.5
AVAILABILITY_TAG=AvailabilityVersions-151

# C++ standard library headers for the Darwin target.
#
# Pinned to the libc++ release that Apple ships in the deployment target (macOS 14):
# every symbol these headers can reference exists in the target's
# /usr/lib/libc++.1.dylib by construction. libc++'s own availability table
# (libcxx/include/__configuration/availability.h) is the authority for the mapping:
# LLVM 16 -> macOS 14.0, LLVM 18 -> macOS 15.0.
#
# apt.llvm.org has no LLVM 16 suite for trixie, so the headers come from the bookworm
# pool. The two .deb files are unpacked directly (see assemble.sh) rather than installed,
# so bookworm packages never enter the image's package database. The header trees are
# byte-identical across deb architectures, so a single arch is pinned to keep the image
# reproducible regardless of which builder produces it.
LIBCXX_MAJOR=16
LIBCXX_DEB_VERSION='16.0.6~++20231112084702+7cbf1a259152-1~exp1~20231112084757.16'
LIBCXX_DEB_ARCH=amd64

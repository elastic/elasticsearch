# Cross-compilation toolchain image for Elasticsearch native libraries (libvec,
# libsimdjson, and future native modules).
# Contains clang-21 (all targets: Darwin, Linux x64, Linux aarch64).
#
# Darwin builds use an open-source sysroot assembled from Apple's open-source
# distributions plus upstream libc++ headers (see darwin-sysroot/). No macOS SDK content
# is downloaded or redistributed, so this image can be published.
# Linux cross builds use libstdc++-14-dev-*-cross (default sysroot).
#
# libsimdjson: Linux cross builds pin libstdc++ to GCC 8 (GLIBCXX_3.4.25) via
# the archived buster packages below; Makefiles select headers with -nostdinc++.
#
# To build and push (see also build_cross_toolchain_image.sh):
#   ./build_cross_toolchain_image.sh

FROM debian:trixie-slim AS toolchain

# clang-21 from the official LLVM apt repository.
# Cross sysroots: libstdc++-14-dev-{arm64,amd64}-cross provide C++ headers + libs
# for cross-compiling to the other architecture regardless of host platform.
# This image is built for both linux/amd64 and linux/arm64.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        wget \
    && wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
        | gpg --dearmor > /usr/share/keyrings/llvm-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm-archive-keyring.gpg] \
        https://apt.llvm.org/trixie/ llvm-toolchain-trixie-21 main" \
        > /etc/apt/sources.list.d/llvm-21.list \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
        make \
        curl \
        xz-utils \
        bzip2 \
        clang-21 \
        lld-21 \
        llvm-21 \
        llvm-21-tools \
        libstdc++-14-dev-arm64-cross \
        libstdc++-14-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/*

# GCC 8 libstdc++ cross packages are no longer in current Debian releases;
# pull them from the archived buster suite. libsimdjson selects these via
# Makefile flags (-nostdinc++); libvec continues to use libstdc++-14 above.
RUN echo "deb [check-valid-until=no] http://archive.debian.org/debian buster main" \
        > /etc/apt/sources.list.d/buster-libstdcxx8-archive.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libstdc++-8-dev-arm64-cross \
        libstdc++-8-dev-amd64-cross \
        linux-libc-dev-arm64-cross \
        linux-libc-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/*

# The Darwin sysroot is assembled in a separate stage to keep its build-only tools out of
# the published image: Apple's Libc header installer needs perl, unifdef and ed, the
# AvailabilityVersions generator needs python3, and the licence scan uses licensecheck.
# This stage builds on the toolchain stage because assemble.sh uses clang to compute the
# header closure and to verify the result.
FROM toolchain AS sysroot-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        perl \
        python3 \
        unifdef \
        ed \
        licensecheck \
    && rm -rf /var/lib/apt/lists/*

COPY darwin-sysroot/ /darwin-sysroot/
RUN CLANGXX=clang++-21 /darwin-sysroot/assemble.sh /opt/darwin-sysroot

FROM toolchain

COPY --from=sysroot-builder /opt/darwin-sysroot /opt/darwin-sysroot

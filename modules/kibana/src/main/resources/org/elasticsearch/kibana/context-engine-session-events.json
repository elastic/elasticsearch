{
  "index_patterns": [
    ".context-engine-session-events*"
  ],
  "data_stream": {
    "allow_custom_routing": false
  },
  "template": {
    "lifecycle": {
      "data_retention": "90d"
    },
    "settings": {
      "index.auto_expand_replicas": "0-1",
      "index.hidden": true,
      "index.sort.field": "@timestamp",
      "index.sort.order": "desc"
    },
    "mappings": {
      "_meta": {
        "version": "${kibana.context.engine.version}",
        "managed_index_mappings_version": ${kibana.context.engine.session.events.managed.index.version}
      },
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event_at": {
          "type": "date"
        },
        "id": {
          "type": "keyword"
        },
        "seq": {
          "type": "long"
        },
        "space": {
          "type": "keyword"
        },
        "ai_index_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "round_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "type": {
          "type": "keyword"
        },
        "content": {
          "type": "text",
          "fields": {
            "semantic": {
              "type": "semantic_text"
            }
          }
        },
        "tool_name": {
          "type": "keyword"
        },
        "ok": {
          "type": "boolean"
        },
        "raw": {
          "type": "object",
          "enabled": false
        }
      }
    }
  },
  "composed_of": [],
  "priority": 500,
  "version": 1
}

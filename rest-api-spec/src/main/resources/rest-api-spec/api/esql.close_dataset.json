{
  "esql.close_dataset": {
    "documentation": {
      "url": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-esql-dataset-close",
      "description": "Close one or more ES|QL datasets so that queries stop reading them (for example for cost control)."
    },
    "stability": "experimental",
    "visibility": "public",
    "headers": {
      "accept": [
        "application/json"
      ],
      "content_type": [
        "application/json"
      ]
    },
    "url": {
      "paths": [
        {
          "path": "/_query/dataset/{name}/_close",
          "methods": [
            "POST"
          ],
          "parts": {
            "name": {
              "type": "list",
              "description": "A comma-separated list of datasets to close"
            }
          }
        }
      ]
    }
  }
}

{
  "esql.disable_dataset": {
    "documentation": {
      "url": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-esql-dataset-disable",
      "description": "Disable one or more ES|QL datasets to stop query use (for example for cost control)."
    },
    "stability": "experimental",
    "visibility": "public",
    "headers": {
      "accept": [
        "application/json"
      ],
      "content_type": [
        "application/json"
      ]
    },
    "url": {
      "paths": [
        {
          "path": "/_query/dataset/{name}/_disable",
          "methods": [
            "POST"
          ],
          "parts": {
            "name": {
              "type": "list",
              "description": "A comma-separated list of datasets to disable"
            }
          }
        }
      ]
    }
  }
}

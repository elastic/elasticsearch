{
  "esql.enable_dataset": {
    "documentation": {
      "url": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-esql-dataset-enable",
      "description": "Enable one or more ES|QL datasets for query use."
    },
    "stability": "experimental",
    "visibility": "public",
    "headers": {
      "accept": [
        "application/json"
      ],
      "content_type": [
        "application/json"
      ]
    },
    "url": {
      "paths": [
        {
          "path": "/_query/dataset/{name}/_enable",
          "methods": [
            "POST"
          ],
          "parts": {
            "name": {
              "type": "list",
              "description": "A comma-separated list of datasets to enable"
            }
          }
        }
      ]
    }
  }
}

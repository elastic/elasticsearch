{
  "fleet.search": {
    "documentation": {
      "url": null,
      "description": "Run a Fleet search"
    },
    "stability": "experimental",
    "visibility": "public",
    "headers": {
      "accept": [
        "application/json"
      ],
      "content_type": [
        "application/json"
      ]
    },
    "url": {
      "paths": [
        {
          "path": "/{index}/_fleet/_fleet_search",
          "methods": [
            "GET",
            "POST"
          ],
          "parts": {
            "index": {
              "type": "string",
              "description": "The index name to search."
            }
          }
        },
        {
          "path": "/{index}/{_slice}/_fleet/_fleet_search",
          "methods": [
            "GET",
            "POST"
          ],
          "parts": {
            "index": {
              "type": "string",
              "description": "The index name to search."
            },
            "_slice": {
              "type": "string",
              "description": "Slice identifier(s) for a slice-enabled index (`index.slice.enabled=true`). A single slice, a comma-separated list (for example `tenant-a,tenant-b`), or the reserved token `_all` to search all slices.",
              "feature_flag": "es.slice_indexing_feature_flag_enabled"
            }
          }
        }
      ]
    },
    "params": {
      "wait_for_checkpoints": {
        "type": "list",
        "description": "Comma separated list of checkpoints, one per shard",
        "default": ""
      },
      "wait_for_checkpoints_timeout": {
        "type": "time",
        "description": "Explicit wait_for_checkpoints timeout"
      },
      "allow_partial_search_results": {
        "type": "boolean",
        "default": true,
        "description": "Indicate if an error should be returned if there is a partial search failure or timeout"
      }
    },
    "body": {
      "description": "The search definition using the Query DSL",
      "required": true
    }
  }
}

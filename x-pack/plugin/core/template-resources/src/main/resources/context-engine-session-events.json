{
  "index_patterns": [
    ".context-engine-session-events"
  ],
  "data_stream": {
    "hidden": true
  },
  "template": {
    "lifecycle": {
      "data_retention": "90d"
    },
    "settings": {
      "index.auto_expand_replicas": "0-1",
      "index.sort.field": "@timestamp",
      "index.sort.order": "desc"
    },
    "mappings": {
      "_meta": {
        "version": "${xpack.contextengine.version}",
        "managed_index_mappings_version": ${xpack.contextengine.managed.index.version}
      },
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "id": {
          "type": "keyword"
        },
        "space": {
          "type": "keyword"
        },
        "ai_index_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "round_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "transcript": {
          "type": "text",
          "index": false
        }
      }
    }
  },
  "composed_of": [],
  "priority": 500,
  "version": 1
}

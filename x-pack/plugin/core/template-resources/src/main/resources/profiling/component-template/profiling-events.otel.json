{
  "template": {
    "settings": {
      "mode": "logsdb",
      "index": {
        "number_of_shards": 4,
        "auto_expand_replicas": "0-1",
        "max_result_window": 150000,
        "refresh_interval": "10s",
        "sort": {
          "field": [
            "resource.attributes.k8s.namespace.name",
            "resource.attributes.k8s.pod.name",
            "resource.attributes.service.name",
            "resource.attributes.host.name",
            "resource.attributes.container.name",
            "resource.attributes.process.executable.name",
            "resource.attributes.thread.name",
            "@timestamp"
          ],
          "order": [
            "asc",
            "asc",
            "asc",
            "asc",
            "asc",
            "asc",
            "asc",
            "desc"
          ]
        },
        "routing.allocation.include._tier_preference": "data_hot"
      },
      "codec": "best_compression"
    },
    "mappings": {
      "_meta": {
        "index-template-version": ${xpack.profiling.template.version},
        "index-version": ${xpack.profiling.index.events.otel.version},
        "managed": true
      },
      "dynamic": false,
      "properties": {
        "@timestamp": {
          "type": "date_nanos",
          "format": "strict_date_optional_time_nanos||epoch_second"
        },
        "Stacktrace.id": {
          "type": "keyword",
          "index": false
        },
        "Stacktrace.count": {
          "type": "short",
          "index": false
        },
        "Stacktrace.sampling_frequency": {
          "type": "long",
          "index": false
        },
        "resource": {
          "properties": {
            "attributes": {
              "type": "passthrough",
              "dynamic": true,
              "priority": 40,
              "properties": {
                "thread.name": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "process.thread.name": {
          "type": "alias",
          "path": "resource.attributes.thread.name"
        }
      }
    }
  },
  "version": ${xpack.profiling.template.version}
}

{
  "template": {
    "settings": {
      "index": {
        "auto_expand_replicas": "0-1",
        "refresh_interval": "10s",
        "routing.allocation.include._tier_preference": "data_hot",
        "mapping": {
          "source": {
            "mode": "synthetic"
          }
        }
      }
    },
    "mappings": {
      "_meta": {
        "index-template-version": ${xpack.profiling.template.version},
        "index-version": ${xpack.profiling.index.executables.otel.version},
        "managed": true
      },
      "dynamic": false,
      "properties": {
        "process.executable.build_id": {
          "type": "keyword",
          "index": true
        },
        "process.executable.name": {
          "type": "keyword",
          "index": true
        },
        "@timestamp": {
          "type": "date",
          "format": "epoch_second"
        }
      }
    }
  },
  "version": ${xpack.profiling.template.version}
}

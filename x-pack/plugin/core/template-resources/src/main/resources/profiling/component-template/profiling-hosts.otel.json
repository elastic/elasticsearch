{
  "template": {
    "settings": {
      "index": {
        "auto_expand_replicas": "0-1",
        "refresh_interval": "10s",
        "sort": {
          "field": [
            "host.id",
            "@timestamp"
          ]
        },
        "routing.allocation.include._tier_preference": "data_hot"
      },
      "codec": "best_compression"
    },
    "mappings": {
      "_source": {
        "enabled": true
      },
      "_meta": {
        "index-template-version": ${xpack.profiling.template.version},
        "index-version": ${xpack.profiling.index.hosts.otel.version},
        "managed": true
      },
      "dynamic": false,
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "epoch_second"
        },
        "host": {
          "properties": {
            "arch": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            }
          }
        },
        "cloud": {
          "properties": {
            "provider": {
              "type": "keyword"
            },
            "region": {
              "type": "keyword"
            }
          }
        },
        "os": {
          "properties": {
            "type": {
              "type": "keyword"
            }
          }
        },
        "profiling": {
          "properties": {
            "agent": {
              "properties": {
                "config.sampling_frequency": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  "version": ${xpack.profiling.template.version}
}

{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 16,
        "auto_expand_replicas": "0-1",
        "refresh_interval": "10s",
        "routing.allocation.include._tier_preference": "data_hot"
      }
    },
    "mappings": {
      "_source": {
        "enabled": true
      },
      "_meta": {
        "index-template-version": ${xpack.profiling.template.version},
        "index-version": ${xpack.profiling.index.stackframes.otel.version},
        "managed": true
      },
      "dynamic": false,
      "properties": {
        "Stackframe.line.number": {
          "type": "integer",
          "index": false,
          "doc_values": false,
          "store": false
        },
        "Stackframe.file.name": {
          "type": "keyword",
          "index": false,
          "doc_values": false,
          "store": false
        },
        "Stackframe.function.name": {
          "type": "keyword",
          "index": false,
          "doc_values": false,
          "store": false
        },
        "Stackframe.function.offset": {
          "type": "integer",
          "index": false,
          "doc_values": false,
          "store": false
        }
      }
    }
  },
  "version": ${xpack.profiling.template.version}
}

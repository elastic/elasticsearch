// The whitespace analyzer does not lowercase, so the lowercase "tech lead" phrase matches nothing.
FROM employees_no_mv
| EVAL t = to_text(job_positions, {"analyzer": "whitespace"})
| WHERE match_phrase(t, "Team Lead") OR match_phrase(t, "tech lead")
| KEEP emp_no, job_positions
| SORT emp_no
;

emp_no:integer | job_positions:keyword

matchOnExternalWithMinimumShouldMatch
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_match_runtime_options
dataset: employees_no_mv: "{{employees_no_mv}}"

// "Purchase Manager" shares only one of the four terms, so it falls short of three.
FROM employees_no_mv
| EVAL t = to_text(job_positions)
| WHERE match(t, "head human resources manager", {"minimum_should_match": 3})
| KEEP emp_no, job_positions
| SORT emp_no
;

emp_no:integer | job_positions:keyword
10012          | Head Human Resources
10083          | Head Human Resources
;

matchOnExternalWithFuzziness
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_match_runtime_options
dataset: employees_no_mv: "{{employees_no_mv}}"

FROM employees_no_mv
| EVAL n = to_text(first_name)
| WHERE match(n, "bezalal", {"fuzziness": 1})
| KEEP emp_no, first_name
;

emp_no:integer | first_name:keyword
10002          | Bezalel
;

matchOnExternalWithValuesAnalyzer
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_to_text_analyzer
dataset: employees_no_mv: "{{employees_no_mv}}"

// The whitespace analyzer does not lowercase, and the query is analyzed the same way, so "lead" matches nothing
// and only "Team" survives; the standard analyzer would also match every "Tech Lead".
FROM employees_no_mv
| EVAL t = to_text(job_positions, {"analyzer": "whitespace"})
| WHERE match(t, "Team lead")
| KEEP emp_no, job_positions
| SORT emp_no
;

emp_no:integer | job_positions:keyword
10002          | Senior Team Lead
10056          | Senior Team Lead
;


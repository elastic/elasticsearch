matchOnExternalKeywordIsExact
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_match_runtime_filter
dataset: employees_no_mv: "{{employees_no_mv}}"

// A keyword column matches by exact equality, so a sub-phrase of "Senior Team Lead" matches nothing.
FROM employees_no_mv
| WHERE match(job_positions, "Team Lead")
| KEEP emp_no, job_positions
;

emp_no:integer | job_positions:keyword
;

matchOnExternalKeywordAsTextIsAnalyzed
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_match_runtime_filter
dataset: employees_no_mv: "{{employees_no_mv}}"

// Any analyzed term matches, so both "Senior Team Lead" and "Tech Lead" qualify.
FROM employees_no_mv
| EVAL t = to_text(job_positions)
| WHERE match(t, "team lead")
| KEEP emp_no, job_positions
| SORT emp_no
;


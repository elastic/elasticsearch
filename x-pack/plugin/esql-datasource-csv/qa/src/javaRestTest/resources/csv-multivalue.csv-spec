10012          | [Head Human Resources, Accountant]
;

// All values of a row are indexed as one document, so the AND operator is satisfied by terms from different values.
matchOnMultiValueTextWithOperatorAndFromDataset
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_match_runtime_options
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| EVAL t = to_text(job_positions)
| WHERE emp_no <= 10012 AND match(t, "accountant python", {"operator": "AND"})
| KEEP emp_no, t
;

emp_no:integer | t:text
10001          | [Senior Python Developer, Accountant]
;

// A phrase cannot span two values: 10001's "Senior Python Developer" and "Accountant" are separated by a position gap
// larger than the slop, while phrases inside a single value still match.
matchPhraseOnMultiValueTextDoesNotSpanValuesFromDataset
required_capability: dataset_in_from_command
required_capability: match_phrase_function
required_capability: fn_match_phrase_runtime_options
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| EVAL t = to_text(job_positions)
| WHERE emp_no <= 10012 AND (match_phrase(t, "developer accountant", {"slop": 5}) OR match_phrase(t, "human resources", {"slop": 5}))
| KEEP emp_no, t
| SORT emp_no
;

emp_no:integer | t:text
10004          | [Reporting Analyst, Tech Lead, Head Human Resources, Support Engineer]
10012          | [Head Human Resources, Accountant]
;

// mv_like / mv_rlike over a dataset: FROM <dataset> has no Lucene index, so the predicate runs on the
// compute-engine evaluator — the path these functions take in production for datasets. The any-value
// reduction must agree with the index-backed mvLikeField/mvRLikeField tests over the identical data.
mvLikeFromDataset
required_capability: fn_mv_like
required_capability: dataset_in_from_command
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no <= 10002 AND mv_like(job_positions, "Senior*")
| KEEP emp_no
| SORT emp_no
;

emp_no:integer
10001
10002
;

// The two-valued contract on the dataset path: emp 10003 has no job_positions, so mv_like is false (never
// null) and NOT includes it; emp 10004's values are all non-Senior, so NOT includes it too.
mvLikeNotFromDataset
required_capability: fn_mv_like
required_capability: dataset_in_from_command
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no <= 10004 AND NOT mv_like(job_positions, "Senior*")
| KEEP emp_no
| SORT emp_no
;

emp_no:integer
10003
10004
;

mvRLikeFromDataset
required_capability: fn_mv_rlike
required_capability: dataset_in_from_command
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no <= 10004 AND mv_rlike(job_positions, "Senior.*")
| KEEP emp_no
| SORT emp_no
;

emp_no:integer
10001
10002
;

// A STATS BY key derived with + from other external integral keys is evaluated on the row, so it is null (with the
// usual multi-value warning) where an input column holds a bracket list. The optimizer used to drop such a key from
// the aggregate and recompute it per group, returning one number per list element (9995 / 10013 here). The exact
// warnings pin the row-level evaluation; a regex would only permit them. Sister shapes live in
// external-multivalue.csv-spec.
derivedGroupingKeyOverMultivalueColumn
required_capability: dataset_in_from_command
required_capability: fix_derived_external_grouping_multivalue
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no == 10002
| EVAL s = emp_no + salary_change.int
| STATS c = COUNT(*) BY emp_no, salary_change.int, s
| SORT salary_change.int
;
warning:Line 3:12: evaluation of [emp_no + salary_change.int] failed, treating result as null. Only first 20 failures recorded.
warning:Line 3:12: java.lang.IllegalArgumentException: single-value function encountered multi-value

c:long | emp_no:integer | salary_change.int:integer | s:integer
1      | 10002          | -7                        | null
1      | 10002          | 11                        | null
;

// The derived key also adds groups: 10037 (single salary_change.int -7) and 10078 (list [-7, 9, 12]) share languages
// 2 and the element -7, yet the row-level s separates them into (-7, -5) and (-7, null). Recomputing s per group
// collapsed those two rows into one group.
derivedGroupingKeyOverMultivalueColumnKeepsGroups
required_capability: dataset_in_from_command
required_capability: fix_derived_external_grouping_multivalue
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no IN (10037, 10078)
| EVAL s = languages + salary_change.int
| STATS c = COUNT(*) BY languages, salary_change.int, s
| SORT salary_change.int, s
;
warning:Line 3:12: evaluation of [languages + salary_change.int] failed, treating result as null. Only first 20 failures recorded.
warning:Line 3:12: java.lang.IllegalArgumentException: single-value function encountered multi-value

c:long | languages:integer | salary_change.int:integer | s:integer
1      | 2                 | -7                        | -5
1      | 2                 | -7                        | null
1      | 2                 | 9                         | null
1      | 2                 | 12                        | null
;


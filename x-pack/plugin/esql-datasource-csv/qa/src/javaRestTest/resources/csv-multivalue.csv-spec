// Runtime match over a multi-value column: a keyword column matches when any value is exactly equal.
matchOnMultiValueKeywordFromDataset
required_capability: dataset_in_from_command
required_capability: match_function
required_capability: fn_match_runtime_filter
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no <= 10012 AND match(job_positions, "Tech Lead")
| KEEP emp_no, job_positions
| SORT emp_no
;

emp_no:integer | job_positions:keyword
10004          | [Reporting Analyst, Tech Lead, Head Human Resources, Support Engineer]
10006          | [Tech Lead, Principal Support Engineer, Senior Team Lead]
10010          | [Architect, Reporting Analyst, Tech Lead, Purchase Manager]
10011          | [Architect, Reporting Analyst, Tech Lead, Senior Team Lead]
;

matchOperatorOnMultiValueKeywordFromDataset
required_capability: dataset_in_from_command
required_capability: match_operator_colon
required_capability: fn_match_runtime_filter
dataset: employees_brackets: "{{employees}}" WITH {"multi_value_syntax": "brackets"}

FROM employees_brackets
| WHERE emp_no <= 10012 AND job_positions : "Accountant"
| KEEP emp_no, job_positions
| SORT emp_no
;

emp_no:integer | job_positions:keyword

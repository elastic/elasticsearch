// CSV nullability tests: verifies that IS NULL / IS NOT NULL predicates work
// correctly against CSV files with empty cells.
//
// apps.csv has a typed header (id:integer,version:version,name:keyword,_id:keyword)
// and two rows with empty version cells (id=11 and id=13).
//
// Authored as FROM <dataset>: each test declares its source via a `dataset:` directive. The harness registers
// the dataset on every storage backend and runs the FROM query verbatim. The bare name `apps` would collide
// with the ES|QL apps index twin, so the dataset is named `apps_ds`.

filterVersionIsNull
required_capability: dataset_in_from_command
required_capability: external_csv_header_row_option
required_capability: datasource_file_readers_no_text_type
dataset: apps_ds: "{{apps}}"

FROM apps_ds
| WHERE version IS NULL
| KEEP id, name
| SORT id
;

id:integer | name:keyword
11         | kkkkk
13         | lllll
;

filterVersionIsNotNull
required_capability: dataset_in_from_command
required_capability: external_csv_header_row_option
required_capability: datasource_file_readers_no_text_type
dataset: apps_ds: "{{apps}}"

FROM apps_ds
| WHERE version IS NOT NULL
| KEEP id, name
| SORT id
;

id:integer | name:keyword
1          | aaaaa
2          | bbbbb
3          | ccccc
4          | ddddd
5          | eeeee
6          | fffff
7          | ggggg
8          | hhhhh
9          | iiiii
10         | jjjjj
12         | aaaaa
14         | mmmmm
;

// The string half of the same rule. employees_no_mv is registered WITHOUT mappings, so every column is
// inferred -- and a blank cell reads as "" on a string column (keyword), so IS NULL returns nothing here.
// Use == "" to match the blank gender rows. The 10 rows are emp_no 10010..10019.
filterInferredBlankKeywordIsEmptyString
required_capability: dataset_in_from_command
required_capability: external_csv_blank_cell_empty_string_unless_null_token
dataset: employees_no_mv: "{{employees_no_mv}}"

FROM employees_no_mv
| WHERE gender == ""
| KEEP emp_no
| SORT emp_no
;

emp_no:integer
10010
10011
10012
10013
10014
10015
10016
10017
10018
10019
;

// A row that stops before the file's width is a row error, not a row of nulls: ragged_short_rows.csv holds
// `2,bob` against a three-column header, and under error_mode: skip_row it is dropped with a warning naming
// the row and both widths. The default fail_fast fails the query outright, which a csv-spec cannot assert.
// The warnings below CONSTRAIN what may be returned rather than requiring it -- warningRegex selects
// AllowedRegexes, which checks the warnings received and so passes on none at all. That the notices actually
// reach a client is pinned by ExternalCsvShortRowWarningsIT, which fails when they are absent.
shortRowDroppedUnderSkipRow
required_capability: dataset_in_from_command
required_capability: external_dataset_messages
required_capability: external_csv_short_row_is_a_row_error
dataset: ragged_short_skip: "{{ragged_short_rows}}" WITH {"error_mode": "skip_row", "max_errors": 10}

FROM ragged_short_skip
| KEEP id, name, score
| SORT id
;
warningRegex:Some rows in \[.+\] cannot be read; skipping them
warningRegex:row \[2\]: missing trailing fields: \[2\] columns, the header has \[3\]

id:integer | name:keyword | score:integer
1          | alice        | 10
3          | carol        | 30
;

// pad_short_rows asks for the old reading back: the short row is kept with its missing field null, and the
// padding is reported whatever the error mode, so nothing is padded silently.
shortRowPaddedWhenOptedIn
required_capability: dataset_in_from_command
required_capability: external_csv_short_row_is_a_row_error
dataset: ragged_short_padded: "{{ragged_short_rows}}" WITH {"pad_short_rows": true}

FROM ragged_short_padded
| KEEP id, name, score
| SORT id
;
warningRegex:Some rows in \[.+\] are missing trailing fields; reading those fields as null
warningRegex:row \[2\]: missing trailing fields, read as null: \[2\] columns, the header has \[3\]

id:integer | name:keyword | score:integer
1          | alice        | 10
2          | bob          | null
3          | carol        | 30
;

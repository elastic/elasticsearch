// Declared-type COERCION on a columnar format: the file carries authoritative types in its footer, and the
// declaration overrides them, so the reader must convert at decode time via DeclaredTypeCoercions.
//
// This is the arm a declaration that AGREES with the file can never reach: identity coercion short-circuits, so
// a declaration restating the footer exercises no conversion at all. Only a declaration that DISAGREES does.
//
// employees_no_mv.parquet is generated from the typed-header CSV, so the footer types are the header's:
// emp_no INT32, salary INT32, avg_worked_seconds INT64, height DOUBLE, salary_change.keyword a UTF8 string.

// INT32 read as a 64-bit integer. Inference reports salary as an integer; the declaration widens it.
strictDeclaredInt32ReadsAsLongOnParquet
required_capability: dataset_in_from_command
dataset: employees_declared_widen: "{{employees_no_mv}}" WITH {"mappings": {"dynamic": "false", "properties": {"id": {"type": "long", "path": "emp_no"}, "pay": {"type": "long", "path": "salary"}}}}

FROM employees_declared_widen
| SORT id
| LIMIT 3;

id:long | pay:long
10001   | 57305
10002   | 56371
10003   | 61805
;

// A UTF8 string column read as a double, crossed with the error policy. The physical column holds text; the
// declared type makes the reader parse it, and inference reports this column as a keyword, so the declared type
// is what produces a number at all. 21 of the 100 rows hold an empty string, which is not a double -- under the
// default policy that fails the read with a message naming the column and the remedy, so the declaration only
// works here alongside error_mode: null_field, which reads the unparseable values as null. Declared coercion and
// the error policy are therefore not independent, and this pins the pair.
strictDeclaredStringReadsAsDoubleOnParquetUnderNullFieldPolicy
required_capability: dataset_in_from_command
dataset: employees_declared_parse: "{{employees_no_mv}}" WITH {"error_mode": "null_field", "mappings": {"dynamic": "false", "properties": {"id": {"type": "long", "path": "emp_no"}, "change": {"type": "double", "path": "salary_change.keyword"}}}}

FROM employees_declared_parse
| SORT id
| LIMIT 3;
warningRegex:Column \[salary_change.keyword\]: cannot coerce value from \[keyword\] to declared type \[double\]: empty String; returning null
warningRegex:.* has values that could not be coerced to the declared column type; they are returned as null
warningRegex:\.\.\. further warnings suppressed .*

id:long | change:double
10001   | 1.19
10002   | -7.23
10003   | 14.68
;

// esql-planning#1056: COUNT / IS NOT NULL over a top-level Parquet list (multivalue) column were
// answered from footer statistics addressed by the attribute name (e.g. "job_positions"), but the
// file keys its column metadata at the leaf chunk path ("job_positions.list.element"). The name miss
// made the stats layer treat the column as absent-and-all-null: COUNT(list) returned 0, and the
// IS NOT NULL filter predicate — built on the phantom attribute path — made parquet-mr drop every
// row group, so no rows survived. The fix registers the list column under its attribute name with an
// unknown null count and declines the IS NULL / IS NOT NULL predicate for list columns, so both fall
// back to the (correct) scan. The decode itself was never wrong (KEEP / MV_COUNT / MIN / MAX read correctly).
//
// employees_ds carries job_positions (list<keyword>) and salary_change (list<double>). ES|QL COUNT
// counts VALUES, so COUNT(<list>) is the total non-null element count across rows, not the row count.
//
// Authored as FROM <dataset>: on dataset-capable backends (S3) ParquetFormatSpecIT registers the
// dataset and runs the FROM query verbatim; other backends rebuild the equivalent EXTERNAL query.

listCountKeyword
required_capability: external_command
dataset: employees_ds: "{{employees}}"

FROM employees_ds
| STATS c = COUNT(job_positions);

c:long
221
;

listCountDouble
required_capability: external_command
dataset: employees_ds: "{{employees}}"

FROM employees_ds
| STATS c = COUNT(salary_change);

c:long
183
;

listIsNotNullKeyword
required_capability: external_command
dataset: employees_ds: "{{employees}}"

FROM employees_ds
| WHERE job_positions IS NOT NULL
| STATS c = COUNT(*);

c:long
89
;

listIsNotNullDouble
required_capability: external_command
dataset: employees_ds: "{{employees}}"

FROM employees_ds
| WHERE salary_change IS NOT NULL
| STATS c = COUNT(*);

c:long
79
;

// Fingerprint of the root cause: COUNT(list) alone is served from footer stats (returned 0 before
// the fix); adding MAX(list) in the same STATS aborts the stats substitution and forces the scan, so
// MAX was always correct. After the fix both are scan-answered and COUNT agrees with the value above.
listCountWithMaxAgrees
required_capability: external_command
dataset: employees_ds: "{{employees}}"

FROM employees_ds
| STATS c = COUNT(job_positions), m = MAX(job_positions)
| KEEP c;

c:long
221
;

// STATS with a single filtered aggregate: the optimizer lifts the LIKE condition into a WHERE
// when no unfiltered aggregate exists beside it. Exercises the same code path as the plain WHERE.
parquetUbnSingleFilteredAggWithLikeOnMissingColumn
required_capability: dataset_in_from_command

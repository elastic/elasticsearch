// ===== YES LIKE on a present column with a withheld RECHECK conjunct =====
// Fixture: parquet_ubn_like_recheck_a.parquet — schema [name:keyword, city:keyword, qty:integer]
//          parquet_ubn_like_recheck_b.parquet — schema [name:keyword, city:keyword, qty:double]
//   Rows A: alice(paris, 2), bob(london, 3)
//   Rows B: charlie(paris, 2.5), dave(london, 3.7)
// Unified schema: name:keyword, city:keyword, qty:double
// qty is int32 in file A and double in file B. UBN widens INTEGER → DOUBLE (one-way: inferFileType
// returns null for DOUBLE), so mapFilters withholds qty > 1.5 for file A. The adapted push-down for
// file A contains only the YES LIKE predicate, which has no native Parquet FilterPredicate.
//
// Correctness pin: the RECHECK conjunct (qty > 1.5) passes BOTH alice and bob because their
// widened values (2.0, 3.0) both exceed 1.5. The YES LIKE evaluated by the late-mat evaluator
// MUST drop bob (city=london) even though the RECHECK conjunct would have kept him. If the
// evaluator returned "all survive" instead of evaluating the real city values, bob would leak.
parquetUbnLikeOnPresentColumnWithRecheckConjunct
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_like_recheck_union: "{{employees_multifile_ubn_like_recheck}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_like_recheck_union
| WHERE city LIKE "par*" AND qty > 1.5
| KEEP name, city
| SORT name ASC;

name:keyword | city:keyword
alice        | paris
charlie      | paris
;

// ===== FIRST_FILE_WINS on divergent Parquet schemas =====
// Anchor: parquet_ubn_a.parquet (lex-smallest; file_sort_by=name) — schema [name, age:integer, score:double]
// File B is read through anchor's schema: name maps OK, age (int64 → int32) is incompatible
// so the entire column is returned as null with a warning, score is missing → null.

parquetFfwAllRows
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_source_file_order_options
dataset: employees_multifile_ubn_ffw: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "first_file_wins", "file_sort_by": "name"}

FROM employees_multifile_ubn_ffw
| SORT name ASC;
warningRegex:Column \[age\] in file \[.*parquet_ubn_b\.parquet\] has type \[LONG\] incompatible with planner type \[INTEGER\]; returning nulls for this column
warningRegex:Parquet file \[.*parquet_ubn_b\.parquet\] has columns whose on-disk type is incompatible with planner type; they are returned as null
warningRegex:declared column \[score\] is not present in some source files


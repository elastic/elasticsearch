// Regression pin: an unfiltered aggregate beside a filtered one keeps the LIKE in the engine
// (the optimizer cannot lift it). Both the total row count and the filtered count must be correct.
parquetUbnMixedFilteredAndUnfilteredAggWithLikeOnMissingColumnPin
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_parquet_like_missing_column_rejects_rows

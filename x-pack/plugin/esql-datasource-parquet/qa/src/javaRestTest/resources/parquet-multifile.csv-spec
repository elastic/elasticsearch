// Parquet-specific multifile tests with divergent schemas.
// Uses {{employees_multifile_ubn}} which resolves to multifile_ubn/*.parquet.
// Two fixture files:
//   parquet_ubn_a.parquet — schema [name:keyword, age:integer, score:double]
//                           rows: alice(30, 85.5), bob(40, 92.0)
//   parquet_ubn_b.parquet — schema [age:long, name:keyword, city:keyword]
//                           rows: charlie(50, paris), dave(60, london)
// The mixed-temporal (ts:date/date_nanos) and lossy-representation (code:integer/keyword) columns live in the
// SEPARATE {{employees_multifile_temporal}} and {{employees_multifile_type_drift}} fixtures, used only by the
// parquetUbnMixedTemporal* / parquetUbnMixedRepresentation tests below, so they do not perturb this fixture's
// first-file-wins and widened-column tests.
//
// Authored as FROM <dataset>: each test declares its source via a `dataset:` directive. ParquetFormatSpecIT
// registers the dataset on every storage backend and runs the FROM query verbatim. The dataset name encodes
// the schema_resolution option so the same name always carries the same settings.
//
// The widened `age` cases below intentionally verify cross-file int32 -> int64 reconciliation.

// ===== UNION_BY_NAME on divergent Parquet schemas =====
// Unified schema: name:keyword, age:long (widened), score:double (null in B), city:keyword (null in A)

// Cross-file column-type widening (C3): age is int32 in file A and int64 in file B; the union
// widens both to long. Projecting age must read all rows with correct values (file A's int32 is
// cast up to long), not fail with "Failed to map page".
parquetUbnProjectWidenedColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| KEEP name, age
| SORT name ASC;

name:keyword | age:long
alice        | 30
bob          | 40
charlie      | 50
dave         | 60
;

parquetUbnAggregateWidenedColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| STATS total = SUM(age);

total:long
180
;

// Unfiltered warm MIN/MAX over the widened age (int32 {30,40} in file A, int64 {50,60} in file B,
// unified to long). Exercises the source-level stat fold (aggregateFileStatistics), which reconciles
// each file's per-column stats to the unified type BEFORE folding -- MIN/MAX served from stats must
// equal a full scan, never a unit/representation-blind mix across files.
parquetUbnMinMaxWidenedColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| STATS lo = MIN(age), hi = MAX(age);

lo:long | hi:long
30      | 60
;

// Filtered warm MIN/MAX over the widened age: exercises the split-filter classifier + filtered stat
// merge on footer splits, which read per-file (file-local-typed) stats reconciled to the unified type.
parquetUbnFilteredMinMaxWidenedColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE age > 45
| STATS lo = MIN(age), hi = MAX(age);

lo:long | hi:long
50      | 60
;


// Representation safe-miss (B4): code is INTEGER in file A {2,9} and KEYWORD in file B {10,11}, widened by
// union_by_name to KEYWORD. A numeric-blind warm serve would give MIN "2" / MAX "11"; normalizeStatsToReconciled
// poisons the numeric extremum (numeric -> KEYWORD is not lexicographically servable), so the aggregate
// safe-misses to a scan, which returns the correct lexicographic extrema (MIN "10" since '1'<'2', MAX "9").
parquetUbnMixedRepresentationMinMax
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_type_drift_union: "{{employees_multifile_type_drift}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_type_drift_union
| STATS lo = MIN(code), hi = MAX(code);
warningRegex:Column \[code\] widened to keyword:.*distinct types: \[integer, keyword\]
warningRegex:Schema reconciliation widened columns to keyword due to cross-file type disagreement.*

lo:keyword | hi:keyword
10         | 9
;

parquetUbnFilterWidenedColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE age > 45
| KEEP name, age
| SORT name ASC;

name:keyword | age:long
charlie      | 50
dave         | 60
;

parquetUbnCount
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| STATS count = COUNT(*);

count:long
4
;

parquetUbnProjectPruning
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| KEEP name, city
| SORT name ASC;

name:keyword | city:keyword
alice        | null
bob          | null
charlie      | paris
dave         | london
;

// ===== FIRST_FILE_WINS on divergent Parquet schemas =====
// Anchor: parquet_ubn_a.parquet (lex-smallest) — schema [name, age:integer, score:double]
// File B is read through anchor's schema: name maps OK, age (int64 → int32) is incompatible
// so the entire column is returned as null with a warning, score is missing → null.

parquetFfwAllRows
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_ffw: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "first_file_wins"}

FROM employees_multifile_ubn_ffw
| SORT name ASC;
warningRegex:Column \[age\] in file \[.*parquet_ubn_b\.parquet\] has type \[LONG\] incompatible with planner type \[INTEGER\]; returning nulls for this column
warningRegex:Parquet file \[.*parquet_ubn_b\.parquet\] has columns whose on-disk type is incompatible with the planner type; they are returned as null

name:keyword | age:integer | score:double
alice        | 30          | 85.5
bob          | 40          | 92.0
charlie      | null        | null
dave         | null        | null
;

parquetFfwCount
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_ffw: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "first_file_wins"}

FROM employees_multifile_ubn_ffw
| STATS count = COUNT(*);
warningRegex:Column \[age\] in file \[.*parquet_ubn_b\.parquet\] has type \[LONG\] incompatible with planner type \[INTEGER\]; returning nulls for this column
warningRegex:Parquet file \[.*parquet_ubn_b\.parquet\] has columns whose on-disk type is incompatible with the planner type; they are returned as null

count:long
4
;

parquetFfwFilterAnchorOnly
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_ffw: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "first_file_wins"}

FROM employees_multifile_ubn_ffw
| WHERE score IS NOT NULL
| KEEP name, score
| SORT name ASC;
warningRegex:Column \[age\] in file \[.*parquet_ubn_b\.parquet\] has type \[LONG\] incompatible with planner type \[INTEGER\]; returning nulls for this column
warningRegex:Parquet file \[.*parquet_ubn_b\.parquet\] has columns whose on-disk type is incompatible with the planner type; they are returned as null

name:keyword | score:double
alice        | 85.5
bob          | 92.0
;

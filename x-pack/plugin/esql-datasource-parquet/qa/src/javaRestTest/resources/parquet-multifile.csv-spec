// ===== Pushed filters on a column one file does not have =====
// Dataset: parquet_ubn_a.parquet = [name:keyword, age:integer, score:double] (alice, bob)
//          parquet_ubn_b.parquet = [age:long, name:keyword, city:keyword]    (charlie, dave)
// => "city" is KEYWORD and absent from file A; "score" is absent from file B.
//
// Comparison/IN/IS NULL filters (RECHECK pushdown) are re-evaluated by FilterExec after the reader
// and answer correctly regardless — they are correctness-stable pins.
//
// LIKE-family filters on an absent column were formerly pushed as Pushability.YES (FilterExec
// dropped) but the per-file evaluator returned null ("all survive") when the column was not in
// the predicate block map. This caused file A's rows to keep every row despite city being null
// there. Fixed by elastic/esql-planning#2052: the evaluator now returns an empty (no-survivors)
// mask for a named, non-virtual column absent from the block map.

parquetUbnFilterOnFileAMissingColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE city == "paris"
| KEEP name, city
| SORT name ASC;

name:keyword | city:keyword
charlie      | paris
;

// WHERE city IS NULL must match file A's rows (city is absent there, so every row is null).
// The overlap skip used to drop file A before the IS NULL carve-out, returning 0.
parquetUbnFilterCityIsNull
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_union_by_name_preserves_null_only_files
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE city IS NULL
| STATS count = COUNT(*);
warningRegex:declared column \[city\] is not present in some source files

count:long
2
;

parquetUbnFilterOnFileBMissingColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE score > 90.0
| KEEP name, score
| SORT name ASC;

name:keyword | score:double
bob          | 92.0
;

// LIKE on a column absent from file A: only file B's matching rows must survive.
// Before the fix: alice and bob (city=null) also survived because the pushed LIKE evaluator
// returned null ("all survive") when the predicate block was absent from the map.
parquetUbnLikeOnMissingColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_parquet_like_missing_column_rejects_rows
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE city LIKE "par*"
| KEEP name, city;
warningRegex:declared column \[city\] is not present in some source files

name:keyword | city:keyword
charlie      | paris
;

// NOT LIKE on a missing column: NOT (null LIKE p) is null (unknown), so file A's rows must not
// survive a NOT LIKE filter either.
parquetUbnNotLikeOnMissingColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_parquet_like_missing_column_rejects_rows
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE NOT (city LIKE "lon*")
| KEEP name, city
| SORT name ASC;
warningRegex:declared column \[city\] is not present in some source files

name:keyword | city:keyword
charlie      | paris
;

// Second route: NOT LIKE on a missing column combined with IS NOT NULL on a column absent from
// file B. The result must be empty: file A's rows are rejected by the NOT LIKE (city is null),
// and file B's rows are rejected by the IS NOT NULL on score (absent in file B).
parquetUbnNotLikeAndIsNotNullOnCrossAbsentColumns
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_parquet_like_missing_column_rejects_rows
dataset: employees_multifile_ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_ubn_union
| WHERE NOT (city LIKE "lon*") AND score IS NOT NULL
| STATS n = COUNT(*);
warningRegex:declared column \[city\] is not present in some source files
warningRegex:declared column \[score\] is not present in some source files

n:long
0
;

// STARTS_WITH on a missing column: same fix, different LIKE-family predicate.
parquetUbnStartsWithOnMissingColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: external_parquet_like_missing_column_rejects_rows

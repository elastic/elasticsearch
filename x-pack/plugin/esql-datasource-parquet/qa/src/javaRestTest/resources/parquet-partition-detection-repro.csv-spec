// End-to-end pins for `partition_detection` reaching the read path (elastic/esql-planning#1749).
//
// These began as reproductions: the `repro*` cases were red against main, where the setting was parsed, stored and
// then never consumed, so the Hive detector ran whatever the user asked for. They are regression pins now — a
// `repro*` case going red again means the setting has stopped reaching the read path.
//
// A csv-spec has no error channel, so only the promises expressible as a result table live here; the promises
// whose fulfilment is an absence — suppressed partition metadata — or a cache-identity property are pinned in
// PartitionDetectionSettingReproTests instead.
//
// Fixtures:
//   {{employees_hive}}         hive-partitioned/lang=*/              partition key `lang`, payload column `languages`
//   {{employees_hive_shadow}}  hive-partitioned-shadow/languages=*/  partition key COLLIDES with payload `languages`

// ---------------------------------------------------------------------------------------------------------
// Control — Hive detection with no partition settings at all. The partition column is real and addressable.
// ---------------------------------------------------------------------------------------------------------

controlBaselineHiveDetectionOn
required_capability: dataset_in_from_command
dataset: repro_baseline: "{{employees_hive}}"

FROM repro_baseline
| STATS count = COUNT(*) BY lang
| SORT lang NULLS LAST;

count:long | lang:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// The legacy switch. It now resolves through the same PartitionConfig as everything else (folded to
// Strategy.NONE), so it must keep behaving exactly as it always has.
// ---------------------------------------------------------------------------------------------------------

controlHivePartitioningFalseTurnsDetectionOff
required_capability: dataset_in_from_command
dataset: repro_hive_false: "{{employees_hive}}" WITH {"hive_partitioning": "false"}

FROM repro_hive_false
| STATS count = COUNT(*);

count:long
100
;

// ---------------------------------------------------------------------------------------------------------
// A `partition_path` template names the partition column. Against main this failed with `Unknown column [bucket]`
// because the Hive detector ran regardless and the template was dropped with no error and no warning.
// ---------------------------------------------------------------------------------------------------------

reproTemplateStrategyNamesTheColumnFromTheTemplate
required_capability: dataset_in_from_command
dataset: repro_tmpl: "{{employees_hive}}" WITH {"partition_detection": "template", "partition_path": "{bucket}"}

FROM repro_tmpl
| STATS count = COUNT(*) BY bucket
| SORT bucket;

count:long | bucket:keyword
15         | lang=1
19         | lang=2
17         | lang=3
18         | lang=4
21         | lang=5
10         | lang=__HIVE_DEFAULT_PARTITION__
;

// ---------------------------------------------------------------------------------------------------------
// Silent column substitution on a colliding layout: the directory key `languages` is also a real column inside the
// parquet files. The path-derived value wins and the physical column is hidden (Spark/DuckDB semantics), and the
// response warns. The warning now points at `partition_detection: none`, which is the setting that actually
// switches it off.
// ---------------------------------------------------------------------------------------------------------

controlShadowedColumnSubstitutionAndWarning
required_capability: dataset_in_from_command
dataset: repro_shadow: "{{employees_hive_shadow}}"

FROM repro_shadow
| STATS count = COUNT(*) BY languages
| SORT languages NULLS LAST;

warningRegex:.*one or more physical columns are shadowed by same-named Hive partition keys.*
warningRegex:.*physical column \[languages\] is shadowed by a same-named Hive partition key.*

count:long | languages:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// The documented opt-out stops the substitution: with `partition_detection: none` nothing is path-derived, so the
// physical column is read and no shadow warning is emitted. Against main the warning still fired — the user asked
// for no partition detection and was told one of their own columns had been replaced by a directory name.
// ---------------------------------------------------------------------------------------------------------

reproNoneStopsTheColumnSubstitution
required_capability: dataset_in_from_command
dataset: repro_shadow_none: "{{employees_hive_shadow}}" WITH {"partition_detection": "none"}

FROM repro_shadow_none
| STATS count = COUNT(*) BY languages
| SORT languages NULLS LAST;

count:long | languages:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// Product-level reproductions for `partition_detection` having no effect on the read path.
//
// `control*` cases pass and pin today's behaviour — they exist so the `repro*` failures cannot be dismissed as a
// broken harness. `repro*` cases assert what the setting promises and fail against main.
//
// A csv-spec has no error channel, so only the promises expressible as a result table live here; the promises
// whose fulfilment is an absence — suppressed partition metadata — or a cache-identity property are pinned in
// PartitionDetectionSettingReproTests instead.
//
// Fixtures:
//   {{employees_hive}}         hive-partitioned/lang=*/              partition key `lang`, payload column `languages`
//   {{employees_hive_shadow}}  hive-partitioned-shadow/languages=*/  partition key COLLIDES with payload `languages`

// ---------------------------------------------------------------------------------------------------------
// Control — Hive detection with no partition settings at all. The partition column is real and addressable.
// ---------------------------------------------------------------------------------------------------------

controlBaselineHiveDetectionOn
required_capability: dataset_in_from_command
dataset: repro_baseline: "{{employees_hive}}"

FROM repro_baseline
| STATS count = COUNT(*) BY lang
| SORT lang NULLS LAST;

count:long | lang:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// Control — the one partition switch that reaches the read path. Undocumented, and the only way to turn
// detection off today. It works, which is what makes the documented spelling a defect and not a limitation.
// ---------------------------------------------------------------------------------------------------------

controlHivePartitioningFalseTurnsDetectionOff
required_capability: dataset_in_from_command
dataset: repro_hive_false: "{{employees_hive}}" WITH {"hive_partitioning": "false"}

FROM repro_hive_false
| STATS count = COUNT(*);

count:long
100
;

// ---------------------------------------------------------------------------------------------------------
// Repro 1 — a `partition_path` template is silently ignored.
//
// The template names the partition column `bucket`. Under a working TEMPLATE strategy `bucket` is the partition
// column. On main the Hive detector runs regardless, `bucket` never exists, and the query fails with
// `Unknown column [bucket]` — the template was dropped with no error and no warning at registration or at query
// time. The failure IS the reproduction.
// ---------------------------------------------------------------------------------------------------------

reproTemplateStrategyNamesTheColumnFromTheTemplate
required_capability: dataset_in_from_command
dataset: repro_tmpl: "{{employees_hive}}" WITH {"partition_detection": "template", "partition_path": "{bucket}"}

FROM repro_tmpl
| STATS count = COUNT(*) BY bucket
| SORT bucket;

count:long | bucket:keyword
15         | lang=1
19         | lang=2
17         | lang=3
18         | lang=4
21         | lang=5
10         | lang=__HIVE_DEFAULT_PARTITION__
;

// ---------------------------------------------------------------------------------------------------------
// Control — silent column substitution on a colliding layout.
//
// The directory key `languages` is also a real column inside the parquet files. The path-derived value wins and
// the physical column is hidden (Spark/DuckDB semantics), and the response carries a warning saying so. Note what
// that warning tells the user to do: set `hive_partitioning` to false — the UNDOCUMENTED setting — because the
// documented `partition_detection: none` does not work.
// ---------------------------------------------------------------------------------------------------------

controlShadowedColumnSubstitutionAndWarning
required_capability: dataset_in_from_command
dataset: repro_shadow: "{{employees_hive_shadow}}"

FROM repro_shadow
| STATS count = COUNT(*) BY languages
| SORT languages NULLS LAST;

warningRegex:.*one or more physical columns are shadowed by same-named Hive partition keys.*
warningRegex:.*physical column \[languages\] is shadowed by a same-named Hive partition key.*

count:long | languages:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// Repro 2 — the documented opt-out cannot stop that substitution.
//
// Same dataset, plus `partition_detection: none`. Asking for no path-derived columns must mean nothing is
// shadowed, so no shadow warning may be emitted. On main the warning still fires: the user explicitly asked for
// no partition detection and was still told one of their own columns had been replaced by a directory name.
// ---------------------------------------------------------------------------------------------------------

reproNoneStopsTheColumnSubstitution
required_capability: dataset_in_from_command
dataset: repro_shadow_none: "{{employees_hive_shadow}}" WITH {"partition_detection": "none"}

FROM repro_shadow_none
| STATS count = COUNT(*) BY languages
| SORT languages NULLS LAST;

count:long | languages:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

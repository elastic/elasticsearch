// Pins that the `partition_detection` and `partition_path` dataset settings select the partition detector on the
// read path, end to end over a real storage backend.
//
// A csv-spec has no error channel, so only the promises expressible as a result table live here; the promises whose
// fulfilment is an absence — suppressed partition metadata — or a cache-identity property are pinned in
// PartitionDetectionSettingTests instead.
//
// Every case that sets `partition_detection`/`partition_path`, or that asserts the shadow warning text, requires
// `partition_detection_on_read_path` as well: a coordinator that predates it ignores both settings and prescribes
// the old `hive_partitioning: false` in the warning, so the case would fail rather than skip on the BWC legs.
// Add the capability to any new case here that is not purely about Hive-by-default detection.
//
// Fixtures:
//   {{employees_hive}}         hive-partitioned/lang=*/              partition key `lang`, payload column `languages`
//   {{employees_hive_shadow}}  hive-partitioned-shadow/languages=*/  partition key COLLIDES with payload `languages`

hiveDetectionOnByDefault
required_capability: dataset_in_from_command
dataset: employees_hive: "{{employees_hive}}"

FROM employees_hive
| STATS count = COUNT(*) BY lang
| SORT lang NULLS LAST;

count:long | lang:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// The canonical way to turn detection off.
// ---------------------------------------------------------------------------------------------------------

partitionDetectionNoneDisablesDetection
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: employees_hive_detection_off: "{{employees_hive}}" WITH {"partition_detection": "none"}

FROM employees_hive_detection_off
| STATS count = COUNT(*);

count:long
100
;

// ---------------------------------------------------------------------------------------------------------
// A `partition_path` template names the partition column. If the setting stops reaching the read path the Hive
// detector runs instead, the template is dropped, and this fails with `Unknown column [bucket]`.
//
// The expected `lang=__HIVE_DEFAULT_PARTITION__` is deliberate: template detection binds the literal directory name,
// and the Hive null sentinel is a Hive-writer convention that only the Hive detector interprets.
// ---------------------------------------------------------------------------------------------------------

templateStrategyNamesTheColumnFromTheTemplate
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: employees_hive_template: "{{employees_hive}}" WITH {"partition_detection": "template", "partition_path": "{bucket}"}

FROM employees_hive_template
| STATS count = COUNT(*) BY bucket
| SORT bucket;

count:long | bucket:keyword
15         | lang=1
19         | lang=2
17         | lang=3
18         | lang=4
21         | lang=5
10         | lang=__HIVE_DEFAULT_PARTITION__
;

// A filter on the template-derived column must prune the five non-matching Parquet files before scanning. The
// retained FilterExec still evaluates the predicate after the source, so the result count alone would pass even
// without pruning; documents_found distinguishes that failure (100 rows emitted) from the pruned scan (17).
templateDerivedPartitionColumnPrunesFiles
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: employees_hive_template_pruned: "{{employees_hive}}" WITH {"partition_detection": "template", "partition_path": "{bucket}"}

FROM employees_hive_template_pruned
| WHERE bucket == "lang=3"
| STATS count = COUNT(*);

documents_found: 17

count:long
17
;

// ---------------------------------------------------------------------------------------------------------
// Silent column substitution on a colliding layout: the directory key `languages` is also a real column inside the
// parquet files. The path-derived value wins and the physical column is hidden (Spark/DuckDB semantics), and the
// response warns. The warning now points at `partition_detection: none`, which is the setting that actually
// switches it off.
// ---------------------------------------------------------------------------------------------------------

shadowedColumnSubstitutionAndWarning
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: employees_hive_shadow_ds: "{{employees_hive_shadow}}"

FROM employees_hive_shadow_ds
| STATS count = COUNT(*) BY languages
| SORT languages NULLS LAST;

warningRegex:.*one or more physical columns are shadowed by same-named Hive partition keys.*Set partition_detection to none to read the physical column instead.*
warningRegex:.*physical column \[languages\] is shadowed by a same-named Hive partition key.*

count:long | languages:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// The documented opt-out stops the substitution: with `partition_detection: none` nothing is path-derived, so the
// physical column is read and no shadow warning is emitted.
// ---------------------------------------------------------------------------------------------------------

noneStopsTheColumnSubstitution
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: employees_hive_shadow_none: "{{employees_hive_shadow}}" WITH {"partition_detection": "none"}

FROM employees_hive_shadow_none
| STATS count = COUNT(*) BY languages
| SORT languages NULLS LAST;

count:long | languages:integer
15         | 1
19         | 2
17         | 3
18         | 4
21         | 5
10         | null
;

// ---------------------------------------------------------------------------------------------------------
// Multi-source FROM over the colliding Hive layout. Two datasets bound to the same tree make the union the
// data twice, so COUNT and SUM double and AVG is unchanged. salary is a data column, so the adapter's
// query schema is non-empty and ColumnMapping.alignToQuery runs under a UnionAll: COUNT(*) alone (or
// COUNT(*) BY a partition key) would take the empty-schema passthrough instead. The grouped case uses
// the path-derived languages key; the none case reads the physical column and emits no shadow warning.
// ---------------------------------------------------------------------------------------------------------

multiSourceShadowedColumnAggregate
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: emp_shadow_a: "{{employees_hive_shadow}}"
dataset: emp_shadow_b: "{{employees_hive_shadow}}"

FROM emp_shadow_a, emp_shadow_b
| STATS total = COUNT(*), sum_salary = SUM(salary), avg_salary = AVG(salary);

warningRegex:.*one or more physical columns are shadowed by same-named Hive partition keys.*Set partition_detection to none to read the physical column instead.*
warningRegex:.*physical column \[languages\] is shadowed by a same-named Hive partition key.*

total:long | sum_salary:long | avg_salary:double
200        | 9649710         | 48248.55
;

multiSourceShadowedColumnAggregateGroupedByShadowedKey
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: emp_shadow_grp_a: "{{employees_hive_shadow}}"
dataset: emp_shadow_grp_b: "{{employees_hive_shadow}}"

FROM emp_shadow_grp_a, emp_shadow_grp_b
| STATS total = COUNT(*), sum_salary = SUM(salary) BY languages
| SORT languages NULLS LAST;

warningRegex:.*one or more physical columns are shadowed by same-named Hive partition keys.*Set partition_detection to none to read the physical column instead.*
warningRegex:.*physical column \[languages\] is shadowed by a same-named Hive partition key.*

total:long | sum_salary:long | languages:integer
30         | 1517300         | 1
38         | 1830796         | 2
34         | 1782242         | 3
36         | 1718388         | 4
42         | 1750592         | 5
20         | 1050392         | null
;

multiSourceDetectionNoneColumnAggregateReadsThePhysicalColumn
required_capability: dataset_in_from_command
required_capability: partition_detection_on_read_path
dataset: emp_none_a: "{{employees_hive_shadow}}" WITH {"partition_detection": "none"}
dataset: emp_none_b: "{{employees_hive_shadow}}" WITH {"partition_detection": "none"}

FROM emp_none_a, emp_none_b
| STATS total = COUNT(*), sum_salary = SUM(salary) BY languages
| SORT languages NULLS LAST;

total:long | sum_salary:long | languages:integer
30         | 1517300         | 1
38         | 1830796         | 2

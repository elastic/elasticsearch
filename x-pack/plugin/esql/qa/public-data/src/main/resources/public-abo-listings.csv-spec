// Amazon Berkeley Objects product listings: 16 gzip NDJSON shards, 147,702 records, frozen since
// 2021-06 (the most stable pins in the suite). The value is the EXTREME per-attribute nesting -
// most fields are arrays of {language_tag, value} objects - surrounding five flat scalars
// (item_id, main_image_id, country, marketplace, domain_name) that the workload queries. The
// nested attributes ride along unprojected: reading records whose bulk is deeply nested IS the
// case. Deviation from the source plan, recorded: ABO listings are NDJSON, not "CSV+gz".
// Expected tables derived at authoring time by clickhouse local over the scratch copy.

// corpus: abo-listings
// reference-variant: abo-listings-s3-ndjson-gzip-shards
// pinned: 16 objects, 87437341 bytes, listings/metadata/listings_*.json.gz, frozen since 2021-06
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('*.json.gz', JSONEachRow, 'item_id String, main_image_id Nullable(String), country String, marketplace String, domain_name String') SETTINGS input_format_skip_unknown_fields=1
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q01_countListings
required_capability: dataset_in_from_command
dataset: abo_listings: "{{corpus}}"
FROM abo_listings | STATS count = COUNT(*);

count:long
147702
;


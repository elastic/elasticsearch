// AWS Public Blockchain, Bitcoin transactions for six pinned dates spanning two eras:
// 2011-01-01..03 (0.6-1.2 MB each) and 2024-01-01..03 (560-690 MB each) - a genuine 1000x
// SKEWED_SHARDS leg over real S3. The in-file `date` STRING column drives date grouping
// (engine-identical; the path-detected partition column goes unreferenced). The tree was
// regenerated 2026-02 and has been stable since (GHCN-D-style pin posture). Expected tables
// derived at authoring time by clickhouse local over the scratch copy of the same pinned bytes.

// corpus: btc-tx-skew
// reference-variant: btc-tx-skew-s3-parquet-snappy-skewed
// pinned: 6 objects (explicit comma-list), 1853852841 bytes, dates 2011-01-01..03 + 2024-01-01..03
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('*.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q01_countTransactions
required_capability: dataset_in_from_command
dataset: btc_tx: "{{corpus}}"
FROM btc_tx | STATS count = COUNT(*);

count:long
1530176
;

// corpus: btc-tx-skew
// reference-variant: btc-tx-skew-s3-parquet-snappy-skewed
// pinned: 6 objects (explicit comma-list), 1853852841 bytes, dates 2011-01-01..03 + 2024-01-01..03
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT countIf(is_coinbase) FROM file('*.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q02_countCoinbase
required_capability: dataset_in_from_command
dataset: btc_tx: "{{corpus}}"
FROM btc_tx | WHERE is_coinbase | STATS count = COUNT(*);

count:long
956
;


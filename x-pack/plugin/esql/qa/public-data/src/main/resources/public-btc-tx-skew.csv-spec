// corpus: btc-tx-skew
// reference-variant: btc-tx-skew-s3-parquet-snappy-skewed
// pinned: 6 objects (explicit comma-list), 1853852841 bytes, dates 2011-01-01..03 + 2024-01-01..03
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT uniqExact(date) FROM file('*.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
// note: the 6 pinned dates; date is an IN-FILE string column, not a path detection
q05_distinctDates
required_capability: dataset_in_from_command
dataset: btc_tx: "{{corpus}}"
FROM btc_tx | STATS BY date | STATS u = COUNT(*);

u:long
6
;

// corpus: btc-tx-skew
// reference-variant: btc-tx-skew-s3-parquet-snappy-skewed
// pinned: 6 objects (explicit comma-list), 1853852841 bytes, dates 2011-01-01..03 + 2024-01-01..03
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() AS c, date FROM file('*.parquet') GROUP BY date ORDER BY c DESC, date ASC LIMIT 6
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 6
// note: the 1000x era skew shows directly in these counts
q08_txByDate
required_capability: dataset_in_from_command
dataset: btc_tx: "{{corpus}}"
FROM btc_tx | STATS c = COUNT(*) BY date | SORT c DESC, date ASC | LIMIT 6;

c:long | date:keyword

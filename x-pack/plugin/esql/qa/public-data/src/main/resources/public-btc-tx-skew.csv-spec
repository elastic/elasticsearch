// corpus: btc-tx-skew
// reference-variant: btc-tx-skew-s3-parquet-snappy-skewed
// pinned: 6 objects (explicit comma-list), 1853852841 bytes, dates 2011-01-01..03 + 2024-01-01..03
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT txid FROM file('*.parquet') WHERE txid = '01453b24e001aa9cd162d3a25c85abedfd9386c0113ec1398e7cf5bd72aa0fc4'
// oracle-run: 2026-08-14
// read-shape: scan
// max-rows: 10
// sort-reviewed: every returned value is the needle itself; order carries no information
// note: needle = the lexically smallest txid of the 2011-01-01 file, picked deterministically
q20_scanNeedleTxid
required_capability: dataset_in_from_command
dataset: btc_tx: "{{corpus}}"
FROM btc_tx | WHERE txid == "01453b24e001aa9cd162d3a25c85abedfd9386c0113ec1398e7cf5bd72aa0fc4" | KEEP txid;

txid:keyword
01453b24e001aa9cd162d3a25c85abedfd9386c0113ec1398e7cf5bd72aa0fc4
;


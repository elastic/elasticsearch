// corpus: clickbench
// reference-variant: clickbench-s3-parquet-snappy-single
// pinned: 1 object, 14779976446 bytes, etag 6b028bb94eecf0ff4e6cde62a0f8fa48-829
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT avg(UserID) FROM file('hits.parquet')
// oracle-run: 2026-08-13
// read-shape: aggregate
// max-rows: 1
// defect: ES|QL AVG(long) accumulates in double precision; at +/-9.2e18 UserID magnitudes the result is 8 orders of magnitude off the exact mean
// defect-variant: clickbench-s3-parquet-snappy-single (identical value on clickbench-s3-parquet-snappy-shards)
// defect-oracle: clickhouse local 26.8.1.1309 exact avg = -55945124888.916016; ES|QL returns 2.528953e18, which equals ClickHouse avg(toFloat64(UserID)) bit-for-bit at compared precision
// defect-found: 2026-08-13
q04_statsAvgUserid-Ignore
required_capability: dataset_in_from_command
dataset: clickbench: "{{corpus}}"
FROM clickbench | STATS avg_UserID = AVG(UserID);

avg_UserID:double
-55945124888.916016
;


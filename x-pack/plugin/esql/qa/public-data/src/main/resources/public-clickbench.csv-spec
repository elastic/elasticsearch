// corpus: clickbench
// reference-variant: clickbench-s3-parquet-snappy-single
// pinned: 1 object, 14779976446 bytes, etag 6b028bb94eecf0ff4e6cde62a0f8fa48-829
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT SearchPhrase FROM file('hits.parquet') WHERE SearchPhrase >= '!' ORDER BY SearchPhrase ASC LIMIT 10
// oracle-run: 2026-08-13
// read-shape: topn
// max-rows: 10
// note: guard >= "!" (identical byte-order comparison in both engines) keeps whitespace-led phrases out of the expected table, which the pipe-table format cannot represent; replaces the extract's TRIM()==self guard
// sort-reviewed: single-key ascending sort over the projected column itself; boundary ties are identical values
q26_sortSearchPhraseAsc
required_capability: dataset_in_from_command
dataset: clickbench: "{{corpus}}"
FROM clickbench | WHERE SearchPhrase >= "!" | SORT SearchPhrase ASC | KEEP SearchPhrase | LIMIT 10;


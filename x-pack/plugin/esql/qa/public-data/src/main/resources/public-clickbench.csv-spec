// ClickBench at full public-corpus scale, on real object storage. The 43 canonical query shapes
// (ported from external-clickbench.csv-spec, queries only) plus one added bounded-LIMIT shape.
// Every expected table below was derived at authoring time by the oracle (clickhouse local
// 26.8.1.1309) against the pinned reference object
// s3://clickhouse-public-datasets/hits_compatible/hits.parquet (99,997,497 rows), read from a
// local scratch download of those exact pinned bytes. The oracle NEVER runs in the suite; these
// tables are the frozen, reviewed expectation. See the README for the regeneration workflow.
//
// Deliberate translation notes:
//  - count-distinct queries use the exact two-stage form (STATS BY x | STATS COUNT(*));
//    MV_COUNT(VALUES(x)) does not scale to millions of distinct values per group.
//  - q10/q23 drop the canonical rides-along COUNT(DISTINCT UserID) column (kept in q09/q11-q14).
//  - every multi-row query carries an explicit SORT tie-breaker so the tables are total orders.

// corpus: clickbench
// reference-variant: clickbench-s3-parquet-snappy-single
// pinned: 1 object, 14779976446 bytes, etag 6b028bb94eecf0ff4e6cde62a0f8fa48-829
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() AS count FROM file('hits.parquet')
// oracle-run: 2026-08-13
// read-shape: aggregate
// max-rows: 1
q01_countHits
required_capability: dataset_in_from_command
dataset: clickbench: "{{corpus}}"
FROM clickbench | STATS count = COUNT(*);

count:long
99997497
;


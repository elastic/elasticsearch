// note: 17500201..17500723: the file's dates are implausible for 1750, which is why it is a frozen leftover rather than part of NOAA's nightly rebuild
q06_y1750MinMaxDate
required_capability: dataset_in_from_command
dataset: ghcnd_1750: "{{corpus}}"
FROM ghcnd_1750 | STATS min_date = MIN(DATE), max_date = MAX(DATE);


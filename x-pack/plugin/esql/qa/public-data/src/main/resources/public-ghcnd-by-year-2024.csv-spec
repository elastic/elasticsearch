// GHCN-D by_year 2024: a 1.3 GB uncompressed CSV single object (37.1M rows, 44,667 stations) plus
// its 168 MB gzip twin. This is the large-uncompressed-text-over-real-blob-latency leg the suite
// was missing -- and it is the suite's ONLY invariant-asserted corpus.
//
// Why invariant: NOAA's readme-by_year.txt says these files are "updated daily for the entire
// period of record", and the object demonstrably moves - 1,336,374,349 bytes on one probe,
// 1,336,374,356 a day later. A frozen expected table over bytes that change nightly would fail for
// upstream reasons and train the reader to ignore red runs, so instead every query here reduces to
// something a re-publish cannot change: a band calibrated to the value measured at authoring time
// (recorded per test as // oracle-observed:), an in-year date range, a fixed cardinality, an absent
// needle, an exact LIMIT. The READ is unchanged - each test still streams the whole object - so the
// coverage is real; only the claim is narrower, and coverage.md reports these cells as
// "covered (invariant)", never plain "covered".
//
// The bands are deliberately tight enough (roughly +/-20%) that a truncated, partial or empty read
// fails rather than passing a vacuous "> 0". The variants' pins are marked volatile: existence and
// an approximate size are verified, ETag is not - otherwise the pipeline's pre-step would report
// PIN_DRIFT every single night.

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(count() > 29000000 AND count() < 45000000, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate
// max-rows: 1
// assertion-mode: invariant
// oracle-observed: count() = 37,106,568 on 2026-08-25; band 29,000,000 .. 45,000,000
q01_y2024CountInBand
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | STATS c = COUNT(*) | EVAL ok = c > 29000000 AND c < 45000000 | KEEP ok;

ok:boolean
true
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(countIf(ELEMENT = 'PRCP') > 9000000 AND countIf(ELEMENT = 'PRCP') < 13500000, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate
// max-rows: 1
// assertion-mode: invariant
// oracle-observed: PRCP rows = 11,265,346 on 2026-08-25; band 9,000,000 .. 13,500,000
q02_y2024PrcpCountInBand
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | WHERE ELEMENT == "PRCP" | STATS c = COUNT(*) | EVAL ok = c > 9000000 AND c < 13500000 | KEEP ok;

ok:boolean
true
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(avgIf(DATA_VALUE, ELEMENT = 'TMAX') > 140 AND avgIf(DATA_VALUE, ELEMENT = 'TMAX') < 220, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate
// max-rows: 1
// assertion-mode: invariant
// oracle-observed: AVG(TMAX) = 176.5771 tenths-degC on 2026-08-25; band 140 .. 220
q03_y2024TmaxAvgInBand
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | WHERE ELEMENT == "TMAX" | STATS a = AVG(DATA_VALUE) | EVAL ok = a > 140 AND a < 220 | KEEP ok;

ok:boolean
true
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(uniqExact(ID) > 35000 AND uniqExact(ID) < 55000, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate
// max-rows: 1
// assertion-mode: invariant
// oracle-observed: distinct stations = 44,667 on 2026-08-25; band 35,000 .. 55,000
q04_y2024StationCountInBand
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | STATS BY ID | STATS u = COUNT(*) | EVAL ok = u > 35000 AND u < 55000 | KEEP ok;

ok:boolean
true
;

// corpus: ghcnd-by-year-2024

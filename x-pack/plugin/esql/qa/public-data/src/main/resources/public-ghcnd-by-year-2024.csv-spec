// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(min(DATE) >= 20240101 AND max(DATE) <= 20241231, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate
// max-rows: 1
// note: the one invariant that is exact rather than banded: a by_year file's dates cannot leave its year however often NOAA revises the values
// timing: OUTLIER, measured 2026-08-25: 1235s on the uncompressed leg vs 156s on the gzip twin (same logical rows) and ~65-75s for every other uncompressed test on the same object. Answer correct, no retries, no warnings - a performance observation for triage, not a correctness defect. Watch it in the nightly timings
// assertion-mode: invariant
// oracle-observed: MIN/MAX(DATE) = 20240101 / 20241231 on 2026-08-25
q06_y2024DatesWithinYear
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | STATS mn = MIN(DATE), mx = MAX(DATE) | EVAL ok = mn >= 20240101 AND mx <= 20241231 | KEEP ok;

ok:boolean
true
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM (SELECT count() AS c, ELEMENT FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String') GROUP BY ELEMENT ORDER BY c DESC, ELEMENT ASC LIMIT 5)
// oracle-run: 2026-08-25
// read-shape: topn
// max-rows: 1
// note: a real TopN over 37M rows whose ROW COUNT is what gets asserted; the ranking itself may be revised, the shape of the answer may not
// assertion-mode: invariant
// oracle-observed: the top 5 by count were PRCP, TMAX, TMIN, TAVG, SNOW on 2026-08-25
q07_y2024TopElementsCount
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | STATS c = COUNT(*) BY ELEMENT | SORT c DESC, ELEMENT ASC | LIMIT 5 | STATS n = COUNT(*);

n:long
5
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String') WHERE ELEMENT = 'ZZZZ'
// oracle-run: 2026-08-25
// read-shape: scan
// max-rows: 1
// note: a full 1.3 GB uncompressed scan with a structurally deterministic answer -- the large-text-over-real-blob-latency shape, asserted exactly
// assertion-mode: invariant
// oracle-observed: 0 rows on 2026-08-25; ZZZZ is not a GHCN-D element code
q08_y2024NeedleAbsent
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | WHERE ELEMENT == "ZZZZ" | STATS c = COUNT(*);

c:long
0
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM (SELECT * FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String') LIMIT 10)
// oracle-run: 2026-08-25
// read-shape: limit
// max-rows: 1
// assertion-mode: invariant
// oracle-observed: 10 rows on 2026-08-25; LIMIT is exact whatever the file holds
q09_y2024LimitTen
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | LIMIT 10 | STATS n = COUNT(*);

n:long
10
;

// corpus: ghcnd-by-year-2024
// reference-variant: ghcnd-by-year-2024-s3-csv-uncompressed-single
// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(countIf(Q_FLAG != '') > 15000 AND countIf(Q_FLAG != '') < 90000, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate
// max-rows: 1
// note: the widest band in the set: QC re-runs move this number most, so it is bounded generously on purpose while still catching a read that returns nothing or everything
// assertion-mode: invariant
// oracle-observed: quality-flagged rows = 36,383 on 2026-08-25; band 15,000 .. 90,000
q10_y2024FlaggedInBand
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | WHERE Q_FLAG != "" | STATS c = COUNT(*) | EVAL ok = c > 15000 AND c < 90000 | KEEP ok;

ok:boolean
true
;

// pinned: 1 object, ~1336374356 bytes (csv) / ~168385897 (csv.gz), VOLATILE - rewritten nightly
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT if(uniqExact(ELEMENT) >= 60 AND uniqExact(ELEMENT) <= 90, 'true', 'false') FROM file('2024.csv', CSVWithNames, 'ID String, DATE Int64, ELEMENT String, DATA_VALUE Nullable(Int64), M_FLAG String, Q_FLAG String, S_FLAG String, OBS_TIME String')
// oracle-run: 2026-08-25
// read-shape: aggregate

q05_y2024ElementCountInBand
required_capability: dataset_in_from_command
dataset: ghcnd_2024: "{{corpus}}"
FROM ghcnd_2024 | STATS BY ELEMENT | STATS u = COUNT(*) | EVAL ok = u >= 60 AND u <= 90 | KEEP ok;

ok:boolean

// corpus: ookla-fixed-2024
// reference-variant: ookla-fixed-2024-s3-parquet-snappy-hive
// pinned: 4 objects, 1440356335 bytes, type=fixed/year=2024 quarters
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT uniqExact(quadkey) FROM file('quarter=*/*.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
// note: no nulls in quadkey; plain uniqExact mirrors the two-stage distinct
q05_distinctQuadkeys
required_capability: dataset_in_from_command
dataset: ookla: "{{corpus}}"
FROM ookla | STATS BY quadkey | STATS u = COUNT(*);

u:long
11107338
;

// corpus: ookla-fixed-2024
// reference-variant: ookla-fixed-2024-s3-parquet-snappy-hive
// pinned: 4 objects, 1440356335 bytes, type=fixed/year=2024 quarters
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() AS c, quarter FROM file('quarter=*/*.parquet') GROUP BY quarter ORDER BY c DESC, quarter ASC LIMIT 4
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 4
// note: quarter is a DETECTED hive-partition column (integer 1-4)
q08_tilesByQuarter
required_capability: dataset_in_from_command
dataset: ookla: "{{corpus}}"
FROM ookla | STATS c = COUNT(*) BY quarter | SORT c DESC, quarter ASC | LIMIT 4;

c:long  | quarter:integer
6655986 | 1
6655377 | 3
6561086 | 4
6492072 | 2
;


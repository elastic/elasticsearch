// oracle-sql: SELECT quadkey FROM file('quarter=*/*.parquet') WHERE quadkey = '0022133222312323'
// oracle-run: 2026-08-14
// read-shape: scan
// max-rows: 10
// sort-reviewed: every returned value is the needle itself; order carries no information
// note: needle = the lexically smallest quadkey present in all four quarters (4 rows)
q20_scanNeedleQuadkey

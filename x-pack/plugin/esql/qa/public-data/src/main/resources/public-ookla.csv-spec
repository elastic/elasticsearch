// Ookla Open Data, fixed-broadband tiles for 2024: 4 hive-partitioned Parquet quarters on
// anonymous S3 (26,364,521 rows, ~1.4 GiB). quarter (integer 1-4) is a DETECTED hive-partition
// column, asserted by q08/q45. Deviation from the source plan, recorded: the Parquet is
// internally SNAPPY, not zstd (verified from footers) - codec=zstd stays a declared gap pointed
// at Overture (Phase 3). Expected tables derived at authoring time by clickhouse local over the
// scratch copy of the same pinned objects.

// corpus: ookla-fixed-2024
// reference-variant: ookla-fixed-2024-s3-parquet-snappy-hive
// pinned: 4 objects, 1440356335 bytes, type=fixed/year=2024 quarters
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('quarter=*/*.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q01_countTiles
required_capability: dataset_in_from_command
dataset: ookla: "{{corpus}}"
FROM ookla | STATS count = COUNT(*);

count:long
26364521
;

// corpus: ookla-fixed-2024
// reference-variant: ookla-fixed-2024-s3-parquet-snappy-hive
// pinned: 4 objects, 1440356335 bytes, type=fixed/year=2024 quarters
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('quarter=*/*.parquet') WHERE tests >= 100
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q02_countBusyTiles
required_capability: dataset_in_from_command
dataset: ookla: "{{corpus}}"
FROM ookla | WHERE tests >= 100 | STATS count = COUNT(*);

count:long
791672
;

// corpus: ookla-fixed-2024
// reference-variant: ookla-fixed-2024-s3-parquet-snappy-hive
// pinned: 4 objects, 1440356335 bytes, type=fixed/year=2024 quarters
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT sum(tests), count(), avg(avg_d_kbps) FROM file('quarter=*/*.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q03_statsTestsTotals
required_capability: dataset_in_from_command
dataset: ookla: "{{corpus}}"
FROM ookla | STATS sum_tests = SUM(tests), count = COUNT(*), avg_download = AVG(avg_d_kbps);

sum_tests:long | count:long | avg_download:double
434760320      | 26364521   | 162401.2203191175
;


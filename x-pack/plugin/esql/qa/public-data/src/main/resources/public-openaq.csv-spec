// OpenAQ archive fraction: locationid=2178/year=2016 (Del Norte, Albuquerque) - 298 tiny gzip
// CSVs (~200-700 bytes each) in nested year=/month= hive partitions on anonymous S3. The
// per-object overhead IS the case: many small objects, deeply nested layout, real store latency.
// datetime carries a UTC offset so ES|QL keeps it keyword (lexical order == temporal within this
// single-offset station). month is a DETECTED hive-partition column (integer), asserted by
// q45/q46. Expected tables derived at authoring time by clickhouse local over the scratch copy
// of the same pinned objects.

// corpus: openaq
// reference-variant: openaq-s3-csv-gzip-nested-hive
// pinned: 298 objects, 198997 bytes, locationid=2178/year=2016 subtree
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('month=*/*.csv.gz', CSVWithNames, 'location_id Int64, sensors_id Int64, location String, datetime String, lat Float64, lon Float64, parameter String, units String, value Float64')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q01_countMeasurements
required_capability: dataset_in_from_command
dataset: openaq: "{{corpus}}"
FROM openaq | STATS count = COUNT(*);

count:long
32952
;


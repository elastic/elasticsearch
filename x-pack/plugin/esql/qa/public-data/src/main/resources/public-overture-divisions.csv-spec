// Overture Maps divisions (release 2026-07-22.0), one zstd Parquet part: 4,655,003 division rows
// with a deeply nested schema (structs, maps, arrays-of-structs, geometry) around scalar columns.
// Closes the codec=zstd cell. q30 is a NESTED-READ PROBE kept by explicit reviewer decision:
// it asserts struct-field access (bbox.xmin/bbox.ymax) on parquet - if the reader's nested
// contract differs, that failure is a finding for the gate, not suite noise. Release paths are
// version-immutable (stable pins). Expected tables derived at authoring time by clickhouse local
// over the scratch copy of the same pinned bytes.

// corpus: overture-divisions
// reference-variant: overture-divisions-s3-parquet-zstd-single
// pinned: 1 object, 576185044 bytes, release/2026-07-22.0 theme=divisions/type=division part-00000
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT count() FROM file('part-00000.zstd.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
q01_countDivisions
required_capability: dataset_in_from_command
dataset: overture_divisions: "{{corpus}}"
FROM overture_divisions | STATS count = COUNT(*);

count:long
4655003
;


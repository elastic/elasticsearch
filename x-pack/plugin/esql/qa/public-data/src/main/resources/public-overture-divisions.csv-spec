// corpus: overture-divisions
// reference-variant: overture-divisions-s3-parquet-zstd-single
// pinned: 1 object, 576185044 bytes, release/2026-07-22.0 theme=divisions/type=division part-00000
// oracle: clickhouse local 26.8.1.1309
// oracle-sql: SELECT sum(population), count(), avg(population) FROM file('part-00000.zstd.parquet')
// oracle-run: 2026-08-14
// read-shape: aggregate
// max-rows: 1
// note: population is mostly null; SUM/AVG skip nulls identically in both engines, COUNT(*) does not
q03_statsPopulation
required_capability: dataset_in_from_command
dataset: overture_divisions: "{{corpus}}"
FROM overture_divisions | STATS sum_pop = SUM(population), count = COUNT(*), avg_pop = AVG(population);

sum_pop:long | count:long | avg_pop:double
18330789755  | 4655003    | 26752.739381458945
;


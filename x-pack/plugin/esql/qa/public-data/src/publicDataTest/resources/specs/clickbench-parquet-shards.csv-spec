// ClickBench `hits` Parquet, clickbench_parquet_shards variant (elastic/esql-planning#1650): 5 of the 100
// Athena-partitioned shards (hits_1.parquet .. hits_5.parquet), 5,000,000 rows total, addressed with a
// brace-glob resource pattern -- read directly from the upstream publisher's own public HTTPS/S3 objects,
// never a local fixture or a mirrored copy. This is a different row subset than clickbench_parquet_single
// (see clickbench-parquet-single.csv-spec), so its expected results below cannot be shared with it, even
// though the query text is identical.
//
// Provenance for every query below: DuckDB 1.x `read_parquet([...])` directly against the 5 pinned objects
// at https://datasets.clickhouse.com/hits_compatible/athena_partitioned/hits_{1..5}.parquet -- no local
// copy; Parquet range-reads only the footer plus the specific column chunks/row-groups each query touches
// (confirmed via `parquet_metadata()`: SNAPPY, single row group per shard), so DuckDB never bulk-downloads
// any of the 5 objects even though they total ~875MB.

count_all
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | STATS count = COUNT(*);

count:long
5000000
;

count_advengineid_nonzero
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | WHERE AdvEngineID != 0 | STATS count = COUNT(*);

count:long
166963
;

stats_advengineid_resolutionwidth
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | STATS sum_AdvEngineID = SUM(AdvEngineID), count = COUNT(*), avg_ResolutionWidth = AVG(ResolutionWidth);

sum_AdvEngineID:long | count:long | avg_ResolutionWidth:double
3028962              | 5000000    | 1449.1777464
;

avg_userid
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | STATS avg_UserID = AVG(UserID);

avg_UserID:double
1.8541433136403523E18
;

distinct_userid
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | STATS u = MV_COUNT(VALUES(UserID));

u:integer
1056657
;

min_max_eventdate
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | STATS min_EventDate = MIN(EventDate), max_EventDate = MAX(EventDate);

min_EventDate:integer | max_EventDate:integer
15888                 | 15917
;

count_by_advengineid
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | WHERE AdvEngineID != 0 | STATS c = COUNT(*) BY AdvEngineID | SORT c DESC, AdvEngineID;

c:long  | AdvEngineID:integer
107433  | 27
59064   | 2
340     | 25
124     | 13
1       | 3
1       | 28
;

distinct_userid_by_regionid
required_capability: dataset_in_from_command
dataset: clickbench: "{{clickbench}}"
FROM clickbench | STATS u = MV_COUNT(VALUES(UserID)) BY RegionID | SORT u DESC, RegionID | LIMIT 10;

u:integer | RegionID:integer
153980    | 229
81192     | 2
49361     | 208
38316     | 158
26726     | 169
25109     | 34
19430     | 55
18113     | 42
17531     | 107
17262     | 184
;

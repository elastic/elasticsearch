No results generates empty buckets
required_capability: bucket_include_empty_buckets

FROM employees
| WHERE hire_date < "1900-01-01T00:00:00Z"
| STATS c = COUNT(*)
  BY month = BUCKET(hire_date, 4, "2000-01-01T00:00:00Z", "2000-05-01T00:00:00Z", {"include_empty_buckets": true})
| SORT month
;

c:long | month:date
0      | 2000-01-01T00:00:00.000Z
0      | 2000-02-01T00:00:00.000Z
0      | 2000-03-01T00:00:00.000Z
0      | 2000-04-01T00:00:00.000Z
;


Empty date range generates no buckets
required_capability: bucket_include_empty_buckets

FROM employees
| WHERE hire_date >= "1985-01-01T00:00:00Z" AND hire_date < "1985-01-06T00:00:00Z"
| STATS hires_per_month = COUNT(*)
  BY bucket = BUCKET(hire_date, 20, "1985-01-01T00:00:00Z", "1984-01-01T00:00:00Z", {"include_empty_buckets": true})
| SORT bucket
;

hires_per_month:long | bucket:date
;


Large number of buckets doesn't OOM - results
required_capability: bucket_include_empty_buckets

FROM employees
| WHERE hire_date >= "1985-01-01T00:00:00Z" AND hire_date < "1986-01-01T00:00:00Z"
| STATS hires_per_month = COUNT(*)
  BY bucket = BUCKET(hire_date, 400000000, "1985-01-01T00:00:00Z", "1986-01-01T00:00:00Z", {"include_empty_buckets": true})
| LIMIT 10
;

// Approximately 300M buckets of 100ms fit in a year.
// This test generates a few buckets, then bails out.
hires_per_month:long | bucket:datetime
0                    | 1985-01-01T00:00:00.000Z
0                    | 1985-01-01T00:00:00.100Z
0                    | 1985-01-01T00:00:00.200Z
0                    | 1985-01-01T00:00:00.300Z
0                    | 1985-01-01T00:00:00.400Z
0                    | 1985-01-01T00:00:00.500Z
0                    | 1985-01-01T00:00:00.600Z
0                    | 1985-01-01T00:00:00.700Z
0                    | 1985-01-01T00:00:00.800Z
0                    | 1985-01-01T00:00:00.900Z
;


Large number of buckets doesn't OOM - stats
required_capability: bucket_include_empty_buckets

FROM employees
| WHERE hire_date >= "1985-01-01T00:00:00Z" AND hire_date < "1986-01-01T00:00:00Z"
| STATS hires_per_month = COUNT(*)
  BY bucket = BUCKET(hire_date, 400000000, "1985-01-01T00:00:00Z", "1986-01-01T00:00:00Z", {"include_empty_buckets": true})
| STATS bucket_count = COUNT(*)
;

// Approximately 300M buckets of 100ms fit in a year.
// This test takes a few seconds to run, but should not OOM.
bucket_count:long
315360000
;



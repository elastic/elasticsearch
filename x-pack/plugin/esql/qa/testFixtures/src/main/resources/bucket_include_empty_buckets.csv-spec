Empty buckets for numeric range
required_capability: bucket_include_empty_buckets

FROM employees
| WHERE salary > 55000 AND salary < 75000
| STATS c = COUNT(*)
  BY b = BUCKET(salary, 25, 60000, 70000, {"include_empty_buckets": true})
| SORT b
;


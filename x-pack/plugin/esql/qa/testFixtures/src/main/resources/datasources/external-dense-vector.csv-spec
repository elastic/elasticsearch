// DENSE_VECTOR over an external relation. Each case runs a FROM books query from dense_vector_command.csv-spec
// against books_ds, a dataset built from the same books data. A dataset has no mapping, so its string columns are
// keyword rather than text; DENSE_VECTOR embeds both. The test_dense_inference mock derives each vector from the
// input string alone, so a string that reads the same in both sources gets the vector from
// dense_vector_command.csv-spec.
//
// The dataset is named books_ds because books is the name of the index loaded from the same data. Its author
// column holds multi-valued cells written as [a, b], which the Parquet, ORC and NDJSON readers decode; those are
// the suites that read this file.

denseVectorOnExternalField
required_capability: dense_vector_command
required_capability: dense_vector_field_type_released
required_capability: dataset_in_from_command
dataset: books_ds: "{{books}}"

FROM books_ds
| WHERE book_no IN ("2924", "7381", "7670")
| DENSE_VECTOR publisher WITH { "inference_id" : "test_dense_inference" }
| SORT book_no
| KEEP book_no, publisher, publisher_dense_vector
;

book_no:keyword | publisher:keyword   | publisher_dense_vector:dense_vector
2924            | Oxford Paperbacks   | [45.0, 56.0, 48.0]
7381            | Red Wheel/Weiser    | [45.0, 53.0, 56.0]
7670            | Courier Corporation | [45.0, 49.0, 55.0]
;


denseVectorOnMultipleExternalFields
required_capability: dense_vector_command
required_capability: dense_vector_field_type_released
required_capability: dataset_in_from_command
dataset: books_ds: "{{books}}"

FROM books_ds
| WHERE book_no IN ("7480", "8605")
| DENSE_VECTOR title, publisher WITH { "inference_id" : "test_dense_inference" }
| SORT book_no
| KEEP book_no, title, publisher, title_dense_vector, publisher_dense_vector
;

book_no:keyword | title:keyword | publisher:keyword | title_dense_vector:dense_vector | publisher_dense_vector:dense_vector
7480            | The Hobbit    | Mariner Books     | [50.0, 49.0, 48.0]              | [45.0, 49.0, 53.0]
8605            | Dead Souls    | Vintage           | [45.0, 49.0, 53.0]              | [50.0, 49.0, 50.0]
;


// DENSE_VECTOR embeds a column computed by an earlier EVAL.
denseVectorOnComputedColumnOverExternal
required_capability: dense_vector_command
required_capability: dense_vector_field_type_released
required_capability: dataset_in_from_command
dataset: books_ds: "{{books}}"

FROM books_ds
| WHERE book_no IN ("7480", "8605")
| EVAL description = CONCAT(title, " (", publisher, ")")
| DENSE_VECTOR description WITH { "inference_id" : "test_dense_inference" }
| SORT book_no
| KEEP book_no, description, description_dense_vector
;

book_no:keyword | description:keyword        | description_dense_vector:dense_vector
7480            | The Hobbit (Mariner Books) | [45.0, 49.0, 49.0]
8605            | Dead Souls (Vintage)       | [53.0, 48.0, 53.0]
;


// The generated column is a dense_vector that vector functions such as v_cosine accept as input.
denseVectorConsumedByVCosineOverExternal
required_capability: dense_vector_command
required_capability: dense_vector_field_type_released
required_capability: vector_similarity_functions_pushdown
required_capability: dataset_in_from_command
dataset: books_ds: "{{books}}"

FROM books_ds
| WHERE book_no == "2924"
| DENSE_VECTOR publisher WITH { "inference_id" : "test_dense_inference" }
| EVAL sim = v_cosine(publisher_dense_vector, publisher_dense_vector)
| KEEP book_no, sim
;

book_no:keyword | sim:double
2924            | 1.0
;


// author is multi-valued in books_ds. DENSE_VECTOR embeds only the first value and emits a warning; MV_SORT makes
// the first value deterministic.
denseVectorOnMultiValuedExternalField
required_capability: dense_vector_command_v3
required_capability: dense_vector_field_type_released
required_capability: dataset_in_from_command
dataset: books_ds: "{{books}}"

FROM books_ds
| WHERE book_no == "2924"
| EVAL sorted_author = MV_SORT(author)
| DENSE_VECTOR sorted_author WITH { "inference_id" : "test_dense_inference" }
| KEEP book_no, sorted_author, sorted_author_dense_vector
;
warningRegex:embedding input is multi-valued; only the first value is embedded\. Reduce the field first, for example with MV_FIRST, to choose the value explicitly\.

book_no:keyword | sorted_author:keyword                                | sorted_author_dense_vector:dense_vector
2924            | [Alan Myers, Fyodor Dostoevsky, W. J. Leatherbarrow] | [45.0, 52.0, 51.0]
;


// All 79 books span several batched inference requests (InferenceSettings.DENSE_VECTOR_DEFAULT_BATCH_SIZE).
// Every row must carry the vector of its own publisher, however the external reader splits rows into pages.
// In books_ds the publisher of book 4636 is "Random House Digital\, Inc.", backslash included, so its vector
// differs from the one in dense_vector_command.csv-spec.
denseVectorAlignsEveryRowOverExternal
required_capability: dense_vector_command
required_capability: dense_vector_field_type_released
required_capability: dataset_in_from_command
dataset: books_ds: "{{books}}"

FROM books_ds
| DENSE_VECTOR publisher WITH { "inference_id" : "test_dense_inference" }
| SORT book_no
| KEEP book_no, publisher_dense_vector
;


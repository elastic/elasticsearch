// Runtime MATCH/MATCH_PHRASE scoring over an external relation's _score. Mirrors
// match-function.csv-spec / match-phrase-function.csv-spec's fn_match_runtime_score /
// fn_match_phrase_runtime_score cases against books_ds instead of books, same shapes and same
// expected scores, so the two are directly comparable.
//
// books collides with its ES|QL index twin, so the dataset is named books_ds.

matchOnExternalRuntimeTextWithScore
required_capability: match_function
required_capability: metadata_score
required_capability: fn_match_runtime_score
required_capability: dataset_in_from_command
required_capability: external_source_standard_metadata_columns
dataset: books_ds: "{{books}}"

FROM books_ds METADATA _score
| EVAL content = to_text(concat(title, " ", description))
| WHERE match(content, "Tolkien")
| SORT book_no
| LIMIT 3
| KEEP book_no, _score
;

book_no:keyword | _score:double
1463            | 1.0
2130            | 1.0
2301            | 1.0
;

matchOnExternalRuntimeTextMultiTermScore
required_capability: match_function
required_capability: metadata_score
required_capability: fn_match_runtime_score
required_capability: dataset_in_from_command
required_capability: external_source_standard_metadata_columns
dataset: books_ds: "{{books}}"

// books matching both terms score 2.0, books matching one score 1.0
FROM books_ds METADATA _score
| EVAL content = to_text(concat(title, " ", description))
| WHERE match(content, "Tolkien Rings")
| SORT book_no
| LIMIT 5
| KEEP book_no, _score
;

book_no:keyword | _score:double
1463            | 2.0
2130            | 1.0
2301            | 1.0
2675            | 1.0
2714            | 2.0
;

matchOnExternalRuntimeTextWithOptionsAndScore
required_capability: match_function
required_capability: metadata_score
required_capability: fn_match_runtime_score
required_capability: dataset_in_from_command
required_capability: external_source_standard_metadata_columns
dataset: books_ds: "{{books}}"

// with operator AND both terms must match, and each matched term scores the boost
FROM books_ds METADATA _score
| EVAL content = to_text(concat(title, " ", description))
| WHERE match(content, "Tolkien Rings", {"operator": "AND", "boost": 1.5})
| STATS max_score = max(_score), min_score = min(_score)
;

max_score:double | min_score:double
3.0              | 3.0
;

matchPhraseOnExternalRuntimeTextWithScore
required_capability: match_phrase_function
required_capability: metadata_score
required_capability: fn_match_phrase_runtime_score
required_capability: dataset_in_from_command
required_capability: external_source_standard_metadata_columns
dataset: books_ds: "{{books}}"

// a runtime match_phrase scores the boost (1.0 by default) on match, not BM25
FROM books_ds METADATA _score
| EVAL content = to_text(concat(title, " ", description))
| WHERE match_phrase(content, "Lord of the Rings")
| SORT book_no
| LIMIT 3
| KEEP book_no, _score
;

book_no:keyword | _score:double
1463            | 1.0
2675            | 1.0
2714            | 1.0
;

matchPhraseOnExternalRuntimeTextWithBoostAndScore
required_capability: match_phrase_function
required_capability: metadata_score
required_capability: fn_match_phrase_runtime_score
required_capability: dataset_in_from_command
required_capability: external_source_standard_metadata_columns
dataset: books_ds: "{{books}}"

FROM books_ds METADATA _score
| EVAL content = to_text(concat(title, " ", description))
| WHERE match_phrase(content, "Lord of the Rings", {"boost": 2.5})
| SORT book_no
| LIMIT 3
| KEEP book_no, _score
;

book_no:keyword | _score:double
1463            | 2.5
2675            | 2.5
2714            | 2.5
;

matchOnExternalRuntimeCombinedMatchAndPhraseScore
required_capability: match_function
required_capability: match_phrase_function
required_capability: metadata_score
required_capability: fn_match_runtime_score
required_capability: fn_match_phrase_runtime_score
required_capability: dataset_in_from_command
required_capability: external_source_standard_metadata_columns
dataset: books_ds: "{{books}}"

// OR sums each matched clause's contribution: 1463 and 2714 match both "Tolkien" and the "Lord
// of the Rings" phrase (1.0 + 2.0 = 3.0); 2130 and 2301 match only "Tolkien" (1.0); 2675 matches
// only the phrase (2.0).
FROM books_ds METADATA _score
| EVAL content = to_text(concat(title, " ", description))
| WHERE match(content, "Tolkien", {"boost": 1.0}) OR match_phrase(content, "Lord of the Rings", {"boost": 2.0})
| SORT book_no
| LIMIT 5
| KEEP book_no, _score
;

book_no:keyword | _score:double
1463            | 3.0
2130            | 1.0
2301            | 1.0
2675            | 2.0
2714            | 3.0
;

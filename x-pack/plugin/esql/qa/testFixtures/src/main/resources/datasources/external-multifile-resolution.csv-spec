// ===== OMITTED schema_resolution (new PUT materializes first_file_wins) =====
// Homogeneous files: rows match explicit FFW and UBN, so mixed clusters that still treat omit as
// union_by_name still agree. No extra capability gate.

omittedCount
required_capability: dataset_in_from_command
dataset: employees_multifile_split: "{{employees_multifile_split}}"

FROM employees_multifile_split
| STATS count = COUNT(*);

count:long
100
;

ubnExplicitCount
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
dataset: employees_multifile_split_ubn: "{{employees_multifile_split}}" WITH {"schema_resolution": "union_by_name"}

FROM employees_multifile_split_ubn
| STATS count = COUNT(*);

count:long
100
;

omittedFilterAndSort
required_capability: dataset_in_from_command
dataset: employees_multifile_split: "{{employees_multifile_split}}"

FROM employees_multifile_split
| WHERE salary > 70000
| KEEP emp_no, first_name, salary
| SORT salary DESC
| LIMIT 3;

emp_no:integer | first_name:keyword | salary:integer
10029          | "Otmar"            | 74999
10045          | "Moss"             | 74970
10007          | "Tzvetan"          | 74572
;

omittedAggregateByGender
required_capability: dataset_in_from_command
required_capability: external_csv_blank_cell_empty_string_unless_null_token
dataset: employees_multifile_split: "{{employees_multifile_split}}"

FROM employees_multifile_split
| STATS count = COUNT(*) BY gender
| SORT gender;

count:long | gender:keyword
10         | ""
33         | "F"
57         | "M"
;


datetimeOffsetInDays
required_capability: fn_decay_date_period

// distance 3.5 days minus 1 day offset, scale 7 days: (14 - 2.5) / 14
ROW value = TO_DATETIME("2023-01-04T12:00:00Z")
| EVAL decay_result = round(decay(value, TO_DATETIME("2023-01-01T00:00:00Z"), 7 days, {"offset": 1 day}), 7)
| KEEP decay_result;

decay_result:double
0.8214286
;


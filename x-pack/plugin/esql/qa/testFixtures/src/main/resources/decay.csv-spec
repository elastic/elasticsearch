ROW value = TO_CARTESIANPOINT("POINT(3 4)")
| EVAL decay_result = round(decay(value, TO_CARTESIANPOINT("POINT(0 0)"), 10.0, {"type": "exp"}), 7)
| KEEP decay_result;

decay_result:double
0.7071068
;

cartesianPointGauss
required_capability: decay_function

// distance 5, d / scale = 0.5, so 0.5 ^ 0.25
ROW value = TO_CARTESIANPOINT("POINT(3 4)")
| EVAL decay_result = round(decay(value, TO_CARTESIANPOINT("POINT(0 0)"), 10.0, {"type": "gauss"}), 7)
| KEEP decay_result;

decay_result:double
0.8408964
;


datetimeDistanceAboveLongRangeWithLargeScale
required_capability: fn_decay_ga_fixes

ROW value = TO_DATETIME(9223372036854775807)
| EVAL decay_result = decay(value, TO_DATETIME(-9223372036854775807), 9223372036854775807 milliseconds)
| KEEP decay_result;

decay_result:double
0.0
;

datetimeDistanceAboveLongRangeOneMillisecondBeyondOffset
required_capability: fn_decay_ga_fixes

// the distance is 2^63 ms and the offset 2^63 - 1 ms, so 1 ms remains: (2 - 1) / 2 with a 1 ms scale
ROW value = TO_DATETIME(9223372036854775807)
| EVAL decay_result = decay(value, TO_DATETIME(-1), 1 millisecond, {"offset": 9223372036854775807 milliseconds})
| KEEP decay_result;

decay_result:double
0.5
;

###############################################
# exp and gauss: with decay 0.5, exp is 0.5 ^ (d / scale) and gauss is 0.5 ^ ((d / scale) ^ 2)
#

longExp
required_capability: decay_function

// d / scale = 15 / 10, so 0.5 ^ 1.5
ROW value = 25::long
| EVAL decay_result = round(decay(value, 10::long, 10::long, {"type": "exp"}), 7)
| KEEP decay_result;

decay_result:double
0.3535534
;

longGauss
required_capability: decay_function

// d / scale = 15 / 10, so 0.5 ^ 2.25
ROW value = 25::long
| EVAL decay_result = round(decay(value, 10::long, 10::long, {"type": "gauss"}), 7)
| KEEP decay_result;

decay_result:double
0.2102241
;

unsignedLongAboveLongRangeExp
required_capability: decay_function_unsigned_long

// d / scale = 2e18 / 1e18, so 0.5 ^ 2; every value is exact as a double
ROW value = 12000000000000000000::unsigned_long
| EVAL decay_result = round(decay(value, 10000000000000000000::unsigned_long, 1000000000000000000, {"type": "exp"}), 7)
| KEEP decay_result;

decay_result:double
0.25
;

unsignedLongAboveLongRangeGauss
required_capability: decay_function_unsigned_long

// d / scale = 2e18 / 1e18, so 0.5 ^ 4
ROW value = 12000000000000000000::unsigned_long
| EVAL decay_result = round(decay(value, 10000000000000000000::unsigned_long, 1000000000000000000, {"type": "gauss"}), 7)
| KEEP decay_result;

decay_result:double
0.0625
;

cartesianPointExp
required_capability: decay_function


dedupAfterInlineStats
required_capability: dedup_command
required_capability: inline_stats

FROM employees
| KEEP gender, languages
| INLINE STATS max_languages = MAX(languages) BY gender
| KEEP gender, max_languages
| DEDUP
| SORT gender NULLS LAST
;

gender:keyword | max_languages:integer
F              | 5
M              | 5
null           | 5
;


dedupAfterForkKeepsBranchesApart
required_capability: dedup_command
required_capability: fork_v9

FROM employees
| KEEP gender
| FORK (WHERE gender == "F") (WHERE gender == "F")
| DEDUP
| SORT _fork
;

gender:keyword | _fork:keyword
F              | fork1
F              | fork2
;


dedupAfterForkWithoutForkColumn
required_capability: dedup_command
required_capability: fork_v9

FROM employees
| KEEP gender
| FORK (WHERE gender == "F") (WHERE gender == "F")
| DROP _fork
| DEDUP
;

gender:keyword
F
;


dedupInsideForkBranches
required_capability: dedup_command
required_capability: fork_v9

FROM employees
| KEEP gender
| FORK (WHERE gender == "F" | DEDUP) (WHERE gender == "M" | DEDUP)
| SORT _fork
;

gender:keyword | _fork:keyword
F              | fork1
M              | fork2
;

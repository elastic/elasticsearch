// DESCRIBE: one row per input column with what the mappings say about it and how to use it.

describeRoles
required_capability: describe_command

FROM k8s
| DESCRIBE
| WHERE name IN ("@timestamp", "cluster", "event", "event_log", "client.ip", "network.bytes_in", "network.total_bytes_in", "network.eth0.rx")
| KEEP name, type, role, origin, metric_type, unit, searchable, aggregatable
| SORT name
;

name:keyword           | type:keyword  | role:keyword | origin:keyword | metric_type:keyword | unit:keyword | searchable:boolean | aggregatable:boolean
@timestamp             | date          | time         | mapped         | null                | null         | true               | true
client.ip              | ip            | attribute    | mapped         | null                | null         | true               | true
cluster                | keyword       | dimension    | mapped         | null                | null         | true               | true
event                  | keyword       | attribute    | mapped         | null                | null         | true               | true
event_log              | text          | text         | mapped         | null                | null         | true               | false
network.bytes_in       | long          | numeric      | mapped         | null                | null         | true               | true
network.eth0.rx        | integer       | metric       | mapped         | gauge               | packets      | true               | true
network.total_bytes_in | counter_long  | metric       | mapped         | counter             | bytes        | true               | true
;

describeMetricsUsageUnderTs
required_capability: describe_command

TS k8s
| DESCRIBE
| WHERE role == "metric"
| KEEP name, metric_type, unit, usage
| SORT name
;

name:keyword            | metric_type:keyword | unit:keyword | usage:keyword
network.eth0.rx         | gauge               | packets      | STATS AVG(LAST_OVER_TIME(<field>)) or MAX(MAX_OVER_TIME(<field>)); never SUM over time
network.eth0.tx         | gauge               | packets      | STATS AVG(LAST_OVER_TIME(<field>)) or MAX(MAX_OVER_TIME(<field>)); never SUM over time
network.total_bytes_in  | counter             | bytes        | STATS SUM(RATE(<field>)) or SUM(INCREASE(<field>)); never SUM over time
network.total_bytes_out | counter             | bytes        | STATS SUM(RATE(<field>)) or SUM(INCREASE(<field>)); never SUM over time
network.total_cost      | counter             | usd          | STATS SUM(RATE(<field>)) or SUM(INCREASE(<field>)); never SUM over time
;

describeCounterUsageWithoutTs
required_capability: describe_command

FROM k8s
| DESCRIBE
| WHERE name == "network.total_cost"
| KEEP name, usage
;

name:keyword       | usage:keyword
network.total_cost | use TS, then RATE(<field>) or INCREASE(<field>); raw values are cumulative
;

describeRolesSummary
required_capability: describe_command

FROM k8s
| DESCRIBE
| STATS fields = COUNT(*) BY role
| SORT role
;

fields:long | role:keyword
7           | attribute
3           | dimension
5           | metric
4           | numeric
2           | other
1           | text
1           | time
;

describeLineage
required_capability: describe_command

FROM employees
| KEEP emp_no, salary, first_name
| RENAME salary AS pay
| EVAL bonus = pay * 2
| DESCRIBE
| KEEP name, type, field, origin, role, usage
;

name:keyword | type:keyword | field:keyword | origin:keyword | role:keyword | usage:keyword
emp_no       | integer      | emp_no        | mapped         | numeric      | null
pay          | integer      | salary        | renamed        | numeric      | null
first_name   | keyword      | first_name    | mapped         | attribute    | null
bonus        | integer      | null          | computed       | null         | null
;

describeAfterStats
required_capability: describe_command

TS k8s
| STATS rate = SUM(RATE(network.total_bytes_in)) BY cluster, bucket = TBUCKET(1 hour)
| EVAL kib_rate = rate / 1024
| DESCRIBE
| KEEP name, type, origin, role, metric_type, usage
;

name:keyword | type:keyword | origin:keyword | role:keyword | metric_type:keyword | usage:keyword
rate         | double       | computed       | null         | null                | null
cluster      | keyword      | mapped         | dimension    | null                | BY <field>; WHERE <field> == <value>; identifies a time series
bucket       | date         | computed       | null         | null                | null
kib_rate     | double       | computed       | null         | null                | null
;

describeRolesAfterStats
required_capability: describe_command

FROM employees
| STATS avg_salary = AVG(salary), hires = COUNT(*) BY gender
| DESCRIBE
| KEEP name, origin, role, usage
;

name:keyword | origin:keyword | role:keyword | usage:keyword
avg_salary   | computed       | null         | null
hires        | computed       | null         | null
gender       | mapped         | attribute    | null
;

describeUnitsThroughRename
required_capability: describe_command

FROM k8s
| KEEP network.total_bytes_in, network.bytes_in
| RENAME network.total_bytes_in AS total
| DESCRIBE
| KEEP name, field, origin, unit
;

name:keyword     | field:keyword          | origin:keyword | unit:keyword
total            | network.total_bytes_in | renamed        | bytes
network.bytes_in | network.bytes_in       | mapped         | null
;

describeStatsAfterTs
required_capability: describe_command

TS k8s
| DESCRIBE
| STATS fields = COUNT(*) BY role, metric_type
| SORT role, metric_type
;

fields:long | role:keyword | metric_type:keyword
7           | attribute    | null
3           | dimension    | null
3           | metric       | counter
2           | metric       | gauge
4           | numeric      | null
2           | other        | null
1           | text         | null
1           | time         | null
;

describeUsageOverview
required_capability: describe_command

TS k8s
| DESCRIBE
| WHERE role IN ("metric", "dimension", "time")
| STATS fields = COUNT(*) BY role, metric_type, usage
| SORT role, metric_type
;

fields:long | role:keyword | metric_type:keyword | usage:keyword
3           | dimension    | null                | BY <field>; WHERE <field> == <value>; identifies a time series
3           | metric       | counter             | STATS SUM(RATE(<field>)) or SUM(INCREASE(<field>)); never SUM over time
2           | metric       | gauge               | STATS AVG(LAST_OVER_TIME(<field>)) or MAX(MAX_OVER_TIME(<field>)); never SUM over time
1           | time         | null                | BY TBUCKET(<field>, <interval>)
;

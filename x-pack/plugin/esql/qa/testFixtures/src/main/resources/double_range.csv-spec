doubleRangeBlockLoader
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| KEEP height_range, description
| SORT description
;

height_range:double_range | description:keyword
1.6..1.8                  | Medium Height
1.5..1.6                  | Short
1.8..2.0                  | Tall
0.0..1.5                  | Very Short
2.0..5.0                  | Very Tall
;

toRange
required_capability: double_range_tech_preview

ROW from = 1.5, to = 2.5
| EVAL height_range = TO_RANGE(from, to)
| KEEP height_range
;

height_range:double_range
1.5..2.5
;

toRangeNullLeft
required_capability: double_range_tech_preview

ROW to = 1.5
| EVAL height_range = TO_RANGE(null, to)
| KEEP height_range
;

height_range:double_range
null
;

toRangeNullRight
required_capability: double_range_tech_preview

ROW from = 1.5
| EVAL height_range = TO_RANGE(from, null)
| KEEP height_range
;

height_range:double_range
null
;

toRangeInvalidBounds
required_capability: double_range_tech_preview

ROW from = 2.5, to = 1.5
| EVAL height_range = TO_RANGE(from, to)
| KEEP height_range
;
warningRegex:evaluation of \[TO_RANGE\(from, to\)\] failed, treating result as null. Only first 20 failures recorded.
warningRegex:java.lang.IllegalArgumentException: 'from' \[2.5\] must be less than 'to' \[1.5\]

height_range:double_range
null
;

toString
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| EVAL height_range_string = TO_STRING(height_range)
| KEEP height_range_string, description
| SORT description
;

height_range_string:keyword | description:keyword
1.6..1.8                    | Medium Height
1.5..1.6                    | Short
1.8..2.0                    | Tall
0.0..1.5                    | Very Short
2.0..5.0                    | Very Tall
;

rangeMinMax
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| EVAL min_bound = RANGE_MIN(height_range), max_bound = RANGE_MAX(height_range)
| KEEP height_range, min_bound, max_bound, description
| SORT description
;

height_range:double_range | min_bound:double | max_bound:double | description:keyword
1.6..1.8                  | 1.6              | 1.8              | Medium Height
1.5..1.6                  | 1.5              | 1.6              | Short
1.8..2.0                  | 1.8              | 2.0              | Tall
0.0..1.5                  | 0.0              | 1.5              | Very Short
2.0..5.0                  | 2.0              | 5.0              | Very Tall
;

rangeMinMaxRoundTrip
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL new_range = TO_RANGE(RANGE_MIN(height_range), RANGE_MAX(height_range))
| KEEP height_range, new_range
;

height_range:double_range | new_range:double_range
1.5..1.6                  | 1.5..1.6
;

doubleRangeEquality
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range == TO_RANGE(1.5, 1.6)
| KEEP description
;

description:keyword
Short
;

doubleRangeNotEquals
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range != TO_RANGE(1.5, 1.6)
| KEEP description
| SORT description
;

description:keyword
Medium Height
Tall
Very Short
Very Tall
;

doubleRangeSelfEquality
required_capability: double_range_tech_preview

FROM heights
| EVAL equal = height_range == height_range
| WHERE equal
| KEEP description
| SORT description
;

description:keyword
Medium Height
Short
Tall
Very Short
Very Tall
;

doubleRangeIn
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IN (TO_RANGE(1.5, 1.6), TO_RANGE(1.8, 2.0))
| KEEP description
| SORT description
;

description:keyword
Short
Tall
;

mvFirstLastDoubleRange
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL first_range = MV_FIRST(height_range),
       last_range = MV_LAST(height_range)
| KEEP first_range, last_range
;

first_range:double_range | last_range:double_range
1.5..1.6                 | 1.5..1.6
;

mvCountDoubleRange
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| STATS ranges = VALUES(height_range)
| EVAL count = MV_COUNT(ranges)
| KEEP count
;

count:integer
5
;

valuesDoubleRange
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| STATS ranges = VALUES(height_range)
| EVAL strings = MV_SORT(TO_STRING(ranges))
| KEEP strings
;

strings:keyword
[0.0..1.5, 1.5..1.6, 1.6..1.8, 1.8..2.0, 2.0..5.0]
;

valuesDoubleRangeGrouped
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| EVAL short = description LIKE "*Short*"
| STATS ranges = VALUES(height_range) BY short
| EVAL strings = MV_SORT(TO_STRING(ranges))
| SORT short
| KEEP strings, short
;

strings:keyword                  | short:boolean
[1.6..1.8, 1.8..2.0, 2.0..5.0] | false
[0.0..1.5, 1.5..1.6]           | true
;

mvExpandValuesDoubleRangeGrouped
required_capability: double_range_tech_preview

FROM heights
| WHERE height_range IS NOT NULL
| EVAL short = description LIKE "*Short*"
| STATS ranges = VALUES(height_range) BY short
| EVAL count = MV_COUNT(ranges)
| MV_EXPAND ranges
| EVAL range_string = TO_STRING(ranges)
| SORT short, range_string
| KEEP ranges, short, count
;

ranges:double_range | short:boolean | count:integer
1.6..1.8            | false         | 3
1.8..2.0            | false         | 3
2.0..5.0            | false         | 3
0.0..1.5            | true          | 2
1.5..1.6            | true          | 2
;

coalesceDoubleRangeField
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL result = COALESCE(height_range, TO_RANGE(10.0, 20.0))
| KEEP result
;

result:double_range
1.5..1.6
;

coalesceDoubleRangeNullFirst
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL missing = TO_RANGE(null, 1.0)
| EVAL result = COALESCE(missing, TO_RANGE(10.0, 20.0))
| KEEP result
;

result:double_range
10.0..20.0
;

coalesceDoubleRangeMultipleArgs
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL missing = TO_RANGE(null, 1.0)
| EVAL result = COALESCE(missing, height_range, TO_RANGE(10.0, 20.0))
| KEEP result
;

result:double_range
1.5..1.6
;

caseDoubleRangeTrueBranch
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL result = CASE(description == "Short", height_range, TO_RANGE(10.0, 20.0))
| KEEP result
;

result:double_range
1.5..1.6
;

caseDoubleRangeFalseBranch
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL result = CASE(description == "Tall", height_range, TO_RANGE(10.0, 20.0))
| KEEP result
;

result:double_range
10.0..20.0
;

caseDoubleRangeNoElse
required_capability: double_range_tech_preview

FROM heights
| WHERE description == "Short"
| EVAL result = CASE(description == "Tall", height_range)
| KEEP result
;

result:double_range
null
;

rangeWithinDoubleRange
required_capability: double_range_tech_preview

FROM heights
| WHERE RANGE_WITHIN(height_range, TO_RANGE(1.4, 1.9))
| KEEP description
| SORT description
;

description:keyword
Medium Height
Short
;

rangeContainsDouble
required_capability: double_range_tech_preview

FROM heights
| WHERE RANGE_CONTAINS(height_range, 1.55)
| KEEP description
;

description:keyword
Short
;

rangeIntersectsDoubleRange
required_capability: double_range_tech_preview

FROM heights
| WHERE RANGE_INTERSECTS(height_range, TO_RANGE(1.55, 1.85))
| KEEP description
| SORT description
;

description:keyword
Medium Height
Short
Tall
;

caseDoubleRangeSelectByDescription
required_capability: double_range_tech_preview

FROM heights
| WHERE description IN ("Short", "Tall")
| EVAL result = CASE(description == "Short", height_range, TO_RANGE(10.0, 20.0))
| KEEP description, result
| SORT description
;

description:keyword | result:double_range
Short               | 1.5..1.6
Tall                | 10.0..20.0
;

countDoubleRange
required_capability: double_range_tech_preview

FROM heights
| STATS count = COUNT(height_range)
;

count:long
5
;

countDoubleRangeWithFilter
required_capability: double_range_tech_preview

FROM heights
| STATS count = COUNT(height_range) WHERE description LIKE "*Short*"
;

count:long
2
;

countDoubleRangeGrouped
required_capability: double_range_tech_preview

FROM heights
| EVAL short = description LIKE "*Short*"

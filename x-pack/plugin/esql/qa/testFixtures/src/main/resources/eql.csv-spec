// Order-sensitive ports below: WITH supplies the tiebreaker so EQL ordering is deterministic and asserted verbatim.

// EQL test_queries.toml: simpleQueryHeadSix -> [1, 2, 3, 4, 5, 6]
eventQueryHeadSix
required_capability: eql_command
required_capability: eql_command_size_independent_of_limit

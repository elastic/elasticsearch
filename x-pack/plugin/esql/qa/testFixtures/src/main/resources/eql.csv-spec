///////////////////////////////////////////////////////////////////////////////////////////////////////
// EQL engine golden corpora, ported from the EQL project's own test_queries.toml / test_sample.toml for
// differential validation of the EQL source command's typed pipeline. endgame-140 carries serial_event_id
// as a typed long column (also indexed as _id) and aliases event.category -> event_type so bare
// "process where ..." resolves under the EQL defaults. Order-independent cases SORT by serial_event_id;
// order-sensitive ones (head/tail/sequence/sample) pass WITH {"tiebreaker_field": "serial_event_id"} and
// assert the EQL engine's expected order verbatim. Snapshot-only (required_capability: eql_command); these
// run in the live QA REST csv-spec suites, not the in-JVM CsvIT.
///////////////////////////////////////////////////////////////////////////////////////////////////////

eventQueryEqual
required_capability: eql_command
required_capability: eql_command_size_independent_of_limit
EQL endgame-140 "process where serial_event_id == 1" | LIMIT 100 | SORT serial_event_id | KEEP serial_event_id;

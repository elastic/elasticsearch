// Tests for the EQL source command, which delegates execution to the EQL engine and exposes the results as
// typed columns (the target index's field-caps mapping, one column per field). Assertions pipe the EQL output
// through downstream ES|QL (WHERE / STATS / KEEP / SORT) to show that EQL composes as a regular typed source.
// The command is snapshot-only.

eventQueryCountsMatchingEvents
required_capability: eql_command

EQL eql_test "process where true" WITH {"event_category_field": "category"}
| STATS count = COUNT(*)
;

count:long
2
;

eventQueryAppliesTheEqlPredicate
required_capability: eql_command

EQL eql_test "process where pid == 100" WITH {"event_category_field": "category"}
| STATS count = COUNT(*)
;

count:long
1
;

eventQueryHonorsCustomTimestampAndTiebreakerFields
required_capability: eql_command

// Uses a non-default timestamp field (ingested) and a tiebreaker field (pid) to exercise those options
// end to end against the EQL engine; the query still resolves the two process events correctly.
EQL eql_test "process where true" WITH {"event_category_field": "category", "timestamp_field": "ingested", "tiebreaker_field": "pid"}
| STATS count = COUNT(*)
;

count:long
2
;

eventQueryExposesTypedColumns
required_capability: eql_command

// The EQL output is a typed table: WHERE filters and KEEP projects real columns, not an opaque _source.
EQL eql_test "process where true" WITH {"event_category_field": "category"}
| WHERE pid == 100
| KEEP name, pid
;

name:keyword | pid:long
cmd.exe      | 100
;

eventQueryExposesDateColumn
required_capability: eql_command

// Pins the date column end to end: the fields API renders @timestamp as epoch millis, the converter reads it
// back into a datetime column.
EQL eql_test "process where true" WITH {"event_category_field": "category"}
| KEEP @timestamp, name
| SORT name
;

@timestamp:datetime      | name:keyword
2026-07-22T10:00:00.000Z | cmd.exe
2026-07-22T10:00:02.000Z | powershell.exe
;

eventQueryGroupsByTypedColumn
required_capability: eql_command

EQL eql_test "process where true" WITH {"event_category_field": "category"}
| STATS count = COUNT(*) BY name
| SORT name
;

count:long | name:keyword
1          | cmd.exe
1          | powershell.exe
;

eventQueryHonorsLimit
required_capability: eql_command

EQL eql_test "process where true" WITH {"event_category_field": "category"}
| KEEP name
| SORT name
| LIMIT 1
;

name:keyword
cmd.exe
;

sequenceQueryUnnestsToOneRowPerEvent
required_capability: eql_command

EQL eql_test "sequence by pid [process where true] [network where true]" WITH {"event_category_field": "category"}
| KEEP join_keys, _sequence_stage
| SORT join_keys, _sequence_stage
;

join_keys:keyword | _sequence_stage:integer
100               | 0
100               | 1
200               | 0
200               | 1
;

sequenceQueryCountsEventsAndSequences
required_capability: eql_command

EQL eql_test "sequence by pid [process where true] [network where true]" WITH {"event_category_field": "category"}
| STATS events = COUNT(*), sequences = COUNT_DISTINCT(_sequence)
;

events:long | sequences:long
4           | 2
;

eventQueryMetadataIndexColumn
required_capability: eql_command
required_capability: eql_command_metadata

// METADATA is declared before WITH (grammar: pattern, query, METADATA, then the WITH tuning).
EQL eql_test "process where true" METADATA _index WITH {"event_category_field": "category"}
| KEEP name, _index
| SORT name
;

name:keyword   | _index:keyword
cmd.exe        | eql_test
powershell.exe | eql_test
;

eventQueryMetadataAggregates
required_capability: eql_command
required_capability: eql_command_metadata

EQL eql_test "process where true" METADATA _index, _id WITH {"event_category_field": "category"}
| STATS n = COUNT(*), idx = COUNT_DISTINCT(_index), ids = COUNT_DISTINCT(_id)
;

n:long | idx:long | ids:long
2      | 1        | 2
;

eventQueryMetadataSourceIsNeverNull
required_capability: eql_command
required_capability: eql_command_metadata

EQL eql_test "process where true" METADATA _source WITH {"event_category_field": "category"}
| WHERE _source IS NOT NULL
| STATS n = COUNT(*)
;

n:long
2
;

sequenceQueryMetadataComposesWithSynthetics
required_capability: eql_command
required_capability: eql_command_metadata

EQL eql_test "sequence by pid [process where true] [network where true]" METADATA _index WITH {"event_category_field": "category"}
| STATS events = COUNT(*), sequences = COUNT_DISTINCT(_sequence) BY _index
;

events:long | sequences:long | _index:keyword
4           | 2              | eql_test
;

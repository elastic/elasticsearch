// A metric of a data stream without exemplars selects no exemplars, because no exemplar of the other data streams carries its name.
metricOnlyInDataStreamWithoutExemplars
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu,metrics-k8s | STATS AVG(cpu_time), MAX(RATE(network.total_bytes_in))
;


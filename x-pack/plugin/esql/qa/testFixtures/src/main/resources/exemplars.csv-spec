exponentialHistogramPromqlMetricsQuery
required_capability: exemplars_setting_development_v6
required_capability: promql_command_v0
required_capability: promql_histogram_sum_count_avg
SET exemplars=true\;
PROMQL index=metrics-cpu start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:05:00.000Z" step=1m (histogram_count(request_duration))
;


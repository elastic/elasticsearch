// Everything after STATS processes the aggregated result, which is never computed.
everythingAfterStatsIsIgnored
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | STATS avg = AVG(cpu_time) BY attributes.cpu | KEEP avg | SORT avg | LIMIT 1
;


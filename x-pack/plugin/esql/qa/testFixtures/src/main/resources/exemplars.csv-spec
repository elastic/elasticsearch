;

// Requiring one of the aggregated metrics excludes the exemplars of the other ones.
metricNotNullCheckFilterIsApplied
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | WHERE cpu_time IS NOT NULL | STATS AVG(cpu_time), MAX(memory_usage)
;


// The filter of an outer aggregate function applies to the metric of the time series aggregate function nested in it, whether that
// one is explicit (MAX_OVER_TIME) or implicit (AVG(memory_usage) aggregates LAST_OVER_TIME(memory_usage)).
overTimeAggregationInOuterAggregation
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.state == "idle" | STATS MAX(MAX_OVER_TIME(cpu_time)) WHERE attributes.cpu == "cpu0", AVG(memory_usage) BY attributes.cpu
;


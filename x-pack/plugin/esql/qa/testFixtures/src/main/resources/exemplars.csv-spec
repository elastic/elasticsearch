// The initial exemplar rewrite replaces the analyzed metrics query with the relation over all exemplar data streams derived from its
// resolved time series indices. Metric and filter selection are added separately.
exemplarsRelation
required_capability: exemplars_setting_development_v2
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time)
;
ignoreOrder:true


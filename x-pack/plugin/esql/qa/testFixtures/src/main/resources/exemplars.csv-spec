// A PROMQL binary operation between two metrics selects the exemplars of both, whether the operands are translated to one shared time
// series aggregation (same labels, no vector matching) ...
promqlBinaryOperation
required_capability: exemplars_setting_development_v6
required_capability: promql_command_v0
SET exemplars=true\;
PROMQL index=metrics-cpu start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:05:00.000Z" step=1m (sum by (attributes.cpu) (avg_over_time(cpu_time[1m])) / sum by (attributes.cpu) (avg_over_time(memory_usage[1m])))
;


// A null check on a metric, also through a conversion function, is applied as a condition on the metric_name of the exemplars.
// An exemplar belongs to exactly one metric, so excluding the samples with a memory_usage excludes the memory_usage exemplars.
metricNullCheckFilterIsApplied
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | WHERE TO_LONG(memory_usage) IS NULL AND attributes.state == "idle" | STATS AVG(cpu_time), MAX(memory_usage)
;


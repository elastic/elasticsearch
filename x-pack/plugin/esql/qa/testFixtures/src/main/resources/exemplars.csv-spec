// The initial exemplar rewrite replaces the analyzed metrics query with the relation over all exemplar data streams derived from its
// resolved time series indices, projected to the exemplar's timestamp, metric name and value plus its full document, most recent first.
// Metric and filter selection are added separately.
exemplarsRelation
required_capability: exemplars_setting_development_v3
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time)
;

@timestamp:date          | metric_name:keyword | value:double | _source:_source

// Only metrics of the data stream without exemplars are aggregated: the exemplar data stream exists, but holds none of them.
onlyMetricsOfDataStreamWithoutExemplars
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu,metrics-k8s | STATS MAX(RATE(network.total_bytes_in)) BY cluster
;

@timestamp:date | metric_name:keyword | value:double | _source:_source
;

// A TS query without STATS aggregates no metrics, so it selects no exemplars.
tsWithoutStats
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | KEEP @timestamp, cpu_time
;

@timestamp:date | metric_name:keyword | value:double | _source:_source
;

// Without the setting the metrics query runs as usual.
settingDisabledRunsMetricsQuery
required_capability: exemplars_setting_development_v6
SET exemplars=false\;
TS metrics-cpu | STATS avg = AVG(cpu_time)
;

avg:double
4.75

exemplarsLimit
required_capability: exemplars_setting_development_v3
SET exemplars={"limit": 2}\;
TS metrics-cpu | STATS AVG(cpu_time)
;

@timestamp:date          | metric_name:keyword | value:double | _source:_source
2024-05-10T00:04:10.000Z | memory_usage        | 105.0        | "{""@timestamp"":""2024-05-10T00:04:10.000Z"",""attributes"":{""cpu"":""cpu0"",""state"":""idle""},""metric_name"":""memory_usage"",""span_id"":""span-9"",""trace_id"":""trace-idle-cpu0-mem"",""value"":105.0}"

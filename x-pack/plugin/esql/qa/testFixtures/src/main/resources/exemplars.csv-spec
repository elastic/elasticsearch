// Without an outer aggregation, the time series aggregate functions aggregate each time series on their own, under their filters.
overTimeAggregationsWithoutOuterAggregation
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.cpu == "cpu1" | STATS MAX_OVER_TIME(cpu_time) WHERE attributes.state == "idle", LAST_OVER_TIME(memory_usage) WHERE attributes.state == "busy"
;


// A filter on the value of a metric selects metric samples, not series, and is not applied to the exemplars: the exemplar with
// value 1.7 is selected although the metrics query only aggregates samples with cpu_time > 2.
metricValueFilterIsNotApplied
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.state == "idle" AND cpu_time > 2 | STATS AVG(cpu_time)
;


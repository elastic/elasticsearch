// Exemplars of an exponential histogram metric are the raw observations that were sampled into the histogram, so their value is a
// plain double like for any other metric.
exponentialHistogramMetric
required_capability: exemplars_setting_development_v6
required_capability: exponential_histogram_tech_preview
SET exemplars=true\;
TS metrics-cpu | STATS p95 = PERCENTILE(LAST_OVER_TIME(request_duration), 95) BY attributes.cpu
;


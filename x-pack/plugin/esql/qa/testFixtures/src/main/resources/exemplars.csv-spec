;

// The filter of an aggregate function applies to the exemplars of its metric only: the idle cpu_time exemplars and the busy
// memory_usage exemplar are selected, not the busy cpu_time or the idle memory_usage ones.
aggregateFilters
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time) WHERE attributes.state == "idle", MAX(memory_usage) WHERE attributes.state == "busy"
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
2024-05-10T00:03:10.000Z | cpu1                   | busy                     | cpu1        | memory_usage        | span-7          | busy          | trace-busy-cpu1-mem | 420.0
;

// A WHERE before STATS applies to all metrics, on top of the filters of the aggregate functions.
aggregateFiltersAndSharedFilter
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.cpu == "cpu1" | STATS AVG(cpu_time) WHERE attributes.state == "idle", MAX(memory_usage) WHERE attributes.state == "busy"
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
2024-05-10T00:03:10.000Z | cpu1                   | busy                     | cpu1        | memory_usage        | span-7          | busy          | trace-busy-cpu1-mem | 420.0
;

// PROMQL metrics queries work the same way: the label matchers and the evaluated time range are applied to the exemplars.
promqlMetricsQuery
required_capability: exemplars_setting_development_v4
required_capability: promql_command_v0
SET exemplars=true\;
PROMQL index=metrics-cpu start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:02:00.000Z" step=1m (avg(avg_over_time(cpu_time{attributes.state="idle"}[1m])))
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
;

// A PROMQL binary operation between two metrics selects the exemplars of both, each under its own label matchers, whether the
// operands are translated to one shared time series aggregation (same labels, no vector matching) ...
promqlBinaryOperation
required_capability: exemplars_setting_development_v4
required_capability: promql_command_v0
SET exemplars=true\;
PROMQL index=metrics-cpu start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:05:00.000Z" step=1m (sum by (attributes.cpu) (avg_over_time(cpu_time{attributes.state="idle"}[1m])) / sum by (attributes.cpu) (avg_over_time(memory_usage{attributes.state="busy"}[1m])))
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
2024-05-10T00:03:10.000Z | cpu1                   | busy                     | cpu1        | memory_usage        | span-7          | busy          | trace-busy-cpu1-mem | 420.0
;

// ... or to two separate ones joined by explicit vector matching.
promqlBinaryOperationWithVectorMatching
required_capability: exemplars_setting_development_v4
required_capability: promql_command_v0
SET exemplars=true\;
PROMQL index=metrics-cpu start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:05:00.000Z" step=1m (sum by (attributes.cpu) (avg_over_time(cpu_time{attributes.state="idle"}[1m])) / on (attributes.cpu) sum by (attributes.cpu) (avg_over_time(memory_usage{attributes.state="busy"}[1m])))
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
2024-05-10T00:03:10.000Z | cpu1                   | busy                     | cpu1        | memory_usage        | span-7          | busy          | trace-busy-cpu1-mem | 420.0
;

// Exemplars of an exponential histogram metric are the raw observations that were sampled into the histogram, so their value is a
// plain double like for any other metric.
exponentialHistogramMetric
required_capability: exemplars_setting_development_v4
required_capability: exponential_histogram_tech_preview
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.state == "busy" | STATS p95 = PERCENTILE(LAST_OVER_TIME(request_duration), 95) BY attributes.cpu
;
ignoreOrder:true


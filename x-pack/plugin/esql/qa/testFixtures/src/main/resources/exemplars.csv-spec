// A metric that is only referenced in the filter of an aggregate function is not aggregated, so its exemplars are not selected.
metricInAggregateFilterIsNotSelected
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time) WHERE memory_usage > 400
;


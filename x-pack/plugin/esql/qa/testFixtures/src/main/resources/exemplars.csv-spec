// metrics-noexemplars derives exemplars-noexemplars, which does not exist. The query returns no exemplars, and the exemplar
// columns it cannot find in any mapping are nullified.
exemplarsWithoutExemplarDataStream
required_capability: exemplars_setting_development_v3
SET exemplars=true\;
TS metrics-noexemplars | STATS AVG(cpu_time)
;

@timestamp:null | metric_name:null | value:null | _source:_source
;

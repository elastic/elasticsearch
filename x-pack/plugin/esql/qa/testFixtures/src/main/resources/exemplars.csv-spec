// Without an exemplar data stream to read from the query yields no rows, and no columns but the fields its filter and sort refer to,
// which are null. Unlike for other source commands, a concrete exemplar data stream that does not exist is not an error.
metricsWithoutExemplarDataStream
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-noexemplars | WHERE attributes.state == "idle" | STATS AVG(cpu_time) BY attributes.cpu
;

attributes.state:null | metric_name:null | @timestamp:null
;

metricsWithoutExemplarDataStreamWildcard
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-noexemplars* | STATS AVG(cpu_time) BY attributes.cpu
;

metric_name:null | @timestamp:null
;

// Index patterns that do not follow the metrics-* naming have no exemplar data streams either.
nonMetricsIndexPattern
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS k8s | STATS MAX(RATE(network.total_bytes_in)) BY cluster
;

metric_name:null | @timestamp:null
;


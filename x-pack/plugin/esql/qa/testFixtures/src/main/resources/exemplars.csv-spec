// A passthrough object does not have to be at the root: disk_io is in the passthrough object system.metrics, inside the regular
// object system. Its root-level alias and its metric name are disk_io, without the regular parent either.
metricInNestedPassthroughObject
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | STATS AVG(system.metrics.disk_io)
;


// The filter of an aggregate function applies to the exemplars of its metrics only: the idle cpu_time exemplars and the busy
// memory_usage exemplar are selected, not the busy cpu_time or the idle memory_usage ones.
aggregateFilters
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time) WHERE attributes.state == "idle", MAX(memory_usage) WHERE attributes.state == "busy"
;


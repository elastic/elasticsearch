// With SET exemplars=true a TS or PROMQL query returns the exemplars of the series it reads instead of its result. The metrics query
// is analyzed but not executed: the metric fields it aggregates and the filters before the aggregation select the exemplars from the
// exemplar data stream derived from the metrics one (metrics-cpu -> exemplars-cpu). An exemplar document belongs to exactly one
// metric: it carries the metric's name in metric_name and the observed value in value instead of the metric field itself, so the
// exemplar query selects exemplars by metric_name where the metrics query refers to the metric field. The exemplars are the result of
// the query, so they cannot be processed further: the columns are all fields of the exemplar index.
//
// Like in the OTel mappings, attributes and metrics are passthrough objects of the metrics index, so every dimension and metric is
// also available under its short name, e.g. cpu_time for metrics.cpu_time. The metric name is the name of the metric field as
// referred to in the query, so the metrics have to be referred to by their short name for now (see the TODO on
// ExemplarsRewriter#metricName).

exemplarsOfSingleMetric
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time)
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:01:10.000Z | cpu0                   | busy                     | cpu0        | cpu_time            | span-2          | busy          | trace-busy-cpu0-cpu | 8.1
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
;

// The exemplars are returned most recent first. SET exemplars=true leaves them under the default limit of a regular query.
exemplarsAreSortedByTimestampDesc
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time)
;

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
2024-05-10T00:01:10.000Z | cpu0                   | busy                     | cpu0        | cpu_time            | span-2          | busy          | trace-busy-cpu0-cpu | 8.1
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
;

// A limit in the setting returns only that many of the most recent exemplars.
exemplarsLimit
required_capability: exemplars_setting_development_v4
SET exemplars={"limit": 2}\;
TS metrics-cpu | STATS AVG(cpu_time)
;

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
2024-05-10T00:01:10.000Z | cpu0                   | busy                     | cpu0        | cpu_time            | span-2          | busy          | trace-busy-cpu0-cpu | 8.1
;

// The dimension filter of the metrics query is applied to the exemplars too.
dimensionFilter
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.state == "idle" | STATS AVG(cpu_time) BY attributes.cpu
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
;

// Dimensions can be referred to by the full field name or the short name alike, as the exemplar index has both. A metric referred to by
// its full field name selects the exemplars of metric_name "metrics.cpu_time", which do not exist.
metricReferencedByFullFieldNameSelectsNoExemplars
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE state == "idle" | STATS AVG(metrics.cpu_time) BY cpu
;

@timestamp:date | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword | value:double
;

// Filters on the metric value itself describe the metric samples, not the exemplars, and are not carried over: the exemplar
// with value 1.7 is returned even though the metrics query only reads samples with cpu_time > 2.
metricValueFilterIsNotAppliedToExemplars
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.state == "idle" AND cpu_time > 2 | STATS AVG(cpu_time)
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
;

// Null checks on metrics, also through conversion functions, are carried over like dimension filters, as conditions on metric_name;
// the metric they mention is not what the exemplars are fetched for, so the memory_usage exemplars are not selected.
metricNullCheckFilterIsApplied
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE TO_LONG(memory_usage) IS NULL AND attributes.state == "idle" | STATS AVG(cpu_time)
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
;

// A null check on a metric other than the aggregated ones excludes all exemplars: an exemplar only ever belongs to one metric.
metricNotNullCheckOnOtherMetricSelectsNothing
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE memory_usage IS NOT NULL | STATS AVG(cpu_time)
;

@timestamp:date | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword | value:double
;

// Only filters before STATS describe the series read; a filter after STATS, even on a grouping dimension, does not carry over.
filterAfterStatsOnDimensionIsNotApplied
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time) BY attributes.cpu | WHERE attributes.cpu == "cpu1"
;
ignoreOrder:true

@timestamp:date          | attributes.cpu:keyword | attributes.state:keyword | cpu:keyword | metric_name:keyword | span_id:keyword | state:keyword | trace_id:keyword    | value:double
2024-05-10T00:00:10.000Z | cpu0                   | idle                     | cpu0        | cpu_time            | span-1          | idle          | trace-idle-cpu0-cpu | 1.7
2024-05-10T00:01:10.000Z | cpu0                   | busy                     | cpu0        | cpu_time            | span-2          | busy          | trace-busy-cpu0-cpu | 8.1
2024-05-10T00:02:20.000Z | cpu1                   | idle                     | cpu1        | cpu_time            | span-5          | idle          | trace-idle-cpu1-cpu | 2.9
;

// The same holds for everything else after STATS: it processes the aggregated result, which is never computed.
everythingAfterStatsIsIgnored
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | STATS avg = AVG(cpu_time) BY attributes.cpu | KEEP avg | SORT avg | LIMIT 1
;
ignoreOrder:true


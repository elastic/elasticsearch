// A filter on a dimension that only the data stream without exemplars has excludes all series of the other data streams, and
// therefore all of their exemplars.
dimensionFilterOnlyInDataStreamWithoutExemplars
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu,metrics-k8s | WHERE cluster == "prod" | STATS AVG(cpu_time), MAX(RATE(network.total_bytes_in))
;

@timestamp:date | metric_name:keyword | value:double | _source:_source
;

dimensionFilterInDataStreamWithExemplars
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu,metrics-k8s | WHERE attributes.state == "idle" | STATS AVG(cpu_time), MAX(RATE(network.total_bytes_in))
;


// When only some of the queried metrics data streams have exemplars, fields that exist in none of the exemplar indices are treated as
// null there: metrics-k8s has neither exemplars nor the dimensions of metrics-cpu and vice versa. Its metric selects no exemplars,
// because no exemplar of the other data stream carries that metric_name.
metricOnlyInDataStreamWithoutExemplars
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu,metrics-k8s | STATS AVG(cpu_time), MAX(RATE(network.total_bytes_in))
;
ignoreOrder:true


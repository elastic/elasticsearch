// metrics-noexemplars derives exemplars-noexemplars, which does not exist. The query returns no exemplars, and the exemplar
// columns it cannot find in any mapping are nullified.
exemplarsWithoutExemplarDataStream
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-noexemplars | STATS AVG(cpu_time)
;

@timestamp:null | metric_name:null | value:null | _source:_source
;

metricsWithoutExemplarDataStreamWildcard
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-noexemplars* | STATS AVG(cpu_time)
;

@timestamp:null | metric_name:null | value:null | _source:_source
;

// Only the metrics-* expressions of a mixed index pattern contribute exemplars, and only those whose exemplar data stream exists.
mixedIndexPattern
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu,metrics-noexemplars,k8s | STATS AVG(cpu_time) BY attributes.cpu
;


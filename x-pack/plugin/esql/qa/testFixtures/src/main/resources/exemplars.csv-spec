;

// A disjunction is applied or dropped as a whole, so a dimension filter in a disjunction with a metric value filter is dropped too.
disjunctionWithMetricValueFilterIsNotApplied
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.state == "busy" OR cpu_time < 2 | STATS AVG(cpu_time)
;


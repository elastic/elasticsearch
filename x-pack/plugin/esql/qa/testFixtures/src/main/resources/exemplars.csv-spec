multipleMetrics
required_capability: exemplars_setting_development_v4
SET exemplars=true\;
TS metrics-cpu | WHERE attributes.cpu == "cpu1" | STATS AVG(cpu_time), MAX(memory_usage)
;
ignoreOrder:true


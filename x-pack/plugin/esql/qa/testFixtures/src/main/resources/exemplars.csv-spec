// With SET exemplars=true a TS or PROMQL query returns the exemplars of the metrics it aggregates instead of its result. The metrics
// query is analyzed but not executed: the metric fields it aggregates select the exemplars from the exemplar data streams derived from
// its resolved time series indices (metrics-cpu -> exemplars-cpu). An exemplar document belongs to exactly one metric: it carries the
// metric's name in metric_name and the observed value in value. The exemplars are projected to their timestamp, metric name and value
// plus their full document, most recent first. The filters of the metrics query on dimensions and @timestamp select the exemplars of
// the filtered series only.
//
// Like in the OTel mappings, attributes and metrics are passthrough objects of the metrics index, so every metric is also available
// under its short name, e.g. cpu_time for metrics.cpu_time. The metric_name of an exemplar omits passthrough parents.

exemplarsOfSingleMetric
required_capability: exemplars_setting_development_v6
SET exemplars=true\;
TS metrics-cpu | STATS AVG(cpu_time)
;

@timestamp:date          | metric_name:keyword | value:double | _source:_source
2024-05-10T00:02:20.000Z | cpu_time            | 2.9          | "{""@timestamp"":""2024-05-10T00:02:20.000Z"",""attributes"":{""cpu"":""cpu1"",""state"":""idle""},""metric_name"":""cpu_time"",""span_id"":""span-5"",""trace_id"":""trace-idle-cpu1-cpu"",""value"":2.9}"
2024-05-10T00:01:10.000Z | cpu_time            | 8.1          | "{""@timestamp"":""2024-05-10T00:01:10.000Z"",""attributes"":{""cpu"":""cpu0"",""state"":""busy""},""metric_name"":""cpu_time"",""span_id"":""span-2"",""trace_id"":""trace-busy-cpu0-cpu"",""value"":8.1}"
2024-05-10T00:00:10.000Z | cpu_time            | 1.7          | "{""@timestamp"":""2024-05-10T00:00:10.000Z"",""attributes"":{""cpu"":""cpu0"",""state"":""idle""},""metric_name"":""cpu_time"",""span_id"":""span-1"",""trace_id"":""trace-idle-cpu0-cpu"",""value"":1.7}"
;

// A limit in the setting returns only that many of the most recent exemplars.
exemplarsLimit
required_capability: exemplars_setting_development_v6
SET exemplars={"limit": 2}\;
TS metrics-cpu | STATS AVG(cpu_time)
;

@timestamp:date          | metric_name:keyword | value:double | _source:_source
2024-05-10T00:02:20.000Z | cpu_time            | 2.9          | "{""@timestamp"":""2024-05-10T00:02:20.000Z"",""attributes"":{""cpu"":""cpu1"",""state"":""idle""},""metric_name"":""cpu_time"",""span_id"":""span-5"",""trace_id"":""trace-idle-cpu1-cpu"",""value"":2.9}"
2024-05-10T00:01:10.000Z | cpu_time            | 8.1          | "{""@timestamp"":""2024-05-10T00:01:10.000Z"",""attributes"":{""cpu"":""cpu0"",""state"":""busy""},""metric_name"":""cpu_time"",""span_id"":""span-2"",""trace_id"":""trace-busy-cpu0-cpu"",""value"":8.1}"
;

// include_timeseries adds the _timeseries column, holding the dimensions of the series an exemplar belongs to. The exemplar data
// streams are time series ones whose dimensions mirror those of the metrics, plus metric_name.
exemplarsWithTimeseries
required_capability: exemplars_setting_development_v6
SET exemplars={"include_timeseries": true}\;
TS metrics-cpu | WHERE attributes.state == "idle" | STATS AVG(cpu_time) BY attributes.cpu
;

@timestamp:date          | metric_name:keyword | value:double | _timeseries:keyword                                                                   | _source:_source
2024-05-10T00:02:20.000Z | cpu_time            | 2.9          | "{""attributes"":{""cpu"":""cpu1"",""state"":""idle""},""metric_name"":""cpu_time""}" | "{""@timestamp"":""2024-05-10T00:02:20.000Z"",""attributes"":{""cpu"":""cpu1"",""state"":""idle""},""metric_name"":""cpu_time"",""span_id"":""span-5"",""trace_id"":""trace-idle-cpu1-cpu"",""value"":2.9}"
2024-05-10T00:00:10.000Z | cpu_time            | 1.7          | "{""attributes"":{""cpu"":""cpu0"",""state"":""idle""},""metric_name"":""cpu_time""}" | "{""@timestamp"":""2024-05-10T00:00:10.000Z"",""attributes"":{""cpu"":""cpu0"",""state"":""idle""},""metric_name"":""cpu_time"",""span_id"":""span-1"",""trace_id"":""trace-idle-cpu0-cpu"",""value"":1.7}"
;

// include_timeseries combines with a limit, and an explicit false is the default.
exemplarsWithTimeseriesAndLimit
required_capability: exemplars_setting_development_v6
SET exemplars={"limit": 1, "include_timeseries": true}\;
TS metrics-cpu | STATS AVG(cpu_time)
;


// Data-correctness tests for aggregates over the multi-source FROM <dataset> a fan-in produces, where each producer
// aggregates its own source and emits intermediate state for one final merge. The plan shape is validated by
// HeterogeneousFromPushdownGoldenTests; these tests validate the merged *results*.
//
// Each test selects two datasets (emp_a, emp_b) that both point at the same {{employees_no_mv}} fixture, so the
// union is the employees data duplicated. That makes the merge math easy to assert exactly: COUNT(*) doubles,
// SUM doubles, AVG is unchanged, and COUNT_DISTINCT de-duplicates back to the single-dataset distinct count
// (proving the per-branch HLL sketches are unioned, not summed). These specs declare two dataset: sources, so they
// run on dataset-capable backends (FROM <dataset>) and are skipped on the EXTERNAL-rebuild backends (EXTERNAL is
// single-source).

heavyAggregatesMergedAcrossDatasets
required_capability: external_command
dataset: emp_a: "{{employees_no_mv}}"
dataset: emp_b: "{{employees_no_mv}}"

FROM emp_a, emp_b
| STATS distinct_emp = COUNT_DISTINCT(emp_no), total = COUNT(*), sum_salary = SUM(salary), avg_salary = AVG(salary);

distinct_emp:long | total:long | sum_salary:long | avg_salary:double
100               | 200        | 9649710         | 48248.55
;

heavyAggregatesGroupedMergedAcrossDatasets
required_capability: external_command
required_capability: external_csv_empty_string_not_null
dataset: emp_a: "{{employees_no_mv}}"
dataset: emp_b: "{{employees_no_mv}}"

FROM emp_a, emp_b
| STATS distinct_emp = COUNT_DISTINCT(emp_no), c = COUNT(*) BY gender
| SORT gender;

distinct_emp:long | c:long | gender:keyword
10                | 20     |
33                | 66     | "F"
57                | 114    | "M"
;

// Grouped SUM and AVG, where each producer contributes a partial sum and count per group rather than a finished one.
// Duplicating the data must double every group's SUM while leaving its AVG untouched, so the two columns disagree on
// purpose: a merge that added the producers' averages, or that summed one producer only, breaks one column or the
// other. The per-group figures come from the fixture (F sums 1666196 over 33 rows, M 2671054 over 57, the unset
// gender 487605 over 10), and the columns below are those doubled and unchanged respectively.
heavyAggregatesGroupedSumAvgMergedAcrossDatasets
required_capability: external_command
required_capability: external_csv_empty_string_not_null
dataset: emp_a: "{{employees_no_mv}}"
dataset: emp_b: "{{employees_no_mv}}"

FROM emp_a, emp_b
| STATS sum_salary = SUM(salary), avg_salary = AVG(salary), c = COUNT(*) BY gender
| SORT gender;

sum_salary:long | avg_salary:double | c:long | gender:keyword
975210          | 48760.5           | 20     |
3332392         | 50490.78787878788 | 66     | "F"
5342108         | 46860.59649122807 | 114    | "M"
;

// Per-aggregate filter on a heavy aggregate mixed with an unfiltered one. Because not every aggregate is filtered,
// ExtractAggregateCommonFilter cannot hoist a common WHERE, so distinct_f's filter stays per-aggregate and travels
// into each producer: a producer folds only the matching rows into its HLL sketch before the sketches are unioned.
// The 33 female employees are identical in both datasets, so the unioned distinct count is 33 (not 66), while the
// unfiltered COUNT(*) doubles to 200. Proves the filter is applied per producer, before the merge.
heavyAggregatesFilteredMergedAcrossDatasets
required_capability: external_command
dataset: emp_a: "{{employees_no_mv}}"
dataset: emp_b: "{{employees_no_mv}}"

FROM emp_a, emp_b
| STATS distinct_f = COUNT_DISTINCT(emp_no) WHERE gender == "F", total = COUNT(*);

distinct_f:long | total:long
33              | 200
;

// Grouped + selective per-aggregate filter on a heavy aggregate. Grouped stats are never hoisted by
// ExtractAggregateCommonFilter, so the filter travels into each producer and is applied per group. Only the M
// group has rows matching gender == "M", so its unioned distinct count is 57; the F and null groups still appear (the
// grouping is over all rows) but their filtered input is empty, so COUNT_DISTINCT is 0. Proves the per-group filter
// actually selects rows and the grouped + filtered merge is correct.
heavyAggregatesFilteredGroupedMergedAcrossDatasets
required_capability: external_command
required_capability: external_csv_empty_string_not_null
dataset: emp_a: "{{employees_no_mv}}"
dataset: emp_b: "{{employees_no_mv}}"

FROM emp_a, emp_b
| STATS distinct_emp = COUNT_DISTINCT(emp_no) WHERE gender == "M" BY gender
| SORT gender;

distinct_emp:long | gender:keyword
0                 |
0                 | "F"
57                | "M"
;

// Empty buckets over the multi-source FROM a fan-in produces. This guards the interaction between
// include_empty_buckets and a grouping key that is computed per producer and merged.
emptyBucketsMergedAcrossDatasets
required_capability: external_command
required_capability: bucket_include_empty_buckets
dataset: emp_a: "{{employees_no_mv}}"
dataset: emp_b: "{{employees_no_mv}}"

FROM emp_a, emp_b
| WHERE languages IS NOT NULL
| STATS c = COUNT(*) BY b = BUCKET(languages, 20, 1, 9, {"include_empty_buckets": true})
| SORT b;

c:long | b:double
30     | 1.0
0      | 1.5
38     | 2.0
0      | 2.5
34     | 3.0
0      | 3.5
36     | 4.0
0      | 4.5
42     | 5.0
0      | 5.5
0      | 6.0
0      | 6.5
0      | 7.0
0      | 7.5
0      | 8.0
0      | 8.5
;

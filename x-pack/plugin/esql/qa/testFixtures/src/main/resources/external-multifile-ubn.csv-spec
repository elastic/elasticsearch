// Union-by-name across files with different column sets, on every format.
//
// The layout holds two files that deliberately disagree about which columns exist:
//   ..._ubn_a — [name:keyword, age:integer]           rows: alice,30 / bob,40
//   ..._ubn_b — [age:long, name:keyword, city:keyword] rows: 50,charlie,paris / 60,dave,london
// Under union_by_name the reader unions the column sets and null-fills what a file lacks, so
// alice and bob must come back with a null city rather than being dropped or misaligned.
//
// Every case here projects explicitly and avoids `age`. That is deliberate: the binary formats
// read a source pair whose first file carries an extra score:double column, and `age` is declared
// integer in one file and long in the other, so both the full projection and the widened type are
// format-dependent. What IS format-independent is the union itself and the null-fill, which is the
// property this layout exists to prove. Widening lives in external-multifile-ubn-widening.csv-spec.

ubnUnionNullFillsAbsentColumn
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: datasource_file_readers_no_text_type
dataset: ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM ubn_union
| KEEP name, city
| SORT name ASC
| LIMIT 10
;

name:keyword | city:keyword
alice        | null
bob          | null
charlie      | paris
dave         | london
;

// Every row from both files survives the union: nothing is dropped when a file lacks a column.
ubnUnionKeepsAllRows
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: datasource_file_readers_no_text_type
dataset: ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM ubn_union
| STATS count = COUNT(*)
;

count:long
4
;

// The null-fill is a real null, not an empty string or a dropped row: only the file that lacks
// the column contributes nulls, and exactly its two rows do.
ubnUnionNullFillIsCountable
required_capability: dataset_in_from_command
required_capability: external_source_read_schema
required_capability: datasource_file_readers_no_text_type
dataset: ubn_union: "{{employees_multifile_ubn}}" WITH {"schema_resolution": "union_by_name"}

FROM ubn_union
| WHERE city IS NULL
| KEEP name
| SORT name ASC
;

name:keyword
alice
bob
;

fillNullStarMixedWithNameFillsAllColumns
required_capability: fillnull

// `*` co-listed with a name is still the all-columns (lenient) form: every column is filled, the co-listed `a` is redundant.
ROW a = null, b = null, c = 1
| EVAL a = a::integer, b = b::integer
| FILLNULL 0 ON *, a
;

c:integer | a:integer | b:integer
1         | 0         | 0
;

fillNullStarMixedWithPatternFillsAllColumns
required_capability: fillnull

// `*` co-listed with a wildcard pattern is still the all-columns (lenient) form.
ROW aa = null, ab = null, c = 1
| EVAL aa = aa::integer, ab = ab::integer
| FILLNULL 0 ON *, a*
;

c:integer | aa:integer | ab:integer
1         | 0          | 0
;

fillNullWildcardTargetThenRenameThenKeepWildcard
required_capability: fillnull

// FILLNULL fills the `*_name` columns (first_name, last_name); after RENAME first_name AS name, KEEP *_name keeps only
// last_name - the renamed `name` no longer matches the wildcard. SORT/LIMIT just make the output deterministic and short.
FROM employees
| FILLNULL "x" ON *_name
| RENAME first_name AS name
| KEEP *_name
| SORT last_name
| LIMIT 5
;

last_name:keyword
Awdeh
Azuma
Baek
Bamford
Bernatsky
;

fillNullWildcardTargetThenRenameCastThenKeepWildcard
required_capability: fillnull

// Like the previous test, but the renamed `name` is re-EVAL'd (moving it to the end) and KEEP *name* now matches both
// `last_name` and `name`. Uses ::keyword because ES|QL has no ToText converter yet (::text throws at parse time).
FROM employees
| FILLNULL "x" ON *_name
| RENAME first_name AS name
| EVAL name = name::keyword
| KEEP *name*
| SORT last_name
| LIMIT 5
;

last_name:keyword | name:keyword
Awdeh             | Satosi
Azuma             | Mona
Baek              | Premal
Bamford           | Parto
Bernatsky         | Mokhtar
;

fromSubqueriesBeforeStatsWhereWithForkInsideInSubquery
required_capability: where_in_subquery_without_view
required_capability: subquery_in_from_command
required_capability: fork_v9
required_capability: where_in_subquery_fork_unknown_column_fix
required_capability: stats_where_in_subquery

FROM
  (FROM employees | WHERE emp_no <= 10005),
  (FROM employees | WHERE emp_no >= 10099)
| STATS c = COUNT(*) WHERE emp_no IN (
    FROM employees
    | FORK
        (WHERE emp_no <= 10002 | KEEP emp_no)
        (WHERE emp_no >= 10100 | KEEP emp_no)
    | KEEP emp_no
  ),
  total = COUNT(*)
;

c:long | total:long
3      | 7
;


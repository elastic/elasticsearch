;

forkAfterStatsWhereInSubquery
required_capability: where_in_subquery_without_view
required_capability: fork_v9
required_capability: stats_where_in_subquery

FROM employees
| STATS c = COUNT(*) WHERE emp_no IN (
    FROM employees
    | WHERE emp_no <= 10003
    | KEEP emp_no
  ),
  total = COUNT(*)
| FORK
    (WHERE c == 3)
    (WHERE total == 100)
| SORT _fork
| KEEP c, total, _fork
;

c:long | total:long | _fork:keyword
3      | 100        | fork1
3      | 100        | fork2
;


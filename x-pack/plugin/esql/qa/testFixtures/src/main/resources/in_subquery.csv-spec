FROM employees
| FORK
    (WHERE emp_no <= 10005)
    (WHERE emp_no >= 10099)
| STATS c = COUNT(*) WHERE emp_no IN (
    FROM
      (FROM employees | WHERE emp_no <= 10003 | KEEP emp_no),
      (FROM employees | WHERE emp_no >= 10099 | KEEP emp_no)
    | KEEP emp_no
  ) AND emp_no NOT IN (
    FROM
      (FROM employees | WHERE emp_no == 10002 | KEEP emp_no),
      (FROM employees | WHERE emp_no == 10100 | KEEP emp_no)
    | KEEP emp_no
  ),
  total = COUNT(*)
;


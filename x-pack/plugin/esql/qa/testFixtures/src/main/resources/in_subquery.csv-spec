inSubqueryWithLHSContainingNullsNoMatchingInsideCoalesce
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// COALESCE(FALSE, true) = FALSE  (non-null language employees — COALESCE does not skip FALSE)
// COALESCE(NULL,  true) = TRUE   (null language employees — NULL is coalesced to the fallback)
// Only the 10 employees with null languages pass.
FROM employees
| WHERE COALESCE(languages IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no), true)
| STATS c = COUNT(*)
;

c:long
10
;

notInSubqueryWithLHSContainingNullsNoMatchingInsideCoalesce
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// CASE(TRUE, true, false) = TRUE for non-null-language employees (90)
// CASE(NULL, true, false) = FALSE  for null-language employees (10)
FROM employees
| WHERE CASE(languages NOT IN (FROM employees | KEEP emp_no), true, false)
| STATS c = COUNT(*)
;

c:long
90
;

// ----------------------------------------------------------
// Group 3: RHS has mixed NULLs and real values
//
// Subquery returns {10001, null, null}:
//   FROM employees | SORT emp_no ASC | LIMIT 3
//   | EVAL x = CASE(emp_no == 10001, emp_no, null) | KEEP x
//
//   emp_no = 10001 → mark = TRUE  (matches 10001)
//   emp_no ≠ 10001 → mark = NULL  (no match, NULLs present in RHS)
// ----------------------------------------------------------

inSubqueryWithRHSContainingNullsInsideIsNull
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// IS NULL(TRUE)  = FALSE → emp_no=10001 is excluded
// IS NULL(NULL)  = TRUE  → all other 99 employees are included
FROM employees
| WHERE (emp_no IN (
    FROM employees | SORT emp_no ASC | LIMIT 3
    | EVAL x = CASE(emp_no == 10001, emp_no, null) | KEEP x
  )) IS NULL
| STATS c = COUNT(*)
;

c:long
99
;


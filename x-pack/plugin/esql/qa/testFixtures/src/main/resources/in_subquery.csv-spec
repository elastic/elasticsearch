        not_in_top3 = COUNT(*) WHERE emp_no NOT IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no),
        total = COUNT(*)
;

in_top3:long | not_in_top3:long | total:long
3            | 97               | 100
;


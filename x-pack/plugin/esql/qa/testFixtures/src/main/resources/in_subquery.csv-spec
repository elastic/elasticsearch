nestedInSubqueriesEachContainingFork
required_capability: where_in_subquery_without_view
required_capability: fork_inside_in_subquery_fix
required_capability: fork_v9

// Each IN subquery is its own query scope; FORKs in separate subquery scopes must not conflict.
// Inner subquery: FORKs to produce salaries > 74000 from both branches (duplicates are harmless for IN).
// Outer subquery: filters to employees whose salary is in that set, then FORKs to produce emp_nos
//                 (both branches identical so LIMIT 2 gives emp_nos 10007 and 10029).
FROM employees
| WHERE emp_no IN (
    FROM employees
    | WHERE salary IN (
        FROM employees
        | FORK (WHERE salary > 74000) (WHERE salary > 74000)
        | KEEP salary
    )
    | SORT emp_no
    | LIMIT 2
    | FORK (WHERE emp_no IS NOT NULL) (WHERE emp_no IS NOT NULL)
    | KEEP emp_no
)
| SORT emp_no
| KEEP emp_no
;

emp_no:integer
10007
10029
;

forkOutsideWithNestedInSubqueriesEachContainingFork
required_capability: where_in_subquery_without_view
required_capability: fork_inside_in_subquery_fix
required_capability: fork_v9

// Combines an outer FORK (outside the IN subquery) with nested IN subqueries where each has its own FORK.
// Innermost subquery: FORK produces salaries > 74000 -> IN set = {74572, 74999, 74970}.
// Outer subquery: employees with those salaries = {10007, 10029, 10045}; FORK (both branches same) -> IN set = {10007, 10029, 10045}.
// Outermost FORK: branch1 keeps emp_no <= 10010 (only 10007), branch2 keeps emp_no > 10040 (only 10045).
FROM employees
| WHERE emp_no IN (
    FROM employees
    | WHERE salary IN (
        FROM employees
        | FORK (WHERE salary > 74000) (WHERE salary > 74000)
        | KEEP salary
    )
    | FORK (WHERE emp_no IS NOT NULL) (WHERE emp_no IS NOT NULL)
    | KEEP emp_no
)
| FORK (WHERE emp_no <= 10010 | KEEP emp_no)
       (WHERE emp_no > 10040  | KEEP emp_no)
| SORT emp_no, _fork
| KEEP emp_no, _fork
;

emp_no:integer | _fork:keyword
10007          | fork1
10045          | fork2
;

forkWithForkInsideInSubqueryInBranch
required_capability: where_in_subquery_without_view
required_capability: fork_inside_in_subquery_fix
required_capability: fork_v9

// Outer FORK whose first branch uses an IN subquery that itself contains a FORK.
// Branch 1: employees whose emp_no is in the set produced by the inner FORK (salary > 74000 from both branches).
// Branch 2: employees with salary < 30000 (plain filter, no FORK in its subquery).
FROM employees
| FORK (WHERE emp_no IN (FROM employees | FORK (WHERE salary > 74000) (WHERE salary > 74000) | KEEP emp_no) | KEEP emp_no, salary)
       (WHERE emp_no IN (FROM employees | WHERE salary < 30000 | KEEP emp_no) | KEEP emp_no, salary)
| SORT emp_no, _fork
| KEEP emp_no, salary, _fork
| LIMIT 5
;

emp_no:integer | salary:integer | _fork:keyword
10007          | 74572          | fork1
10015          | 25324          | fork2
10026          | 28336          | fork2
10029          | 74999          | fork1
10035          | 25945          | fork2
;

notInSubqueryContainingFork
required_capability: where_in_subquery_without_view
required_capability: fork_inside_in_subquery_fix
required_capability: fork_v9

// The NOT IN subquery itself contains a FORK; the FORK is in a separate subquery scope and must not conflict.
// The FORK produces the set of emp_nos with salary > 74000 = {10007, 10029, 10045}; NOT IN gives 97 employees.
FROM employees
| WHERE emp_no NOT IN (
    FROM employees
    | FORK (WHERE salary > 74000) (WHERE salary > 74000)
    | KEEP emp_no
)
| STATS c = COUNT(*)
;

c:long
97
;

conjunctiveInSubqueriesContainingFork
required_capability: where_in_subquery_without_view
required_capability: fork_inside_in_subquery_fix
required_capability: fork_v9

// Both IN/NOT IN subqueries contain a FORK. Results match the plain (no-FORK) version since each FORK
// uses identical branches that produce the same set.
// NOT IN: languages IN (1,2); IN: salary > 70000; AND languages > 0 -> {10007, 10045, 10097}.
FROM employees
| WHERE emp_no NOT IN (
      FROM employees
      | FORK (WHERE languages IN (1, 2)) (WHERE languages IN (1, 2))
      | KEEP emp_no
  ) AND emp_no IN (
      FROM employees
      | FORK (WHERE salary > 70000) (WHERE salary > 70000)
      | KEEP emp_no
  ) AND languages > 0
| SORT emp_no
| KEEP emp_no, languages, salary
;

emp_no:integer | languages:integer | salary:integer
10007          | 4                 | 74572
10045          | 3                 | 74970
10097          | 3                 | 71165
;

disjunctiveInSubqueriesContainingFork
required_capability: where_in_subquery_without_view
required_capability: fork_inside_in_subquery_fix
required_capability: fork_v9

// Both OR-joined IN subqueries contain a FORK; the union of the two sets gives the final result.
// Set 1 (salary > 74000): {10007, 10029, 10045}. Set 2 (first 3 by emp_no): {10001, 10002, 10003}.
FROM employees
| WHERE emp_no IN (
      FROM employees
      | FORK (WHERE salary > 74000) (WHERE salary > 74000)
      | KEEP emp_no
  ) OR emp_no IN (
      FROM employees
      | SORT emp_no
      | LIMIT 3
      | FORK (WHERE true) (WHERE true)
      | KEEP emp_no
  )
| SORT emp_no
| KEEP emp_no
;

emp_no:integer
10001
10002
10003
10007
10029
10045
;

inSubqueryDeeplyNestedInExpressionsBoolean
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null
required_capability: where_in_subquery_with_case_coalesce_is_null_deeply_nested

// The CASE and COALESCE comparisons narrow the result to the first 8 employees.
// Both IS [NOT] NULL comparisons are true for every non-null emp_no because their RHS keys contain no nulls.
FROM employees
| WHERE CASE(emp_no IN (FROM employees | SORT emp_no ASC | LIMIT 10 | KEEP emp_no), true, false) == true
    AND COALESCE(emp_no IN (FROM employees | SORT emp_no ASC | LIMIT 8 | KEEP emp_no), false) != false
    AND ((emp_no IN (FROM employees | SORT emp_no ASC | LIMIT 6 | KEEP emp_no)) IS NULL) == false
    AND ((emp_no IN (FROM employees | SORT emp_no ASC | LIMIT 4 | KEEP emp_no)) IS NOT NULL) != false
| STATS c = COUNT(*)
;

c:long
8
;


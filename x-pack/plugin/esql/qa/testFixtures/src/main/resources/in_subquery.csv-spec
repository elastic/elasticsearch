  (FROM employees | KEEP emp_no, first_name, salary),
  (FROM employees_incompatible | EVAL emp_no = emp_no::integer | KEEP emp_no, first_name, salary)
| EVAL salary = salary::long
| WHERE salary IN (FROM employees_incompatible | SORT salary DESC | LIMIT 3 | KEEP salary)
| STATS cnt = COUNT(*) BY salary
| SORT salary DESC
| KEEP salary, cnt
;

salary:long | cnt:long
74999       | 2
74970       | 2
74572       | 2
;


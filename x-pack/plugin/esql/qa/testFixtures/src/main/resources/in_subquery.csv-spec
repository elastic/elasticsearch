forkBeforeInSubquery
required_capability: where_in_subquery_without_view
required_capability: fork_v9
required_capability: where_in_subquery_fork_unknown_column_fix

FROM employees
| FORK
    (WHERE salary > 70000 | KEEP emp_no, first_name)
    (WHERE salary < 30000 | KEEP emp_no, first_name)
| WHERE _fork == "fork1"
| DROP _fork
| WHERE emp_no IN (
    FROM employees
    | WHERE last_name LIKE "Z*"
    | KEEP emp_no
  )
| SORT emp_no
| KEEP emp_no, first_name
| LIMIT 5
;

emp_no:integer | first_name:keyword
10007          | Tzvetan
;

forkBeforeNotInSubqueryWithGrokInsideSubquery
required_capability: where_in_subquery_without_view
required_capability: fork_v9
required_capability: where_in_subquery_fork_unknown_column_fix

FROM employees
| FORK
    (WHERE salary > 70000 | KEEP emp_no, first_name)
    (WHERE salary < 30000 | KEEP emp_no, first_name)
| WHERE _fork == "fork1"
| DROP _fork
| WHERE first_name NOT IN (
    FROM employees
    | GROK CONCAT(first_name, " ", last_name) "%{WORD:a} %{WORD:b}"
    | WHERE b LIKE "Z*"
    | KEEP a
  )
| SORT emp_no
| KEEP emp_no, first_name
| LIMIT 5
;

emp_no:integer | first_name:keyword
10019          | Lillian
10027          | Divier
10029          | Otmar
10045          | Moss
10097          | Remzi
;


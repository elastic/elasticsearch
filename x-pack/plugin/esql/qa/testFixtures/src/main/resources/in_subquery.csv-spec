statsWhereInSubqueryWithRowAsSourceNestedInFunctions
required_capability: subquery_with_row
required_capability: stats_where_in_subquery

FROM employees
| STATS c1 = COUNT(*) WHERE CASE(emp_no IN (ROW x = 10001 | KEEP x), true, false),
        c2 = COUNT(*) WHERE COALESCE(emp_no IN (ROW x = 10002 | KEEP x), false),
        c3 = COUNT(*) WHERE (emp_no IN (ROW x = 10003 | KEEP x)) IS NOT NULL,
        c4 = COUNT(*) WHERE (emp_no IN (ROW x = 99999 | KEEP x)) IS NULL,
        c5 = COUNT(*) WHERE (emp_no IN (ROW x = 10004 | KEEP x)) IS NULL
;

c1:long | c2:long | c3:long | c4:long | c5:long
1       | 1       | 100     | 0       | 0
;


// ===================================================================
// Null-semantics tests for CASE/COALESCE/IS NULL with IN subquery
// ===================================================================
//
// A MarkJoin mark can be:
//   TRUE  – LHS matches an RHS value
//   FALSE – LHS does not match AND RHS has no NULLs in the key column
//   NULL  – LHS does not match AND RHS has at least one NULL in the key column
//           OR the LHS value itself is NULL
//
// The tests below explore how CASE, COALESCE, and IS [NOT] NULL each
// treat FALSE marks vs NULL marks differently.

// ----------------------------------------------------------
// Group 1: RHS contains NULLs → all marks are NULL
//
// `emp_no IN (FROM employees | KEEP languages)`:
//   emp_no is 10001-10100; language values are 1-5.  No emp_no matches
//   any language value.  Because the languages column has 10 NULLs,
//   every mark is NULL (no match + NULLs present in RHS).
// ----------------------------------------------------------

inSubqueryWithRHSContainingNullsNoMatchingInsideIsNull
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// IS NULL of a NULL mark is TRUE, so all 100 employees pass
FROM employees
| WHERE (emp_no IN (FROM employees | KEEP languages)) IS NULL
| STATS c = COUNT(*)
;

c:long
100
;

inSubqueryWithRHSContainingNullsNoMatchingInsideIsNotNull
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// IS NOT NULL of a NULL mark is FALSE, so no employees pass
FROM employees
| WHERE (emp_no IN (FROM employees | KEEP languages)) IS NOT NULL
| STATS c = COUNT(*)
;

c:long
0
;

inSubqueryWithRHSContainingNullsNoMatchingInsideCoalesce
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// COALESCE(NULL mark, false) = false, so no employees pass
FROM employees
| WHERE COALESCE(emp_no IN (FROM employees | KEEP languages), false)
| STATS c = COUNT(*)
;

c:long
0
;

inSubqueryWithRHSContainingNullsNoMatchingInsideCase
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// CASE(NULL mark, true, false) uses the ELSE arm → false, so no employees pass
FROM employees
| WHERE CASE(emp_no IN (FROM employees | KEEP languages), true, false)
| STATS c = COUNT(*)
;

c:long
0
;

// ----------------------------------------------------------
// Group 2: LHS is NULL → mark is NULL even when RHS has no NULLs
//
// `languages IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no)`:
//   LHS is `languages`: 90 employees have non-null language values (1-5),
//   10 have null.  RHS = {10001, 10002, 10003} (no NULLs).
//   Non-null language values (1-5) cannot match {10001,10002,10003}
//   and no NULLs are present in the RHS → mark = FALSE for those 90.
//   Null language values: NULL IN {10001,10002,10003} = NULL → mark = NULL.
//
// IS [NOT] NULL and COALESCE each distinguish FALSE marks from NULL marks,
// enabling precise control over how null LHS values are handled.
// ----------------------------------------------------------

inSubqueryWithLHSContainingNullsNoMatchingInsideIsNull
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// IS NULL(FALSE) = FALSE for non-null-language employees (90)
// IS NULL(NULL)  = TRUE  for null-language employees (10)
FROM employees
| WHERE (languages IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no)) IS NULL
| STATS c = COUNT(*)
;

c:long
10
;

inSubqueryWithLHSContainingNullsNoMatchingInsideIsNotNull
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_case_coalesce_is_null

// IS NOT NULL(FALSE) = TRUE  for non-null-language employees (90)
// IS NOT NULL(NULL)  = FALSE for null-language employees (10)
FROM employees
| WHERE (languages IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no)) IS NOT NULL
| STATS c = COUNT(*)
;

c:long
90
;


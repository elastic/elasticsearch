99
;

mainRowSubqueryFrom
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

ROW emp_no = 10001, salary = 57305
| WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no, salary)
| KEEP emp_no, salary
;

emp_no:integer | salary:integer
10001          | 57305
;

multiColumnInSubqueryRepeatedConstants
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

ROW x = 1, y = 1
| WHERE (x, y) IN (FROM employees | EVAL one = 1 | KEEP languages, one)
;

x:integer | y:integer
1         | 1
;

// ======== FORK patterns ========

forkBeforeMultiColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: fork_v9

FROM employees
| FORK
    (WHERE salary > 70000 | KEEP emp_no, first_name, salary, languages)
    (WHERE salary < 30000 | KEEP emp_no, first_name, salary, languages)
| WHERE _fork == "fork1"
| DROP _fork
| WHERE (emp_no, salary) IN (
    FROM employees
    | WHERE languages == 4
    | KEEP emp_no, salary
  )
| SORT emp_no
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10007          | Tzvetan            | 74572
;

forkBeforeMultiColumnWithDisjunctiveInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: fork_v9

FROM employees
| FORK
    (WHERE salary > 70000 | KEEP emp_no, first_name, salary, languages)
    (WHERE salary < 30000 | KEEP emp_no, first_name, salary, languages)
| WHERE _fork == "fork1"
| DROP _fork
| WHERE (emp_no, salary) IN (
    FROM employees
    | WHERE languages == 4
    | KEEP emp_no, salary
  ) OR salary > 74000
| SORT emp_no
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10007          | Tzvetan            | 74572
10029          | Otmar              | 74999
10045          | Moss               | 74970
;

multiColumnInSubqueryBeforeFork
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: fork_v9

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 10 | KEEP emp_no, salary)
| FORK
    (WHERE salary > 60000 | SORT emp_no | KEEP emp_no, first_name, salary)
    (WHERE salary <= 60000 | SORT emp_no | KEEP emp_no, first_name, salary)
| SORT _fork, emp_no
;

emp_no:integer | first_name:keyword | salary:integer | _fork:keyword
10003          | Parto              | 61805          | fork1
10005          | Kyoichi            | 63528          | fork1
10006          | Anneke             | 60335          | fork1
10007          | Tzvetan            | 74572          | fork1
10009          | Sumant             | 66174          | fork1
10001          | Georgi             | 57305          | fork2
10002          | Bezalel            | 56371          | fork2
10004          | Chirstian          | 36174          | fork2
10008          | Saniya             | 43906          | fork2
10010          | Duangkaew          | 45797          | fork2
;

forkInsideMultiColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: fork_v9

FROM employees
| WHERE (emp_no, salary) IN (
    FROM employees
    | FORK
        (WHERE last_name LIKE "Z*")
        (WHERE last_name LIKE "A*")
    | WHERE _fork == "fork1"
    | KEEP emp_no, salary
  )
| SORT emp_no
| KEEP emp_no, first_name, salary
;

// fork1 (last_name LIKE "Z*") matches Zielinski, Zockler, Zschoche
emp_no:integer | first_name:keyword | salary:integer
10007          | Tzvetan            | 74572
10053          | Sanjiv             | 54462
10083          | Vishv              | 39110
;

// ======== FROM subquery patterns ========

fromSubqueryBeforeMultiColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM
  (FROM employees | WHERE salary > 70000 | KEEP emp_no, salary, first_name),
  (FROM employees | WHERE salary < 30000 | KEEP emp_no, salary, first_name)
| WHERE (emp_no, salary) IN (
    FROM employees
    | WHERE languages == 4
    | SORT emp_no ASC
    | LIMIT 5
    | KEEP emp_no, salary
  )
| SORT emp_no
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10007          | Tzvetan            | 74572
;

multiColumnInSubqueryInsideFromSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM
  (FROM employees
   | WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no, salary)
   | KEEP emp_no, first_name, salary),
  (FROM employees
   | WHERE (emp_no, salary) IN (FROM employees | SORT emp_no DESC | LIMIT 3 | KEEP emp_no, salary)
   | KEEP emp_no, first_name, salary)
| SORT emp_no
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10001          | Georgi             | 57305
10002          | Bezalel            | 56371
10003          | Parto              | 61805
10098          | Sreekrishna        | 44817
10099          | Valter             | 73578
10100          | Hironobu           | 68431
;

// ======== LOOKUP JOIN patterns ========

lookupJoinBeforeMultiColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: join_lookup_v12

FROM employees
| EVAL language_code = languages
| LOOKUP JOIN languages_lookup ON language_code
| WHERE (emp_no, language_name) IN (
    FROM employees
    | EVAL language_code = languages
    | LOOKUP JOIN languages_lookup ON language_code
    | SORT emp_no ASC
    | LIMIT 3
    | KEEP emp_no, language_name
  )
| SORT emp_no
| KEEP emp_no, first_name, language_name
;

emp_no:integer | first_name:keyword | language_name:keyword
10001          | Georgi             | French
10003          | Parto              | German
;

multiColumnInSubqueryWithLookupJoinInsideSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: join_lookup_v12

FROM employees
| WHERE (emp_no, languages) IN (
    FROM employees
    | EVAL language_code = languages
    | LOOKUP JOIN languages_lookup ON language_code
    | WHERE language_name == "German"
    | KEEP emp_no, languages
  )
| SORT emp_no
| KEEP emp_no, first_name, languages
| LIMIT 3
;

emp_no:integer | first_name:keyword | languages:integer
10003          | Parto              | 4
10007          | Tzvetan            | 4
10010          | Duangkaew          | 4
;

lookupJoinAfterMultiColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: join_lookup_v12

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no, salary)
| EVAL language_code = languages
| LOOKUP JOIN languages_lookup ON language_code
| SORT emp_no
| KEEP emp_no, first_name, salary, language_name
;

emp_no:integer | first_name:keyword | salary:integer | language_name:keyword
10001          | Georgi             | 57305          | French
10002          | Bezalel            | 56371          | null
10003          | Parto              | 61805          | German
;

multiColumnInSubqueryWithLookupJoinInsideAndAfter
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: join_lookup_v12

FROM employees
| WHERE (emp_no, languages) IN (
    FROM employees
    | EVAL language_code = languages
    | LOOKUP JOIN languages_lookup ON language_code
    | WHERE language_name == "German"
    | KEEP emp_no, languages
  )
| EVAL language_code = languages
| LOOKUP JOIN languages_lookup ON language_code
| STATS cnt = COUNT(*) BY language_name
;

cnt:long | language_name:keyword
18       | German
;

// ======== TS source combinations (FROM main + TS subquery) ========

mainFromMultiColumnInSubqueryTs
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_ts
required_capability: ts_command_v0

FROM employees
| EVAL cluster = "qa", pod = "two"
| WHERE (cluster, pod) IN (
    TS k8s
    | STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster, pod
    | KEEP cluster, pod
  )
| STATS cnt = COUNT(*)
;

cnt:long
100
;

mainFromMultiColumnNotInSubqueryTs
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_ts
required_capability: ts_command_v0

FROM employees
| EVAL cluster = "missing_cluster", pod = "missing_pod"
| WHERE (cluster, pod) NOT IN (
    TS k8s
    | STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster, pod
    | KEEP cluster, pod
  )
| STATS cnt = COUNT(*)
;

cnt:long
100
;

mainFromMultiColumnInSubqueryTsConjunctive
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_ts
required_capability: ts_command_v0

FROM employees
| EVAL cluster = "qa", pod = "two"
| WHERE (cluster, pod) IN (
    TS k8s
    | STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster, pod
    | WHERE max_bytes > 8000
    | KEEP cluster, pod
  )
  AND salary > 70000
| STATS cnt = COUNT(*)
;

cnt:long
8
;

mainFromMultiColumnInSubqueryTsWithMaxOverTime
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_ts
required_capability: ts_command_v0

FROM employees
| EVAL cluster = "prod", pod = "one"
| WHERE (cluster, pod) IN (
    TS k8s
    | STATS m = max(max_over_time(network.bytes_in)) BY cluster, pod
    | WHERE m > 0
    | KEEP cluster, pod
  )
| SORT emp_no
| KEEP emp_no, first_name
| LIMIT 3
;

emp_no:integer | first_name:keyword
10001          | Georgi
10002          | Bezalel
10003          | Parto
;


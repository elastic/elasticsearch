multiColumnInSubqueryWithOneMultiValuedFieldWithoutMvExpandWithStats
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// both left and right sides join keys have multi-valued fields, expect warning for multi-value
FROM employees
| WHERE (emp_no, job_positions) IN (FROM employees | KEEP emp_no, job_positions)
| STATS cnt = COUNT(*)
;

warningRegex:.*evaluation of \[\(emp_no, job_positions\) IN \(FROM .*employees.*\|.*KEEP emp_no, job_positions.*\)\] failed.*
warningRegex:.*java\.lang\.IllegalArgumentException: single-value function encountered multi-value

cnt:long

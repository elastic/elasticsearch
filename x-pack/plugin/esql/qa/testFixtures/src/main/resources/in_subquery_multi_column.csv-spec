required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// Every left-side tuple is (NULL, NULL), while the right side contains a known tuple. NOT IN is
// UNKNOWN for every row, so the NULL left keys must not pass the filter.
FROM employees
| EVAL emp_no = null::integer, job_positions = null::keyword
| WHERE (emp_no, job_positions) NOT IN (FROM employees
                                        | WHERE emp_no == 10002
                                        | KEEP emp_no, job_positions)
| KEEP first_name
;


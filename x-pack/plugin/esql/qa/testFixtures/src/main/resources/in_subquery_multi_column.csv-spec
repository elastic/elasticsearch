10002          | Bezalel            | Simmel
;

multiColumnNotInSubqueryStringColumns
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (first_name, last_name) NOT IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP first_name, last_name)
| SORT emp_no

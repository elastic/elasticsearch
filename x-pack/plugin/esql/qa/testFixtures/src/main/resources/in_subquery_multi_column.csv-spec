// ======== constant / ROW subqueries ========

multiColumnInSubqueryWithRow
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_row

FROM employees
| WHERE (emp_no, salary) IN (ROW emp_no = 10001, salary = 57305)
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10001          | Georgi             | 57305
;

multiColumnInSubqueryWithRowNoMatch
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_row

FROM employees
| WHERE (emp_no, salary) IN (ROW emp_no = 10001, salary = 57306)
| KEEP emp_no, salary
;

emp_no:integer | salary:integer
;

multiColumnNotInSubqueryWithRow
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: subquery_with_row

FROM employees
| WHERE (emp_no, salary) NOT IN (ROW emp_no = 10001, salary = 57305)
| STATS cnt = COUNT(*)
;


// ======== multi-valued field patterns ========

multiColumnInSubqueryWithOneMultiValuedFieldWithMvExpandOnBothSides
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// neither left nor right join key have multi-valued field after mv_expand, expect no warning for multi-value
FROM employees
| MV_EXPAND job_positions
| WHERE (emp_no, job_positions) IN (FROM employees
                                    | MV_EXPAND job_positions
                                    | KEEP emp_no, job_positions)
| KEEP emp_no, job_positions
| SORT emp_no, job_positions
| LIMIT 5
;

emp_no:integer | job_positions:keyword
10001          | Accountant
10001          | Senior Python Developer
10002          | Senior Team Lead
10004          | Head Human Resources
10004          | Reporting Analyst
;

multiColumnInSubqueryWithOneMultiValuedFieldWithMvExpandOnLeftSide
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// left join key has no multi-valued field after mv_expand, right join key does have multi-valued field, expect warning for multi-value
FROM employees
| MV_EXPAND job_positions
| WHERE (emp_no, job_positions) IN (FROM employees | KEEP emp_no, job_positions)
| KEEP emp_no, job_positions
| SORT emp_no, job_positions
| LIMIT 5
;

warningRegex:.*evaluation of \[\(emp_no, job_positions\) IN \(FROM .*employees.*\|.*KEEP emp_no, job_positions.*\)\] failed.*
warningRegex:.*java\.lang\.IllegalArgumentException: single-value function encountered multi-value

emp_no:integer | job_positions:keyword
10002          | Senior Team Lead
10013          | Reporting Analyst
10018          | Junior Developer
10019          | Purchase Manager
10020          | Tech Lead
;

multiColumnInSubqueryWithOneMultiValuedFieldWithMvExpandOnRightSide
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// left join key has multi-valued field, right join key has no multi-valued field after mv_expand, expect warning for multi-value
FROM employees
| WHERE (emp_no, job_positions) IN (FROM employees
                                    | MV_EXPAND job_positions
                                    | KEEP emp_no, job_positions)
| KEEP emp_no, job_positions
| SORT emp_no
| LIMIT 5
;

warningRegex:.*evaluation of \[\(emp_no, job_positions\) IN \(FROM .*employees.*\|.*KEEP emp_no, job_positions.*\)\] failed.*
warningRegex:.*java\.lang\.IllegalArgumentException: single-value function encountered multi-value


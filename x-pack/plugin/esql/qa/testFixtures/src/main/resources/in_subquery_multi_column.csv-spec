;

// Without SORT/LIMIT, the single-column subquery covers all emp_nos (CASE=true for every row).
// The multi-column subquery covers all (emp_no, languages) pairs, but for the 10 employees
// where languages IS NULL, (emp_no, null) IN (...) yields null, so COALESCE(null, false)=false.
// Those 10 employees have CASE=true but COALESCE=false and are excluded.
// The remaining 90 employees have CASE=true and COALESCE=true, so they pass.

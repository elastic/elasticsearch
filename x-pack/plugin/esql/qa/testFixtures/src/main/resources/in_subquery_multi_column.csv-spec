// CSV spec for multi-column IN and NOT IN subqueries

basicMultiColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no, salary)
| SORT emp_no
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10001          | Georgi             | 57305
10002          | Bezalel            | 56371
10003          | Parto              | 61805
;

basicMultiColumnNotInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) NOT IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no, salary)
| SORT emp_no
| KEEP emp_no, first_name
| LIMIT 3
;

emp_no:integer | first_name:keyword
10004          | Chirstian
10005          | Kyoichi
10006          | Anneke
;

multiColumnInSubqueryEmptyResults
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | WHERE salary > 100000 | KEEP emp_no, salary)
| SORT emp_no
| KEEP emp_no, salary
;

emp_no:integer | salary:integer
;

multiColumnNotInSubqueryEmptyRightSide
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) NOT IN (FROM employees | WHERE salary > 100000 | KEEP emp_no, salary)
| SORT emp_no
| KEEP emp_no, first_name
| LIMIT 3
;

emp_no:integer | first_name:keyword
10001          | Georgi
10002          | Bezalel
10003          | Parto
;

multiColumnConjunctiveInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 5 | KEEP emp_no, salary)
  AND salary > 57000
| SORT emp_no
| KEEP emp_no, first_name, salary
;

emp_no:integer | first_name:keyword | salary:integer
10001          | Georgi             | 57305
10003          | Parto              | 61805
10005          | Kyoichi            | 63528
;

multiColumnInSubqueryWithStatsInsideSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (salary, languages) IN (FROM employees | STATS m = max(salary) BY languages | KEEP m, languages)
| KEEP emp_no, salary, languages
| SORT emp_no
;

emp_no:integer | salary:integer | languages:integer
10007          | 74572          | 4
10019          | 73717          | 1
10045          | 74970          | 3
10094          | 66817          | 5
10099          | 73578          | 2
;

multiColumnInSubqueryStringColumns
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (first_name, last_name) IN (FROM employees | SORT emp_no ASC | LIMIT 2 | KEEP first_name, last_name)
| SORT emp_no
| KEEP emp_no, first_name, last_name
;

emp_no:integer | first_name:keyword | last_name:keyword
10001          | Georgi             | Facello
10002          | Bezalel            | Simmel
;

multiColumnNotInSubqueryStringColumns
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (first_name, last_name) NOT IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP first_name, last_name)
| SORT emp_no
| KEEP emp_no, first_name, last_name
| LIMIT 3
;

emp_no:integer | first_name:keyword | last_name:keyword
10004          | Chirstian          | Koblick
10005          | Kyoichi            | Maliniak
10006          | Anneke             | Preusig
;

multiColumnDisjunctiveInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 2 | KEEP emp_no, salary)
   OR languages == 1
| SORT emp_no
| KEEP emp_no, first_name, salary, languages
| LIMIT 5
;

emp_no:integer | first_name:keyword | salary:integer | languages:integer
10001          | Georgi             | 57305          | 2
10002          | Bezalel            | 56371          | 5
10005          | Kyoichi            | 63528          | 1
10009          | Sumant             | 66174          | 1
10013          | Eberhardt          | 48735          | 1
;

threeColumnInSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary, languages) IN (FROM employees | SORT emp_no ASC | LIMIT 3 | KEEP emp_no, salary, languages)
| SORT emp_no
| KEEP emp_no, first_name, salary, languages
;

emp_no:integer | first_name:keyword | salary:integer | languages:integer
10001          | Georgi             | 57305          | 2
10002          | Bezalel            | 56371          | 5
10003          | Parto              | 61805          | 4
;

multiColumnInSubqueryWithStatsInMainQuery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) IN (FROM employees | KEEP emp_no, salary)
| STATS cnt = COUNT(*)
;

cnt:long
100
;

multiColumnNotInSubqueryWithStatsInMainQuery
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

FROM employees
| WHERE (emp_no, salary) NOT IN (FROM employees | SORT emp_no ASC | LIMIT 10 | KEEP emp_no, salary)
| STATS cnt = COUNT(*)
;

cnt:long

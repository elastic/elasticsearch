multiColumnNotInSubqueryWithOnlyPartialNullRightTuples
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// emp_no 10001 has a multi-valued job_positions field. After the right-side join-key conversion,
// the subquery contributes (10001, NULL). This makes a row comparison UNKNOWN only when all
// non-NULL components match; every other left tuple is a definite mismatch and must survive NOT IN.
FROM employees
| WHERE (emp_no, job_positions) NOT IN (FROM employees
                                        | WHERE emp_no == 10001
                                        | KEEP emp_no, job_positions)
| SORT emp_no
| KEEP emp_no, job_positions
| LIMIT 3
;


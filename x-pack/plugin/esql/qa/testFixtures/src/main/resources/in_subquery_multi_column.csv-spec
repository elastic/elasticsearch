FROM employees
| EVAL cluster = "qa", pod = "three"
| EVAL is_match = (cluster, pod) IN (TS k8s
                                     | STATS m = max(rate(network.total_bytes_in)) BY cluster, pod
                                     | WHERE m > 10
                                     | KEEP cluster, pod)
| STATS c = COUNT(*) BY is_match
| SORT is_match
;

c:long | is_match:boolean
100    | false
;


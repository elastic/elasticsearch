multiColumnInSubqueryWithEntirelyNullLeftAndRightTuples
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// Both sides produce (NULL, NULL). MarkJoin must produce a NULL mark, which COALESCE turns into
// TRUE; this verifies the combined all-NULL case without relying on IS NULL.
FROM employees
| EVAL emp_no = null::integer, job_positions = null::keyword
| WHERE COALESCE(
    (emp_no, job_positions) IN (FROM employees
                                | EVAL emp_no = null::integer, job_positions = null::keyword
                                | KEEP emp_no, job_positions),
    true)
| STATS cnt = COUNT(*)
;

cnt:long
100
;

multiColumnInSubqueryWithEntirelyNullRightTuple
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// Every right-side tuple is (NULL, NULL). A multi-column IN comparison is never TRUE, so the
// all-null right-side short circuit should return no rows.
FROM employees
| WHERE (emp_no, job_positions) IN (FROM employees
                                    | EVAL emp_no = null::integer, job_positions = null::keyword
                                    | KEEP emp_no, job_positions)
| KEEP emp_no, first_name
;


required_capability: eval_in_subquery

FROM employees
| EVAL m = (emp_no, salary) IN (FROM employees
                                | SORT emp_no ASC
                                | LIMIT 3
                                | KEEP emp_no, salary)
| WHERE m
| SORT emp_no
| KEEP emp_no
;

emp_no:integer
10001
10002
10003
;

multiColumnInSubqueryNestedInCaseInEval
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery
required_capability: eval_in_subquery

FROM employees
| EVAL m = CASE((emp_no, salary) IN (FROM employees | SORT emp_no ASC | LIMIT 1 | KEEP emp_no, salary), "yes", "no")
| WHERE emp_no <= 10003
| SORT emp_no
| KEEP emp_no, m
;

emp_no:integer | m:keyword
10001          | yes
10002          | no
10003          | no
;


multiColumnNotInSubqueryMarkJoinWithOnlyPartialNullRightTuples
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// The OR forces a MarkJoin. The subquery contributes (10001, NULL) because job_positions is
// multi-valued for emp_no 10001. NOT IN is TRUE for definite row mismatches, so rows not selected
// by the explicit OR branch must still be retained.
FROM employees
| WHERE (emp_no, job_positions) NOT IN (FROM employees
                                        | WHERE emp_no == 10001
                                        | KEEP emp_no, job_positions)
    OR emp_no == 10003
| SORT emp_no
| KEEP emp_no, job_positions
| LIMIT 3
;


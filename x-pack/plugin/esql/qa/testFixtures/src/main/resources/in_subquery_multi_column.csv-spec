multiColumnInSubqueryWithTwoMultiValuedFieldsWithMvExpandOnBothSides
required_capability: where_in_subquery_without_view
required_capability: where_in_multi_column_subquery

// neither left nor right join key have multi-valued field after mv_expand, expect no warning for multi-value
FROM employees
| MV_EXPAND job_positions
| MV_EXPAND is_rehired
| WHERE (emp_no, job_positions, is_rehired) IN (FROM employees
                                                | MV_EXPAND job_positions
                                                | MV_EXPAND is_rehired
                                                | KEEP emp_no, job_positions, is_rehired)
| KEEP emp_no, job_positions, is_rehired
| SORT emp_no, job_positions, is_rehired
| LIMIT 5
;


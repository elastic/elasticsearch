whereInSubqueryReferencingTSSubqueryWithInSubqueryInStatsWhere
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_ts
required_capability: subquery_with_ts
required_capability: ts_command_v0
required_capability: stats_where_in_subquery

// The WHERE command's IN subquery contains a rate() aggregation whose inline
// filter uses a nested IN subquery: rates are computed for {prod, qa} only
// (prod 8.72, qa 13.17), the r > 10 filter keeps {qa}, and the outer query
// counts all 100 employees whose synthetic cluster is "qa".
FROM employees
| EVAL cluster = "qa"
| WHERE cluster IN (TS k8s
                    | STATS r = max(rate(network.total_bytes_in))
                              WHERE cluster IN (TS k8s
                                                | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                                                | WHERE mb > 10000
                                                | KEEP cluster)
                      BY cluster
                    | WHERE r > 10
                    | KEEP cluster)
| STATS cnt = COUNT(*)
;

cnt:long
100
;


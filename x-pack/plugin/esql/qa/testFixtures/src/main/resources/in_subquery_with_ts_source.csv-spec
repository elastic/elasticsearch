// A disjunctive IN subquery in the WHERE command (keeps qa via the subquery
// and staging via the equality) feeding a STATS whose aggregate filter uses
// its own IN subquery ({prod, qa}): staging survives the pre-filter but its
// aggregate sees no rows.
TS k8s
| WHERE cluster IN (TS k8s
                    | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                    | WHERE mb > 10500
                    | KEEP cluster)
    OR cluster == "staging"
| STATS max_bytes = max(to_long(network.total_bytes_in)) 
          WHERE cluster IN (TS k8s
                            | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                            | WHERE mb > 10000
                            | KEEP cluster)
  BY cluster
| SORT cluster
;

max_bytes:long | cluster:keyword
10797          | qa
null           | staging
;


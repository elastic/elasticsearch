| WHERE cluster IN (
    FROM
      (FROM employees | WHERE emp_no == 10001 | EVAL selected_cluster = "prod" | KEEP selected_cluster),
      (FROM employees | WHERE emp_no == 10002 | EVAL selected_cluster = "qa" | KEEP selected_cluster)
    | KEEP selected_cluster
  )
| STATS max_bytes = MAX(TO_LONG(network.total_bytes_in)) WHERE cluster IN (
    FROM employees
    | FORK
        (WHERE emp_no == 10001 | EVAL selected_cluster = "prod" | KEEP selected_cluster)
        (WHERE emp_no == 10002 | EVAL selected_cluster = "staging" | KEEP selected_cluster)
    | KEEP selected_cluster
  ) BY cluster
| SORT cluster
;


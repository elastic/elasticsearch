// The filtered aggregate runs first (prod/qa populated, staging null), then a
// disjunctive IN subquery filters the aggregate output: qa passes the IN
// ({qa}), prod passes the comparison, and staging's null passes neither.
TS k8s
| STATS max_bytes = max(to_long(network.total_bytes_in)) 
          WHERE cluster IN (TS k8s
                            | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                            | WHERE mb > 10000
                            | KEEP cluster)
  BY cluster
| WHERE cluster IN (TS k8s
                    | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                    | WHERE mb > 10500
                    | KEEP cluster)
    OR max_bytes > 10000
| SORT cluster
;


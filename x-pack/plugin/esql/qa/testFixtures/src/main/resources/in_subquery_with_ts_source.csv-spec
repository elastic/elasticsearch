3
;

mainFromInSubqueryTsWithRate
required_capability: where_in_subquery_without_view
required_capability: subquery_with_ts
required_capability: ts_command_v0

FROM employees
| EVAL cluster = "qa"
| WHERE cluster IN (TS k8s
                    | STATS r = max(rate(network.total_bytes_in)) BY cluster
                    | WHERE r > 10
                    | KEEP cluster)
| SORT emp_no
| KEEP emp_no, first_name
| LIMIT 3
;

emp_no:integer | first_name:keyword
10001          | Georgi
10002          | Bezalel
10003          | Parto
;

// A regular FROM over the downsampled k8s time series index in the outer query,
// with a TS command over the raw k8s time series index in the subquery. The
// subquery uses time-series aggregation to pick the clusters whose peak ingest
// exceeds a threshold; the outer query then reports the downsampled buckets for
// those clusters.
mainFromTsIndexInSubqueryTs
required_capability: where_in_subquery_without_view
required_capability: subquery_with_ts
required_capability: ts_command_v0

// tag::in_subquery_with_ts[]
FROM k8s-downsampled
| WHERE cluster IN (TS k8s
                    | STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster
                    | WHERE max_bytes > 10000
                    | KEEP cluster)
| STATS buckets = COUNT(*) BY cluster
| SORT cluster
// end::in_subquery_with_ts[]
;

// tag::in_subquery_with_ts-result[]
buckets:long | cluster:keyword
9            | prod
9            | qa
// end::in_subquery_with_ts-result[]
;


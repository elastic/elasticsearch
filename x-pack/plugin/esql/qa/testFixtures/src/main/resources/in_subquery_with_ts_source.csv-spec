TS k8s
| STATS max_bytes = MAX(TO_LONG(network.total_bytes_in)) WHERE cluster IN (
    FROM employees
    | WHERE emp_no <= 10002
    | EVAL selected_cluster = CASE(emp_no == 10001, "prod", "qa")
    | KEEP selected_cluster
  ) BY cluster
| FORK
    (WHERE max_bytes IS NOT NULL)
    (WHERE max_bytes IS NULL)
| SORT cluster
| KEEP max_bytes, cluster, _fork
;


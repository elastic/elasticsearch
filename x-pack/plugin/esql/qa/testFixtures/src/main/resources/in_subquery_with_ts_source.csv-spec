TS k8s
| STATS max_bytes = MAX(TO_LONG(network.total_bytes_in)) BY cluster
| FORK
    (WHERE cluster != "staging")
    (WHERE cluster == "staging")
| STATS c = COUNT(*) WHERE cluster NOT IN (
    FROM
      (TS k8s
       | STATS max_bytes = MAX(TO_LONG(network.total_bytes_in)) BY cluster
       | WHERE cluster == "prod"
       | KEEP cluster),
      (FROM employees | WHERE false | EVAL cluster = "unused" | KEEP cluster)
    | KEEP cluster
  ),
  total = COUNT(*)
;

c:long | total:long
2      | 3
;


statsWhereInSubqueryWithTsSourceAndTimeSeriesAggNested
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_ts
required_capability: ts_command_v0
required_capability: stats_where_in_subquery

FROM employees
| EVAL cluster = CASE(gender == "M", "prod", "qa")
| STATS c1 = COUNT(*) WHERE CASE(cluster IN (TS k8s | STATS max(rate(network.total_bytes_in)) BY cluster | KEEP cluster), true, false),
        c2 = COUNT(*) WHERE COALESCE(cluster IN (TS k8s | STATS max(rate(network.total_bytes_in)) BY cluster | KEEP cluster), false),
        c3 = COUNT(*) WHERE (cluster IN (TS k8s | STATS max(rate(network.total_bytes_in)) BY cluster | KEEP cluster)) IS NOT NULL,
        c4 = COUNT(*) WHERE (cluster IN (TS k8s | STATS max(rate(network.total_bytes_in)) BY cluster | KEEP cluster)) IS NULL
;

c1:long | c2:long | c3:long | c4:long
100     | 100     | 100     | 0
;

statsWhereWithTsMainAndTsSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_ts
required_capability: ts_command_v0
required_capability: stats_where_in_subquery

TS k8s
| STATS m = MAX(network.total_bytes_in) WHERE cluster IN (TS k8s
                                                          | STATS max(rate(network.total_bytes_in)) BY cluster
                                                          | KEEP cluster) 
    BY cluster
| SORT cluster
| KEEP m, cluster
;

m:long | cluster:keyword
10277  | prod
10797  | qa
7403   | staging
;

statsWhereWithTsMainAggAfterAndTsSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_ts
required_capability: ts_command_v0
required_capability: stats_where_in_subquery

TS k8s
| STATS m = MAX(network.total_bytes_in) WHERE cluster IN (TS k8s
                                                          | STATS max(rate(network.total_bytes_in)) BY cluster
                                                          | KEEP cluster)
    BY cluster
| STATS total_max = SUM(m)
;

total_max:long
28477
;

statsWhereWithTsMainAggBeforeAndTsSubquery
required_capability: where_in_subquery_without_view
required_capability: where_in_subquery_with_ts
required_capability: ts_command_v0
required_capability: stats_where_in_subquery

TS k8s
| STATS m1 = MAX(network.total_bytes_in) BY cluster
| STATS m2 = SUM(m1) WHERE cluster IN (TS k8s
                                       | STATS max(rate(network.total_bytes_in)) BY cluster
                                       | KEEP cluster)
;

m2:long
28477
;

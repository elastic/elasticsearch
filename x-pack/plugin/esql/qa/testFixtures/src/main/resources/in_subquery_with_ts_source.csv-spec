// Two IN subqueries OR-ed inside the aggregate filter: mb > 10500 yields
// {qa} and mb < 8000 yields {staging}, so prod passes neither disjunct.
TS k8s
| STATS max_bytes = max(to_long(network.total_bytes_in)) 
          WHERE cluster IN (TS k8s
                            | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                            | WHERE mb > 10500
                            | KEEP cluster)
          OR cluster IN (TS k8s
                         | STATS mb = max(to_long(network.total_bytes_in)) BY cluster
                         | WHERE mb < 8000
                         | KEEP cluster)
  BY cluster
| SORT cluster
;

max_bytes:long | cluster:keyword
null           | prod
10797          | qa
7403           | staging
;


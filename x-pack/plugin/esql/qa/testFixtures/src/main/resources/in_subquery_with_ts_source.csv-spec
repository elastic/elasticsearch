// main query from command, subquery mixed of from/ts/row command

mainFromInSubqueryWithMixedRowFromTs
skip_flattened_rewrite: row_branch_in_from_union_inflates_recovery_scope
required_capability: where_in_subquery_without_view
required_capability: subquery_in_from_command
required_capability: subquery_with_ts
required_capability: subquery_with_row
required_capability: ts_command_v0

FROM employees
| EVAL cluster = "qa"
| WHERE cluster IN (FROM
                       (ROW cluster = "synthetic"),
                       (FROM employees | WHERE emp_no == 10001 | EVAL cluster = "from_branch" | KEEP cluster),
                       (TS k8s | STATS m = max(to_long(network.total_bytes_in)) BY cluster | WHERE m > 10000 | KEEP cluster)
                   )
| STATS cnt = COUNT(*)
;

cnt:long
100
;

// A subquery that unions three different source commands: a ROW literal, a regular
// FROM branch, and a TS branch. Each branch contributes one cluster to the matched
// set (staging from ROW, prod from FROM, qa from TS), so the outer query keeps all
// three clusters.
mainFromInSubqueryWithMixedRowFromTsForDocs
skip_flattened_rewrite: row_branch_in_from_union_inflates_recovery_scope
required_capability: where_in_subquery_without_view
required_capability: subquery_in_from_command
required_capability: subquery_with_ts
required_capability: subquery_with_row
required_capability: ts_command_v0

// tag::in_subquery_with_mixed_sources[]
FROM k8s-downsampled
| WHERE cluster IN (FROM
                       (ROW cluster = "staging"),
                       (FROM employees | WHERE emp_no == 10001 | EVAL cluster = "prod" | KEEP cluster),
                       (TS k8s
                        | STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster
                        | WHERE max_bytes > 10500
                        | KEEP cluster)
                   )
| STATS buckets = COUNT(*) BY cluster
| SORT cluster
// end::in_subquery_with_mixed_sources[]
;

// tag::in_subquery_with_mixed_sources-result[]
buckets:long | cluster:keyword
9            | prod
9            | qa
9            | staging
// end::in_subquery_with_mixed_sources-result[]
;

// main query ts command, subquery ts command

mainTsInSubqueryTs
required_capability: where_in_subquery_without_view
required_capability: subquery_with_ts
required_capability: ts_command_v0

// tag::ts_source_with_in_subquery[]
TS k8s
| WHERE cluster IN (TS k8s
                    | STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster
                    | WHERE max_bytes > 10000
                    | KEEP cluster)
| STATS max_bytes = max(to_long(network.total_bytes_in)) BY cluster
| SORT cluster
// end::ts_source_with_in_subquery[]
;

// tag::ts_source_with_in_subquery-result[]
max_bytes:long | cluster:keyword
10277          | prod
10797          | qa
// end::ts_source_with_in_subquery-result[]
;


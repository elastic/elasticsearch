// The destination refusing a row under keep_going cannot be provoked from a csv-spec, IntoIT covers it.
rowIntoIndexWithOptions
required_capability: into_command

ROW into_long = [1, 2, 3]
| MV_EXPAND into_long
| INTO into_destination_keep_going WITH {"keep_going": true}
;


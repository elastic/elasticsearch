readCounterLong
required_capability: counter_types
FROM k8s | WHERE cluster=="prod" AND pod=="two" | sort @timestamp DESC | keep @timestamp,network.bytes_in,network.total_bytes_in | limit 2;

@timestamp:datetime      | network.bytes_in:long | network.total_bytes_in:counter_long
2024-05-10T00:22:53.000Z | 812                   | 10277
2024-05-10T00:20:44.000Z | 756                   | 9465
;

readCounterDouble
required_capability: counter_types
FROM k8s | WHERE cluster=="prod" AND pod=="two" | sort @timestamp DESC | keep @timestamp,network.cost,network.total_cost | limit 2;

@timestamp:datetime      | network.cost:double | network.total_cost:counter_double 
2024-05-10T00:22:53.000Z | 10.75               | 18.375
2024-05-10T00:20:44.000Z | 7.625               | 7.625
;


castCounterDouble
required_capability: counter_types
FROM k8s | EVAL total_cost=to_double(network.total_cost) | STATS total_cost=max(total_cost) BY cluster,pod | sort total_cost DESC | limit 5;

total_cost:double | cluster:keyword | pod:keyword
144.75            | qa              | three
137.375           | staging         | three
130.625           | prod            | three
112.25            | qa              | one
108.75            | staging         | two
;

countOfCounter
required_capability: count_present_absent_counter_support
FROM k8s | STATS c = count(network.total_bytes_in);

c:long
200
;

countPresentAbsentOfCounterByCluster
required_capability: count_present_absent_counter_support
FROM k8s
| STATS c = count(network.total_cost), p = present(network.total_bytes_in), a = absent(network.total_cost) BY cluster
| SORT cluster;

c:long | p:boolean | a:boolean | cluster:keyword
61     | true      | false     | prod
82     | true      | false     | qa
57     | true      | false     | staging
;

presentAbsentOfCounterWithoutValues
required_capability: count_present_absent_counter_support
FROM k8s | WHERE cluster == "none" | STATS p = present(network.total_bytes_in), a = absent(network.total_cost);

p:boolean | a:boolean
false     | true
;

statsByCounterLong
required_capability: group_by_counters
FROM k8s | STATS events = count(*), bytes = sum(network.bytes_in) BY b = network.total_bytes_in | EVAL b = to_long(b) | SORT b | LIMIT 5;

events:long | bytes:long | b:long
1           | 3          | 3
1           | 16         | 16
1           | 17         | 17
1           | 4          | 21
1           | 131        | 152
;

statsByCounterLongMatchesGroupingByCastBaseType
required_capability: group_by_counters
FROM k8s | STATS events = count(*), bytes = sum(network.bytes_in) BY b = to_long(network.total_bytes_in) | SORT b | LIMIT 5;

events:long | bytes:long | b:long
1           | 3          | 3
1           | 16         | 16
1           | 17         | 17
1           | 4          | 21
1           | 131        | 152
;

statsByCounterDouble
required_capability: group_by_counters
FROM k8s | STATS events = count(*) BY c = network.total_cost | EVAL c = to_double(c) | SORT c | LIMIT 5;

events:long | c:double
1           | 0.625
1           | 1.375
1           | 2.625
1           | 2.875
1           | 3.0
;

statsByCounterDoubleMatchesGroupingByCastBaseType
required_capability: group_by_counters
FROM k8s | STATS events = count(*) BY c = to_double(network.total_cost) | SORT c | LIMIT 5;

events:long | c:double
1           | 0.625
1           | 1.375
1           | 2.625
1           | 2.875
1           | 3.0
;

limitByCounterLong
required_capability: group_by_counters
FROM k8s | LIMIT 1 BY network.total_bytes_in | STATS keys = count(*);

keys:long
198
;

limitByCounterLongMatchesGroupingByCastBaseType
required_capability: group_by_counters
FROM k8s | EVAL b = to_long(network.total_bytes_in) | LIMIT 1 BY b | STATS keys = count(*);

keys:long
198
;

dedupOverCounterLong
required_capability: dedup_command
required_capability: group_by_counters
FROM k8s | KEEP cluster, pod, network.total_bytes_in | DEDUP | STATS keys = count(*);

keys:long
199
;

dedupOverCounterLongMatchesGroupingByCastBaseType
required_capability: dedup_command
required_capability: group_by_counters
FROM k8s | EVAL b = to_long(network.total_bytes_in) | KEEP cluster, pod, b | DEDUP | STATS keys = count(*);

keys:long
199
;

one_rate_no_grouping
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS r = sum(rate(extra.total_bytes_in))
;
r:double
null
;

one_gauge_by_one_dimension
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS g = max(last_over_time(extra.tx)) BY cluster
| SORT cluster
| LIMIT 3
;
g:integer | cluster:keyword
;


one_rate_one_gauge_by_two_dimensions
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS r = sum(rate(extra.total_bytes_in)),
        g = max(last_over_time(extra.tx))
  BY cluster, pod
| SORT cluster, pod
| LIMIT 5
;
r:double | g:integer | cluster:keyword | pod:keyword
;


two_rates_by_three_dimensions
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS r1 = sum(rate(extra.total_bytes_in)),
        r2 = sum(rate(extra.total_bytes_out))
  BY cluster, pod, extra.cluster
| SORT cluster, pod
| LIMIT 5
;
r1:double | r2:double | cluster:keyword | pod:keyword | extra.cluster:keyword
;


two_gauges_without
skip_flattened_rewrite: without_unsupported
required_capability: disable_replace_null_rule_for_time_series
required_capability: esql_without_grouping
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS g1 = max(last_over_time(extra.tx)),
        g2 = max(last_over_time(extra.rx))
  BY WITHOUT(pod, region, extra.cluster, extra.pod, extra.proc)
| SORT g1
| LIMIT 5
;
g1:integer | g2:integer | _timeseries:keyword
;


two_rates_two_gauges
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS r1 = sum(rate(extra.total_bytes_in)),
        r2 = sum(rate(extra.total_bytes_out)),
        g1 = max(last_over_time(extra.tx)),
        g2 = max(last_over_time(extra.rx))
  BY cluster
| SORT cluster
| LIMIT 3
;
r1:double | r2:double | g1:integer | g2:integer | cluster:keyword
;

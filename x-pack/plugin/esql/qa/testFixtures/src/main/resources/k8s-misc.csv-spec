// Test against multiple indices, including one with mappings but no data.

four_rates
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS r1 = sum(rate(network.total_bytes_in)),
        r2 = sum(rate(network.total_bytes_out)),
        r3 = sum(rate(extra.total_bytes_in)),
        r4 = sum(rate(extra.total_bytes_out))
  BY cluster
| SORT cluster
| LIMIT 5
;
r1:double          | r2:double | r3:double | r4:double | cluster:keyword
24.49149357711476  | null      | null      | null      | prod
33.308519044441084 | null      | null      | null      | qa
18.610708062016123 | null      | null      | null      | staging
;

by_four_dims
required_capability: disable_replace_null_rule_for_time_series
required_capability: ts_command_v0
TS k8s, empty-k8s
| STATS r = sum(rate(network.total_bytes_in)) BY cluster, pod, extra.cluster, extra.pod
| SORT cluster, pod
| LIMIT 5
;
r:double           | cluster:keyword | pod:keyword | extra.cluster:keyword | extra.pod:keyword
8.716707021791768  | prod            | one         | null                  | null
8.434290687554395  | prod            | three       | null                  | null
7.340495867768595  | prod            | two         | null                  | null
10.649149922720246 | qa              | one         | null                  | null
9.485643970467596  | qa              | three       | null                  | null
;


// scalar-scalar tests

addition_scalar_scalar_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h sum=(1+1);

sum:double | step:datetime
2.0        | 2024-05-10T01:00:00.000Z
;

addition_scalar_scalar_promql_expanded
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_promql_scalar_constant_results
PROMQL index=k8s step=10m start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:20:00.000Z" sum=(1+1)
| SORT step;

sum:double | step:datetime
2.0        | 2024-05-10T00:00:00.000Z
2.0        | 2024-05-10T00:10:00.000Z
2.0        | 2024-05-10T00:20:00.000Z
;

addition_scalar_scalar_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_promql_scalar_constant_results
PROMQL index=k8s step=10m start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:20:00.000Z" sum=(1+1)
| TS_COLLAPSE;

sum:double         | step:datetime
[2.0, 2.0, 2.0]   | [2024-05-10T00:00:00.000Z, 2024-05-10T00:10:00.000Z, 2024-05-10T00:20:00.000Z]
;

// for TS, the analyzer rejects queries that are foldable to a constant "expected an aggregate function but found [1 + 1]"

// scalar-metric tests

multiplication_metric_scalar_ts
required_capability: ts_command_v0
required_capability: ts_stats_binary_ops
required_capability: metrics_group_by_all
TS k8s
| STATS network_in_bits = network.total_bytes_in * 8
  BY step=TBUCKET(1h)
| SORT network_in_bits DESC;

network_in_bits:long | _timeseries:keyword                                                   | step:datetime           
86376                | "{""cluster"":""qa"",""pod"":""three""}"                              | 2024-05-10T00:00:00.000Z
82216                | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"   | 2024-05-10T00:00:00.000Z

instant_sort_by_label_natural_order
required_capability: promql_command_v0
required_capability: promql_instant_query
required_capability: promql_sort_by_label
required_capability: promql_label_functions
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
// Lexicographic order would put pod10 before pod2; natural order puts pod2 first.
PROMQL index=prom-metrics-name time="2024-05-10T01:00:00.000Z" result=(sort_by_label(sum by (pod) (label_replace(label_replace(last_over_time(metrics.requests{pod=~"pod[AB]"}[5m]), "pod", "pod10", "pod", "podB"), "pod", "pod2", "pod", "podA")), "pod"));

result:double | step:datetime            | pod:keyword
10.0          | 2024-05-10T01:00:00.000Z | pod2
20.0          | 2024-05-10T01:00:00.000Z | pod10
;

instant_sort_by_label_desc_natural_order
required_capability: promql_command_v0
required_capability: promql_instant_query
required_capability: promql_sort_by_label
required_capability: promql_label_functions
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prom-metrics-name time="2024-05-10T01:00:00.000Z" result=(sort_by_label_desc(sum by (pod) (label_replace(label_replace(last_over_time(metrics.requests{pod=~"pod[AB]"}[5m]), "pod", "pod10", "pod", "podB"), "pod", "pod2", "pod", "podA")), "pod"));

result:double | step:datetime            | pod:keyword
20.0          | 2024-05-10T01:00:00.000Z | pod10
10.0          | 2024-05-10T01:00:00.000Z | pod2
;

instant_sort_by_label_missing_label_as_empty
required_capability: promql_command_v0
required_capability: promql_instant_query
required_capability: promql_sort_by_label
required_capability: promql_label_functions
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
// podC has no zone. The output column stays null; COALESCE in the sort key treats that as "" so it sorts first.
PROMQL index=prom-metrics-name time="2024-05-10T01:00:00.000Z" result=(sort_by_label(sum by (zone) (last_over_time(metrics.requests[5m])), "zone"));

result:double | step:datetime            | zone:keyword
2.0           | 2024-05-10T01:00:00.000Z | null
10.0          | 2024-05-10T01:00:00.000Z | eu
20.0          | 2024-05-10T01:00:00.000Z | us
;

instant_scalar_constant_literal
required_capability: promql_command_v0
required_capability: promql_instant_query
required_capability: fix_promql_scalar_constant_results
// folded at planning time without reading the index.
PROMQL index=k8s time="2025-01-01T00:01:00.000Z" result=(42);

result:double | step:datetime
42.0          | 2025-01-01T00:01:00.000Z
;


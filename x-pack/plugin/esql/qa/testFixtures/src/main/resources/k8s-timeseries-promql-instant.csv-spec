instant_sort_desc_nan_last
required_capability: promql_command_v0
required_capability: promql_instant_query
required_capability: promql_sort
// NaN is not null, so the missing-sample filter keeps it. The result has no extra
// column: the synthetic key used to sort NaN last is not projected.
PROMQL index=k8s time="2024-05-10T00:03:00.000Z" bytes=(sort_desc(vector(NaN)));

bytes:double | step:datetime
NaN          | 2024-05-10T00:03:00.000Z
;


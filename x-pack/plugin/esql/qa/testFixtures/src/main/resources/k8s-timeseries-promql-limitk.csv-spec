// Tests for the PromQL limitk() function.
//
// limitk(k, v) returns k arbitrary elements from the input vector, preserving full label identity.
// Unlike topk/bottomk, selection is not value-based: no sort order is implied. When k equals or
// exceeds the number of matching series, every series is returned (same guarantee as topk/bottomk
// with a large k, but without value-based ranking). When k is smaller, the returned series are the
// first k in storage (tsid) order.
//
// Reference values obtained by running against promcheck (elastic/promcheck) with Prometheus started
// with --enable-feature=promql-experimental-functions.

// k larger than the available series count: every series is returned regardless of order.
// Values match the full prod set confirmed by topk_k_exceeds_series_count and bottomk_k_exceeds_series_count.
limitk_k_exceeds_series_count
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h result=(limitk(5, network.total_bytes_in{cluster="prod"}))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
947.0         | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
9969.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""three"",""region"":[""eu"",""us""]}"
10277.0       | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
;

// k exactly equal to the series count: every series is returned.
limitk_k_equals_series_count
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h result=(limitk(3, network.total_bytes_in{cluster="prod"}))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
947.0         | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
9969.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""three"",""region"":[""eu"",""us""]}"
10277.0       | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
;

// k=0: Prometheus returns an empty result.
limitk_k_zero
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h result=(limitk(0, network.total_bytes_in{cluster="prod"}))
| SORT result;

result:double | step:datetime | _timeseries:keyword
;

// k < series count: two arbitrary series from three. ES returns the first two in tsid (storage) order:
// pod=one and pod=two come before pod=three in the tsid scan.
// Values verified by running against promcheck with --enable-feature=promql-experimental-functions.
limitk_bare
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h result=(limitk(2, network.total_bytes_in{cluster="prod"}))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
947.0         | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
10277.0       | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
;

// limitk is evaluated per step, returning the first k series at each evaluation point.
// Over a 5-minute window: at step 00:20, only pod=three has samples in that window;
// at step 00:25, pod=one and pod=two have samples. k=5 returns all available series per step.
limitk_multi_step
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
PROMQL index=k8s step=5m start="2024-05-10T00:20:00.000Z" end="2024-05-10T00:25:00.000Z" result=(limitk(5, network.total_bytes_in{cluster="prod"}))
| SORT step, result;

result:double | step:datetime            | _timeseries:keyword
9969.0        | 2024-05-10T00:20:00.000Z | "{""cluster"":""prod"",""pod"":""three"",""region"":[""eu"",""us""]}"
947.0         | 2024-05-10T00:25:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
10277.0       | 2024-05-10T00:25:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
;

// `by (pod)` partitions the limit by pod across ALL clusters. With k=5 (> 3 series per pod),
// every series is returned. Full identity (cluster, region) is preserved - no label collapse.
// Values include all 9 series (3 pods × 3 clusters), verified against promcheck.
limitk_by_grouping
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h result=(limitk(5, network.total_bytes_in) by (pod))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
947.0         | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""one"",""region"":[""eu"",""us""]}"
5187.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""pod"":""two"",""region"":""us""}"
6637.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""pod"":""one"",""region"":""us""}"
7286.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa"",""pod"":""one""}"
7403.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""pod"":""three"",""region"":""us""}"
8568.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa"",""pod"":""two""}"
9969.0        | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""three"",""region"":[""eu"",""us""]}"
10277.0       | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
10797.0       | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa"",""pod"":""three""}"
;

// limitk over an already-aggregated vector (sum by pod). The inner sum collapses the 3 prod pods to
// scalars; limitk then selects from those 3 collapsed series. k=5 returns all 3.
limitk_over_sum_by
required_capability: promql_command_v0
required_capability: promql_limitk
required_capability: fix_promql_topk_over_aggregate
required_capability: fix_promql_time_bucket_v2
PROMQL index=k8s step=1h result=(limitk(5, sum by (pod) (network.total_bytes_in{cluster="prod"})))
| SORT result;

result:double | step:datetime            | pod:keyword
947.0         | 2024-05-10T01:00:00.000Z | one
9969.0        | 2024-05-10T01:00:00.000Z | three
10277.0       | 2024-05-10T01:00:00.000Z | two
;

// Tests for PromQL `without` grouping.
// https://prometheus.io/docs/prometheus/latest/querying/operators/#group-modifiers


// ------------------------------------------------
// FUNCTIONAL
// ------------------------------------------------

sum_without_prefix_syntax
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod, region) (avg_over_time(network.cost[1h])))
| SORT result;

result:double      | step:datetime            | _timeseries:keyword
17.521233974358974 | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
18.032269021739133 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
20.76903735632184  | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
;


// Postfix form of `without`; equivalent to prefix syntax.
sum_without_postfix_syntax
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum(avg_over_time(network.cost[1h])) without (pod, region))
| SORT result;

result:double      | step:datetime            | _timeseries:keyword
17.521233974358974 | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
18.032269021739133 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
20.76903735632184  | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
;


// Accepts a trailing comma in the `without` label list.
sum_without_trailing_comma
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod, region,) (avg_over_time(network.cost[1h])))
| SORT result;

result:double      | step:datetime            | _timeseries:keyword
17.521233974358974 | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
18.032269021739133 | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
20.76903735632184  | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
;


// Excludes a single label; preserves all others.
sum_without_single_label
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod) (network.cost))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
15.875        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""region"":""us""}"
18.625        | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""region"":[""eu"",""us""]}"
26.5          | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
;


// Excludes multiple labels.
sum_without_multiple_labels
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod, region) (network.cost{cluster!="prod"}))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
15.875        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
26.5          | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
;


// Basic aggregators with `without`: sum, max, min, count.
max_without_over_average_over_time
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(max without (pod, region) (avg_over_time(network.cost[1h])))
| SORT result;

result:double     | step:datetime            | _timeseries:keyword
6.46875           | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
7.262931034482759 | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
8.375             | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
;


// Basic aggregators with `without`: sum, max, min, count.
min_without_over_average_over_time
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(min without (pod, region) (avg_over_time(network.cost[1h])))
| SORT result;

result:double      | step:datetime            | _timeseries:keyword
4.0703125          | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
5.1826923076923075 | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
6.635416666666667  | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
;


// Basic aggregators with `without`: sum, max, min, count.
count_without_over_average_over_time
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(count without (pod, region) (avg_over_time(network.cost[1h])))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
3.0           | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
3.0           | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
3.0           | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
;

// ------------------------------------------------
// EQUIVALENCE
// WITHOUT(S) <=> BY(ALL - S)
// ------------------------------------------------

// `sum by (cluster)` matches `sum without (pod, region)`.
equivalence_sum_by_cluster_matches_sum_without_pod_region
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
PROMQL index=k8s step=1h result=(sum by (cluster) (avg_over_time(network.cost[1h])))
| SORT result;

result:double      | step:datetime            | cluster:keyword
17.521233974358974 | 2024-05-10T01:00:00.000Z | staging
18.032269021739133 | 2024-05-10T01:00:00.000Z | prod
20.76903735632184  | 2024-05-10T01:00:00.000Z | qa
;


// `max by (cluster)` matches `max without (pod, region)`.
equivalence_max_by_cluster_matches_max_without_pod_region
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
PROMQL index=k8s step=1h result=(max by (cluster) (avg_over_time(network.cost[1h])))
| SORT result;

result:double     | step:datetime            | cluster:keyword
6.46875           | 2024-05-10T01:00:00.000Z | staging
7.262931034482759 | 2024-05-10T01:00:00.000Z | qa
8.375             | 2024-05-10T01:00:00.000Z | prod
;


// ------------------------------------------------
// WITHOUT(S)(AGG...)
// ------------------------------------------------

max_over_sum_without
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(max(sum without (pod, region) (avg_over_time(network.cost[1h]))));

result:double     | step:datetime
20.76903735632184 | 2024-05-10T01:00:00.000Z
;


avg_over_sum_without
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(avg(sum without (pod, region) (avg_over_time(network.cost[1h]))));

result:double      | step:datetime
18.774180117473318 | 2024-05-10T01:00:00.000Z
;


// Validates the output cardinality of `sum without (...)`.
count_over_sum_without
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(count(sum without (pod, region) (avg_over_time(network.cost[1h]))));

result:double | step:datetime
3.0           | 2024-05-10T01:00:00.000Z
;


// Applies `without` to an exact child produced by `by`.
sum_without_over_sum_by
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: fix_promql_without_output
PROMQL index=k8s step=1h result=(sum without (pod) (sum by (cluster, region, pod) (network.cost)))
| SORT result;

result:double | step:datetime            | cluster:keyword | region:keyword
15.875        | 2024-05-10T01:00:00.000Z | staging         | us
18.625        | 2024-05-10T01:00:00.000Z | prod            | [eu, us]
26.5          | 2024-05-10T01:00:00.000Z | qa              | null
;


// Applies `by` over a `without` result; `by` re-establishes exact grouping.
by_over_without_re_exactifies
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum by (cluster) (sum without (region) (sum by (cluster, region, pod) (network.cost))))
| SORT result;

result:double | step:datetime            | cluster:keyword
15.875        | 2024-05-10T01:00:00.000Z | staging
18.625        | 2024-05-10T01:00:00.000Z | prod
26.5          | 2024-05-10T01:00:00.000Z | qa
;


// Full round-trip: `by -> without -> by`.
by_over_without_over_by
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum by (cluster) (sum without (pod) (sum by (cluster, region, pod) (network.cost))))
| SORT result;

result:double | step:datetime            | cluster:keyword
15.875        | 2024-05-10T01:00:00.000Z | staging
18.625        | 2024-05-10T01:00:00.000Z | prod
26.5          | 2024-05-10T01:00:00.000Z | qa
;


// Regression: `by` on a concrete label directly over a `without`-over-selector. The inner
// `without (pod)` must surface the concrete `cluster` dimension (not only `_timeseries`) so the
// outer `by (cluster)` can group on it. If `cluster` were not pushed down to the inner aggregate
// it would be null-filled, collapsing every cluster into a single null group. Equivalent to
// `by_over_without_over_by`, whose innermost `by (cluster, region, pod)` is a per-series no-op.
by_over_without_over_selector_surfaces_label
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum by (cluster) (sum without (pod) (network.cost)))
| SORT result;

result:double | step:datetime            | cluster:keyword
15.875        | 2024-05-10T01:00:00.000Z | staging
18.625        | 2024-05-10T01:00:00.000Z | prod
26.5          | 2024-05-10T01:00:00.000Z | qa
;


// `by` cannot restore a label already removed by `without`.
by_cannot_resurrect_removed_label
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum by (region) (sum without (region) (network.cost)));

result:double | step:datetime            | region:keyword
61.0          | 2024-05-10T01:00:00.000Z | null
;


// ------------------------------------------------
// SCALAR(WITHOUT(S))
// ------------------------------------------------

// `scalar(...)` over multiple output series returns NaN.
scalar_over_sum_without_returns_nan
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: promql_scalar
PROMQL index=k8s step=1h result=(scalar(sum without (pod, region) (avg_over_time(network.cost[1h]))));

result:double | step:datetime
NaN           | 2024-05-10T01:00:00.000Z
;


// `scalar(...)` succeeds after reducing to one series.
scalar_over_max_of_without
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: promql_scalar
PROMQL index=k8s step=1h result=(scalar(max(sum without (pod, region) (avg_over_time(network.cost[1h])))));

result:double     | step:datetime
20.76903735632184 | 2024-05-10T01:00:00.000Z
;


// ------------------------------------------------
// Excluded labels must NOT appear in the _timeseries output
// ------------------------------------------------

// `without(pod)` must exclude `pod` from the _timeseries label set.
without_excludes_pod_from_timeseries
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod) (network.cost{cluster="staging"}))
| EVAL has_pod = _timeseries LIKE "*pod*"
| KEEP result, _timeseries, has_pod;

result:double | _timeseries:keyword                            | has_pod:boolean
15.875        | "{""cluster"":""staging"",""region"":""us""}"  | false
;


// `without(pod, region)` must exclude both labels from the _timeseries label set.
without_excludes_multiple_labels_from_timeseries
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod, region) (network.cost{cluster="staging"}))
| EVAL has_pod = _timeseries LIKE "*pod*", has_region = _timeseries LIKE "*region*"
| KEEP result, _timeseries, has_pod, has_region;

result:double | _timeseries:keyword         | has_pod:boolean | has_region:boolean
15.875        | "{""cluster"":""staging""}" | false           | false
;

// An outer without groups the inner without's series by the labels it leaves, not by the source's.
nested_without_over_without_by_the_inner_grain
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
required_capability: enable_tsmd_data_type
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(sum without (cluster) (max without (pod) (last_over_time(network.eth0.tx[5m]))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result, _timeseries
| SORT _timeseries;

result:double | _timeseries:keyword
472.0         | "{""region"":""us""}"
409.0         | "{""region"":[""eu"",""us""]}"
908.0         | {}
;

// without () keeps every label but the metric name, so it keeps one row per series.
by_over_empty_without_keeps_series_grain
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(avg by (cluster) (sum without () (last_over_time(network.eth0.tx[5m]))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result, cluster
| SORT cluster;

result:double | cluster:keyword
356.0         | prod
638.0         | qa
422.0         | staging
;

// A without over a by() leaves out of the by() labels only the listed ones.
without_over_by_keeps_the_by_labels_left
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(max without (pod) (sum by (cluster, pod) (last_over_time(network.eth0.tx[5m]))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result, cluster
| SORT cluster;

result:double | cluster:keyword
409.0         | prod
908.0         | qa
472.0         | staging
;

// Each without leaves out its own labels from what the level below kept.
nested_without_excludes_at_each_level
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates

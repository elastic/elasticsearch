// A without over a within-series function evaluates each series first.
nested_without_over_range_function
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
required_capability: enable_tsmd_data_type
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(max without (cluster) (sum without (pod) (avg_over_time(network.eth0.tx[5m]))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result, _timeseries
| SORT _timeseries;

result:double      | _timeseries:keyword
1001.2166666666667 | "{""region"":""us""}"
777.3333333333333  | "{""region"":[""eu"",""us""]}"
1364.175           | {}
;

without_over_by_over_without
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(max without (cluster) (avg by (cluster) (sum without (pod) (last_over_time(network.eth0.tx[5m])))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result;

result:double
1914.0
;

// A by() of a label the inner without left out groups everything under its absence.
by_over_without_of_the_by_label
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(sum by (pod) (sum without (pod) (last_over_time(network.eth0.tx[5m]))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result, pod
| SORT pod;

result:double | pod:keyword
4248.0        | null
;

// The matcher on a label a without leaves out still filters the series it reads.
nested_without_keeps_selector_filter
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without
required_capability: enable_tsmd_data_type
PROMQL index=k8s step=10m start="2024-05-10T00:00:00Z" end="2024-05-10T00:20:00Z" result=(max without (cluster) (sum without (pod) (last_over_time(network.eth0.tx{pod!="two"}[5m]))))
| WHERE step == "2024-05-10T00:10:00.000Z"
| KEEP result, _timeseries
| SORT _timeseries;

result:double | _timeseries:keyword
794.0         | "{""region"":""us""}"
770.0         | "{""region"":[""eu"",""us""]}"
1006.0        | {}
;

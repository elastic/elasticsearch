1068.0        | "{""cluster"":""prod""}"
1914.0        | "{""cluster"":""qa""}"
1266.0        | "{""cluster"":""staging""}"
;

// Leaving out a label the level below already left out changes nothing.
nested_without_of_a_label_already_left_out
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_without_grouping
required_capability: promql_nested_aggregates
required_capability: promql_nested_without

// Tests for KNN() function operating on runtime expressions (non-index-mapped dense_vector).
//
// All tests require:
//   - knn_runtime_field capability (snapshot builds only)
//   - knn_runtime_field pragma to enable the runtime execution path
//
// The knn_hex_vectors dataset stores vectors as hex strings which is converted at runtime into
// dense_vector field. It does not matter how the runtime dense_vector field is created;
// multi-valued float field was considered but the insertion order is not preserved (unless columnar mode).
// 
// Cosine similarities between to_dense_vector(emb_hex) and query [64,0,0]:
//   id=0 [64,0,0]     cosine ≈ 1.000
//   id=4 [57,29,0]    cosine ≈ 0.891
//   id=3 [45,45,0]    cosine ≈ 0.707
//   id=5 [32,39,39]   cosine ≈ 0.502
//   id=1 [0,64,0]     cosine = 0.0
//   id=2 [0,0,64]     cosine = 0.0

// Test 1: KNN on ROW data using to_dense_vector() on a hex string literal.
// The hex string "400000" decodes to bytes [64,0,0], which is the only row and
// has cosine similarity 1.0 with the query [64,0,0], so it passes the filter.
knnRuntimeOnRow
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

ROW emb_hex = "400000"
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0])
| KEEP dv
| LIMIT 10
;

dv:dense_vector
[64.0, 0.0, 0.0]
;

// Test 2: KNN on runtime field dense_vector field with no _score and no options
// With no similarity threshold all six documents pass the KNN filter; results
// are sorted by id for a deterministic output.
knnRuntimeNoScore
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

FROM knn_hex_vectors
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0])
| SORT id ASC
| KEEP id, label
| LIMIT 10
;

id:integer | label:keyword 
0          | x
1          | y
2          | z
3          | xy
4          | xz
5          | xyz
;

// Test 3: KNN on runtime field dense_vector field with _score and no options
// With no similarity threshold all six documents pass the KNN filter; scores should
// be generated based on cosine similarity.
knnRuntimeWithScore
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

FROM knn_hex_vectors metadata _score
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0])
| SORT id ASC
| KEEP id, _score
| LIMIT 10
;

id:integer | _score:double
0          | 1.0
1          | 0.5
2          | 0.5
3          | 0.8535534143447876
4          | 0.9456390142440796
5          | 0.7509205937385559
;


// Test 4: KNN on runtime field dense_vector field with sorting on _score and no options
// All six documents pass the KNN filter, but [sort + limit] limits to two highest
// scoring rows.
knnRuntimeWithSortOnScore
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

FROM knn_hex_vectors metadata _score
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0])
| SORT _score DESC
| KEEP id
| LIMIT 2
;

id:integer
0
4
;

// Test 5: KNN on runtime field dense_vector field with similarity threshold option
knnRuntimeWithSimThreshold
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

FROM knn_hex_vectors
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0], {"similarity": 0.6})
| SORT id ASC
| KEEP id
| LIMIT 10
;

id:integer
0
3
4
;

// Test 6: KNN on runtime field dense_vector field with boost option
knnRuntimeWithBoost
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

FROM knn_hex_vectors METADATA _score
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0], {"boost": 2.0})
| SORT id ASC
| KEEP id, _score
| LIMIT 10
;

id:integer | _score:double
0          | 2.0
1          | 1.0
2          | 1.0
3          | 1.7071068286895752
4          | 1.8912780284881592
5          | 1.5018411874771118
;

// Test 7: KNN on runtime field dense_vector field: combined filtering and scoring
knnRuntimeCombinedFilter
required_capability: knn_runtime_field
pragma: knn_runtime_field=true

FROM knn_hex_vectors METADATA _score
| EVAL dv = to_dense_vector(emb_hex)
| EVAL runtime_label = to_text(CONCAT(label, " some suffix"))
| WHERE knn(dv, [64, 0, 0], {"boost": 2.0}) and match(runtime_label, "xyz")
| SORT id ASC
| KEEP id, _score
| LIMIT 10
;

id:integer | _score:double
5          | 2.501841187477112
;


// Test 8: KNN on a runtime field carries no positional restriction, since it too is evaluated per row rather than
// through the index. The LIMIT keeps ids 0-3, of which 0 and 3 clear the threshold; id 4 clears it as well (see
// knnRuntimeWithSimThreshold) but is cut, so a filter evaluated before the LIMIT would return it too. The LIMIT
// also puts the filter on the coordinator, which has no shard context - scoring a runtime KNN there needs none.
knnRuntimeAfterLimit
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_anywhere
pragma: knn_runtime_field=true

FROM knn_hex_vectors METADATA _score
| EVAL dv = to_dense_vector(emb_hex)
| SORT id ASC
| LIMIT 4
| WHERE knn(dv, [64, 0, 0], {"similarity": 0.6})
| KEEP id, label, _score
| SORT id
| LIMIT 10
;

id:integer | label:keyword | _score:double
0          | x             | 1.0
3          | xy            | 0.8535534143447876
;

// Test 8: the vector_similarity option replaces the default cosine metric. Hamming counts differing bits over
// the byte encoding of each dimension and is normalized into the fraction of the 24 bits that match:
//   id=0 [64,0,0]     0 bits differ  -> 24/24 = 1.0
//   id=1 [0,64,0]     2 bits differ  -> 22/24
//   id=2 [0,0,64]     2 bits differ  -> 22/24
//   id=3 [45,45,0]    9 bits differ  -> 15/24
//   id=4 [57,29,0]    9 bits differ  -> 15/24
//   id=5 [32,39,39]  10 bits differ  -> 14/24
knnRuntimeWithHammingSimilarity
// Test 8: the vector_similarity option selects l2_norm (euclidean distance). Score is 1 / (1 + d²):
//   id=0 [64,0,0]    d=0      -> 1.0
//   id=4 [57,29,0]   d≈29.83  -> 1/(1+890) ≈ 0.001122
//   id=3 [45,45,0]   d≈48.08  -> 1/(1+2881) ≈ 0.000347 (wait, that's wrong - let me recompute)
// Euclidean distances from [64,0,0]:
//   id=0: 0                     -> score 1.0
//   id=4: sqrt((57-64)²+29²)=sqrt(49+841)=sqrt(890)≈29.83 -> score 1/(1+890) ≈ 0.001122
//   id=3: sqrt((45-64)²+45²)=sqrt(361+2025)=sqrt(2386)≈48.85 -> score 1/(1+2386) ≈ 0.000419
//   id=5: sqrt((32-64)²+39²+39²)=sqrt(1024+1521+1521)=sqrt(4066)≈63.77 -> score 1/(1+4066) ≈ 0.000246
//   id=1: sqrt(64²+64²)=sqrt(8192)≈90.51 -> score 1/(1+8192) ≈ 0.000122
//   id=2: same as id=1
knnRuntimeWithL2NormSimilarity
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_vector_similarity
pragma: knn_runtime_field=true

FROM knn_hex_vectors METADATA _score
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0], {"vector_similarity": "l2_norm"})
| SORT id ASC
| KEEP id, _score
| LIMIT 10
;

id:integer | _score:double
0          | 1.0
1          | 1.2205541733484257E-4
2          | 1.2205541733484257E-4
3          | 4.1893590634394916E-4
4          | 1.122334395865555E-3
5          | 2.458814876570497E-4
;

// Test 9: the similarity threshold is applied in the normalized score space. A l2_norm threshold of 50 keeps
// vectors within euclidean distance 50 of the query: id=0 (d=0), id=4 (d≈29.83), id=3 (d≈48.85), but not
// id=5 (d≈63.77) or id=1/id=2 (d≈90.51).
knnRuntimeWithL2NormSimilarityAndThreshold
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_vector_similarity
pragma: knn_runtime_field=true

FROM knn_hex_vectors
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0], {"vector_similarity": "l2_norm", "similarity": 50.0})
| SORT id ASC
| KEEP id
| LIMIT 10
;

id:integer
0
3
4
;

// Test 10: dot_product requires unit-length vectors. A field vector with squared magnitude != 1 triggers
// a per-row warning and is excluded; the result is empty.
knnRuntimeWithDotProductSimilarityRejectsNonUnitVectors
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_vector_similarity
pragma: knn_runtime_field=true

ROW dv = to_dense_vector([2.0, 0.0, 0.0])
| WHERE knn(dv, [1.0, 0.0, 0.0], {"vector_similarity": "dot_product"})
| KEEP dv
| LIMIT 10
;
warning:Line 2:9: evaluation of [knn(dv, [1.0, 0.0, 0.0], {\"vector_similarity\": \"dot_product\"})] failed, treating result as null. Only first 20 failures recorded.
warning:Line 2:9: java.lang.IllegalArgumentException: dot_product requires unit-length vectors but encountered squared magnitude [4.0]

dv:dense_vector
;

// Test 11: dot_product on unit-length vectors, where the score lands in [0, 1]: the vectors are 36.87
// degrees apart, so the dot product is 0.8 and the score is (1 + 0.8) / 2 = 0.9.
knnRuntimeWithDotProductSimilarityOnUnitVectors
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_vector_similarity
pragma: knn_runtime_field=true

ROW dv = to_dense_vector([0.8, 0.6, 0.0])
| WHERE knn(dv, [1.0, 0.0, 0.0], {"vector_similarity": "dot_product", "similarity": 0.5})
| KEEP dv
| LIMIT 10
;

dv:dense_vector
[0.800000011920929, 0.6000000238418579, 0.0]
;

// Test 12: max_inner_product scores as (dot_product + 1) for positive products and 1/(1-dot_product) for
// negative ones. With non-unit-length vectors the inner product can be large:
//   id=0 [64,0,0]    dp=4096  -> 4097.0
//   id=4 [57,29,0]   dp=3648  -> 3649.0
//   id=3 [45,45,0]   dp=2880  -> 2881.0
//   id=5 [32,39,39]  dp=2048  -> 2049.0
//   id=1 [0,64,0]    dp=0     -> 1.0
//   id=2 [0,0,64]    dp=0     -> 1.0
knnRuntimeWithMaxInnerProductSimilarity
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_vector_similarity
pragma: knn_runtime_field=true

FROM knn_hex_vectors METADATA _score
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0], {"vector_similarity": "max_inner_product"})
| SORT id ASC
| KEEP id, _score
| LIMIT 10
;

id:integer | _score:double
0          | 4097.0
1          | 1.0
2          | 1.0
3          | 2881.0
4          | 3649.0
5          | 2049.0
;

// Test 13: the option value is case insensitive.
knnRuntimeWithUppercaseSimilarityName
required_capability: knn_runtime_field
required_capability: fn_knn_runtime_vector_similarity
pragma: knn_runtime_field=true

FROM knn_hex_vectors
| EVAL dv = to_dense_vector(emb_hex)
| WHERE knn(dv, [64, 0, 0], {"vector_similarity": "L2_Norm", "similarity": 50.0})
| SORT id ASC
| KEEP id
| LIMIT 10
;

id:integer
0
3
4
;

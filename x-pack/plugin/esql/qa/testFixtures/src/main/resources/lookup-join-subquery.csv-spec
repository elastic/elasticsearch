indexJoinLookupSubqueryRepeatedKey
required_capability: join_lookup_v12
required_capability: lookup_join_on_subquery

FROM employees
| WHERE emp_no == 10092
| EVAL language_code = emp_no % 10
| LOOKUP JOIN (
    FROM languages_lookup_non_unique_key
    | WHERE language_code == 2
    | KEEP language_code, language_name
  ) ON language_code
| KEEP emp_no, language_code, language_name
| SORT language_name
;

emp_no:integer | language_code:integer | language_name:keyword
10092          | 2                     | German
10092          | 2                     | German
10092          | 2                     | German
10092          | 2                     | German
;

subqueryJoinLookupSubquery
required_capability: join_lookup_v12
required_capability: lookup_join_on_subquery
required_capability: subquery_in_from_command

FROM (
    FROM employees
    | WHERE emp_no == 10001
    | EVAL language_code = languages
    | KEEP emp_no, language_code
  )
| LOOKUP JOIN (
    FROM languages_lookup
    | WHERE language_code == 2
    | KEEP language_code, language_name
  ) ON language_code
| KEEP emp_no, language_code, language_name
| SORT emp_no
;

emp_no:integer | language_code:integer | language_name:keyword
10001          | 2                     | French
;

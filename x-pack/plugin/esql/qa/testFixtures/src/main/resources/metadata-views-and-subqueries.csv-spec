viewBodyDeclaresMetadataPassesThroughToOuter
required_capability: views_with_no_branching
required_capability: views_crud_as_index_actions
required_capability: outer_metadata_null_injection

FROM view_languages_meta_index METADATA _index
| SORT language_code
;

language_code:integer | language_name:keyword | _index:keyword
1                     | English               | languages
2                     | French                | languages
3                     | Spanish               | languages
4                     | German                | languages
;

// Pass-through: metadata declared in view body returns real values (not null) via outer METADATA.
// _id and _score are document-dependent so verified as non-null rather than by exact value.

viewAllMetadataInBodyPassesThrough
required_capability: views_with_no_branching
required_capability: views_crud_as_index_actions
required_capability: outer_metadata_null_injection

FROM view_languages_all_metadata METADATA _index, _id, _version, _score, _index_mode
| SORT language_code
| LIMIT 1
| EVAL has_id = _id IS NOT NULL, has_score = _score IS NOT NULL
| KEEP language_code, language_name, _index, _version, _index_mode, has_id, has_score
;

language_code:integer | language_name:keyword | _index:keyword | _version:long | _index_mode:keyword | has_id:boolean | has_score:boolean
1                     | English               | languages      | 1             | standard            | true           | true
;

// Null-injection: metadata absent from view body → null values in output rows.
// Full 8-field symmetry is implicitly verified by viewAllMetadataInBodyPassesThrough above.

viewAllMetadataNullWhenNotDeclaredInBody
required_capability: views_with_no_branching
required_capability: views_crud_as_index_actions
required_capability: outer_metadata_null_injection

FROM view_languages METADATA _index, _id, _version, _score, _index_mode
| SORT language_code
| LIMIT 1
| KEEP language_code, language_name, _index, _id, _version, _score, _index_mode
;

language_code:integer | language_name:keyword | _index:keyword | _id:keyword | _version:long | _score:double | _index_mode:keyword
1                     | English               | null           | null        | null          | null          | null
;


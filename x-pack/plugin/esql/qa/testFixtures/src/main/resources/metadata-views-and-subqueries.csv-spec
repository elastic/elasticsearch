// Null-injection: metadata absent from view body → null values in output rows.

viewAllMetadataNullWhenNotDeclaredInBody
required_capability: views_with_no_branching
required_capability: views_crud_as_index_actions
required_capability: outer_metadata_null_injection

FROM view_languages METADATA _index, _id, _version, _score, _index_mode
| SORT language_code
| LIMIT 1
| KEEP language_code, language_name, _index, _id, _version, _score, _index_mode
;

language_code:integer | language_name:keyword | _index:keyword | _id:keyword | _version:long | _score:double | _index_mode:keyword
1                     | English               | null           | null        | null          | null          | null
;


// Wildcard projections in the body: the outer METADATA request must only be applied once the body's
// output is final (after KEEP * has been expanded), otherwise analysis fails on the unresolved star.

viewBodyWithWildcardKeepDeclaresMetadataPassesThroughToOuter
required_capability: views_with_no_branching
required_capability: views_crud_as_index_actions
required_capability: outer_metadata_null_injection

FROM view_languages_meta_index_keep_star METADATA _index
| SORT language_code
;

language_code:integer | language_name:keyword | _index:keyword
1                     | English               | languages
2                     | French                | languages
3                     | Spanish               | languages
4                     | German                | languages
;


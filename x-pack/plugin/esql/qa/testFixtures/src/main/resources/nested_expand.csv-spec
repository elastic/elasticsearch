// NESTED_EXPAND over nested_orders: order 1 has items a and b and one event, order 2 has neither, order 3 has item c and two events.

expandEachObject
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| KEEP id, items.sku, items.qty
| SORT id, items.sku
;

id:keyword | items.sku:keyword | items.qty:long
1          | a                 | 1
1          | b                 | 2
2          | null              | null
3          | c                 | 5
;

filterOnChild
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| WHERE items.qty > 1
| KEEP id, items.sku
| SORT id
;

id:keyword | items.sku:keyword
1          | b
3          | c
;

filterOnParent
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| WHERE id == "1"
| KEEP id, items.sku
| SORT items.sku
;

id:keyword | items.sku:keyword
1          | a
1          | b
;

evalOnChild
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| EVAL total = items.qty * 10
| KEEP id, total
| SORT id, total
;

id:keyword | total:long
1          | 10
1          | 20
2          | null
3          | 50
;

statsAfter
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| STATS qty = SUM(items.qty), rows = COUNT(*), skus = COUNT(items.sku) BY id
| SORT id
;

qty:long | rows:long | skus:long | id:keyword
3        | 2         | 2         | 1
null     | 1         | 0         | 2
5        | 1         | 1         | 3
;

limitAfter
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| SORT items.qty DESC NULLS LAST
| LIMIT 2
| KEEP id, items.qty
;

id:keyword | items.qty:long
3          | 5
1          | 2
;

twoCollections
required_capability: nested_expand

FROM nested_orders
| NESTED_EXPAND items
| NESTED_EXPAND events
| KEEP id, items.sku, events.start
| SORT id, items.sku, events.start
;

id:keyword | items.sku:keyword | events.start:integer
1          | a                 | 10
1          | b                 | 10
2          | null              | null
3          | c                 | 30
3          | c                 | 31
;

matchOnTextChild
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH(items.note, "hello")
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
a          | hello world
b          | say Hello there
;

colonOnTextChild
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE items.note : "hello"
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
a          | hello world
b          | say Hello there
;

matchPhraseOnTextChild
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH_PHRASE(items.note, "hello world")
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
a          | hello world
;

matchOnKeywordChild
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH(items.tag, "x1")
| KEEP id, items.tag
| SORT id, items.tag
;

id:keyword | items.tag:keyword
a          | x1
d          | x1
;

matchOnChildOrParentCondition
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH(items.note, "hello") OR id == "d"
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
a          | hello world
b          | say Hello there
d          | nothing
;

notMatchOnChildKeepsRowsWithoutTheField
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE NOT MATCH(items.note, "hello")
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
a          | goodbye
c          | null
d          | nothing
;

matchOnChildAfterRename
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| RENAME items.note AS note
| WHERE MATCH(note, "hello")
| KEEP id, note
| SORT id, note
;

id:keyword | note:text
a          | hello world
b          | say Hello there
;

matchOnChildScoresRows
required_capability: nested_expand

FROM nested_notes METADATA _score
| NESTED_EXPAND items
| WHERE MATCH(items.note, "hello")
| EVAL scored = _score > 0
| KEEP id, scored
| SORT id
;

id:keyword | scored:boolean
a          | true
b          | true
;

matchOnParentFieldAfterExpansionStillWorks
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH(id, "a")
| KEEP id, items.note
| SORT items.note
;

id:keyword | items.note:text
a          | goodbye
a          | hello world
;

matchWithOptionsOnTextChild
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH(items.note, "world hello", {"operator": "AND"})
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
a          | hello world
;

matchOnChildAndParentCondition
required_capability: nested_expand

FROM nested_notes
| NESTED_EXPAND items
| WHERE MATCH(items.note, "hello") AND id == "b"
| KEEP id, items.note
| SORT id, items.note
;

id:keyword | items.note:text
b          | say Hello there
;

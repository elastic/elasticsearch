nestedSubqueryImplicitDateAndDateNanosInInnerUnion
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: subquery_in_from_command_union_types_conflict_resolution

FROM employees,
     (FROM sample_data, (FROM sample_data_ts_nanos))
| WHERE event_duration == 1232382
| KEEP @timestamp, event_duration, message
| SORT @timestamp

nestedSubqueryWithInSubqueryInsideMultipleSubqueries
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: where_in_subquery_without_view

FROM
  (FROM
     (FROM
        (FROM employees | WHERE emp_no IN (FROM employees | WHERE emp_no == 10001 | KEEP emp_no)),
        (FROM employees | WHERE emp_no == 10002)
     ),
     (FROM employees | WHERE emp_no == 10003)
  ),
  (FROM
     (FROM employees | WHERE emp_no <= 10005 AND emp_no NOT IN (FROM employees | WHERE emp_no <= 10004 | KEEP emp_no))
  )
| STATS c = COUNT(*)
;

c:long
4
;

nestedSubqueryWithMetadata
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: metadata_fields

FROM 
  (FROM employees METADATA _index | WHERE emp_no == 10001 | KEEP emp_no, _index),
  (FROM sample_data METADATA _index | SORT @timestamp | LIMIT 1 | KEEP @timestamp, _index),
  (FROM employees,
        (FROM sample_data METADATA _index | SORT @timestamp DESC | LIMIT 1 | KEEP @timestamp, _index)
        METADATA _index 
   | WHERE emp_no == 10002 OR emp_no IS NULL | KEEP emp_no, _index, @timestamp)
  METADATA _index
| EVAL _index = MV_LAST(SPLIT(_index, ":"))
| KEEP _index, emp_no, @timestamp
| SORT _index, emp_no, @timestamp
;

_index:keyword | emp_no:integer | @timestamp:date
employees      | 10001          | null
employees      | 10002          | null
sample_data    | null           | 2023-10-23T12:15:03.360Z
sample_data    | null           | 2023-10-23T13:55:01.543Z
;

nestedSubqueryNullifyUnmappedFieldWithStats
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: optional_fields_nullify_tech_preview

SET unmapped_fields="nullify"\;
FROM employees,
     (FROM employees,
           (FROM sample_data))
| STATS c = COUNT(*), null_count = COUNT(does_not_exist_field) BY is_null = does_not_exist_field IS NULL
;

c:long | null_count:long | is_null:boolean
207    | 0               | true
;


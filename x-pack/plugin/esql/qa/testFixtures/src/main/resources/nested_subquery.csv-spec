nestedSubqueryWithLookupJoinAndInlineStatsInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: inline_stats
required_capability: join_lookup_v12

FROM
  (FROM
     (FROM employees
      | WHERE emp_no == 10001
      | EVAL language_code = languages
      | LOOKUP JOIN languages_lookup ON language_code
      | KEEP emp_no, language_name),
     (FROM employees | WHERE emp_no == 10002)
  ),
  (FROM
     (FROM employees | WHERE emp_no == 10003),
     (FROM employees | WHERE emp_no == 10004)
  )
| INLINE STATS c = COUNT(*) BY language_name
| KEEP emp_no, language_name, c
| SORT emp_no
;

emp_no:integer | language_name:keyword | c:long
10001          | French                | 1
10002          | null                  | 3
10003          | null                  | 3
10004          | null                  | 3
;

nestedSubqueryWithInlineStatsInsideAndInlineStatsInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: inline_stats

FROM
  (FROM
     (FROM employees | WHERE emp_no <= 10005 | INLINE STATS branch_max = MAX(salary) | KEEP emp_no, salary, branch_max),
     (FROM employees | WHERE emp_no == 10001 | KEEP emp_no, salary)
  ),
  (FROM employees | WHERE emp_no == 10002 | KEEP emp_no, salary)
| INLINE STATS c = COUNT(*)
| KEEP emp_no, salary, branch_max, c
| SORT emp_no, branch_max NULLS FIRST
;

emp_no:integer | salary:integer | branch_max:integer | c:long
10001          | 57305          | null               | 7
10001          | 57305          | 63528              | 7
10002          | 56371          | null               | 7
10002          | 56371          | 63528              | 7
10003          | 61805          | 63528              | 7
10004          | 36174          | 63528              | 7
10005          | 63528          | 63528              | 7
;


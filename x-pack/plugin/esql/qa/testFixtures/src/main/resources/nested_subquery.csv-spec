nestedSubqueryWithInSubqueryInsideSubquery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: where_in_subquery_without_view

FROM
  (FROM employees
   | WHERE emp_no IN (FROM employees
                      | WHERE emp_no <= 10002
                      | KEEP emp_no)),
  (FROM employees
   | WHERE emp_no == 10003)
| STATS c = COUNT(*)
;

c:long
3
;

nestedSubqueryWithConjunctiveNotInSubqueryInsideSubquery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: where_in_subquery_without_view

FROM
  (FROM
     (FROM employees
      | WHERE emp_no <= 10005 
          AND emp_no NOT IN (FROM employees
                                  | WHERE emp_no <= 10003
                                  | KEEP emp_no)),
     (FROM employees | WHERE emp_no == 10001)
  ),
  (FROM employees | WHERE emp_no == 10006)
| STATS c = COUNT(*)
;

c:long
4
;


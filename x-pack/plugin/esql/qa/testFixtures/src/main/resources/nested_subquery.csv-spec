// Tests using partial_mapping_sample_data: fields present in _source but not in the mapping (unmapped_message, etc.)
// These complement the tests above which use employees with a fully-absent field.

nestedSubqueryNullifyUnmappedFieldInSourceAsNullColumn
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: optional_fields_nullify_tech_preview

// Under nullify mode, unmapped_message is in _source but not in the mapping → appears as type :null with all-null values.
SET unmapped_fields="nullify"\;
FROM partial_mapping_sample_data,
     (FROM (FROM sample_data),
           (FROM employees))
| KEEP @timestamp, unmapped_message
| SORT @timestamp DESC NULLS LAST
| LIMIT 3
;

@timestamp:date          | unmapped_message:null
2024-10-23T13:55:01.543Z | null
2024-10-23T13:53:55.832Z | null
2024-10-23T13:52:55.015Z | null
;

nestedSubqueryLoadUnmappedFieldFromSourceKeep
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: optional_fields_load_with_fork_subqueries_and_views

// Under load mode, unmapped_message is loaded from _source with actual values for partial_mapping_sample_data rows
// and null for sample_data rows (which have no unmapped_message in _source).
SET unmapped_fields="load"\;
FROM partial_mapping_sample_data,
     (FROM (FROM sample_data), (FROM employees))
| KEEP @timestamp, message, unmapped_message
| SORT @timestamp DESC NULLS LAST
| LIMIT 3
;

@timestamp:date          | message:keyword        | unmapped_message:keyword
2024-10-23T13:55:01.543Z | Connected to 10.1.0.1! | Disconnected from 10.1.0.1
2024-10-23T13:53:55.832Z | Connection error?      | Disconnection error
2024-10-23T13:52:55.015Z | Connection error?      | Disconnection error
;

nestedSubqueryLoadUnmappedFieldFromInnerBranchSource
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: nested_subquery_in_from_command_planner_fix
required_capability: optional_fields_load_with_fork_subqueries_and_views

SET unmapped_fields="load"\;
FROM sample_data,
     (FROM (FROM partial_mapping_sample_data), (FROM employees))
| KEEP @timestamp, message, unmapped_message
| SORT @timestamp DESC NULLS LAST
| LIMIT 3
;

@timestamp:date          | message:keyword        | unmapped_message:keyword
2024-10-23T13:55:01.543Z | Connected to 10.1.0.1! | Disconnected from 10.1.0.1
2024-10-23T13:53:55.832Z | Connection error?      | Disconnection error
2024-10-23T13:52:55.015Z | Connection error?      | Disconnection error
;

nestedSubqueryLoadFilterByUnmappedFieldValueInInnerSubquery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: optional_fields_load_with_fork_subqueries_and_views

// Under load mode, a WHERE filter on a loaded unmapped field value inside an inner subquery prunes rows correctly.
// partial_mapping_sample_data has 3 rows with unmapped_message == "Disconnection error"; sample_data contributes 7 rows.
SET unmapped_fields="load"\;
FROM (FROM partial_mapping_sample_data | WHERE unmapped_message == "Disconnection error"),
     (FROM (FROM sample_data), (FROM employees))
| STATS c = COUNT(*)
;

c:long
110
;

nestedSubqueryLoadUnmappedFieldStatsByGroupInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: optional_fields_load_with_fork_subqueries_and_views

// Under load mode, STATS BY a loaded unmapped field groups partial_mapping_sample_data rows by their _source values
// and treats sample_data rows (no unmapped_message in _source) as a single null group.
SET unmapped_fields="load"\;
FROM partial_mapping_sample_data,
     (FROM (FROM sample_data), (FROM employees))
| STATS c = COUNT(*) BY unmapped_message
| SORT unmapped_message
;

c:long | unmapped_message:keyword
1      | 43
1      | Disconnected from 10.1.0.1
1      | Disconnected from 10.1.0.2
1      | Disconnected from 10.1.0.3
3      | Disconnection error
107    | null
;


FROM sample_data,
     (FROM sample_data_ts_nanos,
           (FROM sample_data))
| WHERE event_duration == 1232382
| KEEP @timestamp, event_duration, message
| SORT @timestamp
;

@timestamp:date_nanos          | event_duration:long | message:keyword

nestedSubqueryWithWhereAndInlineStatsInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: inline_stats

FROM employees,
     (FROM (FROM employees | WHERE emp_no <= 10003),
           (FROM employees | WHERE emp_no >= 10098))
| INLINE STATS c = COUNT(*)
| STATS rows = COUNT(*), c = MAX(c)
;

rows:long | c:long
106       | 106
;

nestedSubqueryThreeLevelsWithWhereAndStatsAndInlineStatsInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: inline_stats

FROM (FROM employees | WHERE emp_no <= 10005),
     (FROM (FROM employees | WHERE emp_no <= 10003),
           (FROM employees | WHERE emp_no >= 10098 | STATS mx = MAX(salary)))
| INLINE STATS c = COUNT(*), max_mx = MAX(mx)
| STATS rows = COUNT(*), c = MAX(c), max_mx = MAX(max_mx)
;

rows:long | c:long | max_mx:integer
9         | 9      | 73578
;

nestedSubqueryWithWhereAndInlineStatsByGroupInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: inline_stats

FROM employees,
     (FROM (FROM employees | WHERE emp_no <= 10005),
           (FROM sample_data | WHERE event_duration > 1000000))
| INLINE STATS c = COUNT(*) BY missing_emp_no = emp_no IS NULL
| STATS rows = COUNT(*), c = MAX(c) BY missing_emp_no
| SORT missing_emp_no
;

rows:long | c:long | missing_emp_no:boolean
105       | 105    | false
6         | 6      | true
;

nestedSubqueryWithFilterWhereAndInlineStatsInMainQuery
required_capability: subquery_in_from_command
required_capability: nested_subquery_in_from_command
required_capability: inline_stats

FROM employees,
     (FROM (FROM employees | WHERE emp_no < 10005),
           (FROM sample_data | WHERE event_duration == 1232382))
| WHERE emp_no IS NULL OR emp_no < 10005

// The PromQL tests of `k8s-timeseries-absent-over-time.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

absent_over_time_events_received_promql-Ignore
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=2m is_absent=(max by (pod) (absent_over_time(events_received{cluster="prod",pod="two"}[2m])))
| SORT step | LIMIT 10;
ignoreOrder:true

is_absent:double | step:datetime            | pod:keyword
1.0              | 2024-05-10T00:10:00.000Z | two
1.0              | 2024-05-10T00:12:00.000Z | two
1.0              | 2024-05-10T00:18:00.000Z | two
;

absent_over_time_of_long_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m is_absent=(max by (cluster) (absent_over_time(network.bytes_in[10m])))
| SORT cluster, step | LIMIT 10;

is_absent:double | step:datetime            | cluster:keyword
0.0              | 2024-05-10T00:10:00.000Z | prod
0.0              | 2024-05-10T00:20:00.000Z | prod
0.0              | 2024-05-10T00:30:00.000Z | prod
0.0              | 2024-05-10T00:10:00.000Z | qa
0.0              | 2024-05-10T00:20:00.000Z | qa
0.0              | 2024-05-10T00:30:00.000Z | qa
0.0              | 2024-05-10T00:10:00.000Z | staging
0.0              | 2024-05-10T00:20:00.000Z | staging
0.0              | 2024-05-10T00:30:00.000Z | staging
;

absent_over_time_of_long_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:20:00.000Z" is_absent=(max by (cluster) (absent_over_time(network.bytes_in[10m])))
| TS_COLLAPSE
| SORT cluster;

is_absent:double  | step:datetime                                                                                  | cluster:keyword
[0.0, 0.0]       | [2024-05-10T00:10:00.000Z, 2024-05-10T00:20:00.000Z]                                        | prod
[0.0, 0.0]       | [2024-05-10T00:10:00.000Z, 2024-05-10T00:20:00.000Z]                                        | qa
[0.0, 0.0]       | [2024-05-10T00:10:00.000Z, 2024-05-10T00:20:00.000Z]                                        | staging
;

absent_over_time_of_integer_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m is_absent=(max by (cluster) (absent_over_time(network.eth0.currently_connected_clients[10m])))
| SORT step, cluster | LIMIT 10;

is_absent:double | step:datetime            | cluster:keyword
0.0              | 2024-05-10T00:10:00.000Z | prod
0.0              | 2024-05-10T00:10:00.000Z | qa
0.0              | 2024-05-10T00:10:00.000Z | staging
0.0              | 2024-05-10T00:20:00.000Z | prod
0.0              | 2024-05-10T00:20:00.000Z | qa
0.0              | 2024-05-10T00:20:00.000Z | staging
0.0              | 2024-05-10T00:30:00.000Z | prod
0.0              | 2024-05-10T00:30:00.000Z | qa
0.0              | 2024-05-10T00:30:00.000Z | staging
;

absent_over_time_with_filtering_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m is_absent=(max by (cluster) (absent_over_time(network.bytes_in{pod!="three"}[10m])))
| SORT step, cluster | LIMIT 10;

is_absent:double | step:datetime            | cluster:keyword
0.0              | 2024-05-10T00:10:00.000Z | prod
0.0              | 2024-05-10T00:10:00.000Z | qa
0.0              | 2024-05-10T00:10:00.000Z | staging
0.0              | 2024-05-10T00:20:00.000Z | prod
0.0              | 2024-05-10T00:20:00.000Z | qa
0.0              | 2024-05-10T00:20:00.000Z | staging
0.0              | 2024-05-10T00:30:00.000Z | prod
0.0              | 2024-05-10T00:30:00.000Z | qa

// The PromQL tests of `k8s-timeseries-arithmetic.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

addition_scalar_scalar_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1h sum=(1+1);

sum:double | step:datetime
2.0        | 2024-05-10T01:00:00.000Z
;

addition_scalar_scalar_promql_expanded
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_promql_scalar_constant_results
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=10m start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:20:00.000Z" sum=(1+1)
| SORT step;

sum:double | step:datetime
2.0        | 2024-05-10T00:00:00.000Z
2.0        | 2024-05-10T00:10:00.000Z
2.0        | 2024-05-10T00:20:00.000Z
;

addition_scalar_scalar_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_promql_scalar_constant_results
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=10m start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:20:00.000Z" sum=(1+1)
| TS_COLLAPSE;

sum:double         | step:datetime
[2.0, 2.0, 2.0]   | [2024-05-10T00:00:00.000Z, 2024-05-10T00:10:00.000Z, 2024-05-10T00:20:00.000Z]
;

// Fails until the translator drops the metric name here, as Prometheus does.
multiplication_metric_scalar_promql-Ignore
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1h network_in_bits=(network.total_bytes_in * 8)
| SORT network_in_bits DESC;


tx_ratio_promql-Ignore
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1h ratio=(
  max by (cluster) (
    network.eth0.tx /
    (network.eth0.tx + network.eth0.rx)
  )
)
| EVAL ratio=ROUND(ratio, 6), step=step, cluster=cluster
| SORT ratio DESC;

ratio:double | step:datetime            | cluster:keyword

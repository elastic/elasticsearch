// The PromQL tests of `k8s-timeseries-avg-over-time.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

avg_over_time_of_double_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1m cost=(sum(avg_over_time(network.cost[1m])))
| EVAL cost = round(cost, 4)
| KEEP cost, step
| SORT cost DESC, step DESC 
| LIMIT 10;

cost:double | step:datetime
69.6875     | 2024-05-10T00:10:00.000Z
49.5        | 2024-05-10T00:18:00.000Z
48.3125     | 2024-05-10T00:23:00.000Z
47.125      | 2024-05-10T00:16:00.000Z
46.4375     | 2024-05-10T00:20:00.000Z
45.875      | 2024-05-10T00:09:00.000Z
40.4375     | 2024-05-10T00:07:00.000Z
39.5417     | 2024-05-10T00:14:00.000Z
37.9375     | 2024-05-10T00:13:00.000Z
36.375      | 2024-05-10T00:12:00.000Z
;

avg_over_time_of_double_no_grouping_single_bucket_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1h cost=(sum(avg_over_time(network.cost[1h])))
| EVAL cost = round(cost, 4)
| KEEP cost, step;

cost:double | step:datetime
56.3225     | 2024-05-10T01:00:00.000Z
;

avg_over_time_of_double_no_grouping_promql_expanded
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:11:00.000Z" end="2024-05-10T00:14:00.000Z" cost=(round(sum(avg_over_time(network.cost[1m])), 0.0001))
| SORT step;

cost:double | step:datetime
13.25       | 2024-05-10T00:11:00.000Z
36.375      | 2024-05-10T00:12:00.000Z
37.9375     | 2024-05-10T00:13:00.000Z
39.5417     | 2024-05-10T00:14:00.000Z
;

avg_over_time_of_double_no_grouping_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:11:00.000Z" end="2024-05-10T00:14:00.000Z" cost=(round(sum(avg_over_time(network.cost[1m])), 0.0001))
| TS_COLLAPSE;

cost:double                      | step:datetime
[13.25, 36.375, 37.9375, 39.5417] | [2024-05-10T00:11:00.000Z, 2024-05-10T00:12:00.000Z, 2024-05-10T00:13:00.000Z, 2024-05-10T00:14:00.000Z]
;

// Range window (1m) smaller than the step (10m): the per-step result at B is the average over (B-1m, B], identical to
// the values the step=1m query above produces at the same instants. 
avg_over_time_of_double_small_window_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_window_filter_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:20:00.000Z" cost=(round(sum(avg_over_time(network.cost[1m])), 0.0001))
| SORT step;

cost:double | step:datetime
69.6875     | 2024-05-10T00:10:00.000Z
46.4375     | 2024-05-10T00:20:00.000Z
;

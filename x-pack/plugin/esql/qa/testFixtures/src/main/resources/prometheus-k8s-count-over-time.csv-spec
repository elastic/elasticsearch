eval_on_count_over_time_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m bytes=(sum by (pod) (count_over_time(network.bytes_in[10m])))
| EVAL kb = bytes / 1000.0
| SORT step, pod | LIMIT 10;

bytes:double | step:datetime            | pod:keyword | kb:double
27.0         | 2024-05-10T00:10:00.000Z | one         | 0.027
29.0         | 2024-05-10T00:10:00.000Z | three       | 0.029
28.0         | 2024-05-10T00:10:00.000Z | two         | 0.028
30.0         | 2024-05-10T00:20:00.000Z | one         | 0.03
36.0         | 2024-05-10T00:20:00.000Z | three       | 0.036
30.0         | 2024-05-10T00:20:00.000Z | two         | 0.03
8.0          | 2024-05-10T00:30:00.000Z | one         | 0.008
5.0          | 2024-05-10T00:30:00.000Z | three       | 0.005
7.0          | 2024-05-10T00:30:00.000Z | two         | 0.007
;


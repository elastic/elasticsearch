// In the remote-write layout a missing sample is no document at all, so windows without samples yield no row, as in Prometheus; the k8s original has documents with a null field and reports 0.
count_over_time_null_values_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:14:00.000Z" events=(sum by (pod) (count_over_time(events_received[1m])))
| SORT events, pod, step | LIMIT 10;


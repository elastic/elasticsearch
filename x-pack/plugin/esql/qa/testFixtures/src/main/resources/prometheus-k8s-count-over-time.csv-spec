// The PromQL tests of `k8s-timeseries-count-over-time.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

count_over_time_of_long_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m bytes_in=(sum by (cluster) (count_over_time(network.bytes_in[10m])))
| SORT bytes_in DESC, cluster, step | LIMIT 10;

bytes_in:double | step:datetime            | cluster:keyword
40.0            | 2024-05-10T00:20:00.000Z | qa
37.0            | 2024-05-10T00:10:00.000Z | qa
32.0            | 2024-05-10T00:20:00.000Z | prod
24.0            | 2024-05-10T00:10:00.000Z | staging
24.0            | 2024-05-10T00:20:00.000Z | staging
23.0            | 2024-05-10T00:10:00.000Z | prod
9.0             | 2024-05-10T00:30:00.000Z | staging
6.0             | 2024-05-10T00:30:00.000Z | prod
5.0             | 2024-05-10T00:30:00.000Z | qa
;

count_over_time_with_window_promql

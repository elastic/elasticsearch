PROMQL index=prometheus-k8s step=10m avg_bytes=(avg by (cluster) (delta(network.bytes_in[10m])))
| EVAL kb_minus_offset = (avg_bytes - 100) / 1000.0
| EVAL avg_bytes = round(avg_bytes, 6), kb_minus_offset = round(kb_minus_offset, 6)
| KEEP avg_bytes, step, cluster, kb_minus_offset
| SORT step, cluster | LIMIT 10;


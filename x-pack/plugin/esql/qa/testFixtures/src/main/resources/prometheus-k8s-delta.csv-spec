// Round final floating-point results to avoid asserting on aggregation-order noise.
// The PromQL tests of `k8s-timeseries-delta.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

delta_of_double_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m cost_change=(sum(delta(network.cost[1m])))
| EVAL cost_change = round(cost_change, 6)
| KEEP cost_change, step
| SORT cost_change DESC, step DESC | LIMIT 10;

cost_change:double | step:datetime
21.036058          | 2024-05-10T00:21:00.000Z
13.259615          | 2024-05-10T00:14:00.000Z
11.486895          | 2024-05-10T00:13:00.000Z
11.066667          | 2024-05-10T00:22:00.000Z
11.0625            | 2024-05-10T00:23:00.000Z
10.491071          | 2024-05-10T00:16:00.000Z
9.222489           | 2024-05-10T00:10:00.000Z
5.833333           | 2024-05-10T00:11:00.000Z
5.03125            | 2024-05-10T00:01:00.000Z
2.25               | 2024-05-10T00:15:00.000Z
;

delta_of_double_no_grouping_promql_expanded
required_capability: promql_command_v0
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:09:00.000Z" end="2024-05-10T00:11:00.000Z" cost_change=(round(sum(delta(network.cost[1m])), 0.000001))
| SORT step;

cost_change:double | step:datetime
0.416667 | 2024-05-10T00:09:00.000Z
9.222489            | 2024-05-10T00:10:00.000Z
5.833333            | 2024-05-10T00:11:00.000Z
;

delta_of_double_no_grouping_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:09:00.000Z" end="2024-05-10T00:11:00.000Z" cost_change=(round(sum(delta(network.cost[1m])), 0.000001))
| TS_COLLAPSE;

cost_change:double                        | step:datetime
[0.416667, 9.222489, 5.833333] | [2024-05-10T00:09:00.000Z, 2024-05-10T00:10:00.000Z, 2024-05-10T00:11:00.000Z]
;

// Remote write stores every sample as a double, so `delta` extrapolates to the window as Prometheus does; the k8s original runs on an integer field, whose delta is not extrapolated.
delta_of_integer_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_ts_block_loader_passthrough_aliasing


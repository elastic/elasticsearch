// The PromQL tests of `k8s-timeseries-first-over-time.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

first_over_time_of_integer_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m clients=(avg by (cluster) (first_over_time(network.eth0.currently_connected_clients[1m])))
| SORT step, cluster | LIMIT 10;

clients:double | step:datetime            | cluster:keyword
949.0          | 2024-05-10T00:01:00.000Z | prod
615.5          | 2024-05-10T00:01:00.000Z | staging
396.5          | 2024-05-10T00:02:00.000Z | prod
440.0          | 2024-05-10T00:02:00.000Z | qa
659.5          | 2024-05-10T00:03:00.000Z | prod
565.0          | 2024-05-10T00:03:00.000Z | qa
426.5          | 2024-05-10T00:03:00.000Z | staging
742.0          | 2024-05-10T00:04:00.000Z | prod
407.5          | 2024-05-10T00:04:00.000Z | qa
672.0          | 2024-05-10T00:04:00.000Z | staging
;

first_over_time_of_integer_promql_expanded
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:02:00.000Z" end="2024-05-10T00:04:00.000Z" clients=(avg by (cluster) (first_over_time(network.eth0.currently_connected_clients[1m])))
| SORT cluster, step;

clients:double | step:datetime            | cluster:keyword
396.5          | 2024-05-10T00:02:00.000Z | prod
659.5          | 2024-05-10T00:03:00.000Z | prod
742.0          | 2024-05-10T00:04:00.000Z | prod
440.0          | 2024-05-10T00:02:00.000Z | qa
565.0          | 2024-05-10T00:03:00.000Z | qa
407.5          | 2024-05-10T00:04:00.000Z | qa
426.5          | 2024-05-10T00:03:00.000Z | staging
672.0          | 2024-05-10T00:04:00.000Z | staging
;

first_over_time_of_integer_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:02:00.000Z" end="2024-05-10T00:04:00.000Z" clients=(avg by (cluster) (first_over_time(network.eth0.currently_connected_clients[1m])))
| TS_COLLAPSE
| SORT cluster;

clients:double        | step:datetime                                                                  | cluster:keyword
[396.5, 659.5, 742.0] | [2024-05-10T00:02:00.000Z, 2024-05-10T00:03:00.000Z, 2024-05-10T00:04:00.000Z] | prod
[440.0, 565.0, 407.5] | [2024-05-10T00:02:00.000Z, 2024-05-10T00:03:00.000Z, 2024-05-10T00:04:00.000Z] | qa
[426.5, 672.0]        | [2024-05-10T00:03:00.000Z, 2024-05-10T00:04:00.000Z]                           | staging
;


377.3333333333333  | 2024-05-10T00:20:00.000Z | prod            | 0.2773333333333333
104.33333333333333 | 2024-05-10T00:20:00.000Z | qa              | 0.004333333333333329
286.0              | 2024-05-10T00:20:00.000Z | staging         | 0.186
815.5              | 2024-05-10T00:30:00.000Z | prod            | 0.7155
934.0              | 2024-05-10T00:30:00.000Z | qa              | 0.834
786.0              | 2024-05-10T00:30:00.000Z | staging         | 0.686
;


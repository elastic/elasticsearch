eval_on_idelta_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m avg_bytes=(avg by (cluster) (idelta(network.bytes_in[10m])))
| EVAL kb_minus_offset = (avg_bytes - 100) / 1000.0
| SORT step, cluster | LIMIT 10;

avg_bytes:double    | step:datetime            | cluster:keyword | kb_minus_offset:double

// The PromQL tests of `k8s-timeseries-idelta.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

idelta_of_double_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m cost_change=(sum(idelta(network.cost[1m])))
| SORT cost_change DESC, step DESC | LIMIT 10;

cost_change:double | step:datetime
18.625             | 2024-05-10T00:10:00.000Z
14.125             | 2024-05-10T00:21:00.000Z
12.375             | 2024-05-10T00:16:00.000Z
8.0                | 2024-05-10T00:22:00.000Z
7.125              | 2024-05-10T00:13:00.000Z
6.625              | 2024-05-10T00:23:00.000Z
5.375              | 2024-05-10T00:18:00.000Z
3.5                | 2024-05-10T00:11:00.000Z
2.875              | 2024-05-10T00:01:00.000Z
2.75               | 2024-05-10T00:05:00.000Z
;

idelta_of_double_no_grouping_promql_expanded
required_capability: promql_command_v0
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:08:00.000Z" end="2024-05-10T00:10:00.000Z" cost_change=(sum(idelta(network.cost[1m])))
| SORT step;

cost_change:double | step:datetime
2.5                | 2024-05-10T00:08:00.000Z
0.5                | 2024-05-10T00:09:00.000Z
18.625             | 2024-05-10T00:10:00.000Z
;

idelta_of_double_no_grouping_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:08:00.000Z" end="2024-05-10T00:10:00.000Z" cost_change=(sum(idelta(network.cost[1m])))
| TS_COLLAPSE;

cost_change:double   | step:datetime
[2.5, 0.5, 18.625]   | [2024-05-10T00:08:00.000Z, 2024-05-10T00:09:00.000Z, 2024-05-10T00:10:00.000Z]
;


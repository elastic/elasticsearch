irate_with_filtering_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m start="2024-05-10T00:00:00.000Z" end="2024-05-10T00:20:00.000Z" irate_bytes_in=(round(sum by (cluster) (irate(network.total_bytes_in{pod="one"}[10m])), 0.01))
| TS_COLLAPSE
| SORT cluster;


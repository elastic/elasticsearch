// The PromQL tests of `k8s-timeseries-irate.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

irate_of_long_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_unmapped_fields_filter_nulls
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m irate_bytes_in=(avg(irate(network.total_bytes_in[1m])))
| EVAL irate_bytes_in = round(irate_bytes_in, 6)
| KEEP irate_bytes_in, step
| SORT irate_bytes_in DESC, step DESC | LIMIT 10;

irate_bytes_in:double | step:datetime

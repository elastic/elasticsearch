eval_on_irate_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m irate_bytes=(avg by (cluster) (irate(network.total_bytes_in[10m])))
| EVAL irate_kb = irate_bytes / 1024.0
| EVAL irate_bytes = round(irate_bytes, 6), irate_kb = round(irate_kb, 6)
| KEEP irate_bytes, step, cluster, irate_kb
| SORT step, cluster | LIMIT 10;


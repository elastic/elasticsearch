686.3333333333334 | 2024-05-10T00:20:00.000Z | qa              | 0.5863333333333334
282.3333333333333 | 2024-05-10T00:20:00.000Z | staging         | 0.18233333333333332
871.5             | 2024-05-10T00:30:00.000Z | prod            | 0.7715
697.0             | 2024-05-10T00:30:00.000Z | qa              | 0.597
81.33333333333333 | 2024-05-10T00:30:00.000Z | staging         | -0.01866666666666667
;


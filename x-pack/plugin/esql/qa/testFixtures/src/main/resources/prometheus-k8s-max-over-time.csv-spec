50.125      | 2024-05-10T00:09:00.000Z
83.125      | 2024-05-10T00:10:00.000Z
;

max_over_time_of_double_no_grouping_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:08:00.000Z" end="2024-05-10T00:10:00.000Z" cost=(sum(max_over_time(network.cost[1m])))
| TS_COLLAPSE;

cost:double          | step:datetime
[33.25, 50.125, 83.125] | [2024-05-10T00:08:00.000Z, 2024-05-10T00:09:00.000Z, 2024-05-10T00:10:00.000Z]
;


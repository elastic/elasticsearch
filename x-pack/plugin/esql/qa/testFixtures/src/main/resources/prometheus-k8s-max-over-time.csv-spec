// The PromQL tests of `k8s-timeseries-max-over-time.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

max_over_time_of_double_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m cost=(sum(max_over_time(network.cost[1m])))
| SORT cost DESC, step DESC | LIMIT 10;

cost:double | step:datetime
83.125      | 2024-05-10T00:10:00.000Z
60.375      | 2024-05-10T00:18:00.000Z
55.25       | 2024-05-10T00:19:00.000Z
53.5        | 2024-05-10T00:20:00.000Z
52.75       | 2024-05-10T00:16:00.000Z
51.625      | 2024-05-10T00:23:00.000Z
50.125      | 2024-05-10T00:09:00.000Z
44.875      | 2024-05-10T00:07:00.000Z
42.625      | 2024-05-10T00:14:00.000Z
42.25       | 2024-05-10T00:04:00.000Z
;


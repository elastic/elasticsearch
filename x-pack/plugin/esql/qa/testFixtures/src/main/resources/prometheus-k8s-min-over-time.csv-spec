// The PromQL tests of `k8s-timeseries-min-over-time.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

min_over_time_of_double_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m cost=(sum(min_over_time(network.cost[1m])))
| SORT cost DESC, step DESC | LIMIT 10;

cost:double | step:datetime
53.625      | 2024-05-10T00:10:00.000Z
45.0        | 2024-05-10T00:23:00.000Z
41.625      | 2024-05-10T00:09:00.000Z
40.375      | 2024-05-10T00:16:00.000Z
39.375      | 2024-05-10T00:20:00.000Z
36.0        | 2024-05-10T00:07:00.000Z
35.125      | 2024-05-10T00:18:00.000Z
34.0        | 2024-05-10T00:14:00.000Z
33.875      | 2024-05-10T00:13:00.000Z
33.75       | 2024-05-10T00:12:00.000Z
;

min_over_time_of_double_no_grouping_promql_expanded
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:08:00.000Z" end="2024-05-10T00:10:00.000Z" cost=(sum(min_over_time(network.cost[1m])))
| SORT step;

cost:double | step:datetime
29.375      | 2024-05-10T00:08:00.000Z
41.625      | 2024-05-10T00:09:00.000Z
53.625      | 2024-05-10T00:10:00.000Z
;

min_over_time_of_double_no_grouping_promql_collapsed
required_capability: promql_command_v0
required_capability: ts_collapse
required_capability: fix_promql_time_bucket_v2
required_capability: fix_tstep_bucket_rounding
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m start="2024-05-10T00:08:00.000Z" end="2024-05-10T00:10:00.000Z" cost=(sum(min_over_time(network.cost[1m])))
| TS_COLLAPSE;

cost:double          | step:datetime
[29.375, 41.625, 53.625] | [2024-05-10T00:08:00.000Z, 2024-05-10T00:09:00.000Z, 2024-05-10T00:10:00.000Z]
;


// The PromQL tests of `k8s-timeseries-promql-without.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

sum_without_prefix_syntax
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_metric_name_drop
PROMQL index=prometheus-k8s step=1h result=(sum without (pod, region) (avg_over_time(network.cost[1h])))
| SORT result;

result:double      | step:datetime            | _timeseries:keyword
17.521233974358974 | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""staging""}}"
18.032269021739133 | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""prod""}}"
20.76903735632184  | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""qa""}}"
;

// Postfix form of `without`; equivalent to prefix syntax.
sum_without_postfix_syntax
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_metric_name_drop
PROMQL index=prometheus-k8s step=1h result=(sum(avg_over_time(network.cost[1h])) without (pod, region))
| SORT result;

result:double      | step:datetime            | _timeseries:keyword
17.521233974358974 | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""staging""}}"
18.032269021739133 | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""prod""}}"
20.76903735632184  | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""qa""}}"
;


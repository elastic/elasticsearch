PROMQL index=prometheus-k8s step=1h result=(sum without (pod) (network.cost))
| SORT result;

result:double | step:datetime            | _timeseries:keyword
15.875        | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""staging"",""region"":""us""}}"
18.625        | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""prod"",""region"":[""eu"",""us""]}}"
26.5          | 2024-05-10T01:00:00.000Z | "{""labels"":{""cluster"":""qa""}}"
;


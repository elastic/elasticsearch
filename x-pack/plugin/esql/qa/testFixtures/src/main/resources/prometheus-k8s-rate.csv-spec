rate_of_long_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=5m rate_bytes_in=(avg by (cluster) (rate(network.total_bytes_in[5m])))
| EVAL rate_bytes_in=ROUND(rate_bytes_in, 6), step=step, cluster=cluster
| SORT rate_bytes_in DESC, step, cluster | LIMIT 10;


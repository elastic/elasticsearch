// The PromQL tests of `k8s-timeseries-rate.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

rate_of_long_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m rate_bytes_in=(avg(rate(network.total_bytes_in[1m])))
| EVAL rate_bytes_in=ROUND(rate_bytes_in, 6), step=step
| SORT rate_bytes_in DESC, step DESC | LIMIT 10;

rate_bytes_in:double | step:datetime
26.69853             | 2024-05-10T00:05:00.000Z
22.148003            | 2024-05-10T00:02:00.000Z
18.744102            | 2024-05-10T00:12:00.000Z
17.669007            | 2024-05-10T00:18:00.000Z
17.386587            | 2024-05-10T00:21:00.000Z
16.945882            | 2024-05-10T00:11:00.000Z
16.65479             | 2024-05-10T00:08:00.000Z
16.002437            | 2024-05-10T00:19:00.000Z
15.515104            | 2024-05-10T00:01:00.000Z
14.451021            | 2024-05-10T00:20:00.000Z
;


rate_of_double_no_grouping_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=1m rate_cost=(sum(rate(network.total_cost[1m])))
| EVAL rate_cost=ROUND(rate_cost, 6), step=step
| SORT rate_cost DESC, step | LIMIT 10;


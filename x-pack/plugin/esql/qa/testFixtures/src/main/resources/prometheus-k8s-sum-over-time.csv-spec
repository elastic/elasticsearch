6820.0             | 2024-05-10T00:20:00.000Z | qa              | 6.72
3439.6666666666665 | 2024-05-10T00:20:00.000Z | staging         | 3.3396666666666666
2073.0             | 2024-05-10T00:30:00.000Z | prod            | 1.973
1068.3333333333333 | 2024-05-10T00:30:00.000Z | qa              | 0.9683333333333333
1152.6666666666667 | 2024-05-10T00:30:00.000Z | staging         | 1.0526666666666666
;


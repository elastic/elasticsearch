# Awaits fix: Arithmetic on instant vector is not supported at this time.
eval_on_sum_over_time_promql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=10m max_bytes=(avg by (cluster) (sum_over_time(network.bytes_in[10m])))
| EVAL kb_minus_offset = (max_bytes - 100) / 1000.0
| SORT step, cluster | LIMIT 10;

max_bytes:double   | step:datetime            | cluster:keyword | kb_minus_offset:double

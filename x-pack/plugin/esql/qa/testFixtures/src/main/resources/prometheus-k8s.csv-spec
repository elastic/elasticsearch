// The PromQL tests of `k8s-timeseries.csv-spec` over `index=k8s`, run on `prometheus-k8s`: the same samples in the Prometheus
// remote-write layout (one document per sample, `labels.*` dimensions including `__name__`, one
// `metrics.<name>` field per metric). Queries are identical up to the index name; `_timeseries` carries
// the labels under `labels`, with `__name__` where Prometheus keeps the metric name. Keep in sync with the
// source file.

oneRateWithPromql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: rate_with_interpolation_v2
required_capability: fix_ts_block_loader_passthrough_aliasing

PROMQL index=prometheus-k8s step=5m max(rate(network.total_bytes_in[5m]))
| SORT step DESC | LIMIT 2;

max(rate(network.total_bytes_in[5m])):double | step:datetime
17.22641509433962                            | 2024-05-10T00:25:00.000Z
22.359073868541127                           | 2024-05-10T00:20:00.000Z
;

oneRateWithSingleStepPromql
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1h max(rate(network.total_bytes_in[1h]));

max(rate(network.total_bytes_in[1h])):double | step:datetime
4.379885057471264                            | 2024-05-10T01:00:00.000Z
;


// Binary operators between raw selectors of different metrics over the Prometheus remote-write layout: one document per
// sample, `labels.__name__` a dimension, one `metrics.<name>` field per metric. Two metrics never share a document or a
// series, so the operands must meet on the series identity without `__name__`, which the operator drops anyway.

subtraction_between_metrics_in_separate_documents
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total - mem_free)
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
60.0          | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
150.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podB"",""zone"":""us""}}"
;

division_between_metrics_under_sum_by
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(sum by (zone) (mem_total / mem_free))
| SORT zone;

result:double | step:datetime            | zone:keyword
2.5           | 2024-05-10T01:00:00.000Z | eu
4.0           | 2024-05-10T01:00:00.000Z | us
;

// Arithmetic with a scalar also drops the metric name from the series identity.
scalar_arithmetic_drops_metric_name
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total * 2)
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
200.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
400.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podB"",""zone"":""us""}}"
;

// A chain of raw operands: the first pair collapses eagerly, the third operand collapses alone and fuses with it.
chained_addition_across_metrics
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total + mem_free + mem_total)
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
240.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
450.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podB"",""zone"":""us""}}"
;

// A raw operand over an already collapsed one.
raw_operand_over_nested_sum
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total / (mem_free + mem_total))
| SORT _timeseries;

result:double      | step:datetime            | _timeseries:keyword
0.7142857142857143 | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
0.8                | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podB"",""zone"":""us""}}"
;

// Two collapsed operands fuse into one aggregate; each side carries its own packing alias, rebound by name.
nested_operands_on_both_sides
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=((mem_total - mem_free) - (mem_total + mem_free))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
-80.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
-100.0        | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podB"",""zone"":""us""}}"
;

// `or` matches series without `__name__` too: both branches drop the metric name, so the left branch wins per pod.
scalar_arithmetic_in_or
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total / 1000 or mem_free / 1000)
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
0.1           | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
0.2           | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podB"",""zone"":""us""}}"
;

// Label matchers on the operands become filters on the per-series functions of the fused aggregate, not on the
// aggregates of its second phase, where the matched fields no longer exist.
chained_addition_with_matchers
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total{pod="podA"} + mem_free{pod="podA"} + mem_total{pod="podA"})
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
240.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
;

nested_subtraction_with_matchers
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(mem_total{zone="eu"} - mem_free{zone="eu"} - (mem_total{zone="eu"} + mem_free{zone="eu"}))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
-80.0         | 2024-05-10T01:00:00.000Z | "{""labels"":{""pod"":""podA"",""zone"":""eu""}}"
;

sum_by_over_chained_subtraction
required_capability: promql_command_v0
required_capability: fix_ts_block_loader_passthrough_aliasing
required_capability: fix_promql_binary_op_across_metrics
PROMQL index=prom-two-metrics step=1h result=(sum by (zone) (mem_total - mem_free - mem_free))
| SORT zone;

result:double | step:datetime            | zone:keyword
20.0          | 2024-05-10T01:00:00.000Z | eu
100.0         | 2024-05-10T01:00:00.000Z | us
;

short_step_first_sample
required_capability: promql_lookback_delta
PROMQL index=k8s start="2024-05-10T00:10:00Z" end="2024-05-10T00:10:00Z" step=30s result=(sum(network.eth0.tx{cluster="qa",pod="one"}))
| SORT step;

result:double | step:datetime
506.0 | 2024-05-10T00:10:00.000Z
;

large_step_excludes_expired
required_capability: promql_lookback_delta
PROMQL index=k8s start="2024-05-10T00:30:00Z" end="2024-05-10T00:30:00Z" step=10m result=(sum(network.eth0.tx{cluster="qa",pod="one"}))
| STATS n=COUNT(*);

n:long
0
;


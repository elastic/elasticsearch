;

offset_uses_shifted_lookback
required_capability: promql_lookback_delta
PROMQL index=k8s start="2024-05-10T00:24:00Z" end="2024-05-10T00:24:00Z" step=30s lookback_delta=2m result=(sum(network.eth0.tx{cluster="qa",pod="one"} offset 1m))
| SORT step;

result:double | step:datetime

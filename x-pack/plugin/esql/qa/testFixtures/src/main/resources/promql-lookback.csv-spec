;

query_setting_default
required_capability: promql_lookback_delta
SET promql_lookback_delta="2m"\;
PROMQL index=k8s start="2024-05-10T00:23:00Z" end="2024-05-10T00:25:00Z" step=1m result=(sum(network.eth0.tx{cluster="qa",pod="one"}))
| SORT step;

result:double | step:datetime

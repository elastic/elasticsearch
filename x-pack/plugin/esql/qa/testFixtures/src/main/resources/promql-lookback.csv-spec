explicit_window_is_independent
required_capability: promql_lookback_delta
PROMQL index=k8s start="2024-05-10T00:30:00Z" end="2024-05-10T00:30:00Z" step=7m lookback_delta=1s result=(sum(last_over_time(network.eth0.tx{cluster="qa",pod="one"}[10m])))
| SORT step;

result:double | step:datetime

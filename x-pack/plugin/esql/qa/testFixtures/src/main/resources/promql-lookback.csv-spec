submillisecond_plain_selector_is_empty
required_capability: promql_lookback_delta
PROMQL index=k8s time="2024-05-10T00:22:59Z" lookback_delta="0.0005" result=(network.eth0.tx{cluster="qa",pod="one"})
| KEEP result, step
| SORT step;

result:double | step:datetime
;

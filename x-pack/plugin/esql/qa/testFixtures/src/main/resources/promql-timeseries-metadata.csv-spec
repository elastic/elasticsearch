// Each branch the one-_timeseries-per-node translation takes, and its counterpart on the per-exclusion-set translation.
//
// Every spec runs on the path the cluster supports: wherever every node the query reaches supports
// esql_timeseries_metadata_unset (CsvIT, single- and multi-node REST, cross-cluster between current clusters) a translation
// carries each series' one _timeseries and unsets the labels a `without` or a histogram's `le` drops; in a mixed cluster,
// and across clusters with an older one, it asks the source for one _timeseries per exclusion set. Both must return the
// same result. The specs requiring promql_timeseries_metadata_unset pin what only the new path returns: the empty identity
// for `without` over every label, where older nodes return the whole source document, and a `without` over a histogram,
// which older nodes cannot plan.


// ------------------------------------------------
// without (K): AcrossSeriesAggregate
// ------------------------------------------------

// A raw child collapses per series by its whole _timeseries; the aggregate unsets K and regroups.
without_over_raw_selector
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod) (network.cost))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
18.625        | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""region"":[""eu"",""us""]}"
26.5          | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
15.875        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""region"":""us""}"
;


// An aggregated per-series child (rate) carries its _timeseries; the aggregate unsets K from it.
without_over_rate
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod) (rate(network.total_bytes_in[1h])))
| SORT _timeseries;

result:double      | step:datetime            | _timeseries:keyword
8.582205615942028  | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""region"":[""eu"",""us""]}"
11.685430635376756 | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
7.0555243016290685 | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""region"":""us""}"
;


// Several labels unset at once.
without_two_labels
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(max without (pod, region) (network.cost))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
10.75         | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod""}"
10.875        | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
9.5           | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging""}"
;


// An unset over an already regrouped _timeseries: the histogram regroups its buckets with le unset, then `without`
// unsets instance from that regrouped _timeseries. Older nodes cannot plan it: they need one _timeseries per exclusion
// set, both on one node.
without_over_histogram_quantile
required_capability: promql_command_v0
required_capability: promql_histogram_quantile
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: promql_timeseries_metadata_unset
PROMQL index=promql_classic_histogram step=5m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:10:00.000Z" result=(round(max without (instance) (histogram_quantile(0.5, rate(request_duration_seconds_bucket[5m]))), 0.001))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
1.583         | 2024-05-10T00:10:00.000Z | "{""labels"":{""job"":""api""}}"
2.167         | 2024-05-10T00:10:00.000Z | "{""labels"":{""job"":""repair""}}"
1.5           | 2024-05-10T00:10:00.000Z | "{""labels"":{""job"":""worker""}}"
;


// A child of promoted labels only carries no _timeseries: there is nothing to unset, the promoted labels regroup.
without_over_by
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(sum without (pod) (sum by (cluster, pod) (network.cost)))
| SORT cluster;

result:double | step:datetime            | cluster:keyword
18.625        | 2024-05-10T01:00:00.000Z | prod
26.5          | 2024-05-10T01:00:00.000Z | qa
15.875        | 2024-05-10T01:00:00.000Z | staging
;


// An empty label list keeps the per-exclusion-set translation on every version: the identity is unchanged.
without_empty_label_list
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s step=1h result=(max without () (network.cost))
| SORT _timeseries;


// Unsetting every label leaves the empty identity: one series. Older nodes return the whole source document instead.
without_every_label
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: promql_timeseries_metadata_unset
PROMQL index=k8s step=1h result=(sum without (cluster, pod, region) (network.cost));

result:double | step:datetime            | _timeseries:keyword
61.0          | 2024-05-10T01:00:00.000Z | "{}"
;


// The same series with the source stored as the documents send it, rather than synthesized: the same identities.
without_stored_source
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
PROMQL index=k8s_stored_source step=1h result=(sum without (pod) (network.cost))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
18.625        | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""region"":[""eu"",""us""]}"
26.5          | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa""}"
15.875        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""region"":""us""}"
;


// ------------------------------------------------
// Label names: TranslationContext#storedNames, #resolvesStoredNames
// ------------------------------------------------

// A Prometheus label is stored under the `labels.` passthrough: unset under both pod and labels.pod.
without_prometheus_passthrough_label
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=prometheus-k8s step=1h result=(sum without (pod) (network.cost))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
18.625        | 2024-05-10T01:00:00.000Z | "{""labels"":{""__name__"":""network.cost"",""cluster"":""prod"",""region"":[""eu"",""us""]}}"
26.5          | 2024-05-10T01:00:00.000Z | "{""labels"":{""__name__"":""network.cost"",""cluster"":""qa""}}"
15.875        | 2024-05-10T01:00:00.000Z | "{""labels"":{""__name__"":""network.cost"",""cluster"":""staging"",""region"":""us""}}"
;


// A passthrough alias the plan cannot resolve (cpu for attributes.cpu) keeps the per-exclusion-set translation, where
// the source resolves it per shard.
without_otel_passthrough_alias
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=otel-metrics step=1h result=(sum without (cpu) (metrics.cpu_time))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
15.0          | 2024-05-10T01:00:00.000Z | "{""attributes"":{""state"":""active""}}"
3.0           | 2024-05-10T01:00:00.000Z | "{""attributes"":{""state"":""idle""}}"
;


// The concrete field name of a nested dimension: unset at its nested path, the emptied-out siblings kept.
without_nested_dimension_field
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_nested_aggregates
required_capability: promql_without_grouping
required_capability: fix_ts_block_loader_passthrough_aliasing
PROMQL index=otel-metrics step=1h result=(sum without (attributes.cpu) (metrics.cpu_time))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
15.0          | 2024-05-10T01:00:00.000Z | "{""attributes"":{""state"":""active""}}"
3.0           | 2024-05-10T01:00:00.000Z | "{""attributes"":{""state"":""idle""}}"
;


// ------------------------------------------------
// The le of a classic histogram: HistogramFunctionCall
// ------------------------------------------------

// The buckets of a raw child collapse per series by their whole _timeseries; le is unset where the buckets merge.
histogram_quantile_over_raw_buckets
required_capability: promql_command_v0
required_capability: promql_histogram_quantile
PROMQL index=promql_classic_histogram step=5m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:10:00.000Z" result=(round(histogram_quantile(0.5, request_duration_seconds_bucket), 0.001))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
1.583         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""api""}}"
1.5           | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""worker""}}"
1.375         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""api""}}"
1.25          | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""worker""}}"
2.167         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""r"",""job"":""repair""}}"
;


// Per-series rates of the buckets carry their _timeseries; le is unset from it.
histogram_quantile_over_rate
required_capability: promql_command_v0
required_capability: promql_histogram_quantile
PROMQL index=promql_classic_histogram step=5m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:10:00.000Z" result=(round(histogram_quantile(0.5, rate(request_duration_seconds_bucket[5m])), 0.001))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
1.583         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""api""}}"
1.5           | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""worker""}}"
1.375         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""api""}}"
1.25          | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""worker""}}"
2.167         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""r"",""job"":""repair""}}"
;


// Buckets already regrouped by promoted labels carry no _timeseries: le regroups as a promoted label.
histogram_quantile_over_by_le
required_capability: promql_command_v0
required_capability: promql_histogram_quantile
PROMQL index=promql_classic_histogram step=5m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:10:00.000Z" result=(round(histogram_quantile(0.5, sum by (job, le) (rate(request_duration_seconds_bucket[5m]))), 0.001))
| SORT job;

result:double | step:datetime            | job:keyword
1.5           | 2024-05-10T00:10:00.000Z | api
2.167         | 2024-05-10T00:10:00.000Z | repair
1.333         | 2024-05-10T00:10:00.000Z | worker
;


// ------------------------------------------------
// Unions: TranslationContext#doTranslateUnion
// ------------------------------------------------

// A branch edits its _timeseries (the histogram's le): every branch is rewritten in canonical form before the dedup.
or_with_an_edited_branch
required_capability: promql_command_v0
required_capability: promql_histogram_quantile
required_capability: promql_set_operator_union
PROMQL index=promql_classic_histogram step=5m start="2024-05-10T00:10:00.000Z" end="2024-05-10T00:10:00.000Z" result=(round(histogram_quantile(0.5, rate(request_duration_seconds_bucket[5m])), 0.001) or round(rate(request_duration_seconds_bucket{le="+Inf"}[5m]), 0.001))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword
0.05          | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""api"",""le"":""+Inf""}}"
1.583         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""api""}}"
0.013         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""worker"",""le"":""+Inf""}}"
1.5           | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""a"",""job"":""worker""}}"
0.05          | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""api"",""le"":""+Inf""}}"
1.375         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""api""}}"
0.027         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""worker"",""le"":""+Inf""}}"
1.25          | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""b"",""job"":""worker""}}"
0.017         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""r"",""job"":""repair"",""le"":""+Inf""}}"
2.167         | 2024-05-10T00:10:00.000Z | "{""labels"":{""instance"":""r"",""job"":""repair""}}"
;


// No branch edits its _timeseries: they compare as the source loads them.
or_of_loaded_branches
required_capability: promql_command_v0
required_capability: fix_promql_time_bucket_v2
required_capability: promql_set_operator_union
PROMQL index=k8s step=1h result=(max_over_time(network.cost[1h]) or min_over_time(network.cost[1h]))
| SORT _timeseries;

result:double | step:datetime            | _timeseries:keyword

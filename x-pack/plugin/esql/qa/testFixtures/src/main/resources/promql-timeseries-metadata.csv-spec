10.75         | 2024-05-10T01:00:00.000Z | "{""cluster"":""prod"",""pod"":""two"",""region"":[""eu"",""us""]}"
12.375        | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa"",""pod"":""one""}"
11.625        | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa"",""pod"":""three""}"
12.375        | 2024-05-10T01:00:00.000Z | "{""cluster"":""qa"",""pod"":""two""}"
10.125        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""pod"":""one"",""region"":""us""}"
11.375        | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""pod"":""three"",""region"":""us""}"
12.5          | 2024-05-10T01:00:00.000Z | "{""cluster"":""staging"",""pod"":""two"",""region"":""us""}"

    truncated_zero = WINDOW_FUNNEL(0 seconds, TO_DATETIME(event_nanos), action == "view", action == "cart", action == "checkout"),
    millis_one = WINDOW_FUNNEL(1 millisecond, @timestamp, action == "view", action == "cart", action == "checkout"),

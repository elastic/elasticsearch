fork
required_capability: fn_window_funnel
required_capability: fork_v9
FROM funnel_events
| FORK (WHERE device == "desktop" | STATS level = WINDOW_FUNNEL(1 hour, @timestamp, action == "view", action == "cart", action == "checkout", action == "purchase"))
       (WHERE device == "mobile" | STATS level = WINDOW_FUNNEL(1 hour, @timestamp, action == "view", action == "cart", action == "checkout", action == "purchase"))
| KEEP _fork, level
| SORT _fork
;


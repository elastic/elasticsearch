conditionsOnEvaluatedColumns
required_capability: fn_window_funnel
FROM funnel_events
| EVAL step = CASE(action == "view", 1, action == "cart", 2, action == "checkout", 3, action == "purchase", 4, 0)
| RENAME @timestamp AS ts
| STATS level = WINDOW_FUNNEL(1 hour, ts, step == 1, step == 2, step == 3, step == 4) BY user
| WHERE level >= 3
| SORT level DESC, user
;

level:integer | user:keyword
4             | u1
3             | u2
3             | u5
3             | u9
;


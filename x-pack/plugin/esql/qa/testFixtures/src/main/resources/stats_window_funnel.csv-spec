lookupJoinBeforeStats
required_capability: fn_window_funnel
required_capability: join_lookup_v12
FROM funnel_events
| EVAL language_code = CASE(action == "view", 1, action == "cart", 2, action == "checkout", 3, action == "purchase", 4)
| LOOKUP JOIN languages_lookup ON language_code
| STATS level = WINDOW_FUNNEL(1 hour, @timestamp, language_name == "English", language_name == "French", language_name == "Spanish", language_name == "German") BY user
| SORT user
;


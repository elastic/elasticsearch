required_capability: fn_window_funnel
// tag::window-funnel-by-multiple[]
FROM funnel_events
| STATS level = WINDOW_FUNNEL(15 minutes, @timestamp, action == "view", action == "cart", action == "checkout") BY user, session
| SORT user, session
// end::window-funnel-by-multiple[]
;


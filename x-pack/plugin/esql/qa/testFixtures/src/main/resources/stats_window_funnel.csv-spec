prefixLevels
required_capability: fn_window_funnel
ROW code = [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008]
| MV_EXPAND code
| EVAL ts = TO_DATETIME((code - 1000) * 1000)
| STATS
    one = WINDOW_FUNNEL(1 hour, ts, code == 1000),
    two = WINDOW_FUNNEL(1 hour, ts, code == 1000, code == 1001),
    three = WINDOW_FUNNEL(1 hour, ts, code == 1000, code == 1001, code == 1002),
    with_gap = WINDOW_FUNNEL(1 hour, ts, code == 1000, code == 1001, code == 1002, code == 1008),
    reversed = WINDOW_FUNNEL(1 hour, ts, code == 1008, code == 1001)
;

one:integer | two:integer | three:integer | with_gap:integer | reversed:integer
1           | 2           | 3             | 4                | 1
;

windowSizes
required_capability: fn_window_funnel
ROW code = [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008]
| MV_EXPAND code
| EVAL ts = TO_DATETIME((code - 1000) * 1000)
| STATS
    w2 = WINDOW_FUNNEL(2 seconds, ts, code == 1003, code == 1004, code == 1005, code == 1006, code == 1007),
    w3 = WINDOW_FUNNEL(3 seconds, ts, code == 1003, code == 1004, code == 1005, code == 1006, code == 1007),
    w4 = WINDOW_FUNNEL(4 seconds, ts, code == 1003, code == 1004, code == 1005, code == 1006, code == 1007)
;

w2:integer | w3:integer | w4:integer
3          | 4          | 5
;

overlappingConditions
required_capability: fn_window_funnel
ROW code = [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008]
| MV_EXPAND code
| EVAL ts = TO_DATETIME((code - 1000) * 1000)
| STATS
    w4 = WINDOW_FUNNEL(4 seconds, ts, code <= 1007, code >= 1002, code <= 1006, code >= 1004),
    w0 = WINDOW_FUNNEL(0 seconds, ts, code <= 1007, code >= 1002, code <= 1006, code >= 1004)
;

w4:integer | w0:integer
4          | 4
;

unsortedInput
required_capability: fn_window_funnel
ROW code = [1008, 1003, 1000, 1005, 1001, 1007, 1002, 1006, 1004]
| MV_EXPAND code
| EVAL ts = TO_DATETIME((code - 1000) * 1000)
| STATS
    three = WINDOW_FUNNEL(1 hour, ts, code == 1000, code == 1001, code == 1002),
    w2 = WINDOW_FUNNEL(2 seconds, ts, code == 1003, code == 1004, code == 1005, code == 1006, code == 1007)
;

three:integer | w2:integer
3             | 3
;

repeatedCondition
required_capability: fn_window_funnel
ROW code = [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008]
| MV_EXPAND code
| EVAL ts = TO_DATETIME((code - 1000) * 1000)
| STATS level = WINDOW_FUNNEL(1 hour, ts, code == 1004, code == 1004, code == 1004)
;

level:integer
3
;

equalTimestampsChainInConditionOrder
required_capability: fn_window_funnel
ROW event = ["0:1000", "1:1001", "1:1002", "1:1003", "2:1004"]
| MV_EXPAND event
| DISSECT event "%{t}:%{c}"
| EVAL ts = TO_DATETIME(TO_LONG(t) * 1000), code = TO_INTEGER(c)
| STATS
    two_seconds = WINDOW_FUNNEL(2 seconds, ts, code == 1000, code == 1001, code == 1002, code == 1003, code == 1004),
    one_second = WINDOW_FUNNEL(1 second, ts, code == 1000, code == 1001, code == 1002, code == 1003, code == 1004)
;

two_seconds:integer | one_second:integer
5                   | 4
;

restartAtLatestStart
required_capability: fn_window_funnel
ROW event = ["0:a", "1:a", "5:b", "6:c", "20:a", "21:b", "30:c"]
| MV_EXPAND event
| DISSECT event "%{t}:%{e}"
| EVAL ts = TO_DATETIME(TO_LONG(t) * 1000)
| STATS
    w5 = WINDOW_FUNNEL(5 seconds, ts, e == "a", e == "b", e == "c"),
    w4 = WINDOW_FUNNEL(4 seconds, ts, e == "a", e == "b", e == "c"),
    w10 = WINDOW_FUNNEL(10 seconds, ts, e == "a", e == "b", e == "c")
;

w5:integer | w4:integer | w10:integer
3          | 2          | 3
;

windowFunnel
required_capability: fn_window_funnel
// tag::window-funnel[]
FROM funnel_events
| STATS level = WINDOW_FUNNEL(1 hour, @timestamp, action == "view", action == "cart", action == "checkout", action == "purchase") BY user
| SORT user
// end::window-funnel[]
;

// tag::window-funnel-result[]
level:integer | user:keyword
4             | u1
3             | u2
0             | u3
2             | u4
3             | u5
1             | u6
0             | u7
2             | u8
3             | u9
// end::window-funnel-result[]
;


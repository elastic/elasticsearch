| WHERE emp_no <= 10005
| EVAL language_code = languages, language_name = CASE(languages == 2 OR languages == 4, "German", "English")
| LEFT OUTER JOIN languages_lookup_non_unique_key ON language_code, language_name
| EVAL countries = MV_COUNT(country)
| KEEP emp_no, language_code, language_name, countries
| SORT emp_no, countries
;

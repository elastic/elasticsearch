leftOuterJoinSubqueryOnTwoKeysOverTheSameField
required_capability: join_on_subquery
// The optimizer replaces both keys with languages, which is cast once to long and once to double.

FROM employees
| WHERE emp_no <= 10002
| EVAL a = languages, b = languages
| LEFT OUTER JOIN (
    FROM languages_lookup
    | EVAL a = TO_LONG(language_code), b = TO_DOUBLE(language_code)
    | KEEP a, b, language_name
  ) ON a, b
| KEEP emp_no, language_name
| SORT emp_no
;

emp_no:integer | language_name:keyword
10001          | French
10002          | null
;


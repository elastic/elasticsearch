;

leftOuterJoinSubqueryInFromSubqueryBranch
required_capability: join_on_subquery
required_capability: subquery_in_from_command

FROM (
    FROM employees
    | WHERE emp_no <= 10002
    | EVAL language_code = languages
    | LEFT OUTER JOIN (FROM languages_lookup) ON language_code
    | KEEP emp_no, language_name
  ), (
    FROM employees
    | WHERE emp_no == 10003
    | EVAL language_name = first_name
    | KEEP emp_no, language_name
  )
| KEEP emp_no, language_name
| SORT emp_no
;

emp_no:integer | language_name:keyword
10001          | French
10002          | null
10003          | Parto
;

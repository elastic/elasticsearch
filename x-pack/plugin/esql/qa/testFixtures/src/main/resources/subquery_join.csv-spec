leftOuterJoinSubqueryOnTheCoordinatorLoadsOnlyUsedColumns
required_capability: join_on_subquery
required_capability: implicit_casting_date_and_date_nanos

// The join runs on the coordinator. The left side must not load nanos, which nothing reads: a date in 1923 can't become a
// date_nanos, so loading it would add a warning.
FROM date_nanos, date_nanos_union_types
| EVAL k = 1
| LIMIT 1000
| LEFT OUTER JOIN (ROW k = 1, x = 2) ON k
| STATS c = COUNT(*), m = MAX(x)
;

c:long | m:integer
22     | 2
;

leftOuterJoinSubqueryMultivaluedSubqueryKeyMatchesNothing
required_capability: join_on_subquery
// A multivalued key in the subquery is reported once, whether or not a left key would have matched one of its values.

ROW key = 1
| LEFT OUTER JOIN (ROW key = [1, 2], v = "one or two") ON key
;

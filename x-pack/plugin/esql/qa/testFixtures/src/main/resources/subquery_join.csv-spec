leftOuterJoinMultivaluedKeyMatchesNothing
required_capability: join_on_subquery
// A multivalued key on the left matches nothing, as in LOOKUP JOIN, and is reported like one in the subquery.

ROW key = [1, 2]
| LEFT OUTER JOIN (ROW key = 1, v = "one") ON key
;
warning:Line 2:3: evaluation of [LEFT OUTER JOIN (ROW key = 1, v = \"one\") ON key] failed, treating result as null. Only first 20 failures recorded.
warning:Line 2:3: java.lang.IllegalArgumentException: JOIN encountered multi-value

key:integer | v:keyword
[1, 2]      | null
;


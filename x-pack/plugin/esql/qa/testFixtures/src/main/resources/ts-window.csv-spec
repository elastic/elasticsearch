###############################################
# Tests for non-multiple and window-smaller-than-bucket combos
# Uses the ts_window dataset with controlled
# data at 1-minute intervals:
#   dim a: val[m] = m + 1  (1..30)
#   dim b: val[m] = (m+1)*10  (10..300)
#   counter_val: cumulative sum of val
# Timestamps: 2024-01-01T00:00..00:29
###############################################

###############################################
# Window smaller than bucket: handled by WindowFilter
# (TranslateTimeSeriesAggregate skips internal bucket changes)
###############################################

sum_over_time_window_smaller_than_bucket_2m_window_5m_bucket
required_capability: ts_command_v0
required_capability: time_series_window_smaller_than_bucket
required_capability: fix_time_series_window_backward

TS ts_window
| STATS s = sum(sum_over_time(val, 2m)) BY dim, time_bucket = TBUCKET(5minute)
| SORT time_bucket, dim
| LIMIT 20;

s:long | dim:keyword | time_bucket:datetime
9      | a           | 2024-01-01T00:00:00.000Z
90     | b           | 2024-01-01T00:00:00.000Z
19     | a           | 2024-01-01T00:05:00.000Z
190    | b           | 2024-01-01T00:05:00.000Z
29     | a           | 2024-01-01T00:10:00.000Z
290    | b           | 2024-01-01T00:10:00.000Z
39     | a           | 2024-01-01T00:15:00.000Z
390    | b           | 2024-01-01T00:15:00.000Z
49     | a           | 2024-01-01T00:20:00.000Z
490    | b           | 2024-01-01T00:20:00.000Z
59     | a           | 2024-01-01T00:25:00.000Z
590    | b           | 2024-01-01T00:25:00.000Z
;


increase_window_smaller_than_bucket_2m_window_4m_bucket_exact_half
required_capability: ts_command_v0
required_capability: time_series_window_smaller_than_bucket
required_capability: fix_time_series_window_backward
required_capability: fix_esql_small_windows

TS ts_window
| STATS s = sum(increase(counter_val, 2m)) BY dim, time_bucket = TBUCKET(4minute)
| SORT time_bucket, dim
| LIMIT 14;

s:double | dim:keyword | time_bucket:datetime
5.0      | a           | 2024-01-01T00:00:00.000Z
50.0     | b           | 2024-01-01T00:00:00.000Z
10.0     | a           | 2024-01-01T00:04:00.000Z
100.0    | b           | 2024-01-01T00:04:00.000Z
15.0     | a           | 2024-01-01T00:08:00.000Z
150.0    | b           | 2024-01-01T00:08:00.000Z
20.0     | a           | 2024-01-01T00:12:00.000Z
200.0    | b           | 2024-01-01T00:12:00.000Z
25.0     | a           | 2024-01-01T00:16:00.000Z
250.0    | b           | 2024-01-01T00:16:00.000Z
30.0     | a           | 2024-01-01T00:20:00.000Z
300.0    | b           | 2024-01-01T00:20:00.000Z
35.0     | a           | 2024-01-01T00:24:00.000Z
350.0    | b           | 2024-01-01T00:24:00.000Z
;

rate_window_smaller_than_bucket_2m_window_4m_bucket_exact_half
required_capability: ts_command_v0
required_capability: time_series_window_smaller_than_bucket
required_capability: fix_time_series_window_backward
required_capability: fix_esql_small_windows

TS ts_window
| STATS r = avg(rate(counter_val, 2m)) BY dim, time_bucket = TBUCKET(4minute)
| EVAL r = ROUND(r, 6)
| SORT time_bucket, dim
| LIMIT 14;

dim:keyword | time_bucket:datetime     | r:double
a           | 2024-01-01T00:00:00.000Z | 0.041667
b           | 2024-01-01T00:00:00.000Z | 0.416667
a           | 2024-01-01T00:04:00.000Z | 0.083333
b           | 2024-01-01T00:04:00.000Z | 0.833333
a           | 2024-01-01T00:08:00.000Z | 0.125
b           | 2024-01-01T00:08:00.000Z | 1.25
a           | 2024-01-01T00:12:00.000Z | 0.166667
b           | 2024-01-01T00:12:00.000Z | 1.666667
a           | 2024-01-01T00:16:00.000Z | 0.208333
b           | 2024-01-01T00:16:00.000Z | 2.083333
a           | 2024-01-01T00:20:00.000Z | 0.25
b           | 2024-01-01T00:20:00.000Z | 2.5
a           | 2024-01-01T00:24:00.000Z | 0.291667
b           | 2024-01-01T00:24:00.000Z | 2.916667
;

# AwaitsFix: https://github.com/elastic/elasticsearch/issues/152658
increase_window_smaller_than_bucket_2m_window_4m_tstep_exact_half-Ignore
required_capability: ts_command_v0
required_capability: time_series_window_smaller_than_bucket
required_capability: fix_time_series_window_backward
required_capability: fix_esql_small_windows
required_capability: tstep
required_capability: fix_tstep_bucket_rounding
request_time_filter: 2024-01-01T00:00:00.000Z,2024-01-01T00:30:00.000Z

TS ts_window
| STATS s = sum(increase(counter_val, 2m)) BY dim, time_bucket = TSTEP(4minute)
| SORT time_bucket, dim
| LIMIT 14;

s:double | dim:keyword | time_bucket:datetime
5.0      | a           | 2024-01-01T00:04:00.000Z
50.0     | b           | 2024-01-01T00:04:00.000Z
10.0     | a           | 2024-01-01T00:08:00.000Z
100.0    | b           | 2024-01-01T00:08:00.000Z
15.0     | a           | 2024-01-01T00:12:00.000Z
150.0    | b           | 2024-01-01T00:12:00.000Z
20.0     | a           | 2024-01-01T00:16:00.000Z
200.0    | b           | 2024-01-01T00:16:00.000Z
25.0     | a           | 2024-01-01T00:20:00.000Z
250.0    | b           | 2024-01-01T00:20:00.000Z
30.0     | a           | 2024-01-01T00:24:00.000Z
300.0    | b           | 2024-01-01T00:24:00.000Z
;


request_time_filter: 2024-01-01T00:00:00.000Z,2024-01-01T00:30:00.000Z

TS ts_window
| STATS s = sum(sum_over_time(val, 10m)) BY dim, time_bucket = TSTEP(5minute)
| SORT time_bucket, dim
| LIMIT 20;

s:long | dim:keyword | time_bucket:datetime
1      | a           | 2024-01-01T00:00:00.000Z
10     | b           | 2024-01-01T00:00:00.000Z
21     | a           | 2024-01-01T00:05:00.000Z
210    | b           | 2024-01-01T00:05:00.000Z
65     | a           | 2024-01-01T00:10:00.000Z
650    | b           | 2024-01-01T00:10:00.000Z
115    | a           | 2024-01-01T00:15:00.000Z
1150   | b           | 2024-01-01T00:15:00.000Z
165    | a           | 2024-01-01T00:20:00.000Z
1650   | b           | 2024-01-01T00:20:00.000Z
215    | a           | 2024-01-01T00:25:00.000Z
2150   | b           | 2024-01-01T00:25:00.000Z
234    | a           | 2024-01-01T00:30:00.000Z
2340   | b           | 2024-01-01T00:30:00.000Z
;

# Data has a gap at minutes 10-19: the bucket labeled 00:15 exists only through
# window expansion and gets its value from the partial channel of (00:05, 00:10].
non_multiple_with_partial_data_at_bucket_edge_tstep
required_capability: ts_command_v0
required_capability: per_aggregate_windows
required_capability: fix_time_series_window_backward
required_capability: tstep
required_capability: fix_tstep_bucket_rounding
request_time_filter: 2024-01-01T00:00:00.000Z,2024-01-01T00:30:00.000Z

TS ts_window
| WHERE dim == "a" AND (val <= 10 OR val >= 21)
| STATS s = sum(sum_over_time(val, 7m)) BY time_bucket = TSTEP(5minute)
| SORT time_bucket
| LIMIT 20;

s:long | time_bucket:datetime
1      | 2024-01-01T00:00:00.000Z
21     | 2024-01-01T00:05:00.000Z
45     | 2024-01-01T00:10:00.000Z
10     | 2024-01-01T00:15:00.000Z
21     | 2024-01-01T00:20:00.000Z
141    | 2024-01-01T00:25:00.000Z
165    | 2024-01-01T00:30:00.000Z
;

# The request time filter starts mid-bucket at 00:07, so the TSTEP grid is anchored at
# a non-round instant. Bucket boundaries are not epoch multiples of the bucket width,
# which catches hidden epoch-alignment assumptions in the window decomposition.
offset_anchored_tstep_windows
required_capability: ts_command_v0
required_capability: per_aggregate_windows
required_capability: fix_time_series_window_backward
required_capability: tstep
required_capability: fix_tstep_bucket_rounding
request_time_filter: 2024-01-01T00:07:00.000Z,2024-01-01T00:30:00.000Z

TS ts_window
| WHERE dim == "a"
| STATS s7 = sum(sum_over_time(val, 7m)), s12 = sum(sum_over_time(val, 12m)) BY time_bucket = TSTEP(5minute)
| SORT time_bucket
| LIMIT 20;

s7:long | s12:long | time_bucket:datetime
8       | 8        | 2024-01-01T00:07:00.000Z
63      | 63       | 2024-01-01T00:12:00.000Z
105     | 143      | 2024-01-01T00:17:00.000Z
140     | 210      | 2024-01-01T00:22:00.000Z
175     | 270      | 2024-01-01T00:27:00.000Z
114     | 234      | 2024-01-01T00:32:00.000Z
;

# Multi-dimension series: the partial-channel merge must interact correctly with the
# per-(cluster, pod) tsids and their dimension-value remapping for expanded buckets.
non_multiple_window_with_multiple_dimensions
required_capability: ts_command_v0
required_capability: per_aggregate_windows
required_capability: fix_time_series_window_backward

TS k8s
| STATS s = sum(sum_over_time(network.bytes_in, 7minute)) BY cluster, pod, time_bucket = TBUCKET(5minute)
| SORT time_bucket, cluster, pod
| LIMIT 12;

s:long | cluster:keyword | pod:keyword | time_bucket:datetime

# Data has a gap at minutes 10-19: the bucket at 00:10 gets its value only from
# the partial channel of the 00:05 bucket, and the empty 00:15 bucket is not emitted.
non_multiple_with_partial_data_at_bucket_edge
required_capability: ts_command_v0
required_capability: per_aggregate_windows
required_capability: fix_time_series_window_backward

TS ts_window
| WHERE dim == "a" AND (val <= 10 OR val >= 21)
| STATS s = sum(sum_over_time(val, 7m)) BY time_bucket = TBUCKET(5minute)
| SORT time_bucket
| LIMIT 20;


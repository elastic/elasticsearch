# The nested expression is extracted into an eval while the window decomposes into the
# full and partial channels; the bucket inside the partial filter must stay untouched.
sum_over_time_nested_expression_non_multiple
required_capability: ts_command_v0
required_capability: per_aggregate_windows
required_capability: fix_time_series_window_backward

TS ts_window
| STATS s = sum(sum_over_time(val + 1, 7m)) BY dim, time_bucket = TBUCKET(5minute)
| SORT time_bucket, dim
| LIMIT 20;


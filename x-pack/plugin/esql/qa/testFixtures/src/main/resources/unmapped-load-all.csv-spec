// All three dotted leaves are keyword-mapped in unmapped_multi_mapped and unmapped in the siblings; each is partially mapped, so ids 8 and 9
// carry their mapped values and ids 1-7 the values (if any) loaded from the siblings' _source, one column per leaf.
multiIndexMappedFieldsAllDottedLeaves
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*, -unmapped_multi_mapped_mixed

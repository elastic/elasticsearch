inlineStatsByMappedFieldWithExpansion
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| INLINE STATS count = COUNT(*) BY message
| SORT @timestamp DESC
| LIMIT 3
;

@timestamp:datetime      | client_ip:ip | event_duration:long | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword   | count:long | message:keyword
2024-10-23T13:55:01.543Z | 173.21.3.15  | 1756466             | 1                     | a                       | 1756468                         | Disconnected from 10.1.0.1 | 1          | Connected to 10.1.0.1!
2024-10-23T13:53:55.832Z | 173.21.3.15  | 5033754             | 2                     | b                       | 5033756                         | Disconnection error        | 3          | Connection error?
2024-10-23T13:52:55.015Z | 173.21.3.15  | 8268152             | 3                     | c                       | 8268154                         | Disconnection error        | 3          | Connection error?
;


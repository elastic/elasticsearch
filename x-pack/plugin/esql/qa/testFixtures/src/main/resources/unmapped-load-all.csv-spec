loadAllSubqueryOuterWhereMaterializesAllBranches
required_capability: optional_fields_load_all_subqueries
required_capability: subquery_in_from_command

SET unmapped_fields="LOAD_ALL"\;
FROM (FROM partial_mapping_sample_data | WHERE message == "42"),
     (FROM partial_mapping_sample_data | WHERE message == "Connection error?")
| WHERE unmapped_message == "Disconnection error"
| KEEP messag*, unmapped_mess*
| SORT message
;


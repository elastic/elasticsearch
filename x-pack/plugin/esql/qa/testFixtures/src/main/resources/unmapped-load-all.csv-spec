// KEEP a field that is present in neither the mapping nor _source: it is demand-loaded as a null keyword column.
keepFieldAbsentFromSource
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP @timestamp, does_not_exist
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | does_not_exist:keyword
2024-10-23T12:15:03.360Z | null
2024-10-23T12:27:28.948Z | null
2024-10-23T13:33:34.937Z | null
;


;

// DROP wildcard applied _after_ the join: removes expanded unmapped source fields from the output.
lookupJoinDropWildcardAfterJoin
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| LOOKUP JOIN keyword_languages_lookup ON language_code
| DROP unmapped_*
| SORT @timestamp
| LIMIT 2
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | language_name:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g                       | German
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f                       | Spanish
;

// Lookup index field shadows an unmapped source field of the same name: the blob must not emit a second language_code column.
// Joining on the mapped message field; language_code comes from the lookup and replaces the unmapped _source language_code.
lookupJoinLookupFieldShadowsUnmappedField
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| LOOKUP JOIN message_language_code_lookup ON message
| KEEP @timestamp, *language*, *unmapped*
| SORT @timestamp
| LIMIT 3
;


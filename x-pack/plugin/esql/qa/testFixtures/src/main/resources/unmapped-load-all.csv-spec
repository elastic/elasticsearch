2          | null                 | null
3          | foo3                 | null
4          | null                 | null
5          | [arr1, arr2]         | null
6          | null                 | deep6
7          | null                 | null
8          | mfoo8                | mleaf8
9          | [mfa, mfb]           | null
;

// All three dotted leaves are keyword-mapped in unmapped_multi_mapped and unmapped in the siblings; each is partially mapped, so ids 8 and 9
// carry their mapped values and ids 1-7 the values (if any) loaded from the siblings' _source, one column per leaf.
multiIndexMappedFieldsAllDottedLeaves
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*, -unmapped_multi_mapped_mixed
| KEEP id, unmapped*, unmapped.*
| SORT id
;

id:keyword | unmapped:keyword | unmapped.bar:keyword | unmapped.deep.leaf:keyword | unmapped.foo:keyword
1          | null             | null                 | null                       | foo1
2          | null             | bar2                 | null                       | null
3          | null             | null                 | null                       | foo3
4          | scalar4          | null                 | null                       | null
5          | null             | null                 | null                       | [arr1, arr2]
6          | null             | null                 | deep6                      | null
7          | null             | bar7                 | null                       | null
8          | null             | mbar8                | mleaf8                     | mfoo8
9          | null             | null                 | null                       | [mfa, mfb]
;

// The KEEP names every column explicitly, so it contributes no wildcard and the pattern collapses to NONE: nothing is expanded and the
// plan is the one LOAD would build. The bare scalar unmapped is an object in unmapped_multi_mapped and unmapped everywhere else, so its
// value at id 4 (scalar4) is demand-loaded from _source by the explicit reference; the dotted unmapped.foo merges its two legs.
// Kept as the reference case that LOAD_ALL with an all-literal KEEP is indistinguishable from LOAD.
multiIndexMappedDottedAndUnmappedScalarCoexist
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*, -unmapped_multi_mapped_mixed
| KEEP id, unmapped, unmapped.foo
| SORT id
;

id:keyword | unmapped:keyword | unmapped.foo:keyword
1          | null             | foo1
2          | null             | null
3          | null             | foo3
4          | scalar4          | null
5          | null             | [arr1, arr2]
6          | null             | null
7          | null             | null
8          | null             | mfoo8
9          | null             | [mfa, mfb]
;

// Queries five indices with no KEEP and no DROP: unmapped_multi_mapped, which maps the three dotted leaves, plus the four
// mapping-unmapped_multi.json indices, which map only id. Each dotted leaf is therefore a real column that merges its mapped leg with
// the _source legs of its siblings. The bare scalar unmapped is mapped nowhere, so it reaches the output only through the LOAD_ALL
// expansion. With no KEEP there is no order to replay, so the expanded column is appended on the right.
multiIndexMappedAndUnmappedNoProjection

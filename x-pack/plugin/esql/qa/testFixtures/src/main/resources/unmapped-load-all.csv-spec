// EVAL shadows an unmapped source field name without referencing it (assigns a literal): the shadowed
// field becomes a regular output column and is excluded from expansion.
evalShadowsUnmappedFieldWithLiteral
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| EVAL unmapped_message = "x"
| SORT @timestamp
;


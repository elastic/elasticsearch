###########################################################
# Object and array expansion: flatten to leaf columns     #
###########################################################
// An array-valued unmapped source field expands to a multivalue keyword column (its scalar elements), not a blind string.
arrayFieldExpandsToMultivalue
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_array_data
| EVAL n = MV_COUNT(tags)
| KEEP id, tags, n
| SORT id
;

id:keyword | tags:keyword | n:integer
1          | [web, api]   | 2
2          | web          | 1
3          | web          | 1
;

arrayOfObjectsFlattensToDottedLeafMultivalue
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_array_data METADATA _source
| KEEP id, samples*, _source
| SORT id
;

id:keyword | samples.nested:keyword | _source:_source
1          | [x, y]                 | "{""id"":""1"",""tags"":[""web"",""api""],""samples"":[{""nested"":""x""},{""nested"":""y""}]}"
2          | z                      | "{""id"":""2"",""tags"":""web"",""samples"":{""nested"":""z""}}"
3          | null                   | "{""id"":""3"",""tags"":""web""}"
;


// A KEEP wildcard that matches only unmapped source fields is tolerated under LOAD_ALL: the wildcard
// matches nothing visible at analysis time, but instead of failing with "No matches found" the pattern
// is captured and applied during _unmapped_fields expansion. Keeps @timestamp plus every unmapped source
// field matching unmapped_* (unmapped.nested does not match the underscore).
keepUnmappedWildcardPrefix
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP @timestamp, unmapped_*
| SORT @timestamp
;

@timestamp:datetime      | unmapped_event_duration:keyword | unmapped_message:keyword
2024-10-23T12:15:03.360Z | 3450234                         | Disconnected from 10.1.0.3
2024-10-23T12:27:28.948Z | 2764890                         | Disconnected from 10.1.0.2
2024-10-23T13:33:34.937Z | 1232383                         | 43
2024-10-23T13:51:54.732Z | 725449                          | Disconnection error
2024-10-23T13:52:55.015Z | 8268154                         | Disconnection error
2024-10-23T13:53:55.832Z | 5033756                         | Disconnection error
2024-10-23T13:55:01.543Z | 1756468                         | Disconnected from 10.1.0.1
;

// Synthetic source keeps unmapped fields alive, since dynamic: false stores them in _ignored_source. The wildcard matches no
// mapped field, so only the expansion can produce the column - naming it outright would just re-test LOAD, which
// syntheticSourceLoadsScalarUnmappedField in unmapped-load.csv-spec does.
syntheticSourceKeepScalarUnmappedField
required_capability: optional_fields_load_all_v2
skip_columnar: dynamic:false unmapped fields are dropped at ingest in columnar mode (no _ignored_source), so unmapped_fields=load has nothing to read - lossy by design

SET unmapped_fields="LOAD_ALL"\;
FROM synthetic_source_partial_mapping
| KEEP @timestamp, unmapped_messag*
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | unmapped_message:keyword
2024-10-23T12:15:03.360Z | Disconnected from 10.1.0.3
2024-10-23T12:27:28.948Z | Disconnected from 10.1.0.2
2024-10-23T13:33:34.937Z | 43
;

// A field mapped on only some of the queried indices is read from the mapping where it exists and from _source where
// it does not, so both legs produce values. Mirrors crossMappingLoadsBothLegs in unmapped-load.csv-spec.
crossMappingLoadsBothLegs
required_capability: optional_fields_load_all_v2
skip_columnar: dynamic:false unmapped fields are dropped at ingest in columnar mode (no _ignored_source), so unmapped_fields=load_all has nothing to read - lossy by design

SET unmapped_fields="LOAD_ALL"\;
FROM cross_mapping_a, cross_mapping_b METADATA _index
| SORT foo NULLS LAST, bar NULLS LAST
;

bar:keyword | foo:keyword | _index:keyword
b1          | a1          | cross_mapping_a
b2          | a2          | cross_mapping_b
;


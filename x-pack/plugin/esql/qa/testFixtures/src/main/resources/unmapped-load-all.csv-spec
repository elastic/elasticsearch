###################################
# ENRICH with LOAD_ALL             #
###################################

enrichExpandsUnmappedFields
skip_flattened_rewrite: enrich_output_type_mismatch
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| EVAL lc = language_code::integer
| ENRICH languages_policy ON lc
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword   | lc:integer | language_name:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g                       | 3450234                         | Disconnected from 10.1.0.3 | 4          | German
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f                       | 2764890                         | Disconnected from 10.1.0.2 | 3          | Spanish
2024-10-23T13:33:34.937Z | 173.21.0.5   | 1232381             | 42                     | 2                     | e                       | 1232383                         | 43                         | 2          | French
;

// ENRICH WITH (non-renamed output): language_name is explicitly requested without renaming, so it does not shadow
// the unmapped source field language_code, which still expands from the blob.
enrichWithNamedOutputExpandsUnmappedFields
skip_flattened_rewrite: enrich_output_type_mismatch
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| EVAL lc = language_code::integer
| ENRICH languages_policy ON lc WITH language_name
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword   | lc:integer | language_name:keyword

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*
| EVAL foo = unmapped.foo::keyword
| KEEP id, foo
| SORT id
;

id:keyword | foo:keyword
1          | foo1
10         | lazy fox
11         | [lazy fox, quick dog]
12         | null
2          | null
3          | foo3
4          | null
5          | [arr1, arr2]
6          | null
7          | null
8          | mfoo8
9          | [mfa, mfb]
;

// WHERE on the cast-resolved union column filters the computed keyword value (not pushed to Lucene), keeping only ids with a value.
multiIndexTypeConflictCastThenFilteredByWhere
required_capability: optional_fields_load_all
required_capability: optional_fields_fix_load_object_from_synthetic_source

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*
| EVAL foo = unmapped.foo::keyword
| WHERE foo IS NOT NULL
| KEEP id, foo
| SORT id
;

id:keyword | foo:keyword
1          | foo1
10         | lazy fox
11         | [lazy fox, quick dog]
3          | foo3
5          | [arr1, arr2]
8          | mfoo8
9          | [mfa, mfb]
;

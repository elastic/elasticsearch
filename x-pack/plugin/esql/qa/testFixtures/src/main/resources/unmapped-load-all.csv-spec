// EVAL and RENAME targets deliberately clash with unmapped source field names
// (unmapped_event_duration, unmapped_message): the shadowed fields become regular output columns
// and are excluded from expansion, leaving only language_code and unmapped.nested expanded.
complexDropRenameEval
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| EVAL unmapped_event_duration = event_duration / 1000
| DROP event_duration, client_ip
| RENAME message AS unmapped_message
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | unmapped_message:keyword | unmapped_event_duration:long | language_code:keyword | unmapped.nested:keyword
2024-10-23T12:15:03.360Z | Connected to 10.1.0.3! | 3450             | 4                     | g
2024-10-23T12:27:28.948Z | Connected to 10.1.0.2! | 2764             | 3                     | f
2024-10-23T13:33:34.937Z | 42                     | 1232             | 2                     | e
;

// An index with no mapping at all: LOAD_ALL expands every source field into its own keyword column.
allFieldsUnmapped
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM no_mapping_sample_data
| SORT @timestamp
| LIMIT 1
;

@timestamp:keyword        | client_ip:keyword | event_duration:keyword | language_code:keyword | message:keyword        | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword
2024-10-23T12:15:03.360Z  | 173.21.2.162      | 3450232                | 4                     | Connected to 10.1.0.3! | g                       | 3450234                         | Disconnected from 10.1.0.3
;

// A DROP pattern that only matches unmapped source fields excludes those fields from expansion,
// leaving unmapped.nested (which does not match the underscore).
dropUnmappedByPattern
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| DROP unmapped_*
| SORT @timestamp
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f
2024-10-23T13:33:34.937Z | 173.21.0.5   | 1232381             | 42                     | 2                     | e
2024-10-23T13:51:54.732Z | 173.21.3.15  | 725447              | Connection error?      | 1                     | d
2024-10-23T13:52:55.015Z | 173.21.3.15  | 8268152             | Connection error?      | 3                     | c
2024-10-23T13:53:55.832Z | 173.21.3.15  | 5033754             | Connection error?      | 2                     | b
2024-10-23T13:55:01.543Z | 173.21.3.15  | 1756466             | Connected to 10.1.0.1! | 1                     | a
;

############################
# Gap coverage: known-failing tests documenting intended behaviour
############################

// (gap): multi-value JSON arrays are rendered via List.toString() ("[web, api]") instead of a
// multi-value keyword block. Only multi-element arrays trigger this: single-element CSV arrays
// are collapsed to scalars by the data loader.
arraysGap
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_array_data
| SORT id
;

id:keyword | tags:keyword
1          | [web,api]
2          | web
3          | web
;

// (gap): JSON object values are rendered via Map.toString() ("{baz=world}") instead of valid JSON.
objectsGap
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_object_data
| SORT id
;

id:keyword | extra:keyword
1          | hello
2          | "{""baz"":""world""}"
;

// (gap): for a field mapped on only some shards, the source value from the shards where it is
// unmapped is silently dropped, with no representation in the output.
crossMappingGap
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM cross_mapping_a, cross_mapping_b METADATA _index
| SORT foo NULLS LAST, bar NULLS LAST
;

bar:keyword | foo:keyword | _index:keyword
b1          | a1          | cross_mapping_a
b2          | a2          | cross_mapping_b
;

// (gap): a KEEP wildcard that only matches unmapped source fields throws
// "No matches found for pattern [unmapped_*]" because unmapped fields are not yet visible to the
// analyzer as columns (expansion happens after analysis). Intended: keep @timestamp plus every
// unmapped source field matching unmapped_* (unmapped.nested does not match the underscore).
keepUnmappedWildcardPrefix
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP @timestamp, unmapped_*
| SORT @timestamp
;

@timestamp:datetime      | unmapped_event_duration:keyword | unmapped_message:keyword
2024-10-23T12:15:03.360Z | 3450234                         | Disconnected from 10.1.0.3
2024-10-23T12:27:28.948Z | 2764890                         | Disconnected from 10.1.0.2
2024-10-23T13:33:34.937Z | 1232383                         | 43
2024-10-23T13:51:54.732Z | 725449                          | Disconnection error
2024-10-23T13:52:55.015Z | 8268154                         | Disconnection error
2024-10-23T13:53:55.832Z | 5033756                         | Disconnection error
2024-10-23T13:55:01.543Z | 1756468                         | Disconnected from 10.1.0.1
;

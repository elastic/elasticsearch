// Same pattern-awareness as the subquery case: KEEP * admits unmapped_message, so the mention still reaches this branch.
forkKeepStarBranchStillGetsMention
required_capability: optional_fields_load_all_fork
required_capability: fork_v9

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| FORK (WHERE unmapped_message == "43") (KEEP *)
| STATS with_message = COUNT(*) WHERE unmapped_message IS NOT NULL, rows = COUNT(*)
;

with_message:long | rows:long
8                 | 8
;

// Contrast with the KEEP * branch above: messag* does not admit unmapped_message, so the mention stops at the branch that made it.

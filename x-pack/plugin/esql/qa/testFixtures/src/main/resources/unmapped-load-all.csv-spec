2024-10-23T13:33:34.937Z | fr                    | e                       | 1232383                         | 43
;

// Match field is unmapped and absent from _source: it is null for every row, so no lookup-table rows match and the
// added language_code column is null for all rows. The other unmapped source fields still expand from the blob.
lookupJoinMissingMatchField
required_capability: optional_fields_load_all_v2


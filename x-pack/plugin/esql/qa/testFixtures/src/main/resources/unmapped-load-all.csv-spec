###################################
# LOOKUP JOIN with LOAD_ALL        #
###################################

// Basic: unmapped _source fields expand alongside lookup-index fields. language_code (unmapped, keyword) serves as the join key
// and therefore becomes a real query column — it is excluded from the blob and does not reappear as an expanded column.
lookupJoinExpandsUnmappedFields
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| LOOKUP JOIN keyword_languages_lookup ON language_code
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword   | language_name:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g                       | 3450234                         | Disconnected from 10.1.0.3 | German
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f                       | 2764890                         | Disconnected from 10.1.0.2 | Spanish
2024-10-23T13:33:34.937Z | 173.21.0.5   | 1232381             | 42                     | 2                     | e                       | 1232383                         | 43                         | French
;

// Coordinator LOOKUP JOIN: the $unmapped_fields blob crosses the coordinator exchange and expands on the coordinator.
lookupJoinCoordinatorExpandsUnmappedFields
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| LOOKUP JOIN _coordinator:keyword_languages_lookup ON language_code
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword   | language_name:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g                       | 3450234                         | Disconnected from 10.1.0.3 | German
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f                       | 2764890                         | Disconnected from 10.1.0.2 | Spanish
2024-10-23T13:33:34.937Z | 173.21.0.5   | 1232381             | 42                     | 2                     | e                       | 1232383                         | 43                         | French
;

// KEEP wildcard before the join: the blob is preserved through the KEEP (special handling), and the *message* pattern
// restricts it so only unmapped_message (which contains "message") expands — other unmapped fields are excluded.
// message_type is added by the join after the KEEP.
lookupJoinKeepWildcardBeforeJoin
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP @timestamp, *message*
| LOOKUP JOIN partial_message_types_lookup ON message
| SORT @timestamp
| LIMIT 3
;

@timestamp:datetime      | message:keyword        | unmapped_message:keyword   | message_type:keyword
2024-10-23T12:15:03.360Z | Connected to 10.1.0.3! | Disconnected from 10.1.0.3 | connection
2024-10-23T12:27:28.948Z | Connected to 10.1.0.2! | Disconnected from 10.1.0.2 | connection
2024-10-23T13:33:34.937Z | 42                     | 43                         | numeric
;

lookupJoinDropWildcardBeforeJoin
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| DROP unmapped_*
| LOOKUP JOIN keyword_languages_lookup ON language_code
| SORT @timestamp
| LIMIT 2
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | language_name:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g                       | German
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f                       | Spanish
;

// Expression-based join: lc_expr derives from the unmapped language_code; language_code is then dropped to avoid
// ambiguity with the lookup's language_code field. The ON expression references lc_expr (an unmapped-source value)
// and the lookup's language_code via an explicit == expression. The remaining unmapped fields expand via the blob.
lookupJoinOnExpressionWithUnmappedField
required_capability: optional_fields_load_all_v2
required_capability: lookup_join_on_boolean_expression

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| EVAL lc_expr = language_code
| DROP language_code
| LOOKUP JOIN keyword_languages_lookup ON lc_expr == language_code
| KEEP @timestamp, lc_expr, *unmapped*
| SORT @timestamp
| LIMIT 3
;


// Same nulls and warning as the load twin in unmapped-load.csv-spec: a comma-separated FROM does not reach the non-loadable
// marker, so it warns instead of failing the way the subquery form does (298_unmapped_load_all_subquery_non_loadable.yml).
loadAllCommaFormDenseVectorWarnsAndNulls
required_capability: optional_fields_load_all_v2
required_capability: optional_fields_fix_partially_unmapped_dense_vector
required_capability: optional_fields_warn_non_loadable_punk

SET unmapped_fields="LOAD_ALL"\;
FROM dense_vector, dense_vector_unmapped METADATA _index
| KEEP _index, id, float_vector
| SORT _index, id
| LIMIT 6
;

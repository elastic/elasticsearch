required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| EVAL dur_secs = event_duration / 1000
| EVAL msg_len = LENGTH(message)
| WHERE msg_len > 5
| SORT @timestamp
| KEEP @timestamp, message, dur_secs, msg_len
| LIMIT 3
;


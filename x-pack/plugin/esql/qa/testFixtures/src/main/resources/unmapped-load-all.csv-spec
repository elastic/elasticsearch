// Asking for the object field itself (not a wildcard) yields null - object values have no keyword representation.
explicitObjectFieldIsNull
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_array_data METADATA _source
| KEEP id, samples, _source
| SORT id
;

id:keyword | samples:keyword | _source:_source
1          | null            | "{""id"":""1"",""tags"":[""web"",""api""],""samples"":[{""nested"":""x""},{""nested"":""y""}]}"
2          | null            | "{""id"":""2"",""tags"":""web"",""samples"":{""nested"":""z""}}"
3          | null            | "{""id"":""3"",""tags"":""web""}"
;

// An object-valued unmapped source field has no keyword representation of its own, so it contributes no "extra" value; its leaves
// become their own dotted columns instead. Here "extra" is a scalar in one document and an object in the other, so both an "extra"
// and an "extra.baz" column appear.
objectFieldFlattensToLeafColumns
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_object_data
| SORT id
;

id:keyword | extra:keyword | extra.baz:keyword
1          | hello         | null
2          | null          | world
;

// Same data and mapping as fromNoProjection, but with synthetic source, which reconstructs the dotted key "unmapped.nested" as a
// nested object. Flattening that object back to its leaf yields the same "unmapped.nested" column, so LOAD_ALL over a
// synthetic-source index produces exactly the output of the non-synthetic fromNoProjection above.
syntheticSourceObjectFlattensLikeStoredSource
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM synthetic_source_partial_mapping
| SORT @timestamp
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword
2024-10-23T12:15:03.360Z | 173.21.2.162 | 3450232             | Connected to 10.1.0.3! | 4                     | g                       | 3450234                         | Disconnected from 10.1.0.3
2024-10-23T12:27:28.948Z | 173.21.2.113 | 2764888             | Connected to 10.1.0.2! | 3                     | f                       | 2764890                         | Disconnected from 10.1.0.2
2024-10-23T13:33:34.937Z | 173.21.0.5   | 1232381             | 42                     | 2                     | e                       | 1232383                         | 43
2024-10-23T13:51:54.732Z | 173.21.3.15  | 725447              | Connection error?      | 1                     | d                       | 725449                          | Disconnection error
2024-10-23T13:52:55.015Z | 173.21.3.15  | 8268152             | Connection error?      | 3                     | c                       | 8268154                         | Disconnection error
2024-10-23T13:53:55.832Z | 173.21.3.15  | 5033754             | Connection error?      | 2                     | b                       | 5033756                         | Disconnection error
2024-10-23T13:55:01.543Z | 173.21.3.15  | 1756466             | Connected to 10.1.0.1! | 1                     | a                       | 1756468                         | Disconnected from 10.1.0.1
;

// LOAD_ALL unions every leaf across the indices into its own keyword column; a row carries a value only where that leaf
// exists. A bare scalar "unmapped" (id 4) is its own column and never collides with the object twin that contributes leaves.
multiIndexDivergentUnmappedFieldShapes
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_stored_foo, unmapped_multi_stored_bar, unmapped_multi_synthetic, unmapped_multi_stored_mixed
| SORT id
;

id:keyword | unmapped:keyword | unmapped.bar:keyword | unmapped.deep.leaf:keyword | unmapped.foo:keyword
1          | null             | null                 | null                       | foo1
2          | null             | bar2                 | null                       | null
3          | null             | null                 | null                       | foo3
4          | scalar4          | null                 | null                       | null
5          | null             | null                 | null                       | [arr1, arr2]
6          | null             | null                 | deep6                      | null
7          | null             | bar7                 | null                       | null
;


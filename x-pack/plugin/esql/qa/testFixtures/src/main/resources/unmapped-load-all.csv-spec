// RENAME's target name shadows the unmapped source field of the same name, so it is not expanded.
renameMappedFieldConflictsWithUnmapped
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| RENAME message AS language_code
| SORT @timestamp
;

@timestamp:datetime      | client_ip:ip | event_duration:long | language_code:keyword  | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword

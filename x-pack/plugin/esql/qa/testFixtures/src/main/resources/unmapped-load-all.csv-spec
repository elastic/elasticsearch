2024-10-23T12:27:28.948Z | Disconnected from 10.1.0.2
2024-10-23T13:33:34.937Z | 43
;

// A field mapped on only some of the queried indices is read from the mapping where it exists and from _source where
// it does not, so both legs produce values. Mirrors crossMappingLoadsBothLegs in unmapped-load.csv-spec.
crossMappingLoadsBothLegs
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM cross_mapping_a, cross_mapping_b METADATA _index
| SORT foo NULLS LAST, bar NULLS LAST
;

bar:keyword | foo:keyword | _index:keyword
b1          | a1          | cross_mapping_a
b2          | a2          | cross_mapping_b

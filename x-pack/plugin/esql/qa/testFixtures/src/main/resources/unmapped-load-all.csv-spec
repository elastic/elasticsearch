SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| DROP @timestamp, client_ip, event_duration, message, language_code, unmapped*
| EVAL n = 1
;

n:integer
1
1
1
1
1
1
1
;

#########
# STATS #
#########

statsCountStar
required_capability: optional_fields_load_all_stats

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| STATS c = COUNT(*)
;

c:long
7
;

statsByMappedField
required_capability: optional_fields_load_all_stats

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| STATS c = COUNT(*) BY message
| SORT message
;

c:long | message:keyword
1      | 42
1      | Connected to 10.1.0.1!
1      | Connected to 10.1.0.2!
1      | Connected to 10.1.0.3!
3      | Connection error?
;

statsByUnmappedField
required_capability: optional_fields_load_all_stats

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| STATS s = SUM(event_duration), c = COUNT(*) BY unmapped_message
| SORT unmapped_message
;

s:long       | c:long | unmapped_message:keyword
1232381      | 1      | 43
1756466      | 1      | Disconnected from 10.1.0.1
2764888      | 1      | Disconnected from 10.1.0.2
3450232      | 1      | Disconnected from 10.1.0.3
14027353     | 3      | Disconnection error
;

statsAfterKeepWildcard
required_capability: optional_fields_load_all_stats

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP unmapped*
| STATS c = COUNT(*)
;

c:long
7
;

statsAfterWhereOnUnmappedField
required_capability: optional_fields_load_all_stats

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| WHERE unmapped_message == "Disconnection error"
| STATS c = COUNT(*)
;

c:long
3
;

####################################################################
# Gap coverage: known-failing tests documenting intended behaviour #
####################################################################

arraysGap-Ignore
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_array_data
| EVAL n = MV_COUNT(tags)
| SORT id
;

id:keyword | tags:keyword | n:integer
1          | [web, api]   | 2
2          | web          | 1
3          | web          | 1
;

// Whether a sub-object should become a JSON string, as expected here, or be flattened into its own column is still
// open: https://github.com/elastic/elasticsearch/pull/155020#discussion_r3676465198
objectsGap-Ignore
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_object_data
| SORT id
;

id:keyword | extra:keyword
1          | hello
2          | "{""baz"":""world""}"
;

// Same data and mapping as fromNoProjection, but with synthetic source, which reconstructs the dotted key
// "unmapped.nested" as an object. Only top-level keys are expanded, so today the column is named "unmapped" and holds
// the stringified object. The expectation below is the goal instead: the same output as if the field were mapped,
// which is also what the non-synthetic fromNoProjection produces. Blocked on objectsGap above.
syntheticSource-Ignore
required_capability: optional_fields_load_all

SET unmapped_fields="LOAD_ALL"\;
FROM synthetic_source_partial_mapping
| SORT @timestamp
;

@timestamp:datetime      | client_ip:ip | event_duration:long | message:keyword        | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword

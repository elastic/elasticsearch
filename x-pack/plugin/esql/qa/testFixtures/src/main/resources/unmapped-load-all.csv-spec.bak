;

// Root cause: outermostRenames composes the accumulated map once per alias instead of once per RENAME node, so the second
// alias of a swap rewrites the first one's value and the map collapses to {client_ip: client_ip}. The KEEP's original names
// are then unrecoverable and the order replays as identity. Expected results below are the correct ones.
swapRenamesAboveKeeprequired_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP message, client_ip, @timestamp, *
| RENAME message AS temp, client_ip AS message, temp AS client_ip
| SORT @timestamp
;

client_ip:keyword      | message:ip   | @timestamp:datetime      | event_duration:long | language_code:keyword | unmapped.nested:keyword | unmapped_event_duration:keyword | unmapped_message:keyword
Connected to 10.1.0.3! | 173.21.2.162 | 2024-10-23T12:15:03.360Z | 3450232             | 4                     | g                       | 3450234                         | Disconnected from 10.1.0.3
Connected to 10.1.0.2! | 173.21.2.113 | 2024-10-23T12:27:28.948Z | 2764888             | 3                     | f                       | 2764890                         | Disconnected from 10.1.0.2
42                     | 173.21.0.5   | 2024-10-23T13:33:34.937Z | 1232381             | 2                     | e                       | 1232383                         | 43
Connection error?      | 173.21.3.15  | 2024-10-23T13:51:54.732Z | 725447              | 1                     | d                       | 725449                          | Disconnection error
Connection error?      | 173.21.3.15  | 2024-10-23T13:52:55.015Z | 8268152             | 3                     | c                       | 8268154                         | Disconnection error
Connection error?      | 173.21.3.15  | 2024-10-23T13:53:55.832Z | 5033754             | 2                     | b                       | 5033756                         | Disconnection error
Connected to 10.1.0.1! | 173.21.3.15  | 2024-10-23T13:55:01.543Z | 1756466             | 1                     | a                       | 1756468                         | Disconnected from 10.1.0.1
;

// Root cause: the walk only inspects RENAME/KEEP/DROP nodes, so an EVAL that re-creates a renamed-away name is invisible to it.
// Both b and c end up mapped to the same original (message), and inverting that map picks a winner by iteration order - on half
// the JVMs c is emitted twice and b is dropped. Expected results below are the correct ones.
renameOfEvalRecreatedNameAboveKeeprequired_capability: optional_fields_load_all_v2


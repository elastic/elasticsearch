// The bare scalar unmapped is fully unmapped (an object in the two mapped indices, a keyword scalar only in unmapped_multi_stored_mixed at id 4), so
// its expansion still surfaces scalar4, while the dotted unmapped.foo is a keyword-vs-text conflict that stays an unsupported null column alongside it.
multiIndexTypeConflictScalarUnmappedCoexistsWithConflict
required_capability: optional_fields_load_all_v2


SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*
| KEEP id, unmapped, unmapped.foo
| SORT id
;

id:keyword | unmapped:keyword | unmapped.foo:unsupported
1          | null             | null
10         | null             | null
11         | null             | null
12         | null             | null
2          | null             | null
3          | null             | null
4          | scalar4          | null
5          | null             | null
6          | null             | null
7          | null             | null
8          | null             | null
9          | null             | null
;

// Casting the conflicting unmapped.foo to keyword resolves the union type: both mapped legs (keyword and text) and the unmapped _source legs are
// read as keyword, so the values that were null under the raw conflict now surface - the keyword leg (ids 1, 3, 5, 8, 9) and the text leg (ids 10, 11).
multiIndexTypeConflictResolvedByExplicitCast
required_capability: optional_fields_load_all_v2


SET unmapped_fields="LOAD_ALL"\;
FROM unmapped_multi_*
| EVAL foo = unmapped.foo::keyword
| KEEP id, foo
| SORT id
;

id:keyword | foo:keyword
1          | foo1
10         | lazy fox
11         | [lazy fox, quick dog]
12         | null
2          | null
3          | foo3
4          | null
5          | [arr1, arr2]
6          | null
7          | null
8          | mfoo8
9          | [mfa, mfb]
;

// WHERE on the cast-resolved union column filters the computed keyword value (not pushed to Lucene), keeping only ids with a value.
multiIndexTypeConflictCastThenFilteredByWhere
required_capability: optional_fields_load_all_v2



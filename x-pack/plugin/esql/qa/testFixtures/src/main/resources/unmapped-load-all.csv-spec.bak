// A KEEP wildcard that matches only unmapped source fields is tolerated under LOAD_ALL: the wildcard
// matches nothing visible at analysis time, but instead of failing with "No matches found" the pattern
// is captured and applied during _unmapped_fields expansion. Keeps @timestamp plus every unmapped source
// field matching unmapped_* (unmapped.nested does not match the underscore).
keepUnmappedWildcardPrefix
required_capability: optional_fields_load_all_v2

SET unmapped_fields="LOAD_ALL"\;
FROM partial_mapping_sample_data
| KEEP @timestamp, unmapped_*
| SORT @timestamp
;

@timestamp:datetime      | unmapped_event_duration:keyword | unmapped_message:keyword

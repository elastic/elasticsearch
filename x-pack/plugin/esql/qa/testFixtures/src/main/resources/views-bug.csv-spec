// Q1
// This works correctly at the moment
tsBugRepro1

FROM (TS k8s), (FROM addresses
               | RENAME city.country.name AS country
               | EVAL country = CASE(country == "United States of America", "United States", country)
               | STATS count=COUNT() BY country)
| STATS bytes = last_over_time(event) BY step = bucket(@timestamp, 1 day)
;

bytes:keyword | step:datetime
null          | null
null          | 2024-05-10T00:00:00.000Z
;

// Q2
// This does not work because the TS subquery will require the STATS to be a TimeSeriesAggregate and the FROM subquery
// will be an Aggregate, so we will error out with something similar to:
//     optimized incorrectly due to missing references [_tsid{m}#321, _timeseries{f}#320]
//
// A possible fix: given TS is used inside a FROM command, we should demote that to a STANDARD index
// instead of keeping unresolved relation as a TIME SERIES index
tsBugRepro2

FROM (TS k8s), (FROM employees)
| STATS bytes = last_over_time(event) BY time_bucket = bucket(@timestamp, 1 day)
| SORT time_bucket
;

bytes:keyword | step:datetime
;

// Q3
// main query TS, no view, but there is subquery, should throw ParsingException 
// because a subquery cannot appear inside TS
// This works at the moment
tsBugRepro3

TS (TS k8s), (FROM addresses
               | RENAME city.country.name AS country
               | EVAL country = CASE(country == "United States of America", "United States", country)
               | STATS count=COUNT() BY country)
| STATS bytes = last_over_time(event) BY time_bucket = bucket(@timestamp, 1 day)
| SORT time_bucket
;

bytes:keyword | step:datetime
;



Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[language_code{f}#0,ASC,LAST]]]
  \_Filter[language_code{f}#0 < 5[INTEGER]]
    \_Project[[language_name{f}#1, language_code{f}#0]]
      \_Filter[language_code{f}#0 > 1[INTEGER]]
        \_EsRelation[languages][language_code{f}#0, language_name{f}#1]
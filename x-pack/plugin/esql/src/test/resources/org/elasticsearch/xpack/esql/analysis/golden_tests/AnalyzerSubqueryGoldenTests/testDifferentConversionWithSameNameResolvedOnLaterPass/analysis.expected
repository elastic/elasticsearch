Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3, does_not_exist{r}#4, d{r}#5]]
\_Limit[1000[INTEGER],false,false]
  \_Eval[[TODEGREES(event_duration{r}#2) AS d#5]]
    \_Filter[$$event_duration$converted_to$double{r$}#6 > 0[INTEGER] OR ISNOTNULL(does_not_exist{r}#4)]
      \_UnionAll[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, $$event_duration$converted_to$double{r$}#6, message{r}#3, does_not_exist{r}#4]]
        |_Project[[@timestamp{f}#7, client_ip{f}#8, event_duration{f}#9, $$event_duration$converted_to$double{r$}#10, message{f}#11, does_not_exist{f(MissingEsField)}#12]]
        | \_Eval[[TODOUBLE(event_duration{f}#9) AS $$event_duration$converted_to$double#10]]
        |   \_Subquery[]
        |     \_EsRelation[sample_data][@timestamp{f}#7, client_ip{f}#8, event_duration{f}#9, message{f}#11, does_not_exist{f(MissingEsField)}#12]
        \_Project[[@timestamp{f}#13, client_ip{f}#14, event_duration{f}#15, $$event_duration$converted_to$double{r$}#16, message{f}#17, does_not_exist{f(MissingEsField)}#18]]
          \_Eval[[TODOUBLE(event_duration{f}#15) AS $$event_duration$converted_to$double#16]]
            \_Subquery[]
              \_EsRelation[sample_data][@timestamp{f}#13, client_ip{f}#14, event_duration{f}#15, message{f}#17, does_not_exist{f(MissingEsField)}#18]
Limit[1000[INTEGER],false,false]
\_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY, unnamed_view_3=SUBQUERY]]
  |_Project[[x{r}#0]]
  | \_Eval[[TO_INTEGER(x{r}#1) AS x#0]]
  |   \_Row[[1[KEYWORD] AS x#1]]
  |_Project[[x{r}#2]]
  | \_Eval[[TO_INTEGER(x{r}#3) AS x#2]]
  |   \_Row[[1.5[DOUBLE] AS x#3]]
  \_Project[[x{r}#4]]
    \_Row[[3[INTEGER] AS x#4]]
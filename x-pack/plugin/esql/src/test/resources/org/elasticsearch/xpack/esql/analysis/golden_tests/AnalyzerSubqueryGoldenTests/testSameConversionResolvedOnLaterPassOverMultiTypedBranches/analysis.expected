        |_Project[[!avg_worked_seconds, birth_date{f}#3, !emp_no, $$emp_no$converted_to$keyword{f(CompactMultiTypeEsField)$}#4, !first_name, !gender, !height, hire_date{f(CompactMultiTypeEsField)}#5, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, does_not_exist{f(MissingEsField)}#6]]
        | \_EsRelation[employees,employees_incompatible][!avg_worked_seconds, birth_date{f}#3, !emp_no, !first_name, !gender, !height, hire_date{f(CompactMultiTypeEsField)}#5, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, $$emp_no$converted_to$keyword{f(CompactMultiTypeEsField)$}#4, does_not_exist{f(MissingEsField)}#6]
        \_Project[[!avg_worked_seconds, birth_date{f}#7, !emp_no, $$emp_no$converted_to$keyword{f(CompactMultiTypeEsField)$}#8, !first_name, !gender, !height, hire_date{f(CompactMultiTypeEsField)}#9, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, does_not_exist{f(MissingEsField)}#10]]
          \_EsRelation[employees,employees_incompatible][!avg_worked_seconds, birth_date{f}#7, !emp_no, !first_name, !gender, !height, hire_date{f(CompactMultiTypeEsField)}#9, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, $$emp_no$converted_to$keyword{f(CompactMultiTypeEsField)$}#8, does_not_exist{f(MissingEsField)}#10]
Limit[1000[INTEGER],false,false]
\_Project[[e{r}#0]]
  \_Eval[[$$emp_no$converted_to$keyword{r$}#1 AS e#0]]
    \_Filter[$$emp_no$converted_to$keyword{r$}#1 == 10001[KEYWORD] OR ISNOTNULL(does_not_exist{r}#2)]
      \_UnionAll[[!avg_worked_seconds, birth_date{r}#3, !emp_no, $$emp_no$converted_to$keyword{r$}#1, !first_name, !gender, !height, hire_date{r}#4, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, does_not_exist{r}#2]]
        |_Project[[!avg_worked_seconds, birth_date{f}#5, !emp_no, $$emp_no$converted_to$keyword{f(MultiTypeEsField)$}#6, !first_name, !gender, !height, hire_date{f(MultiTypeEsField)}#7, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, does_not_exist{f(MissingEsField)}#8]]
        | \_Subquery[]
        |   \_EsRelation[employees,employees_incompatible][!avg_worked_seconds, birth_date{f}#5, !emp_no, !first_name, !gender, !height, hire_date{f(MultiTypeEsField)}#7, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, $$emp_no$converted_to$keyword{f(MultiTypeEsField)$}#6, does_not_exist{f(MissingEsField)}#8]
        \_Project[[!avg_worked_seconds, birth_date{f}#9, !emp_no, $$emp_no$converted_to$keyword{f(MultiTypeEsField)$}#10, !first_name, !gender, !height, hire_date{f(MultiTypeEsField)}#11, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, does_not_exist{f(MissingEsField)}#12]]
          \_Subquery[]
            \_EsRelation[employees,employees_incompatible][!avg_worked_seconds, birth_date{f}#9, !emp_no, !first_name, !gender, !height, hire_date{f(MultiTypeEsField)}#11, !is_rehired, !job_positions, !languages, !last_name, !salary, !salary_change, !still_hired, $$emp_no$converted_to$keyword{f(MultiTypeEsField)$}#10, does_not_exist{f(MissingEsField)}#12]
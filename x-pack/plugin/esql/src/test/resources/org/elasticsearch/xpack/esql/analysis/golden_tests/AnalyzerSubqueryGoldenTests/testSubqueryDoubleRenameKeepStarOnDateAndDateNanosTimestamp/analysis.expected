Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[y{r}#0,ASC,LAST]]]
  \_Project[[y{r}#0]]
    \_Project[[x{r}#1 AS y#0]]
      \_Project[[@timestamp{r}#2 AS x#1]]
        \_Project[[@timestamp{r}#2]]
          \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
            |_Project[[@timestamp{r}#3, client_ip{f}#4, event_duration{f}#5, message{f}#6]]
            | \_Eval[[TODATENANOS(@timestamp{f}#7) AS @timestamp#3]]
            |   \_EsRelation[sample_data][@timestamp{f}#7, client_ip{f}#4, event_duration{f}#5, message{f}#6]
            \_Project[[@timestamp{f}#8, client_ip{f}#9, event_duration{f}#10, message{f}#11]]
              \_EsRelation[sample_data_ts_nanos][@timestamp{f}#8, client_ip{f}#9, event_duration{f}#10, message{f}#11]
Project[[x{r}#0]]
\_Limit[1000[INTEGER],false,false]
  \_OrderBy[[Order[x{r}#0,ASC,LAST]]]
    \_Project[[x{r}#0, $$@timestamp$converted_to$long{r$}#1]]
      \_Project[[@timestamp{r}#2 AS x#0, $$@timestamp$converted_to$long{r$}#1]]
        \_Project[[@timestamp{r}#2, $$@timestamp$converted_to$long{r$}#1]]
          \_Eval[[$$@timestamp$converted_to$long{r$}#1 AS @timestamp#2]]
            \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
              |_Eval[[null[KEYWORD] AS @timestamp#3]]
              | \_Eval[[TOLONG(@timestamp{f}#4) AS $$@timestamp$converted_to$long#5]]
              |   \_EsRelation[sample_data][@timestamp{f}#4, client_ip{f}#6, event_duration{f}#7, message{f}#8]
              \_Eval[[null[KEYWORD] AS @timestamp#9]]
                \_Eval[[TOLONG(@timestamp{f}#10) AS $$@timestamp$converted_to$long#11]]
                  \_EsRelation[sample_data_ts_long][@timestamp{f}#10, client_ip{f}#12, event_duration{f}#13, message{f}#14]
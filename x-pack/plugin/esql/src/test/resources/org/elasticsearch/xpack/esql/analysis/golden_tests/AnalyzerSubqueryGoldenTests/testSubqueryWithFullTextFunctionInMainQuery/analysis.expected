Limit[1000[INTEGER],false,false]
\_Filter[MATCH(client_ip{r}#0,127.0.0.1[KEYWORD])]
  \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
    |_Project[[@timestamp{f}#1, client_ip{f}#2, event_duration{f}#3, message{f}#4]]
    | \_EsRelation[sample_data][@timestamp{f}#1, client_ip{f}#2, event_duration{f}#3, message{f}#4]
    \_Project[[@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8]]
      \_Filter[:(message{f}#8,error[KEYWORD])]
        \_EsRelation[sample_data][@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8]
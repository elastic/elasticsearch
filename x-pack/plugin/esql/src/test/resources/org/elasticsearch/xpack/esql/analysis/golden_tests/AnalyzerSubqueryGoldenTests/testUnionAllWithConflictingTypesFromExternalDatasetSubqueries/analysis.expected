  \_ViewUnionAll[[unnamed_view_1, unnamed_view_2]]
    |_Project[[emp_no{r}#0, name{r}#1, salary{r}#2]]
    | \_Eval[[null[KEYWORD] AS salary#2]]
    |   \_ExternalRelation[salaries_int.parquet][parquet][emp_no{r}#0, name{r}#1, salary{r}#3]
    \_Project[[emp_no{r}#4, name{r}#5, salary{r}#6]]
      \_Eval[[null[KEYWORD] AS salary#6]]
        \_ExternalRelation[salaries_long.parquet][parquet][emp_no{r}#4, name{r}#5, salary{r}#7]
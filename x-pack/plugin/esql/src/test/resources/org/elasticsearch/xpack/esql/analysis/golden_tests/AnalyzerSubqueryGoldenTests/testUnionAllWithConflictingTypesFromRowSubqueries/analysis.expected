Limit[1000[INTEGER],false,false]
\_Project[[!x]]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Project[[x{r}#0]]
    | \_Eval[[null[KEYWORD] AS x#0]]
    |   \_Row[[1[INTEGER] AS x#1]]
    \_Project[[x{r}#2]]
      \_Eval[[null[KEYWORD] AS x#2]]
        \_Row[[abc[KEYWORD] AS x#3]]
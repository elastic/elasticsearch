Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[@timestamp{r}#0,ASC,LAST], Order[_fork{r}#1,ASC,LAST]]]
  \_Fork[[@timestamp{r}#0, client_ip{r}#2, event_duration{r}#3, message{r}#4, _fork{r}#1]]
    |_Project[[@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8, _fork{r}#9]]
    | \_Eval[[fork1[KEYWORD] AS _fork#9]]
    |   \_Project[[@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8]]
    |     \_EsRelation[partial_mapping_sample_data][@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8, unmapped_message{f}#10]
    \_Project[[@timestamp{f}#11, client_ip{f}#12, event_duration{f}#13, message{f}#14, _fork{r}#15]]
      \_Eval[[fork2[KEYWORD] AS _fork#15]]
        \_Filter[true[BOOLEAN]]
          \_EsRelation[partial_mapping_sample_data][@timestamp{f}#11, client_ip{f}#12, event_duration{f}#13, message{f}#14]
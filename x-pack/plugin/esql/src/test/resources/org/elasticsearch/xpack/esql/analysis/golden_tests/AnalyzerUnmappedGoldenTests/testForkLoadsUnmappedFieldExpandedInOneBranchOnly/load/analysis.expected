\_OrderBy[[Order[_fork{r}#0,ASC,LAST], Order[message{r}#1,ASC,LAST], Order[unmapped_message{r}#2,ASC,LAST]]]
  \_Project[[_fork{r}#0, message{r}#1, unmapped_message{r}#2]]
    \_Fork[[@timestamp{r}#3, client_ip{r}#4, event_duration{r}#5, message{r}#1, unmapped_message{r}#2, _fork{r}#0]]
      |_Eval[[fork1[KEYWORD] AS _fork#6]]
      | \_MvExpand[unmapped_message{f(PotentiallyUnmappedKeywordEsField)}#7,unmapped_message{r}#8]
      |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#9, client_ip{f}#10, event_duration{f}#11, message{f}#12, unmapped_message{f(PotentiallyUnmappedKeywordEsField)}#7]
      \_Eval[[fork2[KEYWORD] AS _fork#13]]
        \_Filter[message{f}#14 == 42[KEYWORD]]
          \_EsRelation[partial_mapping_sample_data][@timestamp{f}#15, client_ip{f}#16, event_duration{f}#17, message{f}#14, unmapped_message{f(PotentiallyUnmappedKeywordEsField)}#18]
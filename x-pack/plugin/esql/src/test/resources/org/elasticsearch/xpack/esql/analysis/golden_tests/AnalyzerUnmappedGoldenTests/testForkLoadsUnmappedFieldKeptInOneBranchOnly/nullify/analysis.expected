Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[_fork{r}#0,ASC,LAST], Order[message{r}#1,ASC,LAST]]]
  \_Project[[_fork{r}#0, message{r}#1, unmapped_message{r}#2]]
    \_Fork[[message{r}#1, unmapped_message{r}#2, _fork{r}#0, @timestamp{r}#3, client_ip{r}#4, event_duration{r}#5]]
      |_Eval[[fork1[KEYWORD] AS _fork#6]]
      | \_Project[[message{f}#7, unmapped_message{f(MissingEsField)}#8]]
      |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#9, client_ip{f}#10, event_duration{f}#11, message{f}#7, unmapped_message{f(MissingEsField)}#8]
      \_Eval[[fork2[KEYWORD] AS _fork#12]]
        \_Filter[message{f}#13 == 42[KEYWORD]]
          \_EsRelation[partial_mapping_sample_data][@timestamp{f}#14, client_ip{f}#15, event_duration{f}#16, message{f}#13, unmapped_message{f(MissingEsField)}#17]
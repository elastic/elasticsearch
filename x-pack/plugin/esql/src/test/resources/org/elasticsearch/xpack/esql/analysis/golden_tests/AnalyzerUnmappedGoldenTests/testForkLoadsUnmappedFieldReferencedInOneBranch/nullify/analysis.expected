Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[_fork{r}#0,ASC,LAST], Order[unmapped_event_duration{r}#1,ASC,LAST]]]
  \_Project[[_fork{r}#0, message{r}#2, unmapped_message{r}#3, unmapped_event_duration{r}#1]]
    \_Fork[[@timestamp{r}#4, client_ip{r}#5, event_duration{r}#6, message{r}#2, unmapped_message{r}#3, _fork{r}#0, unmapped_event_duration{r}#1]]
      |_Eval[[fork1[KEYWORD] AS _fork#7]]
      | \_Filter[unmapped_message{f(MissingEsField)}#8 == Disconnection error[KEYWORD]]
      |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#9, client_ip{f}#10, event_duration{f}#11, message{f}#12, unmapped_message{f(MissingEsField)}#8, unmapped_event_duration{f(MissingEsField)}#13]
      \_Eval[[fork2[KEYWORD] AS _fork#14]]
        \_Filter[message{f}#15 == 42[KEYWORD]]
          \_EsRelation[partial_mapping_sample_data][@timestamp{f}#16, client_ip{f}#17, event_duration{f}#18, message{f}#15, unmapped_message{f(MissingEsField)}#19, unmapped_event_duration{f(MissingEsField)}#20]
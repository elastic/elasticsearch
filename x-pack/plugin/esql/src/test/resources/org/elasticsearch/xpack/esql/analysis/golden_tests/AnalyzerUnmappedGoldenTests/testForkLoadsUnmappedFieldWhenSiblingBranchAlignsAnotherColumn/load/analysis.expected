Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[_fork{r}#0,ASC,LAST], Order[message{r}#1,ASC,LAST]]]
  \_Project[[_fork{r}#0, message{r}#1, unmapped_message{r}#2, branch_tag{r}#3]]
    \_Fork[[@timestamp{r}#4, client_ip{r}#5, event_duration{r}#6, message{r}#1, unmapped_message{r}#2, _fork{r}#0, branch_tag{r}#3]]
      |_Eval[[fork1[KEYWORD] AS _fork#7]]
      | \_Filter[unmapped_message{f(PotentiallyUnmappedKeywordEsField)}#8 == Disconnection error[KEYWORD]]
      |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#9, client_ip{f}#10, event_duration{f}#11, message{f}#12, unmapped_message{f(PotentiallyUnmappedKeywordEsField)}#8]
      \_Eval[[fork2[KEYWORD] AS _fork#13]]
        \_Eval[[two[KEYWORD] AS branch_tag#14]]
          \_EsRelation[partial_mapping_sample_data][@timestamp{f}#15, client_ip{f}#16, event_duration{f}#17, message{f}#18, unmapped_message{f(PotentiallyUnmappedKeywordEsField)}#19]
Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[_fork{r}#0,ASC,LAST]]]
  \_Project[[_fork{r}#0, id{r}#1]]
    \_Fork[[id{r}#1, _fork{r}#0]]
      |_Eval[[fork1[KEYWORD] AS _fork#2]]
      | \_Filter[true[BOOLEAN]]
      |   \_Project[[id{f}#3]]
      |     \_EsRelation[apps_short,partial_mapping_sample_data][@timestamp{f}#4, client_ip{f}#5, event_duration{f}#6, id{f}#3, message{f}#7, name{f}#8, version{f}#9]
      \_Eval[[fork2[KEYWORD] AS _fork#10]]
        \_Filter[true[BOOLEAN]]
          \_Project[[id{f}#11]]
            \_EsRelation[apps_short,partial_mapping_sample_data][@timestamp{f}#12, client_ip{f}#13, event_duration{f}#14, id{f}#11, message{f}#15, name{f}#16, version{f}#17]
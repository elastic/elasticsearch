    |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#0, client_ip{f}#1, event_duration{f}#2, message{f}#3, language_code{f(PotentiallyUnmappedKeywordEsField)}#8, _unmapped_fields{m}#7]

Project[[@timestamp{r}#0]]
\_Limit[1000[INTEGER],false,false]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Project[[@timestamp{f}#1, client_ip{f}#2, event_duration{f}#3, message{f}#4]]
    | \_EsRelation[partial_mapping_sample_data][@timestamp{f}#1, client_ip{f}#2, event_duration{f}#3, message{f}#4]
    \_Project[[@timestamp{r}#5, client_ip{r}#6, event_duration{r}#7, message{r}#8]]
      \_Eval[[COALESCE(message{f(PotentiallyUnmappedKeywordEsField)}#9,x[KEYWORD]) AS message#8, TODATETIME(COALESCE(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#10,x[KEYWORD])) AS @timestamp#5, TO_IP(COALESCE(client_ip{f(PotentiallyUnmappedKeywordEsField)}#11,x[KEYWORD])) AS client_ip#6, TOLONG(COALESCE(event_duration{f(PotentiallyUnmappedKeywordEsField)}#12,x[KEYWORD])) AS event_duration#7]]
        \_EsRelation[no_mapping_sample_data][<no-fields>{r$}#13, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#10, client_ip{f(PotentiallyUnmappedKeywordEsField)}#11, event_duration{f(PotentiallyUnmappedKeywordEsField)}#12, message{f(PotentiallyUnmappedKeywordEsField)}#9]
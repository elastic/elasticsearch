Limit[1000[INTEGER],false,false]
\_Project[[event_duration{r}#0]]
  \_UnionAll[[@timestamp{r}#1, client_ip{r}#2, event_duration{r}#0, message{r}#3]]
    |_Project[[@timestamp{f}#4, client_ip{f}#5, event_duration{f}#6, message{f}#7]]
    | \_Subquery[]
    |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#4, client_ip{f}#5, event_duration{f}#6, message{f}#7]
    \_Project[[@timestamp{r}#8, client_ip{r}#9, event_duration{r}#10, message{r}#11]]
      \_Eval[[TOLONG(event_duration{f(PotentiallyUnmappedKeywordEsField)}#12) AS event_duration#10]]
        \_Eval[[null[DATETIME] AS @timestamp#8, null[IP] AS client_ip#9, null[KEYWORD] AS message#11]]
          \_Subquery[]
            \_Project[[event_duration{f(PotentiallyUnmappedKeywordEsField)}#12]]
              \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#12]
Limit[1000[INTEGER],false,false]
\_UnionAll[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3, $$unmapped_fields{m}#4]]
  |_Project[[@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8, $$unmapped_fields{m}#4]]
  | \_Subquery[]
  |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#5, client_ip{f}#6, event_duration{f}#7, message{f}#8, $$unmapped_fields{m}#4]
  \_Project[[@timestamp{r}#9, client_ip{r}#10, event_duration{r}#11, message{f(PotentiallyUnmappedKeywordEsField)}#12, $$unmapped_fields{m}#13]]
    \_Eval[[TOLONG(event_duration{f(PotentiallyUnmappedKeywordEsField)}#14) AS event_duration#11]]
      \_Eval[[TODATETIME(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#15) AS @timestamp#9, TO_IP(client_ip{f(PotentiallyUnmappedKeywordEsField)}#16) AS client_ip#10]]
        \_Subquery[]
          \_Project[[event_duration{f(PotentiallyUnmappedKeywordEsField)}#14, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#15, client_ip{f(PotentiallyUnmappedKeywordEsField)}#16, message{f(PotentiallyUnmappedKeywordEsField)}#12, $$unmapped_fields{m}#13]]
            \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#14, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#15, client_ip{f(PotentiallyUnmappedKeywordEsField)}#16, message{f(PotentiallyUnmappedKeywordEsField)}#12, $$unmapped_fields{m}#13]
Limit[1000[INTEGER],false,false]
\_Project[[event_duration{r}#0]]
  \_UnionAll[[@timestamp{r}#1, client_ip{r}#2, event_duration{r}#0, message{r}#3]]
    |_Project[[@timestamp{f}#4, client_ip{f}#5, event_duration{f}#6, message{f}#7]]
    | \_Subquery[]
    |   \_EsRelation[partial_mapping_sample_data][@timestamp{f}#4, client_ip{f}#5, event_duration{f}#6, message{f}#7]
    \_Project[[@timestamp{r}#8, client_ip{r}#9, event_duration{r}#10, message{f(PotentiallyUnmappedKeywordEsField)}#11]]
      \_Eval[[TODATETIME(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#12) AS @timestamp#8, TO_IP(client_ip{f(PotentiallyUnmappedKeywordEsField)}#13) AS client_ip#9, TOLONG(event_duration{f(PotentiallyUnmappedKeywordEsField)}#14) AS event_duration#10]]
        \_Subquery[]
          \_EsRelation[no_mapping_sample_data][<no-fields>{r$}#15, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#12, client_ip{f(PotentiallyUnmappedKeywordEsField)}#13, event_duration{f(PotentiallyUnmappedKeywordEsField)}#14, message{f(PotentiallyUnmappedKeywordEsField)}#11]
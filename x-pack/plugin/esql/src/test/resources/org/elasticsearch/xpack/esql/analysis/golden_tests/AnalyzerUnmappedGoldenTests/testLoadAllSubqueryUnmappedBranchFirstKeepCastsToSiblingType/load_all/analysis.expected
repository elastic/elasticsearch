Limit[1000[INTEGER],false,false]
\_Project[[event_duration{r}#0]]
  \_UnionAll[[event_duration{r}#0, @timestamp{r}#1, client_ip{r}#2, message{r}#3]]
    |_Project[[event_duration{r}#4, @timestamp{r}#5, client_ip{r}#6, message{r}#7]]
    | \_Eval[[TOLONG(event_duration{f(PotentiallyUnmappedKeywordEsField)}#8) AS event_duration#4]]
    |   \_Eval[[null[DATETIME] AS @timestamp#5, null[IP] AS client_ip#6, null[KEYWORD] AS message#7]]
    |     \_Subquery[]
    |       \_Project[[event_duration{f(PotentiallyUnmappedKeywordEsField)}#8]]
    |         \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#8]
    \_Project[[event_duration{f}#9, @timestamp{f}#10, client_ip{f}#11, message{f}#12]]
      \_Subquery[]
        \_EsRelation[partial_mapping_sample_data][@timestamp{f}#10, client_ip{f}#11, event_duration{f}#9, message{f}#12]
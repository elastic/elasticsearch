    |         \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#7]
    \_Project[[event_duration{r}#8, @timestamp{f}#9, client_ip{f}#10, message{f}#11]]

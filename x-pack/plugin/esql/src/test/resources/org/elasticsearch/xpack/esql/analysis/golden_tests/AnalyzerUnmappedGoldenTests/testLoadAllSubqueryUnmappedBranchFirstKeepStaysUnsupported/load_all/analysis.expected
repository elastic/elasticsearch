Limit[1000[INTEGER],false,false]
\_Project[[!event_duration]]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Project[[event_duration{r}#0, @timestamp{r}#1, client_ip{r}#2, message{r}#3]]
    | \_Eval[[null[KEYWORD] AS event_duration#0]]
    |   \_Eval[[null[DATETIME] AS @timestamp#1, null[IP] AS client_ip#2, null[KEYWORD] AS message#3]]
    |     \_Project[[event_duration{f(PotentiallyUnmappedKeywordEsField)}#4]]
    |       \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#4]
    \_Project[[event_duration{r}#5, @timestamp{f}#6, client_ip{f}#7, message{f}#8]]
      \_Eval[[null[KEYWORD] AS event_duration#5]]
        \_EsRelation[partial_mapping_sample_data][@timestamp{f}#6, client_ip{f}#7, event_duration{f}#9, message{f}#8]
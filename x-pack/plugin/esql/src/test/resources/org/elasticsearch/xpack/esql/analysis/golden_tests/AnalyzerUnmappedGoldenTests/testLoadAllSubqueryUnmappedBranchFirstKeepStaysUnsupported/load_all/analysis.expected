\_Project[[!event_duration]]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Eval[[null[KEYWORD] AS event_duration#0]]
    | \_Project[[event_duration{f(PotentiallyUnmappedKeywordEsField)}#1]]
    |   \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#1]
    \_Eval[[null[KEYWORD] AS event_duration#2]]
      \_EsRelation[partial_mapping_sample_data][@timestamp{f}#3, client_ip{f}#4, event_duration{f}#5, message{f}#6]
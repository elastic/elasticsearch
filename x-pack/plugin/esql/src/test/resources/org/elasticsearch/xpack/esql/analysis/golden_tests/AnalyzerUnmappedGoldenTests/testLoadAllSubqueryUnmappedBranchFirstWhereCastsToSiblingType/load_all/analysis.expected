Limit[1000[INTEGER],false,false]
\_Project[[event_duration{r}#0]]
  \_UnionAll[[event_duration{r}#0, @timestamp{r}#1, client_ip{r}#2, message{r}#3]]
    |_Project[[event_duration{r}#4, @timestamp{r}#5, client_ip{r}#6, message{f(PotentiallyUnmappedKeywordEsField)}#7]]
    | \_Eval[[TOLONG(event_duration{f(PotentiallyUnmappedKeywordEsField)}#8) AS event_duration#4]]
    |   \_Eval[[TODATETIME(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#9) AS @timestamp#5, TO_IP(client_ip{f(PotentiallyUnmappedKeywordEsField)}#10) AS client_ip#6]]
    |     \_Subquery[]
    |       \_Filter[ISNOTNULL(event_duration{f(PotentiallyUnmappedKeywordEsField)}#8)]
    |         \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#8, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#9, client_ip{f(PotentiallyUnmappedKeywordEsField)}#10, message{f(PotentiallyUnmappedKeywordEsField)}#7]
    \_Project[[event_duration{f}#11, @timestamp{f}#12, client_ip{f}#13, message{f}#14]]
      \_Subquery[]
        \_EsRelation[partial_mapping_sample_data][@timestamp{f}#12, client_ip{f}#13, event_duration{f}#11, message{f}#14]
Limit[1000[INTEGER],false,false]
\_Project[[!event_duration]]
  \_UnionAll[[!event_duration, @timestamp{r}#0, client_ip{r}#1, message{r}#2]]
    |_Project[[event_duration{r}#3, @timestamp{r}#4, client_ip{r}#5, message{f(PotentiallyUnmappedKeywordEsField)}#6]]
    | \_Eval[[null[KEYWORD] AS event_duration#3]]
    |   \_Eval[[TODATETIME(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#7) AS @timestamp#4, TO_IP(client_ip{f(PotentiallyUnmappedKeywordEsField)}#8) AS client_ip#5]]
    |     \_Subquery[]
    |       \_Filter[ISNOTNULL(event_duration{f(PotentiallyUnmappedKeywordEsField)}#9)]
    |         \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#9, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#7, client_ip{f(PotentiallyUnmappedKeywordEsField)}#8, message{f(PotentiallyUnmappedKeywordEsField)}#6]
    \_Project[[event_duration{r}#10, @timestamp{f}#11, client_ip{f}#12, message{f}#13]]
      \_Eval[[null[KEYWORD] AS event_duration#10]]
        \_Subquery[]
          \_EsRelation[partial_mapping_sample_data][@timestamp{f}#11, client_ip{f}#12, event_duration{f}#14, message{f}#13]
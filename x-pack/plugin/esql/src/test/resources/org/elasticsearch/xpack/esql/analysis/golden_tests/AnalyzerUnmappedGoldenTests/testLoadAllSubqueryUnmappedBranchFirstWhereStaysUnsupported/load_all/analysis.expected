Limit[1000[INTEGER],false,false]
\_Project[[!event_duration]]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Eval[[null[KEYWORD] AS event_duration#0]]
    | \_Eval[[TODATETIME(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#1) AS @timestamp#2, TO_IP(client_ip{f(PotentiallyUnmappedKeywordEsField)}#3) AS client_ip#4]]
    |   \_Filter[ISNOTNULL(event_duration{f(PotentiallyUnmappedKeywordEsField)}#5)]
    |     \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#5, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#1, client_ip{f(PotentiallyUnmappedKeywordEsField)}#3, message{f(PotentiallyUnmappedKeywordEsField)}#6]
    \_Eval[[null[KEYWORD] AS event_duration#7]]
      \_EsRelation[partial_mapping_sample_data][@timestamp{f}#8, client_ip{f}#9, event_duration{f}#10, message{f}#11]
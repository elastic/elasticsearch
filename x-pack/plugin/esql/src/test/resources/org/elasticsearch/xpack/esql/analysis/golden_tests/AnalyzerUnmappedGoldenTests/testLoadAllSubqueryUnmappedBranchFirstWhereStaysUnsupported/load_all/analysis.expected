Limit[1000[INTEGER],false,false]
\_Project[[!event_duration]]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Project[[event_duration{r}#0, @timestamp{r}#1, client_ip{r}#2, message{f(PotentiallyUnmappedKeywordEsField)}#3]]
    | \_Eval[[null[KEYWORD] AS event_duration#0]]
    |   \_Eval[[TODATETIME(@timestamp{f(PotentiallyUnmappedKeywordEsField)}#4) AS @timestamp#1, TO_IP(client_ip{f(PotentiallyUnmappedKeywordEsField)}#5) AS client_ip#2]]
    |     \_Filter[ISNOTNULL(event_duration{f(PotentiallyUnmappedKeywordEsField)}#6)]
    |       \_EsRelation[no_mapping_sample_data][event_duration{f(PotentiallyUnmappedKeywordEsField)}#6, @timestamp{f(PotentiallyUnmappedKeywordEsField)}#4, client_ip{f(PotentiallyUnmappedKeywordEsField)}#5, message{f(PotentiallyUnmappedKeywordEsField)}#3]
    \_Project[[event_duration{r}#7, @timestamp{f}#8, client_ip{f}#9, message{f}#10]]
      \_Eval[[null[KEYWORD] AS event_duration#7]]
        \_EsRelation[partial_mapping_sample_data][@timestamp{f}#8, client_ip{f}#9, event_duration{f}#11, message{f}#10]
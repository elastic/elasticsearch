LimitExec[1000[INTEGER],null]
\_AggregateExec[[],[SUM(salary{r}#0,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS s#1],SINGLE,[$$s$sum{r}#2, $$s$seen{r}#3],null]
  \_MergeExec[[salary{r}#0],UNION]
    |_ExchangeExec[[salary{r}#4],false]
    | \_ProjectExec[[salary{r}#4]]
    |   \_FilterExec[salary{r}#4 > 0[INTEGER]]
    |     \_ExternalSourceExec[s3://bucket/heavy_a.parquet][parquet][dataset=heavy_a][salary{r}#4]
    \_ExchangeExec[[salary{r}#5],false]
      \_ProjectExec[[salary{r}#5]]
        \_FilterExec[salary{r}#5 > 0[INTEGER]]
          \_ExternalSourceExec[s3://bucket/heavy_b.parquet][parquet][dataset=heavy_b][salary{r}#5]
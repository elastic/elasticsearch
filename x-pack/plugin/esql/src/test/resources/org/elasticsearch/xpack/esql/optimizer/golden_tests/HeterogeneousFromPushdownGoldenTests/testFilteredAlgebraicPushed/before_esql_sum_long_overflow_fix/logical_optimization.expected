Limit[1000[INTEGER],false,false]
\_Aggregate[[],[SUM(salary{r}#0,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS s#1]]
  \_UnionAll[[salary{r}#0]]
    |_Project[[salary{r}#2]]
    | \_Filter[salary{r}#2 > 0[INTEGER]]
    |   \_ExternalRelation[s3://bucket/heavy_a.parquet][parquet][salary{r}#2]
    \_Project[[salary{r}#3]]
      \_Filter[salary{r}#3 > 0[INTEGER]]
        \_ExternalRelation[s3://bucket/heavy_b.parquet][parquet][salary{r}#3]
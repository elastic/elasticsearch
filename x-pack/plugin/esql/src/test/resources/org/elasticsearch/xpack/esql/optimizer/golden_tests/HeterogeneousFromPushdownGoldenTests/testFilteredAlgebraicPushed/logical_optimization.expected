Limit[1000[INTEGER],false,false]
\_Aggregate[[],[SUM($$partial$$s{r$}#0,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS s#1]]
  \_UnionAll[[$$partial$$s{r$}#0]]
    |_Aggregate[[],[SUM(salary{r}#2,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$partial$$s#0]]
    | \_Filter[salary{r}#2 > 0[INTEGER]]
    |   \_ExternalRelation[s3://bucket/heavy_a.parquet][parquet][emp_no{r}#3, salary{r}#2, dept{r}#4]
    \_Aggregate[[],[SUM(salary{r}#5,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$partial$$s#0]]
      \_Filter[salary{r}#5 > 0[INTEGER]]

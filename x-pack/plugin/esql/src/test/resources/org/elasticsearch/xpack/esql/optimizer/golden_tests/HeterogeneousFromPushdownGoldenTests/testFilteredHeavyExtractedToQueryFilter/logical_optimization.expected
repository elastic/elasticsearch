Limit[1000[INTEGER],false,false]
\_Aggregate[[],[COUNTDISTINCT(emp_no{r}#0,true[BOOLEAN],PT0S[TIME_DURATION]) AS d#1]]
  \_UnionAll[[emp_no{r}#0]]
    |_Project[[emp_no{r}#2]]
    | \_Filter[salary{r}#3 > 0[INTEGER]]
    |   \_ExternalRelation[s3://bucket/heavy_a.parquet][parquet][emp_no{r}#2, salary{r}#3]
    \_Project[[emp_no{r}#4]]
      \_Filter[salary{r}#5 > 0[INTEGER]]
        \_ExternalRelation[s3://bucket/heavy_b.parquet][parquet][emp_no{r}#4, salary{r}#5]
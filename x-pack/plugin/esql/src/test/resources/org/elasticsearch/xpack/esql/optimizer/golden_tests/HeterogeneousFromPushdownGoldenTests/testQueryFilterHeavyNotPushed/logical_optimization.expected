Limit[1000[INTEGER],false,false]
\_Aggregate[[],[COUNTDISTINCT(emp_no{r}#0,true[BOOLEAN],PT0S[TIME_DURATION]) AS d#1]]
  \_BranchPlan[[heavy_a=DATASET, heavy_b=DATASET]]
    |_Project[[emp_no{r}#2, salary{r}#3, dept{r}#4]]
    | \_Filter[salary{r}#3 > 0[INTEGER]]
    |   \_ExternalRelation[heavy_a.parquet][parquet][emp_no{r}#2, salary{r}#3, dept{r}#4]
    \_Project[[emp_no{r}#5, salary{r}#6, dept{r}#7]]
      \_Filter[salary{r}#6 > 0[INTEGER]]
        \_ExternalRelation[heavy_b.parquet][parquet][emp_no{r}#5, salary{r}#6, dept{r}#7]
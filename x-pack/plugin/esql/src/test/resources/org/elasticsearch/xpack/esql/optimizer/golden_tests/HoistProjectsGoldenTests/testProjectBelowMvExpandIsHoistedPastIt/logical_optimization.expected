Project[[avg_worked_seconds{f}#0, birth_date{f}#1, emp_no{f}#2, first_name{f}#3, gender{f}#4, height{f}#5, height.float{f}#6, height.half_float{f}#7, height.scaled_float{f}#8, hire_date{f}#9, is_rehired{f}#10, job_positions{r}#11, languages{f}#12, languages.byte{f}#13, languages.long{f}#14, languages.short{f}#15, last_name{f}#16, salary{f}#17, salary_change{f}#18, salary_change.int{f}#19, salary_change.keyword{f}#20, salary_change.long{f}#21, still_hired{f}#22, $$language_name$temp_name$0{r$}#23 AS lang#24, language_name{f}#25 AS lang_minus_one#26]]
\_Limit[1000[INTEGER],true,false]
  \_Join[LEFT,[language_code{r}#27],[language_code{f}#28],null,ANY]
    |_Eval[[languages{f}#12 - 1[INTEGER] AS language_code#27, language_name{f}#29 AS $$language_name$temp_name$0#23]]
    | \_Limit[1000[INTEGER],true,false]
    |   \_MvExpand[job_positions{f}#30,job_positions{r}#11]
    |     \_Limit[1000[INTEGER],true,false]
    |       \_Join[LEFT,[languages{f}#12],[language_code{f}#31],null,ANY]
    |         |_Limit[1000[INTEGER],false,false]
    |         | \_EsRelation[employees][avg_worked_seconds{f}#0, birth_date{f}#1, emp_no{f}#2, first_name{f}#3, gender{f}#4, height{f}#5, height.float{f}#6, height.half_float{f}#7, height.scaled_float{f}#8, hire_date{f}#9, is_rehired{f}#10, job_positions{f}#30, languages{f}#12, languages.byte{f}#13, languages.long{f}#14, languages.short{f}#15, last_name{f}#16, salary{f}#17, salary_change{f}#18, salary_change.int{f}#19, salary_change.keyword{f}#20, salary_change.long{f}#21, still_hired{f}#22]
    |         \_EsRelation[languages_lookup][LOOKUP][language_code{f}#31, language_name{f}#29]
    \_EsRelation[languages_lookup][LOOKUP][language_code{f}#28, language_name{f}#25]
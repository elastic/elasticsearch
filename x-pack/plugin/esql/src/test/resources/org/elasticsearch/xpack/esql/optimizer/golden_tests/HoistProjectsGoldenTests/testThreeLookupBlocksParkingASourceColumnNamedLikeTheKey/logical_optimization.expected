Project[[avg_worked_seconds{f}#0, birth_date{f}#1, emp_no{f}#2, first_name{f}#3, gender{f}#4, height{f}#5, height.float{f}#6, height.half_float{f}#7, height.scaled_float{f}#8, hire_date{f}#9, is_rehired{f}#10, job_positions{f}#11, languages{f}#12 AS language_code#13, languages.byte{f}#14, languages.long{f}#15, languages.short{f}#16, last_name{f}#17, salary{f}#18, salary_change{f}#19, salary_change.int{f}#20, salary_change.keyword{f}#21, salary_change.long{f}#22, still_hired{f}#23, $$language_name$temp_name$0{r$}#24 AS lang#25, $$language_name$temp_name$1{r$}#26 AS lang_minus_one#27, language_name{f}#28 AS lang_minus_two#29]]
\_Limit[1000[INTEGER],true,false]
  \_Join[LEFT,[language_code{r}#30],[language_code{f}#31],null,ANY]
    |_Eval[[languages{f}#12 - 2[INTEGER] AS language_code#30, language_name{f}#32 AS $$language_name$temp_name$1#26]]
    | \_Limit[1000[INTEGER],true,false]
    |   \_Join[LEFT,[language_code{r}#33],[language_code{f}#34],null,ANY]
    |     |_Eval[[languages{f}#12 - 1[INTEGER] AS language_code#33, language_name{f}#35 AS $$language_name$temp_name$0#24]]
    |     | \_Limit[1000[INTEGER],true,false]
    |     |   \_Join[LEFT,[languages{f}#12],[language_code{f}#36],null,ANY]
    |     |     |_Limit[1000[INTEGER],false,false]
    |     |     | \_EsRelation[employees][avg_worked_seconds{f}#0, birth_date{f}#1, emp_no{f}#2, first_name{f}#3, gender{f}#4, height{f}#5, height.float{f}#6, height.half_float{f}#7, height.scaled_float{f}#8, hire_date{f}#9, is_rehired{f}#10, job_positions{f}#11, languages{f}#12, languages.byte{f}#14, languages.long{f}#15, languages.short{f}#16, last_name{f}#17, salary{f}#18, salary_change{f}#19, salary_change.int{f}#20, salary_change.keyword{f}#21, salary_change.long{f}#22, still_hired{f}#23]
    |     |     \_EsRelation[languages_lookup][LOOKUP][language_code{f}#36, language_name{f}#35]
    |     \_EsRelation[languages_lookup][LOOKUP][language_code{f}#34, language_name{f}#32]
    \_EsRelation[languages_lookup][LOOKUP][language_code{f}#31, language_name{f}#28]
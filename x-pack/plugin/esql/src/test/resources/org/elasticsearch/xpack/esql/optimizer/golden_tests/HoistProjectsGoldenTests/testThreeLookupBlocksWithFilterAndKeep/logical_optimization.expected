Project[[emp_no{f}#0, languages{f}#1, salary{f}#2, $$language_name$temp_name$0{r$}#3 AS lang#4, $$language_name$temp_name$1{r$}#5 AS lang_minus_one#6, language_name{f}#7 AS lang_minus_two#8]]
\_Limit[10000[INTEGER],true,false]
  \_Join[LEFT,[language_code{r}#9],[language_code{f}#10],null,ANY]
    |_Eval[[languages{f}#1 - 2[INTEGER] AS language_code#9, language_name{f}#11 AS $$language_name$temp_name$1#5]]
    | \_Limit[100[INTEGER],true,false]
    |   \_Join[LEFT,[language_code{r}#12],[language_code{f}#13],null,ANY]
    |     |_Eval[[languages{f}#1 - 1[INTEGER] AS language_code#12, language_name{f}#14 AS $$language_name$temp_name$0#3]]
    |     | \_Limit[100[INTEGER],true,false]
    |     |   \_Join[LEFT,[languages{f}#1],[language_code{f}#15],null,ANY]
    |     |     |_Limit[100[INTEGER],false,false]
    |     |     | \_Filter[salary{f}#2 > 40000[INTEGER]]
    |     |     |   \_EsRelation[employees][avg_worked_seconds{f}#16, birth_date{f}#17, emp_no{f}#0, first_name{f}#18, gender{f}#19, height{f}#20, height.float{f}#21, height.half_float{f}#22, height.scaled_float{f}#23, hire_date{f}#24, is_rehired{f}#25, job_positions{f}#26, languages{f}#1, languages.byte{f}#27, languages.long{f}#28, languages.short{f}#29, last_name{f}#30, salary{f}#2, salary_change{f}#31, salary_change.int{f}#32, salary_change.keyword{f}#33, salary_change.long{f}#34, still_hired{f}#35]
    |     |     \_EsRelation[languages_lookup][LOOKUP][language_code{f}#15, language_name{f}#14]
    |     \_EsRelation[languages_lookup][LOOKUP][language_code{f}#13, language_name{f}#11]
    \_EsRelation[languages_lookup][LOOKUP][language_code{f}#10, language_name{f}#7]
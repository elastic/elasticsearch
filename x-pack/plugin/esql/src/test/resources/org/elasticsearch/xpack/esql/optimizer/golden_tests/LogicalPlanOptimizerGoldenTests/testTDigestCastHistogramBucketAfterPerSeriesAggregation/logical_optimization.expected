Project[[count{r}#0, bucket{r}#1]]
\_Eval[[CASE(ISNOTNULL(bucket{r}#1),COALESCE(TOLONG(HISTOGRAMFRACTION($$HISTOGRAMMERGE$count$0{r$}#2,bucket{r}#1,0[INTEGER])),0[LONG])) AS count#0]]
  \_Limit[10000[INTEGER],false,false]
    \_Aggregate[[bucket{r}#1],[HISTOGRAMMERGE(HISTOGRAMMERGEOVERTIME_$1{r}#3,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$HISTOGRAMMERGE$count$0#2, bucket{r}#1]]
      \_Eval[[BUCKET(HISTOGRAMMERGEOVERTIME_$1{r}#3,42[INTEGER]) AS bucket#1]]
        \_TimeSeriesAggregate[[_tsid{m}#4],[DELTAONLYHISTOGRAMMERGEOVERTIME($$responseTime::t>$HISTOGRAMMERGEOVERTIME$1{r$}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS HISTOGRAMMERGEOVERTIME_$1#3],null,@timestamp{f}#6,TS_COMMAND]
          \_Eval[[TOTDIGEST(responseTime{f}#7) AS $$responseTime::t>$HISTOGRAMMERGEOVERTIME$1#5]]
            \_EsRelation[exp_histo_sample][TIME_SERIES][responseTime{f}#7, _tsid{m}#4]
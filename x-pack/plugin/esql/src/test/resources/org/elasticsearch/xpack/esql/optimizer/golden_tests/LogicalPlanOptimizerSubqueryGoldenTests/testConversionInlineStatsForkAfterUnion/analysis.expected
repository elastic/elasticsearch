Limit[10000[INTEGER],false,false]
\_Limit[10[INTEGER],false,false]
  \_Project[[client_ip{r}#0, cnt{r}#1]]
    \_Fork[[cnt{r}#1, client_ip{r}#0, _fork{r}#2]]
      |_Project[[cnt{r}#3, client_ip{r}#4, _fork{r}#5]]
      | \_Eval[[fork1[KEYWORD] AS _fork#5]]
      |   \_Filter[cnt{r}#3 > 0[INTEGER]]
      |     \_InlineStats[]
      |       \_Aggregate[[client_ip{r}#4],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#3, client_ip{r}#4]]
      |         \_Eval[[$$client_ip$converted_to$ip{r$}#6 AS client_ip#4]]
      |           \_UnionAll[[client_ip{r}#7, $$client_ip$converted_to$ip{r$}#6]]
      |             |_Project[[client_ip{r}#8, $$client_ip$converted_to$ip{r$}#9]]
      |             | \_Eval[[TO_IP(client_ip{r}#8) AS $$client_ip$converted_to$ip#9]]
      |             |   \_Subquery[]
      |             |     \_Row[[172.21.0.5[KEYWORD] AS client_ip#8]]
      |             \_Project[[client_ip{r}#10, $$client_ip$converted_to$ip{r$}#11]]
      |               \_Eval[[TO_IP(client_ip{r}#10) AS $$client_ip$converted_to$ip#11]]
      |                 \_Subquery[]
      |                   \_Row[[172.21.3.15[KEYWORD] AS client_ip#10]]
      \_Project[[cnt{r}#3, client_ip{r}#4, _fork{r}#12]]
        \_Eval[[fork2[KEYWORD] AS _fork#12]]
          \_Filter[cnt{r}#3 > 1[INTEGER]]
            \_InlineStats[]
              \_Aggregate[[client_ip{r}#4],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#3, client_ip{r}#4]]
                \_Eval[[$$client_ip$converted_to$ip{r$}#13 AS client_ip#4]]
                  \_UnionAll[[client_ip{r}#14, $$client_ip$converted_to$ip{r$}#13]]
                    |_Project[[client_ip{r}#8, $$client_ip$converted_to$ip{r$}#15]]
                    | \_Eval[[TO_IP(client_ip{r}#8) AS $$client_ip$converted_to$ip#15]]
                    |   \_Subquery[]
                    |     \_Row[[172.21.0.5[KEYWORD] AS client_ip#8]]
                    \_Project[[client_ip{r}#10, $$client_ip$converted_to$ip{r$}#16]]
                      \_Eval[[TO_IP(client_ip{r}#10) AS $$client_ip$converted_to$ip#16]]
                        \_Subquery[]
                          \_Row[[172.21.3.15[KEYWORD] AS client_ip#10]]
Limit[10000[INTEGER],false,false]
\_Limit[10[INTEGER],false,false]
  \_Project[[client_ip{r}#0, cnt{r}#1]]
    \_Fork[[cnt{r}#1, client_ip{r}#0, _fork{r}#2]]
      |_Eval[[fork1[KEYWORD] AS _fork#3]]
      | \_Filter[cnt{r}#4 > 0[INTEGER]]
      |   \_InlineStats[]
      |     \_Aggregate[[client_ip{r}#5],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#4, client_ip{r}#5]]
      |       \_Eval[[$$client_ip$converted_to$ip{r$}#6 AS client_ip#5]]
      |         \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
      |           |_Eval[[TO_IP(client_ip{r}#7) AS $$client_ip$converted_to$ip#8]]
      |           | \_Row[[172.21.0.5[KEYWORD] AS client_ip#7]]
      |           \_Eval[[TO_IP(client_ip{r}#9) AS $$client_ip$converted_to$ip#10]]
      |             \_Row[[172.21.3.15[KEYWORD] AS client_ip#9]]
      \_Eval[[fork2[KEYWORD] AS _fork#11]]
        \_Filter[cnt{r}#4 > 1[INTEGER]]
          \_InlineStats[]
            \_Aggregate[[client_ip{r}#5],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#4, client_ip{r}#5]]
              \_Eval[[$$client_ip$converted_to$ip{r$}#12 AS client_ip#5]]
                \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
                  |_Eval[[TO_IP(client_ip{r}#7) AS $$client_ip$converted_to$ip#13]]
                  | \_Row[[172.21.0.5[KEYWORD] AS client_ip#7]]
                  \_Eval[[TO_IP(client_ip{r}#9) AS $$client_ip$converted_to$ip#14]]
                    \_Row[[172.21.3.15[KEYWORD] AS client_ip#9]]
Project[[client_ip{r}#0, cnt{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Limit[10[INTEGER],false,false]
    \_Project[[client_ip{r}#0, cnt{r}#1, $$client_ip$converted_to$keyword{r$}#2]]
      \_Eval[[$$client_ip$converted_to$keyword{r$}#2 AS client_ip#0]]
        \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
          |_Eval[[TO_STRING(client_ip{r}#3) AS $$client_ip$converted_to$keyword#4]]
          | \_InlineStats[]
          |   \_Aggregate[[client_ip{r}#3],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#5, client_ip{r}#3]]
          |     \_Eval[[$$client_ip$converted_to$ip{r$}#6 AS client_ip#3]]
          |       \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
          |         |_Eval[[TO_IP(client_ip{r}#7) AS $$client_ip$converted_to$ip#8]]
          |         | \_Row[[172.21.0.5[KEYWORD] AS client_ip#7]]
          |         \_Eval[[TO_IP(client_ip{r}#9) AS $$client_ip$converted_to$ip#10]]
          |           \_Row[[172.21.3.15[KEYWORD] AS client_ip#9]]
          \_Eval[[TO_STRING(client_ip{r}#11) AS $$client_ip$converted_to$keyword#12]]
            \_InlineStats[]
              \_Aggregate[[client_ip{r}#11],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#13, client_ip{r}#11]]
                \_Eval[[$$client_ip$converted_to$ip{r$}#14 AS client_ip#11]]
                  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
                    |_Eval[[TO_IP(client_ip{r}#15) AS $$client_ip$converted_to$ip#16]]
                    | \_Row[[172.21.0.5[KEYWORD] AS client_ip#15]]
                    \_Eval[[TO_IP(client_ip{r}#17) AS $$client_ip$converted_to$ip#18]]
                      \_Row[[172.21.3.15[KEYWORD] AS client_ip#17]]
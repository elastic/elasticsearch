Limit[10000[INTEGER],false,false]
\_Limit[10[INTEGER],false,false]
  \_UnionAll[[cnt{r}#0, client_ip{r}#1]]
    |_Project[[cnt{r}#2, client_ip{r}#3]]
    | \_Subquery[]
    |   \_InlineStats[]
    |     \_Aggregate[[client_ip{r}#3],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#2, client_ip{r}#3]]
    |       \_Eval[[$$client_ip$converted_to$ip{r$}#4 AS client_ip#3]]
    |         \_UnionAll[[client_ip{r}#5, $$client_ip$converted_to$ip{r$}#4]]
    |           |_Project[[client_ip{r}#6, $$client_ip$converted_to$ip{r$}#7]]
    |           | \_Eval[[TO_IP(client_ip{r}#6) AS $$client_ip$converted_to$ip#7]]
    |           |   \_Subquery[]
    |           |     \_Row[[172.21.0.5[KEYWORD] AS client_ip#6]]
    |           \_Project[[client_ip{r}#8, $$client_ip$converted_to$ip{r$}#9]]
    |             \_Eval[[TO_IP(client_ip{r}#8) AS $$client_ip$converted_to$ip#9]]
    |               \_Subquery[]
    |                 \_Row[[172.21.3.15[KEYWORD] AS client_ip#8]]
    \_Project[[cnt{r}#10, client_ip{r}#11]]
      \_Subquery[]
        \_Row[[TOIP(172.21.2.162[KEYWORD]) AS client_ip#11, TOLONG(1[INTEGER]) AS cnt#10]]
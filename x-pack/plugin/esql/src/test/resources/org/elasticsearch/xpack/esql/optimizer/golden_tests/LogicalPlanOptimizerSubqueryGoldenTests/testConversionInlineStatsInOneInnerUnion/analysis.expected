Limit[10000[INTEGER],false,false]
\_Limit[10[INTEGER],false,false]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Project[[cnt{r}#0, client_ip{r}#1]]
    | \_InlineStats[]
    |   \_Aggregate[[client_ip{r}#1],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS cnt#0, client_ip{r}#1]]
    |     \_Eval[[$$client_ip$converted_to$ip{r$}#2 AS client_ip#1]]
    |       \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |         |_Project[[client_ip{r}#3, $$client_ip$converted_to$ip{r$}#4]]
    |         | \_Eval[[TO_IP(client_ip{r}#3) AS $$client_ip$converted_to$ip#4]]
    |         |   \_Row[[172.21.0.5[KEYWORD] AS client_ip#3]]
    |         \_Project[[client_ip{r}#5, $$client_ip$converted_to$ip{r$}#6]]
    |           \_Eval[[TO_IP(client_ip{r}#5) AS $$client_ip$converted_to$ip#6]]
    |             \_Row[[172.21.3.15[KEYWORD] AS client_ip#5]]
    \_Project[[cnt{r}#7, client_ip{r}#8]]
      \_Row[[TOIP(172.21.2.162[KEYWORD]) AS client_ip#8, TOLONG(1[INTEGER]) AS cnt#7]]
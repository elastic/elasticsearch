Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3, does_not_exist{r}#4, d{r}#5]]
\_Limit[1000[INTEGER],false,false]
  \_Eval[[TODEGREES(event_duration{r}#2) AS d#5]]
    \_Filter[$$event_duration$converted_to$double{r$}#6 > 0[INTEGER] OR ISNOTNULL(does_not_exist{r}#4)]
      \_BranchPlan[[unnamed_view_2=SUBQUERY, unnamed_view_1=SUBQUERY, unnamed_view_2~2=SUBQUERY]]
        |_Eval[[TODOUBLE(event_duration{f}#7) AS $$event_duration$converted_to$double#8]]
        | \_EsRelation[sample_data][@timestamp{f}#9, client_ip{f}#10, event_duration{f}#7, message{f}#11, does_not_exist{f(MissingEsField)}#12]
        |_Eval[[TODOUBLE(event_duration{f}#13) AS $$event_duration$converted_to$double#14]]
        | \_EsRelation[sample_data][@timestamp{f}#15, client_ip{f}#16, event_duration{f}#13, message{f}#17, does_not_exist{f(MissingEsField)}#18]
        \_Eval[[TODOUBLE(event_duration{f}#19) AS $$event_duration$converted_to$double#20]]
          \_EsRelation[sample_data][@timestamp{f}#21, client_ip{f}#22, event_duration{f}#19, message{f}#23, does_not_exist{f(MissingEsField)}#24]
Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[x{r}#0,ASC,LAST]]]
  \_Aggregate[[x{r}#0],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS c#1, x{r}#0]]
    \_Eval[[DATETRUNC(PT1H[TIME_DURATION],$$@timestamp$converted_to$datetime{r$}#2) AS x#0]]
      \_UnionAll[[@timestamp{r}#3, $$@timestamp$converted_to$datetime{r$}#2, client_ip{r}#4, event_duration{r}#5, message{r}#6]]
        |_Project[[@timestamp{r}#7, $$@timestamp$converted_to$datetime{r$}#8, client_ip{f}#9, event_duration{f}#10, message{f}#11]]
        | \_Eval[[TODATENANOS(@timestamp{f}#12) AS @timestamp#7]]
        |   \_Eval[[TODATETIME(@timestamp{f}#12) AS $$@timestamp$converted_to$datetime#8]]
        |     \_EsRelation[sample_data][@timestamp{f}#12, client_ip{f}#9, event_duration{f}#10, message{f}#11]
        \_Project[[@timestamp{f}#13, $$@timestamp$converted_to$datetime{r$}#14, client_ip{f}#15, event_duration{f}#16, message{f}#17]]
          \_Eval[[TODATETIME(@timestamp{f}#13) AS $$@timestamp$converted_to$datetime#14]]
            \_Subquery[]
              \_EsRelation[sample_data_ts_nanos][@timestamp{f}#13, client_ip{f}#15, event_duration{f}#16, message{f}#17]
Project[[s{r}#0, h{r}#1]]
\_Limit[1000[INTEGER],false,false]
  \_OrderBy[[Order[s{r}#0,ASC,LAST]]]
    \_Project[[s{r}#0, h{r}#1, $$@timestamp$converted_to$keyword{r$}#2]]
      \_Eval[[$$@timestamp$converted_to$keyword{r$}#2 AS s#0, DATEEXTRACT(hour_of_day[KEYWORD],@timestamp{r}#3) AS h#1]]
        \_UnionAll[[@timestamp{r}#3, $$@timestamp$converted_to$keyword{r$}#2, client_ip{r}#4, event_duration{r}#5, message{r}#6]]
          |_Project[[@timestamp{r}#7, $$@timestamp$converted_to$keyword{r$}#8, client_ip{f}#9, event_duration{f}#10, message{f}#11]]
          | \_Eval[[TODATENANOS(@timestamp{f}#12) AS @timestamp#7]]
          |   \_Eval[[TO_STRING(@timestamp{f}#12) AS $$@timestamp$converted_to$keyword#8]]
          |     \_EsRelation[sample_data][@timestamp{f}#12, client_ip{f}#9, event_duration{f}#10, message{f}#11]
          \_Project[[@timestamp{f}#13, $$@timestamp$converted_to$keyword{r$}#14, client_ip{f}#15, event_duration{f}#16, message{f}#17]]
            \_Eval[[TO_STRING(@timestamp{f}#13) AS $$@timestamp$converted_to$keyword#14]]
              \_Subquery[]
                \_EsRelation[sample_data_ts_nanos][@timestamp{f}#13, client_ip{f}#15, event_duration{f}#16, message{f}#17]
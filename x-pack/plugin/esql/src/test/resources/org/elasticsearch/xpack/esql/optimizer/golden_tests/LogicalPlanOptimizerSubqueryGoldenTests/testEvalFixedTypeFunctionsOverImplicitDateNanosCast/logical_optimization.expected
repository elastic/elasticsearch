  \_Eval[[DATEEXTRACT(hour_of_day[KEYWORD],@timestamp{r}#3) AS h#2]]
    \_UnionAll[[@timestamp{r}#3, $$@timestamp$converted_to$keyword{r$}#0, client_ip{r}#4, event_duration{r}#5, message{r}#6]]

\_Project[[y{r}#0, @timestamp{r}#1, _fork{r}#2]]
  \_OrderBy[[Order[y{r}#0,ASC,LAST]]]
    \_Project[[@timestamp{r}#1, client_ip{r}#3, event_duration{r}#4, message{r}#5, t{r}#6 AS y#0, _fork{r}#2]]

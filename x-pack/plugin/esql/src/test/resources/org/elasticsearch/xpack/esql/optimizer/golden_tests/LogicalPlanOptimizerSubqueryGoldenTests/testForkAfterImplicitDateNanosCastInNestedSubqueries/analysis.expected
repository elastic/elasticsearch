        |               \_Project[[@timestamp{r}#26, client_ip{f}#27, event_duration{f}#28, message{f}#29]]
        |                 \_Eval[[TODATENANOS(@timestamp{f}#30) AS @timestamp#26]]
        |                   \_Subquery[]

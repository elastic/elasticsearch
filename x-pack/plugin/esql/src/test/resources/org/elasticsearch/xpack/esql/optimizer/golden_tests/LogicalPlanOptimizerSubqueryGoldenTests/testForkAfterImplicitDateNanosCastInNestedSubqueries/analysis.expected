                  \_Project[[@timestamp{r}#41, client_ip{r}#42, event_duration{r}#43, message{r}#44]]
                    \_Subquery[]
                      \_UnionAll[[@timestamp{r}#41, client_ip{r}#42, event_duration{r}#43, message{r}#44]]
                        |_Project[[@timestamp{f}#45, client_ip{f}#46, event_duration{f}#47, message{f}#48]]

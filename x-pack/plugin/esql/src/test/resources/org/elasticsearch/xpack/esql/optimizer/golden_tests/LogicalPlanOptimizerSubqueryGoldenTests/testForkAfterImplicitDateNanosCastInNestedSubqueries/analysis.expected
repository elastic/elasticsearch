        |_Project[[@timestamp{r}#7, client_ip{r}#8, event_duration{r}#9, message{r}#10, t{r}#11, _fork{r}#12]]
        | \_Eval[[fork1[KEYWORD] AS _fork#12]]
        |   \_Filter[event_duration{r}#9 > 0[INTEGER]]
        |     \_Eval[[@timestamp{r}#7 AS t#11]]
        |       \_BranchPlan[[null=INDEX, main=INDEX, unnamed_view_1=SUBQUERY]]
        |         |_Project[[@timestamp{r}#13, client_ip{f}#14, event_duration{f}#15, message{f}#16]]
        |         | \_Eval[[TODATENANOS(@timestamp{f}#17) AS @timestamp#13]]

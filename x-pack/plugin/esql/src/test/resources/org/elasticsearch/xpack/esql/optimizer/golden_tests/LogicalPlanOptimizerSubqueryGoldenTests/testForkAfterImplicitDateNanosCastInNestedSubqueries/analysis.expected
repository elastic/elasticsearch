        \_Project[[@timestamp{r}#31, client_ip{r}#32, event_duration{r}#33, message{r}#34, t{r}#11, _fork{r}#35]]
          \_Eval[[fork2[KEYWORD] AS _fork#35]]
            \_Filter[event_duration{r}#33 <= 0[INTEGER]]
              \_Eval[[@timestamp{r}#31 AS t#11]]
                \_UnionAll[[@timestamp{r}#31, client_ip{r}#32, event_duration{r}#33, message{r}#34]]
                  |_Project[[@timestamp{r}#36, client_ip{f}#37, event_duration{f}#38, message{f}#39]]

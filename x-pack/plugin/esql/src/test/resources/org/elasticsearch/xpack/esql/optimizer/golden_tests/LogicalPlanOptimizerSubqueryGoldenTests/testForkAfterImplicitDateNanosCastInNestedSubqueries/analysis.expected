        |         |_Project[[@timestamp{f}#18, client_ip{f}#19, event_duration{f}#20, message{f}#21]]
        |         | \_EsRelation[sample_data_ts_nanos][@timestamp{f}#18, client_ip{f}#19, event_duration{f}#20, message{f}#21]
        |         \_Project[[@timestamp{r}#22, client_ip{f}#23, event_duration{f}#24, message{f}#25]]
        |           \_Eval[[TODATENANOS(@timestamp{f}#26) AS @timestamp#22]]
        |             \_EsRelation[sample_data][@timestamp{f}#26, client_ip{f}#23, event_duration{f}#24, message{f}#25]
        \_Project[[@timestamp{r}#27, client_ip{r}#28, event_duration{r}#29, message{r}#30, t{r}#11, _fork{r}#31]]
          \_Eval[[fork2[KEYWORD] AS _fork#31]]
            \_Filter[event_duration{r}#29 <= 0[INTEGER]]
              \_Eval[[@timestamp{r}#27 AS t#11]]
                \_BranchPlan[[null=INDEX, main=INDEX, unnamed_view_1=SUBQUERY]]
                  |_Project[[@timestamp{r}#32, client_ip{f}#33, event_duration{f}#34, message{f}#35]]
                  | \_Eval[[TODATENANOS(@timestamp{f}#36) AS @timestamp#32]]
                  |   \_EsRelation[sample_data][@timestamp{f}#36, client_ip{f}#33, event_duration{f}#34, message{f}#35]
                  |_Project[[@timestamp{f}#37, client_ip{f}#38, event_duration{f}#39, message{f}#40]]
                  | \_EsRelation[sample_data_ts_nanos][@timestamp{f}#37, client_ip{f}#38, event_duration{f}#39, message{f}#40]
                  \_Project[[@timestamp{r}#41, client_ip{f}#42, event_duration{f}#43, message{f}#44]]
                    \_Eval[[TODATENANOS(@timestamp{f}#45) AS @timestamp#41]]
                      \_EsRelation[sample_data][@timestamp{f}#45, client_ip{f}#42, event_duration{f}#43, message{f}#44]
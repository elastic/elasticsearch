Limit[1000[INTEGER],false,false]
\_Project[[y{r}#0, @timestamp{r}#1, _fork{r}#2]]
  \_OrderBy[[Order[y{r}#0,ASC,LAST]]]
    \_Project[[@timestamp{r}#1, client_ip{r}#3, event_duration{r}#4, message{r}#5, t{r}#6 AS y#0, _fork{r}#2]]
      \_Fork[[@timestamp{r}#1, client_ip{r}#3, event_duration{r}#4, message{r}#5, t{r}#6, _fork{r}#2]]
        |_Eval[[fork1[KEYWORD] AS _fork#7]]
        | \_Filter[event_duration{r}#8 > 0[INTEGER]]
        |   \_Eval[[@timestamp{r}#9 AS t#10]]
        |     \_BranchPlan[[null=INDEX, main=INDEX, unnamed_view_1=SUBQUERY]]
        |       |_Eval[[TODATENANOS(@timestamp{f}#11) AS @timestamp#12]]
        |       | \_EsRelation[sample_data][@timestamp{f}#11, client_ip{f}#13, event_duration{f}#14, message{f}#15]
        |       |_EsRelation[sample_data_ts_nanos][@timestamp{f}#16, client_ip{f}#17, event_duration{f}#18, message{f}#19]
        |       \_Eval[[TODATENANOS(@timestamp{f}#20) AS @timestamp#21]]
        |         \_EsRelation[sample_data][@timestamp{f}#20, client_ip{f}#22, event_duration{f}#23, message{f}#24]
        \_Eval[[fork2[KEYWORD] AS _fork#25]]
          \_Filter[event_duration{r}#26 <= 0[INTEGER]]
            \_Eval[[@timestamp{r}#27 AS t#10]]
              \_BranchPlan[[null=INDEX, main=INDEX, unnamed_view_1=SUBQUERY]]
                |_Eval[[TODATENANOS(@timestamp{f}#28) AS @timestamp#29]]
                | \_EsRelation[sample_data][@timestamp{f}#28, client_ip{f}#30, event_duration{f}#31, message{f}#32]
                |_EsRelation[sample_data_ts_nanos][@timestamp{f}#33, client_ip{f}#34, event_duration{f}#35, message{f}#36]
                \_Eval[[TODATENANOS(@timestamp{f}#37) AS @timestamp#38]]
                  \_EsRelation[sample_data][@timestamp{f}#37, client_ip{f}#39, event_duration{f}#40, message{f}#41]
Limit[1000[INTEGER],false,false]
\_Fork[[emp_no{r}#0, salary{r}#1, dept{r}#2, _fork{r}#3]]
  |_Eval[[fork1[KEYWORD] AS _fork#4]]
  | \_Filter[emp_no{r}#5 > 10[INTEGER]]
  |   \_BranchPlan[[heavy_a=DATASET, heavy_b=DATASET]]
  |     |_ExternalRelation[heavy_a.parquet][parquet][emp_no{r}#6, salary{r}#7, dept{r}#8]
  |     \_ExternalRelation[heavy_b.parquet][parquet][emp_no{r}#9, salary{r}#10, dept{r}#11]
  \_Eval[[fork2[KEYWORD] AS _fork#12]]
    \_Filter[emp_no{r}#13 <= 10[INTEGER]]
      \_BranchPlan[[heavy_a=DATASET, heavy_b=DATASET]]
        |_ExternalRelation[heavy_a.parquet][parquet][emp_no{r}#6, salary{r}#7, dept{r}#8]
        \_ExternalRelation[heavy_b.parquet][parquet][emp_no{r}#9, salary{r}#10, dept{r}#11]
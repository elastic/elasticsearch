    \_Eval[[fork2[KEYWORD] AS _fork#8]]
      \_Filter[true[BOOLEAN]]
        \_Project[[ts{r}#9 AS x#4]]
          \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
            |_Eval[[TODATENANOS(ts{r}#5) AS ts#10]]

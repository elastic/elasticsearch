            |   \_EsRelation[sample_data][@timestamp{f}#27, client_ip{f}#24, event_duration{f}#25, message{f}#26]
            \_Project[[@timestamp{f}#28, client_ip{f}#29, event_duration{f}#30, message{f}#31]]
              \_Subquery[]
                \_EsRelation[sample_data_ts_nanos][@timestamp{f}#28, client_ip{f}#29, event_duration{f}#30, message{f}#31]
    |_Project[[message{r}#3, _fork{r}#4, @timestamp{r}#5]]
    | \_Eval[[null[DATE_NANOS] AS @timestamp#5]]
    |   \_Eval[[fork1[KEYWORD] AS _fork#4]]
    |     \_Project[[message{r}#3]]
    |       \_UnionAll[[@timestamp{r}#6, client_ip{r}#7, event_duration{r}#8, message{r}#3]]
    |         |_Project[[@timestamp{r}#9, client_ip{f}#10, event_duration{f}#11, message{f}#12]]
    |         | \_Eval[[TODATENANOS(@timestamp{f}#13) AS @timestamp#9]]
    |         |   \_EsRelation[sample_data][@timestamp{f}#13, client_ip{f}#10, event_duration{f}#11, message{f}#12]
    |         \_Project[[@timestamp{f}#14, client_ip{f}#15, event_duration{f}#16, message{f}#17]]
    |           \_Subquery[]
    |             \_EsRelation[sample_data_ts_nanos][@timestamp{f}#14, client_ip{f}#15, event_duration{f}#16, message{f}#17]
    \_Project[[message{r}#18, _fork{r}#19, @timestamp{r}#20]]
      \_Eval[[fork2[KEYWORD] AS _fork#19]]
        \_Project[[@timestamp{r}#20, message{r}#18]]
          \_UnionAll[[@timestamp{r}#20, client_ip{r}#21, event_duration{r}#22, message{r}#18]]
            |_Project[[@timestamp{r}#23, client_ip{f}#24, event_duration{f}#25, message{f}#26]]

Limit[1000[INTEGER],false,false]
\_Project[[m{r}#0, @timestamp{r}#1]]
  \_Fork[[m{r}#0, _fork{r}#2, @timestamp{r}#1]]
    |_Eval[[fork1[KEYWORD] AS _fork#3]]
    | \_Aggregate[[],[MAX(@timestamp{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS m#5]]
    |   \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
    |     |_Eval[[TODATENANOS(@timestamp{f}#6) AS @timestamp#7]]
    |     | \_EsRelation[sample_data][@timestamp{f}#6, client_ip{f}#8, event_duration{f}#9, message{f}#10]
    |     \_EsRelation[sample_data_ts_nanos][@timestamp{f}#11, client_ip{f}#12, event_duration{f}#13, message{f}#14]
    \_Eval[[fork2[KEYWORD] AS _fork#15]]
      \_Project[[@timestamp{r}#16]]
        \_Filter[true[BOOLEAN]]
          \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
            |_Eval[[TODATENANOS(@timestamp{f}#17) AS @timestamp#18]]
            | \_EsRelation[sample_data][@timestamp{f}#17, client_ip{f}#19, event_duration{f}#20, message{f}#21]
            \_EsRelation[sample_data_ts_nanos][@timestamp{f}#22, client_ip{f}#23, event_duration{f}#24, message{f}#25]
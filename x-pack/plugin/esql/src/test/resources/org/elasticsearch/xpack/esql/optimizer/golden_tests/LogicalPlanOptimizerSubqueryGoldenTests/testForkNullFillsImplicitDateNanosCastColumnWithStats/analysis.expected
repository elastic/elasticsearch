Limit[1000[INTEGER],false,false]
\_Project[[m{r}#0, @timestamp{r}#1]]
  \_Fork[[m{r}#0, _fork{r}#2, @timestamp{r}#1]]
    |_Project[[m{r}#3, _fork{r}#4, @timestamp{r}#5]]
    | \_Eval[[null[DATE_NANOS] AS @timestamp#5]]
    |   \_Eval[[fork1[KEYWORD] AS _fork#4]]
    |     \_Aggregate[[],[MAX(@timestamp{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS m#3]]
    |       \_UnionAll[[@timestamp{r}#6, client_ip{r}#7, event_duration{r}#8, message{r}#9]]
    |         |_Project[[@timestamp{r}#10, client_ip{f}#11, event_duration{f}#12, message{f}#13]]
    |         | \_Eval[[TODATENANOS(@timestamp{f}#14) AS @timestamp#10]]
    |         |   \_EsRelation[sample_data][@timestamp{f}#14, client_ip{f}#11, event_duration{f}#12, message{f}#13]
    |         \_Project[[@timestamp{f}#15, client_ip{f}#16, event_duration{f}#17, message{f}#18]]
    |           \_Subquery[]
    |             \_EsRelation[sample_data_ts_nanos][@timestamp{f}#15, client_ip{f}#16, event_duration{f}#17, message{f}#18]
    \_Project[[m{r}#19, _fork{r}#20, @timestamp{r}#21]]
      \_Eval[[null[DATE_NANOS] AS m#19]]
        \_Eval[[fork2[KEYWORD] AS _fork#20]]
          \_Project[[@timestamp{r}#21]]
            \_Filter[true[BOOLEAN]]
              \_UnionAll[[@timestamp{r}#21, client_ip{r}#22, event_duration{r}#23, message{r}#24]]
                |_Project[[@timestamp{r}#25, client_ip{f}#26, event_duration{f}#27, message{f}#28]]
                | \_Eval[[TODATENANOS(@timestamp{f}#29) AS @timestamp#25]]
                |   \_EsRelation[sample_data][@timestamp{f}#29, client_ip{f}#26, event_duration{f}#27, message{f}#28]
                \_Project[[@timestamp{f}#30, client_ip{f}#31, event_duration{f}#32, message{f}#33]]
                  \_Subquery[]
                    \_EsRelation[sample_data_ts_nanos][@timestamp{f}#30, client_ip{f}#31, event_duration{f}#32, message{f}#33]
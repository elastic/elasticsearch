Limit[1000[INTEGER],false,false]
\_Project[[m{r}#0, @timestamp{r}#1]]
  \_Fork[[m{r}#0, _fork{r}#2, @timestamp{r}#1]]
    |_Project[[m{r}#3, _fork{r}#4, @timestamp{r}#5]]
    | \_Eval[[null[DATE_NANOS] AS @timestamp#5]]
    |   \_Eval[[fork1[KEYWORD] AS _fork#4]]
    |     \_Aggregate[[],[MAX(@timestamp{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS m#3]]
    |       \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
    |         |_Project[[@timestamp{r}#7, client_ip{f}#8, event_duration{f}#9, message{f}#10]]
    |         | \_Eval[[TODATENANOS(@timestamp{f}#11) AS @timestamp#7]]
    |         |   \_EsRelation[sample_data][@timestamp{f}#11, client_ip{f}#8, event_duration{f}#9, message{f}#10]
    |         \_Project[[@timestamp{f}#12, client_ip{f}#13, event_duration{f}#14, message{f}#15]]
    |           \_EsRelation[sample_data_ts_nanos][@timestamp{f}#12, client_ip{f}#13, event_duration{f}#14, message{f}#15]
    \_Project[[m{r}#16, _fork{r}#17, @timestamp{r}#18]]
      \_Eval[[null[DATE_NANOS] AS m#16]]
        \_Eval[[fork2[KEYWORD] AS _fork#17]]
          \_Project[[@timestamp{r}#18]]
            \_Filter[true[BOOLEAN]]
              \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
                |_Project[[@timestamp{r}#19, client_ip{f}#20, event_duration{f}#21, message{f}#22]]
                | \_Eval[[TODATENANOS(@timestamp{f}#23) AS @timestamp#19]]
                |   \_EsRelation[sample_data][@timestamp{f}#23, client_ip{f}#20, event_duration{f}#21, message{f}#22]
                \_Project[[@timestamp{f}#24, client_ip{f}#25, event_duration{f}#26, message{f}#27]]
                  \_EsRelation[sample_data_ts_nanos][@timestamp{f}#24, client_ip{f}#25, event_duration{f}#26, message{f}#27]
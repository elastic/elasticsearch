Limit[1000[INTEGER],false,false]
\_Project[[!x]]
  \_Fork[[!x, _fork{r}#0]]
    |_Eval[[fork1[KEYWORD] AS _fork#1]]
    | \_Filter[true[BOOLEAN]]
    |   \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |     |_Eval[[null[KEYWORD] AS x#2]]
    |     | \_Row[[1[INTEGER] AS x#3]]
    |     \_Eval[[null[KEYWORD] AS x#4]]
    |       \_Row[[abc[KEYWORD] AS x#5]]
    \_Eval[[fork2[KEYWORD] AS _fork#6]]
      \_Filter[true[BOOLEAN]]
        \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
          |_Eval[[null[KEYWORD] AS x#7]]
          | \_Row[[1[INTEGER] AS x#3]]
          \_Eval[[null[KEYWORD] AS x#8]]
            \_Row[[abc[KEYWORD] AS x#5]]
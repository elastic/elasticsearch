Project[[t{r}#0]]
\_Limit[1000[INTEGER],false,false]
  \_OrderBy[[Order[t{r}#0,ASC,LAST]]]
    \_Project[[t{r}#0, $$@timestamp$converted_to$date_nanos{r$}#1]]
      \_Eval[[$$@timestamp$converted_to$date_nanos{r$}#1 AS t#0]]
        \_Filter[$$@timestamp$converted_to$date_nanos{r$}#1 > TODATENANOS(2023-10-23T13:00:00Z[KEYWORD]) OR ISNOTNULL(does_not_exist{r}#2)]
          \_UnionAll[[@timestamp{r}#3, $$@timestamp$converted_to$date_nanos{r$}#1, client_ip{r}#4, event_duration{r}#5, message{r}#6, does_not_exist{r}#2]]
            |_Project[[@timestamp{r}#7, $$@timestamp$converted_to$date_nanos{r$}#8, client_ip{f}#9, event_duration{f}#10, message{f}#11, does_not_exist{f(MissingEsField)}#12]]
            | \_Eval[[TODATENANOS(@timestamp{f}#13) AS @timestamp#7]]
            |   \_Eval[[TODATENANOS(@timestamp{f}#13) AS $$@timestamp$converted_to$date_nanos#8]]
            |     \_EsRelation[sample_data][@timestamp{f}#13, client_ip{f}#9, event_duration{f}#10, message{f}#11, does_not_exist{f(MissingEsField)}#12]
            \_Project[[@timestamp{f}#14, $$@timestamp$converted_to$date_nanos{r$}#15, client_ip{f}#16, event_duration{f}#17, message{f}#18, does_not_exist{f(MissingEsField)}#19]]
              \_Eval[[TODATENANOS(@timestamp{f}#14) AS $$@timestamp$converted_to$date_nanos#15]]
                \_Subquery[]
                  \_EsRelation[sample_data_ts_nanos][@timestamp{f}#14, client_ip{f}#16, event_duration{f}#17, message{f}#18, does_not_exist{f(MissingEsField)}#19]
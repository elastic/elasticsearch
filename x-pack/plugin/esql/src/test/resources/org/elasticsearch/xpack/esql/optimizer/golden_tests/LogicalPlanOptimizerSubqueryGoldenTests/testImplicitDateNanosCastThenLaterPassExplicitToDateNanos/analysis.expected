Project[[t{r}#0]]
\_Limit[1000[INTEGER],false,false]
  \_OrderBy[[Order[t{r}#0,ASC,LAST]]]
    \_Project[[t{r}#0, $$@timestamp$converted_to$date_nanos{r$}#1]]
      \_Eval[[$$@timestamp$converted_to$date_nanos{r$}#1 AS t#0]]
        \_Filter[$$@timestamp$converted_to$date_nanos{r$}#1 > TODATENANOS(2023-10-23T13:00:00Z[KEYWORD]) OR ISNOTNULL(does_not_exist{r}#2)]
          \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
            |_Project[[@timestamp{r}#3, $$@timestamp$converted_to$date_nanos{r$}#4, client_ip{f}#5, event_duration{f}#6, message{f}#7, does_not_exist{f(MissingEsField)}#8]]
            | \_Eval[[TODATENANOS(@timestamp{f}#9) AS @timestamp#3]]
            |   \_Eval[[TODATENANOS(@timestamp{f}#9) AS $$@timestamp$converted_to$date_nanos#4]]
            |     \_EsRelation[sample_data][@timestamp{f}#9, client_ip{f}#5, event_duration{f}#6, message{f}#7, does_not_exist{f(MissingEsField)}#8]
            \_Project[[@timestamp{f}#10, $$@timestamp$converted_to$date_nanos{r$}#11, client_ip{f}#12, event_duration{f}#13, message{f}#14, does_not_exist{f(MissingEsField)}#15]]
              \_Eval[[TODATENANOS(@timestamp{f}#10) AS $$@timestamp$converted_to$date_nanos#11]]
                \_EsRelation[sample_data_ts_nanos][@timestamp{f}#10, client_ip{f}#12, event_duration{f}#13, message{f}#14, does_not_exist{f(MissingEsField)}#15]
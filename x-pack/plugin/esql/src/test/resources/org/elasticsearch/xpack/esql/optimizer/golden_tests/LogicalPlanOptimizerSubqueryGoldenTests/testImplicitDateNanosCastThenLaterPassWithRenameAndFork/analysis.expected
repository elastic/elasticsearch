      |         \_Eval[[TODATENANOS(@timestamp{f}#22) AS $$@timestamp$converted_to$date_nanos#23]]
      |           \_EsRelation[sample_data_ts_nanos][@timestamp{f}#22, client_ip{f}#24, event_duration{f}#25, message{f}#26, does_not_exist{f(MissingEsField)}#27]
      \_Eval[[fork2[KEYWORD] AS _fork#28]]
        \_Filter[true[BOOLEAN]]
          \_Project[[@timestamp{r}#29 AS ts#9, $$@timestamp$converted_to$date_nanos{r$}#30, client_ip{r}#31, event_duration{r}#32, message{r}#33, does_not_exist{r}#34]]
            \_Filter[$$@timestamp$converted_to$date_nanos{r$}#30 > TODATENANOS(2023-10-23T13:00:00Z[KEYWORD]) OR ISNOTNULL(does_not_exist{r}#34)]

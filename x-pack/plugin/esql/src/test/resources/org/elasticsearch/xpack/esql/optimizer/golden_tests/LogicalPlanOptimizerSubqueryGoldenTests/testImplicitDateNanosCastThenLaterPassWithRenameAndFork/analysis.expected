      \_Project[[ts{r}#7, $$@timestamp$converted_to$date_nanos{r$}#28, client_ip{r}#29, event_duration{r}#30, message{r}#31, does_not_exist{r}#32, _fork{r}#33]]
        \_Eval[[fork2[KEYWORD] AS _fork#33]]

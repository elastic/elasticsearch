Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[ts{r}#0,ASC,LAST], Order[_fork{r}#1,ASC,LAST]]]
  \_Project[[ts{r}#0, _fork{r}#1]]
    \_Project[[@timestamp{r}#2 AS ts#0, client_ip{r}#3, event_duration{r}#4, message{r}#5, _fork{r}#1]]
      \_Fork[[@timestamp{r}#2, client_ip{r}#3, event_duration{r}#4, message{r}#5, _fork{r}#1]]
        |_Eval[[fork1[KEYWORD] AS _fork#6]]
        | \_Filter[true[BOOLEAN]]
        |   \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
        |     |_Eval[[TODATENANOS(@timestamp{f}#7) AS @timestamp#8]]
        |     | \_EsRelation[sample_data][@timestamp{f}#7, client_ip{f}#9, event_duration{f}#10, message{f}#11]
        |     \_EsRelation[sample_data_ts_nanos][@timestamp{f}#12, client_ip{f}#13, event_duration{f}#14, message{f}#15]
        \_Eval[[fork2[KEYWORD] AS _fork#16]]
          \_Filter[true[BOOLEAN]]
            \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
              |_Eval[[TODATENANOS(@timestamp{f}#17) AS @timestamp#18]]
              | \_EsRelation[sample_data][@timestamp{f}#17, client_ip{f}#19, event_duration{f}#20, message{f}#21]
              \_EsRelation[sample_data_ts_nanos][@timestamp{f}#22, client_ip{f}#23, event_duration{f}#24, message{f}#25]
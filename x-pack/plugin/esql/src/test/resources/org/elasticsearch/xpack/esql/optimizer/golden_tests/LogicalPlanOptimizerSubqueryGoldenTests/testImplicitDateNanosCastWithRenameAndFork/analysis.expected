Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[ts{r}#0,ASC,LAST], Order[_fork{r}#1,ASC,LAST]]]
  \_Project[[ts{r}#0, _fork{r}#1]]
    \_Fork[[ts{r}#0, client_ip{r}#2, event_duration{r}#3, message{r}#4, _fork{r}#1]]
      |_Project[[ts{r}#5, client_ip{r}#6, event_duration{r}#7, message{r}#8, _fork{r}#9]]
      | \_Eval[[fork1[KEYWORD] AS _fork#9]]
      |   \_Filter[true[BOOLEAN]]
      |     \_Project[[@timestamp{r}#10 AS ts#5, client_ip{r}#6, event_duration{r}#7, message{r}#8]]
      |       \_UnionAll[[@timestamp{r}#10, client_ip{r}#6, event_duration{r}#7, message{r}#8]]
      |         |_Project[[@timestamp{r}#11, client_ip{f}#12, event_duration{f}#13, message{f}#14]]
      |         | \_Eval[[TODATENANOS(@timestamp{f}#15) AS @timestamp#11]]
      |         |   \_EsRelation[sample_data][@timestamp{f}#15, client_ip{f}#12, event_duration{f}#13, message{f}#14]
      |         \_Project[[@timestamp{f}#16, client_ip{f}#17, event_duration{f}#18, message{f}#19]]
      |           \_Subquery[]
      |             \_EsRelation[sample_data_ts_nanos][@timestamp{f}#16, client_ip{f}#17, event_duration{f}#18, message{f}#19]
      \_Project[[ts{r}#5, client_ip{r}#20, event_duration{r}#21, message{r}#22, _fork{r}#23]]
        \_Eval[[fork2[KEYWORD] AS _fork#23]]
          \_Filter[true[BOOLEAN]]
            \_Project[[@timestamp{r}#24 AS ts#5, client_ip{r}#20, event_duration{r}#21, message{r}#22]]
              \_UnionAll[[@timestamp{r}#24, client_ip{r}#20, event_duration{r}#21, message{r}#22]]
                |_Project[[@timestamp{r}#25, client_ip{f}#26, event_duration{f}#27, message{f}#28]]
                | \_Eval[[TODATENANOS(@timestamp{f}#29) AS @timestamp#25]]
                |   \_EsRelation[sample_data][@timestamp{f}#29, client_ip{f}#26, event_duration{f}#27, message{f}#28]
                \_Project[[@timestamp{f}#30, client_ip{f}#31, event_duration{f}#32, message{f}#33]]
                  \_Subquery[]
                    \_EsRelation[sample_data_ts_nanos][@timestamp{f}#30, client_ip{f}#31, event_duration{f}#32, message{f}#33]
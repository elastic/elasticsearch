              \_Eval[[TODATENANOS(@timestamp{f}#17) AS $$@timestamp$converted_to$date_nanos#18]]
                \_EsRelation[sample_data_ts_nanos][@timestamp{f}#17, client_ip{f}#19, event_duration{f}#20, message{f}#21, does_not_exist{f(MissingEsField)}#22]
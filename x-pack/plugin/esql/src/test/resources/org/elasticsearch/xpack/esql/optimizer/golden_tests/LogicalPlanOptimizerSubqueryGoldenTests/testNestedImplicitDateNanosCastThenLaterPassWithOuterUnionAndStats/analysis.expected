Limit[10000[INTEGER],false,false]
\_Limit[10[INTEGER],false,false]
  \_OrderBy[[Order[@timestamp{r}#0,ASC,LAST]]]
    \_Aggregate[[@timestamp{r}#0],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS c#1, @timestamp{r}#0]]
      \_Filter[TODATENANOS(@timestamp{r}#0) > TODATENANOS(2023-10-23T13:00:00Z[KEYWORD]) OR ISNOTNULL(does_not_exist{r}#2)]
        \_UnionAll[[@timestamp{r}#0, client_ip{r}#3, event_duration{r}#4, message{r}#5, $$@timestamp$converted_to$date_nanos{r$}#6, does_not_exist{r}#2]]
          |_Project[[@timestamp{r}#7, client_ip{f}#8, event_duration{f}#9, message{f}#10, $$@timestamp$converted_to$date_nanos{r}#11, does_not_exist{r}#12]]
          | \_Eval[[TODATENANOS(@timestamp{f}#13) AS @timestamp#7]]
          |   \_Eval[[null[DATE_NANOS] AS $$@timestamp$converted_to$date_nanos#11, null[NULL] AS does_not_exist#12]]
          |     \_EsRelation[sample_data][@timestamp{f}#13, client_ip{f}#8, event_duration{f}#9, message{f}#10]
          \_Project[[@timestamp{r}#14, client_ip{r}#15, event_duration{r}#16, message{r}#17, $$@timestamp$converted_to$date_nanos{r$}#18, does_not_exist{r}#19]]
            \_Subquery[]
              \_Filter[$$@timestamp$converted_to$date_nanos{r$}#18 > TODATENANOS(2023-10-23T12:00:00Z[KEYWORD]) OR ISNOTNULL(does_not_exist{r}#19)]
                \_UnionAll[[@timestamp{r}#14, $$@timestamp$converted_to$date_nanos{r$}#18, client_ip{r}#15, event_duration{r}#16, message{r}#17, does_not_exist{r}#19]]
                  |_Project[[@timestamp{r}#20, $$@timestamp$converted_to$date_nanos{r$}#21, client_ip{f}#22, event_duration{f}#23, message{f}#24, does_not_exist{f(MissingEsField)}#25]]
                  | \_Eval[[TODATENANOS(@timestamp{f}#26) AS @timestamp#20]]
                  |   \_Eval[[TODATENANOS(@timestamp{f}#26) AS $$@timestamp$converted_to$date_nanos#21]]
                  |     \_EsRelation[sample_data][@timestamp{f}#26, client_ip{f}#22, event_duration{f}#23, message{f}#24, does_not_exist{f(MissingEsField)}#25]
                  \_Project[[@timestamp{f}#27, $$@timestamp$converted_to$date_nanos{r$}#28, client_ip{f}#29, event_duration{f}#30, message{f}#31, does_not_exist{f(MissingEsField)}#32]]
                    \_Eval[[TODATENANOS(@timestamp{f}#27) AS $$@timestamp$converted_to$date_nanos#28]]
                      \_Subquery[]
                        \_EsRelation[sample_data_ts_nanos][@timestamp{f}#27, client_ip{f}#29, event_duration{f}#30, message{f}#31, does_not_exist{f(MissingEsField)}#32]
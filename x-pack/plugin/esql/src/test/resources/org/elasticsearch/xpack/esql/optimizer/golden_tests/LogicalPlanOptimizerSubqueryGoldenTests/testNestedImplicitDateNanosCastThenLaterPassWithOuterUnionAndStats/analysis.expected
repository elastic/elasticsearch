          \_Filter[$$@timestamp$converted_to$date_nanos{r$}#8 > TODATENANOS(2023-10-23T12:00:00Z[KEYWORD]) OR ISNOTNULL(does_not_exist{r}#9)]
            \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
              |_Eval[[TODATENANOS(@timestamp{f}#10) AS @timestamp#11]]

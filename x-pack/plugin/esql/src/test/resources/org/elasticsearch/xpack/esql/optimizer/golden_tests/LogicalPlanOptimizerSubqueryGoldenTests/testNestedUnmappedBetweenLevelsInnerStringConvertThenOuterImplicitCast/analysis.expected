Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[@timestamp{r}#0,ASC,LAST]]]
  \_Project[[@timestamp{r}#0, msg{r}#1]]
    \_Filter[ISNOTNULL(@timestamp{r}#0) OR ISNOTNULL(missing_outer{r}#2)]
      \_UnionAll[[@timestamp{r}#0, client_ip{r}#3, event_duration{r}#4, message{r}#5, msg{r}#1, missing_outer{r}#2, $$message$converted_to$keyword{r$}#6]]
        |_Project[[@timestamp{r}#7, client_ip{f}#8, event_duration{f}#9, message{f}#10, msg{r}#11, missing_outer{f(MissingEsField)}#12, $$message$converted_to$keyword{r}#13]]
        | \_Eval[[null[KEYWORD] AS $$message$converted_to$keyword#13]]
        |   \_Project[[@timestamp{r}#7, client_ip{f}#8, event_duration{f}#9, message{f}#10, msg{r}#11, missing_outer{f(MissingEsField)}#12]]
        |     \_Eval[[TODATENANOS(@timestamp{f}#14) AS @timestamp#7]]
        |       \_Eval[[null[KEYWORD] AS msg#11]]
        |         \_EsRelation[sample_data][@timestamp{f}#14, client_ip{f}#8, event_duration{f}#9, message{f}#10, missing_outer{f(MissingEsField)}#12]
        \_Project[[@timestamp{r}#15, client_ip{r}#16, event_duration{r}#17, message{r}#18, msg{r}#19, missing_outer{r}#20, $$message$converted_to$keyword{r$}#21]]
          \_Eval[[null[NULL] AS missing_outer#20]]
            \_Project[[@timestamp{r}#15, client_ip{r}#16, event_duration{r}#17, message{r}#18, msg{r}#19, $$message$converted_to$keyword{r$}#21]]
              \_Eval[[null[IP] AS client_ip#16, null[LONG] AS event_duration#17, null[KEYWORD] AS message#18]]
                \_Subquery[]
                  \_Project[[@timestamp{r}#15, msg{r}#19, $$message$converted_to$keyword{r$}#21]]
                    \_Eval[[$$message$converted_to$keyword{r$}#21 AS msg#19]]
                      \_Filter[ISNOTNULL($$message$converted_to$keyword{r$}#21) OR ISNOTNULL(missing_inner{r}#22)]
                        \_UnionAll[[@timestamp{r}#15, client_ip{r}#23, event_duration{r}#24, message{r}#25, $$message$converted_to$keyword{r$}#21, missing_inner{r}#22, missing_outer{r}#26]]
                          |_Project[[@timestamp{r}#27, client_ip{f}#28, event_duration{f}#29, message{f}#30, $$message$converted_to$keyword{r$}#31, missing_inner{f(MissingEsField)}#32, missing_outer{f(MissingEsField)}#33]]
                          | \_Eval[[TODATENANOS(@timestamp{f}#34) AS @timestamp#27]]
                          |   \_Eval[[TO_STRING(message{f}#30) AS $$message$converted_to$keyword#31]]
                          |     \_EsRelation[sample_data][@timestamp{f}#34, client_ip{f}#28, event_duration{f}#29, message{f}#30, missing_inner{f(MissingEsField)}#32, missing_outer{f(MissingEsField)}#33]
                          \_Project[[@timestamp{f}#35, client_ip{f}#36, event_duration{f}#37, message{f}#38, $$message$converted_to$keyword{r$}#39, missing_inner{f(MissingEsField)}#40, missing_outer{f(MissingEsField)}#41]]
                            \_Eval[[TO_STRING(message{f}#38) AS $$message$converted_to$keyword#39]]
                              \_Subquery[]
                                \_EsRelation[sample_data_ts_nanos][@timestamp{f}#35, client_ip{f}#36, event_duration{f}#37, message{f}#38, missing_inner{f(MissingEsField)}#40, missing_outer{f(MissingEsField)}#41]
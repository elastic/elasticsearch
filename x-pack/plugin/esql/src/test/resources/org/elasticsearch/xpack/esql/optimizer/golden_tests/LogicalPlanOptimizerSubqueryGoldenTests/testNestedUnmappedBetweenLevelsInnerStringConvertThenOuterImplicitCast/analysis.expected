Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[@timestamp{r}#0,ASC,LAST]]]
  \_Project[[@timestamp{r}#0, msg{r}#1]]
    \_Filter[ISNOTNULL(@timestamp{r}#0) OR ISNOTNULL(missing_outer{r}#2)]
      \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
        |_Eval[[TODATENANOS(@timestamp{f}#3) AS @timestamp#4]]
        | \_EsRelation[sample_data][@timestamp{f}#3, client_ip{f}#5, event_duration{f}#6, message{f}#7, missing_outer{f(MissingEsField)}#8]
        \_Project[[@timestamp{r}#9, msg{r}#10]]
          \_Eval[[$$message$converted_to$keyword{r$}#11 AS msg#10]]
            \_Filter[ISNOTNULL($$message$converted_to$keyword{r$}#11) OR ISNOTNULL(missing_inner{r}#12)]
              \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
                |_Eval[[TODATENANOS(@timestamp{f}#13) AS @timestamp#14]]
                | \_Eval[[TO_STRING(message{f}#15) AS $$message$converted_to$keyword#16]]
                |   \_EsRelation[sample_data][@timestamp{f}#13, client_ip{f}#17, event_duration{f}#18, message{f}#15, missing_inner{f(MissingEsField)}#19, missing_outer{f(MissingEsField)}#20]
                \_Eval[[TO_STRING(message{f}#21) AS $$message$converted_to$keyword#22]]
                  \_EsRelation[sample_data_ts_nanos][@timestamp{f}#23, client_ip{f}#24, event_duration{f}#25, message{f}#21, missing_inner{f(MissingEsField)}#26, missing_outer{f(MissingEsField)}#27]
        |   \_Project[[@timestamp{r}#3, client_ip{f}#4, event_duration{f}#5, message{f}#6, msg{r}#7, missing_outer{f(MissingEsField)}#8]]
        |     \_Eval[[TODATENANOS(@timestamp{f}#10) AS @timestamp#3]]
        |       \_Eval[[null[KEYWORD] AS msg#7]]

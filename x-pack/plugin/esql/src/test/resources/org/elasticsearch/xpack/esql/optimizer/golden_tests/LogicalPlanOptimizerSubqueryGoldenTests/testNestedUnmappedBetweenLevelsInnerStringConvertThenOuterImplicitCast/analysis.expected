        \_Project[[@timestamp{r}#11, client_ip{r}#12, event_duration{r}#13, message{r}#14, msg{r}#15, missing_outer{r}#16, $$message$converted_to$keyword{r$}#17]]
          \_Eval[[null[NULL] AS missing_outer#16]]
            \_Project[[@timestamp{r}#11, client_ip{r}#12, event_duration{r}#13, message{r}#14, msg{r}#15, $$message$converted_to$keyword{r$}#17]]
              \_Eval[[null[IP] AS client_ip#12, null[LONG] AS event_duration#13, null[KEYWORD] AS message#14]]
                \_Project[[@timestamp{r}#11, msg{r}#15, $$message$converted_to$keyword{r$}#17]]
                  \_Eval[[$$message$converted_to$keyword{r$}#17 AS msg#15]]
                    \_Filter[ISNOTNULL($$message$converted_to$keyword{r$}#17) OR ISNOTNULL(missing_inner{r}#18)]
                      \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
                        |_Project[[@timestamp{r}#19, client_ip{f}#20, event_duration{f}#21, message{f}#22, $$message$converted_to$keyword{r$}#23, missing_inner{f(MissingEsField)}#24, missing_outer{f(MissingEsField)}#25]]
                        | \_Eval[[TODATENANOS(@timestamp{f}#26) AS @timestamp#19]]
                        |   \_Eval[[TO_STRING(message{f}#22) AS $$message$converted_to$keyword#23]]
                        |     \_EsRelation[sample_data][@timestamp{f}#26, client_ip{f}#20, event_duration{f}#21, message{f}#22, missing_inner{f(MissingEsField)}#24, missing_outer{f(MissingEsField)}#25]
                        \_Project[[@timestamp{f}#27, client_ip{f}#28, event_duration{f}#29, message{f}#30, $$message$converted_to$keyword{r$}#31, missing_inner{f(MissingEsField)}#32, missing_outer{f(MissingEsField)}#33]]
                          \_Eval[[TO_STRING(message{f}#30) AS $$message$converted_to$keyword#31]]
                            \_EsRelation[sample_data_ts_nanos][@timestamp{f}#27, client_ip{f}#28, event_duration{f}#29, message{f}#30, missing_inner{f(MissingEsField)}#32, missing_outer{f(MissingEsField)}#33]
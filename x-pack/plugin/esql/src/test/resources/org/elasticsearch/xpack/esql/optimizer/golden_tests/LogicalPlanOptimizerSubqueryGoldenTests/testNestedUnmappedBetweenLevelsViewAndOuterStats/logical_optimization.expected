TopN[[Order[@timestamp{r}#0,ASC,LAST]],10[INTEGER],false]
\_Aggregate[[@timestamp{r}#0],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS c#1, @timestamp{r}#0]]
  \_BranchPlan[[ts_view=VIEW, unnamed_view_1=SUBQUERY]]
    |_Project[[@timestamp{r}#2, client_ip{f}#3, event_duration{f}#4, message{f}#5, missing_inner{r}#6, missing_outer{r}#7]]
    | \_Filter[ISNOTNULL(@timestamp{r}#2)]
    |   \_Eval[[null[NULL] AS missing_inner#6, TODATENANOS(@timestamp{f}#8) AS @timestamp#2, null[NULL] AS missing_outer#7]]
    |     \_EsRelation[sample_data][@timestamp{f}#8, client_ip{f}#3, event_duration{f}#4, message{f}#5]
    \_Project[[@timestamp{r}#9, client_ip{r}#10, event_duration{r}#11, message{r}#12, missing_inner{r}#13, missing_outer{r}#14]]
      \_BranchPlan[[null=INDEX, unnamed_view_1=SUBQUERY]]
        |_Project[[@timestamp{r}#15, client_ip{f}#16, event_duration{f}#17, message{f}#18, missing_inner{f(MissingEsField)}#19, missing_outer{f(MissingEsField)}#20]]
        | \_Filter[ISNOTNULL(@timestamp{r}#15) OR ISNOTNULL(missing_inner{f(MissingEsField)}#19) AND ISNOTNULL(missing_outer{f(MissingEsField)}#20)]
        |   \_Eval[[TODATENANOS(@timestamp{f}#21) AS @timestamp#15]]
        |     \_EsRelation[sample_data][@timestamp{f}#21, client_ip{f}#16, event_duration{f}#17, message{f}#18, missing_inner{f(MissingEsField)}#19, missing_outer{f(MissingEsField)}#20]
        \_Project[[@timestamp{f}#22, client_ip{f}#23, event_duration{f}#24, message{f}#25, missing_inner{f(MissingEsField)}#26, missing_outer{f(MissingEsField)}#27]]
          \_Filter[ISNOTNULL(@timestamp{f}#22) OR ISNOTNULL(missing_inner{f(MissingEsField)}#26) AND ISNOTNULL(missing_outer{f(MissingEsField)}#27)]
            \_EsRelation[sample_data_ts_nanos][@timestamp{f}#22, client_ip{f}#23, event_duration{f}#24, message{f}#25, missing_inner{f(MissingEsField)}#26, missing_outer{f(MissingEsField)}#27]
FROM (
  FROM sample_data,
       (FROM sample_data_ts_nanos, (FROM sample_data))
  | STATS c = COUNT(*) BY @timestamp
  | SORT @timestamp
  | LIMIT 2
  | EVAL _subquery = 1
), (
  FROM sample_data,
       (FROM sample_data_ts_nanos, (FROM sample_data))
  | STATS c = COUNT(*) BY @timestamp
  | SORT @timestamp
  | LIMIT 2
  | EVAL _subquery = 2
)
| WHERE _subquery == 1
| DROP _subquery

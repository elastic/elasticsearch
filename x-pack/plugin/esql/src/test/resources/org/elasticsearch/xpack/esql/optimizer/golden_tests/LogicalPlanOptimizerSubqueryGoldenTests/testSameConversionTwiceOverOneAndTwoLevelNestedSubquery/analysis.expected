Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3]]
\_Limit[1000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#4) AND NOT($$client_ip$converted_to$keyword{r$}#4 == L2[KEYWORD])]
    \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
      |_Eval[[$$client_ip$converted_to$keyword{r$}#5 AS $$client_ip$converted_to$keyword#6]]
      | \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#5) AND NOT($$client_ip$converted_to$keyword{r$}#5 == L2[KEYWORD])]
      |   \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
      |     |_Eval[[TO_STRING(client_ip{f}#7) AS $$client_ip$converted_to$keyword#8]]
      |     | \_EsRelation[sample_data][@timestamp{f}#9, client_ip{f}#7, event_duration{f}#10, message{f}#11]
      |     \_Eval[[TO_STRING(client_ip{f}#12) AS $$client_ip$converted_to$keyword#13]]
      |       \_EsRelation[sample_data][@timestamp{f}#14, client_ip{f}#12, event_duration{f}#15, message{f}#16]
      \_Eval[[TO_STRING(client_ip{f}#17) AS $$client_ip$converted_to$keyword#18]]
        \_EsRelation[sample_data][@timestamp{f}#19, client_ip{f}#17, event_duration{f}#20, message{f}#21]
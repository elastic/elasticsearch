    |         \_EsRelation[sample_data][@timestamp{f}#15, client_ip{f}#16, event_duration{f}#18, message{f}#19]
    \_Project[[@timestamp{f}#20, client_ip{f}#21, $$client_ip$converted_to$keyword{r$}#22, event_duration{f}#23, message{f}#24]]
      \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#22) AND NOT($$client_ip$converted_to$keyword{r$}#22 == L2[KEYWORD])]
        \_Eval[[TO_STRING(client_ip{f}#21) AS $$client_ip$converted_to$keyword#22]]
          \_EsRelation[sample_data][@timestamp{f}#20, client_ip{f}#21, event_duration{f}#23, message{f}#24]
Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3]]
\_Limit[1000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#4) AND NOT($$client_ip$converted_to$keyword{r$}#4 == L2[KEYWORD])]
    \_ViewUnionAll[[unnamed_view_2, unnamed_view_1, unnamed_view_2#5]]
      |_Project[[@timestamp{f}#6, client_ip{f}#7, $$client_ip$converted_to$keyword{r$}#8, event_duration{f}#9, message{f}#10]]
      | \_Eval[[TO_STRING(client_ip{f}#7) AS $$client_ip$converted_to$keyword#8]]
      |   \_EsRelation[sample_data][@timestamp{f}#6, client_ip{f}#7, event_duration{f}#9, message{f}#10]
      |_Project[[@timestamp{f}#11, client_ip{f}#12, $$client_ip$converted_to$keyword{r$}#13, event_duration{f}#14, message{f}#15]]
      | \_Eval[[TO_STRING(client_ip{f}#12) AS $$client_ip$converted_to$keyword#13]]
      |   \_EsRelation[sample_data][@timestamp{f}#11, client_ip{f}#12, event_duration{f}#14, message{f}#15]
      \_Project[[@timestamp{f}#16, client_ip{f}#17, $$client_ip$converted_to$keyword{r$}#18, event_duration{f}#19, message{f}#20]]
        \_Eval[[TO_STRING(client_ip{f}#17) AS $$client_ip$converted_to$keyword#18]]
          \_EsRelation[sample_data][@timestamp{f}#16, client_ip{f}#17, event_duration{f}#19, message{f}#20]
Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3]]
\_Limit[1000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#4) AND NOT($$client_ip$converted_to$keyword{r$}#4 == L2[KEYWORD])]
    \_BranchPlan[[unnamed_view_2=SUBQUERY, unnamed_view_1=SUBQUERY, unnamed_view_2~2=SUBQUERY]]
      |_Eval[[TO_STRING(client_ip{f}#5) AS $$client_ip$converted_to$keyword#6]]
      | \_EsRelation[sample_data][@timestamp{f}#7, client_ip{f}#5, event_duration{f}#8, message{f}#9]
      |_Eval[[TO_STRING(client_ip{f}#10) AS $$client_ip$converted_to$keyword#11]]
      | \_EsRelation[sample_data][@timestamp{f}#12, client_ip{f}#10, event_duration{f}#13, message{f}#14]
      \_Eval[[TO_STRING(client_ip{f}#15) AS $$client_ip$converted_to$keyword#16]]
        \_EsRelation[sample_data][@timestamp{f}#17, client_ip{f}#15, event_duration{f}#18, message{f}#19]
Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3]]
\_Limit[1000[INTEGER],false,false]
  \_BranchPlan[[unnamed_view_1=SUBQUERY, unnamed_view_2=SUBQUERY]]
    |_Project[[@timestamp{f}#4, client_ip{f}#5, $$client_ip$converted_to$keyword{r$}#6, event_duration{f}#7, message{f}#8]]
    | \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#6) AND NOT($$client_ip$converted_to$keyword{r$}#6 == L2[KEYWORD])]
    |   \_Eval[[TO_STRING(client_ip{f}#5) AS $$client_ip$converted_to$keyword#6]]
    |     \_EsRelation[sample_data][@timestamp{f}#4, client_ip{f}#5, event_duration{f}#7, message{f}#8]
    \_Project[[@timestamp{f}#9, client_ip{f}#10, $$client_ip$converted_to$keyword{r$}#11, event_duration{f}#12, message{f}#13]]
      \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#11) AND NOT($$client_ip$converted_to$keyword{r$}#11 == L2[KEYWORD])]
        \_Eval[[TO_STRING(client_ip{f}#10) AS $$client_ip$converted_to$keyword#11]]
          \_EsRelation[sample_data][@timestamp{f}#9, client_ip{f}#10, event_duration{f}#12, message{f}#13]
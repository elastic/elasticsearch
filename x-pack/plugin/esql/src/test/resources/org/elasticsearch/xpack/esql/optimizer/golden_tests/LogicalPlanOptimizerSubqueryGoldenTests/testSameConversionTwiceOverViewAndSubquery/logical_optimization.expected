Project[[@timestamp{r}#0, client_ip{r}#1, event_duration{r}#2, message{r}#3]]
\_Limit[1000[INTEGER],false,false]
  \_UnionAll[[@timestamp{r}#0, client_ip{r}#1, $$client_ip$converted_to$keyword{r$}#4, event_duration{r}#2, message{r}#3]]
    |_Project[[@timestamp{f}#5, client_ip{f}#6, $$client_ip$converted_to$keyword{r$}#7, event_duration{f}#8, message{f}#9]]
    | \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#7) AND NOT($$client_ip$converted_to$keyword{r$}#7 == L2[KEYWORD])]
    |   \_Eval[[TO_STRING(client_ip{f}#6) AS $$client_ip$converted_to$keyword#7]]
    |     \_Subquery[]
    |       \_EsRelation[sample_data][@timestamp{f}#5, client_ip{f}#6, event_duration{f}#8, message{f}#9]
    \_Project[[@timestamp{f}#10, client_ip{f}#11, $$client_ip$converted_to$keyword{r$}#12, event_duration{f}#13, message{f}#14]]
      \_Filter[ISNOTNULL($$client_ip$converted_to$keyword{r$}#12) AND NOT($$client_ip$converted_to$keyword{r$}#12 == L2[KEYWORD])]
        \_Eval[[TO_STRING(client_ip{f}#11) AS $$client_ip$converted_to$keyword#12]]
          \_Subquery[]
            \_EsRelation[sample_data][@timestamp{f}#10, client_ip{f}#11, event_duration{f}#13, message{f}#14]
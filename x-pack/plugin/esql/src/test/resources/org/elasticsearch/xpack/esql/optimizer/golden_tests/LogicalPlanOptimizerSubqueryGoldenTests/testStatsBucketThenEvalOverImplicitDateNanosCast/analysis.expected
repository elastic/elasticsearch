Limit[1000[INTEGER],false,false]
\_OrderBy[[Order[b2{r}#0,ASC,LAST]]]
  \_Project[[c{r}#1, b2{r}#0]]
    \_Eval[[b{r}#2 + PT1H[TIME_DURATION] AS b2#0]]
      \_Aggregate[[BUCKET(@timestamp{r}#3,PT1H[TIME_DURATION]) AS b#2],[COUNT(*[KEYWORD],true[BOOLEAN],PT0S[TIME_DURATION]) AS c#1, b{r}#2]]
        \_UnionAll[[@timestamp{r}#3, client_ip{r}#4, event_duration{r}#5, message{r}#6]]
          |_Project[[@timestamp{r}#7, client_ip{f}#8, event_duration{f}#9, message{f}#10]]
          | \_Eval[[TODATENANOS(@timestamp{f}#11) AS @timestamp#7]]
          |   \_EsRelation[sample_data][@timestamp{f}#11, client_ip{f}#8, event_duration{f}#9, message{f}#10]
          \_Project[[@timestamp{f}#12, client_ip{f}#13, event_duration{f}#14, message{f}#15]]
            \_Subquery[]
              \_EsRelation[sample_data_ts_nanos][@timestamp{f}#12, client_ip{f}#13, event_duration{f}#14, message{f}#15]
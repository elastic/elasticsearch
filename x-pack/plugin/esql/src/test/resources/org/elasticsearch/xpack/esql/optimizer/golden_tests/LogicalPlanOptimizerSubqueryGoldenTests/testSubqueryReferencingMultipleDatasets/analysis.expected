Limit[1000[INTEGER],false,false]
\_Filter[emp_no{r}#0 > 10[INTEGER]]
  \_ViewUnionAll[[heavy_a, heavy_b, unnamed_view_1]]
    |_Project[[emp_no{r}#1, salary{r}#2, dept{r}#3]]
    | \_ExternalRelation[heavy_a.parquet][parquet][emp_no{r}#1, salary{r}#2, dept{r}#3]
    |_Project[[emp_no{r}#4, salary{r}#5, dept{r}#6]]
    | \_ExternalRelation[heavy_b.parquet][parquet][emp_no{r}#4, salary{r}#5, dept{r}#6]
    \_Project[[emp_no{r}#4, salary{r}#5, dept{r}#6]]
      \_ExternalRelation[heavy_b.parquet][parquet][emp_no{r}#4, salary{r}#5, dept{r}#6]
Limit[1000[INTEGER],false,false]
\_BranchPlan[[heavy_a=DATASET, heavy_b=DATASET]]
  |_Project[[emp_no{r}#0, salary{r}#1, dept{r}#2]]
  | \_Filter[salary{r}#1 > 1000[INTEGER]]
  |   \_ExternalRelation[heavy_a.parquet][parquet][emp_no{r}#0, salary{r}#1, dept{r}#2]
  \_Project[[emp_no{r}#3, salary{r}#4, dept{r}#5]]
    \_Filter[salary{r}#4 > 1000[INTEGER]]
      \_ExternalRelation[heavy_b.parquet][parquet][emp_no{r}#3, salary{r}#4, dept{r}#5]
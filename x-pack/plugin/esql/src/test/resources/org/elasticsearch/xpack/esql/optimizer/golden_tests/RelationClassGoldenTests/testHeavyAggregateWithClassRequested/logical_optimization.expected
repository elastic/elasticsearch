  \_UnionAll[[emp_no{r}#0, salary{r}#2, dept{r}#3, _class{xm}#4]]
    |_Project[[emp_no{r}#5, salary{r}#6, dept{r}#7, _class{r}#8]]
    | \_Eval[[dataset[KEYWORD] AS _class#8]]
    |   \_ExternalRelation[s3://bucket/class_a.parquet][parquet][emp_no{r}#5, salary{r}#6, dept{r}#7]
    \_Project[[emp_no{r}#9, salary{r}#10, dept{r}#11, _class{r}#12]]
      \_Eval[[dataset[KEYWORD] AS _class#12]]
        \_ExternalRelation[s3://bucket/class_b.parquet][parquet][emp_no{r}#9, salary{r}#10, dept{r}#11]
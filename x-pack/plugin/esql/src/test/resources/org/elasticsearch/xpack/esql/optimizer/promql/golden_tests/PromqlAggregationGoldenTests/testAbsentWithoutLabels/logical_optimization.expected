Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[$$SUM$result$0{r$}#3 / $$COUNT$result$1{r$}#4 AS result#5, TODOUBLE(result{r}#5) AS result#0, TO_STRING(_timeseries{r}#6) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$result$0#3, COUNT(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$result$1#4, step{r}#1, _timeseries{r}#6]]
          \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM(LASTOVERTIME_$1{r}#8,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#7, step{r}#1, _timeseries{r}#6]]
            \_TimeSeriesAggregate[[_tsid{m}#9, step{r}#1],[LASTOVERTIME(network.cost{f}#10,@timestamp{f}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#8, step{r}#1 AS step#1, DIMENSIONVALUES(_timeseries{f}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#6],BUCKET(@timestamp{f}#11,PT1H[TIME_DURATION]),@timestamp{f}#11,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#11,PT1H[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#11, client.ip{f}#12, cluster{f}#13, event{f}#14, event_city{f}#15, event_city_boundary{f}#16, event_location{f}#17, event_log{f}#18, event_shape{f}#19, events_received{f}#20, network.bytes_in{f}#21, network.cost{f}#10, network.eth0.currently_connected_clients{f}#22, network.eth0.firmware_version{f}#23, network.eth0.last_up{f}#24, network.eth0.rx{f}#25, network.eth0.tx{f}#26, network.eth0.up{f}#27, network.total_bytes_in{f}#28, network.total_bytes_out{f}#29, network.total_cost{f}#30, pod{f}#31, region{f}#32, _timeseries{f}#6, _tsid{m}#9]
Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[$$SUM$result$0{r$}#3 / $$COUNT$result$1{r$}#4 AS result#5, TODOUBLE(result{r}#5) AS result#0, TO_STRING(_timeseries{r}#6) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$result$0#3, COUNT(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$result$1#4, step{r}#1, _timeseries{r}#6]]
          \_Aggregate[[step{r}#1, _timeseries{r}#8],[SUM(LASTOVERTIME_$1{r}#9,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#7, step{r}#1 AS step#1, _timeseries{r}#8 AS _timeseries#6]]
            \_Eval[[TOTIMESERIESMETADATA($$_timeseries$series{r}#10) AS _timeseries#8]]
              \_TimeSeriesAggregate[[_tsid{m}#11, step{r}#1],[LASTOVERTIME(network.cost{f}#12,@timestamp{f}#13,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#9, DIMENSIONVALUES(_timeseries{f$}#14,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$_timeseries$series#10, step{r}#1],BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]),@timestamp{f}#13,PROMQL_COMMAND]
                \_Eval[[BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#13, client.ip{f}#15, cluster{f}#16, event{f}#17, event_city{f}#18, event_city_boundary{f}#19, event_location{f}#20, event_log{f}#21, event_shape{f}#22, events_received{f}#23, network.bytes_in{f}#24, network.cost{f}#12, network.eth0.currently_connected_clients{f}#25, network.eth0.firmware_version{f}#26, network.eth0.last_up{f}#27, network.eth0.rx{f}#28, network.eth0.tx{f}#29, network.eth0.up{f}#30, network.total_bytes_in{f}#31, network.total_bytes_out{f}#32, network.total_cost{f}#33, pod{f}#34, region{f}#35, _timeseries{f$}#14, _tsid{m}#11]
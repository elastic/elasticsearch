Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1, $$label$temp_name$1{r}#2 AS cluster#3]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[TODOUBLE($$value$temp_name$2{r}#4) AS $$value$temp_name$0#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_UnpackDims[_$packed_grouping_dims{r}#5,[$$label$temp_name$1{r}#2]]
          \_Aggregate[[step{r}#1, _$packed_dims{f$}#6],[SUM($$value$temp_name$3{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$2#4, step{r}#1, _$packed_dims{f$}#6 AS _$packed_grouping_dims#5]]
            \_PackDims[[$$label$temp_name$1{r}#2],_$packed_dims{f$}#6]
              \_Eval[[TIMESERIESGET(_timeseries{r}#8,cluster[KEYWORD]) AS $$label$temp_name$1#2]]
                \_Aggregate[[step{r}#1, _timeseries{r}#8],[SUM(LASTOVERTIME_$1{r}#9,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$3#7, step{r}#1, _timeseries{r}#8]]
                  \_TimeSeriesAggregate[[_tsid{m}#10, step{r}#1],[LASTOVERTIME(network.cost{f}#11,@timestamp{f}#12,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#9, step{r}#1 AS step#1, VALUES(_timeseries{r}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#8],BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]),@timestamp{f}#12,PROMQL_COMMAND]
                    \_Eval[[TIMESERIESUNSET(_timeseries{f}#13,pod[KEYWORD],__name__[KEYWORD]) AS _timeseries#8, BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#12, client.ip{f}#14, cluster{f}#3, event{f}#15, event_city{f}#16, event_city_boundary{f}#17, event_location{f}#18, event_log{f}#19, event_shape{f}#20, events_received{f}#21, network.bytes_in{f}#22, network.cost{f}#11, network.eth0.currently_connected_clients{f}#23, network.eth0.firmware_version{f}#24, network.eth0.last_up{f}#25, network.eth0.rx{f}#26, network.eth0.tx{f}#27, network.eth0.up{f}#28, network.total_bytes_in{f}#29, network.total_bytes_out{f}#30, network.total_cost{f}#31, pod{f}#32, region{f}#33, _timeseries{f}#13, _tsid{m}#10]
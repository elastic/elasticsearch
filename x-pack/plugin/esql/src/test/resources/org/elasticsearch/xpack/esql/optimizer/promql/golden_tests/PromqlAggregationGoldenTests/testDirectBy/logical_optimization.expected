                \_Eval[[MVDIFFERENCE(cluster{f}#3,[KEYWORD]) AS $$label$temp_name$1#2, MVDIFFERENCE(pod{f}#5,[KEYWORD]) AS $$label$temp_name$2#4, BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#14, client.ip{f}#15, cluster{f}#3, event{f}#16, event_city{f}#17, event_city_boundary{f}#18, event_location{f}#19, event_log{f}#20, event_shape{f}#21, events_received{f}#22, network.bytes_in{f}#23, network.cost{f}#13, network.eth0.currently_connected_clients{f}#24, network.eth0.firmware_version{f}#25, network.eth0.last_up{f}#26, network.eth0.rx{f}#27, network.eth0.tx{f}#28, network.eth0.up{f}#29, network.total_bytes_in{f}#30, network.total_bytes_out{f}#31, network.total_cost{f}#32, pod{f}#5, region{f}#33, _tsid{m}#12]
            \_TimeSeriesAggregate[[_tsid{m}#7, step{r}#1],[LASTOVERTIME(network.cost{f}#8,@timestamp{f}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#6, step{r}#1 AS step#1, DIMENSIONVALUES(_timeseries{f}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#4],BUCKET(@timestamp{f}#9,PT1H[TIME_DURATION]),@timestamp{f}#9,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#9,PT1H[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#9, client.ip{f}#10, cluster{f}#11, event{f}#12, event_city{f}#13, event_city_boundary{f}#14, event_location{f}#15, event_log{f}#16, event_shape{f}#17, events_received{f}#18, network.bytes_in{f}#19, network.cost{f}#8, network.eth0.currently_connected_clients{f}#20, network.eth0.firmware_version{f}#21, network.eth0.last_up{f}#22, network.eth0.rx{f}#23, network.eth0.tx{f}#24, network.eth0.up{f}#25, network.total_bytes_in{f}#26, network.total_bytes_out{f}#27, network.total_cost{f}#28, pod{f}#29, region{f}#30, _timeseries{f}#4, _tsid{m}#7]
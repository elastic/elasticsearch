\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[TODOUBLE($$value$temp_name$1{r}#3) AS $$value$temp_name$0#0, TO_STRING(_timeseries{r}#4) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#4],[MAX($$value$temp_name$2{r}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$value$temp_name$1#3, step{r}#1, _timeseries{r}#4]]

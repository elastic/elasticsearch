                  \_Eval[[BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#16, client.ip{f}#18, cluster{f}#3, event{f}#19, event_city{f}#20, event_city_boundary{f}#21, event_location{f}#22, event_log{f}#23, event_shape{f}#24, events_received{f}#25, network.bytes_in{f}#26, network.cost{f}#15, network.eth0.currently_connected_clients{f}#27, network.eth0.firmware_version{f}#28, network.eth0.last_up{f}#29, network.eth0.rx{f}#30, network.eth0.tx{f}#31, network.eth0.up{f}#32, network.total_bytes_in{f}#33, network.total_bytes_out{f}#34, network.total_cost{f}#35, pod{f}#36, region{f}#37, _timeseries{f}#17, _tsid{m}#14]
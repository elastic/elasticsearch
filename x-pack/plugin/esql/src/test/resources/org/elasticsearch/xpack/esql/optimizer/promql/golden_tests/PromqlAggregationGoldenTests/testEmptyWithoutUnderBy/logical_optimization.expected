Project[[result{r}#0, step{r}#1, cluster{f}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[$$SUM$result$0{r$}#3 / $$COUNT$result$1{r$}#4 AS result#5, TODOUBLE(result{r}#5) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, cluster{r}#2],[SUM(result{r}#6,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$result$0#3, COUNT(result{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$result$1#4, step{r}#1, cluster{r}#2]]
          \_UnpackDims[_$packed_grouping_dims{r}#7,[_timeseries$__name__{r}#8, cluster{r}#2]]
            \_Aggregate[[step{r}#1, _$packed_dims{r}#9],[SUM(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#6, step{r}#1 AS step#1, _$packed_dims{r}#9 AS _$packed_grouping_dims#7]]
              \_TimeSeriesAggregate[[_tsid{m}#11, step{r}#1],[LASTOVERTIME(network.cost{f}#12,@timestamp{f}#13,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#10, PACKDIMSAGG(_timeseries{f}#14,cluster{f}#2,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#9, step{r}#1],BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]),@timestamp{f}#13,PROMQL_COMMAND]
                \_Eval[[BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]) AS step#1]]

              \_PackDims[[cluster{r}#11],_$packed_dims{f$}#9,true]
                \_Eval[[TOTIMESERIESMETADATA($$_timeseries$series{r}#12) AS _timeseries#8]]
                  \_TimeSeriesAggregate[[_tsid{m}#13, step{r}#1],[LASTOVERTIME(network.cost{f}#14,@timestamp{f}#15,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#10, DIMENSIONVALUES(_timeseries{f$}#16,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$_timeseries$series#12, DIMENSIONVALUES(cluster{f}#17,true[BOOLEAN],PT0S[TIME_DURATION]) AS cluster#11, step{r}#1],BUCKET(@timestamp{f}#15,PT1H[TIME_DURATION]),@timestamp{f}#15,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#15,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#15, client.ip{f}#18, cluster{f}#17, event{f}#19, event_city{f}#20, event_city_boundary{f}#21, event_location{f}#22, event_log{f}#23, event_shape{f}#24, events_received{f}#25, network.bytes_in{f}#26, network.cost{f}#14, network.eth0.currently_connected_clients{f}#27, network.eth0.firmware_version{f}#28, network.eth0.last_up{f}#29, network.eth0.rx{f}#30, network.eth0.tx{f}#31, network.eth0.up{f}#32, network.total_bytes_in{f}#33, network.total_bytes_out{f}#34, network.total_cost{f}#35, pod{f}#36, region{f}#37, _timeseries{f$}#16, _tsid{m}#13]
Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[TODOUBLE($$value$temp_name$1{r}#3) AS $$value$temp_name$0#0, TO_STRING(_timeseries{r}#4) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#4],[MAX($$value$temp_name$2{r}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$value$temp_name$1#3, step{r}#1, _timeseries{r}#4]]
          \_Eval[[TIMESERIESUNSET(_timeseries{r}#6,cluster[KEYWORD],__name__[KEYWORD]) AS _timeseries#4]]
            \_Aggregate[[step{r}#1, _timeseries{r}#7],[SUM(AVGOVERTIME_$1{r}#8,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$2#5, step{r}#1 AS step#1, _timeseries{r}#7 AS _timeseries#6]]
              \_Eval[[$$SUM$AVGOVERTIME_$3{r$}#9 / $$COUNT$AVGOVERTIME_$4{r$}#10 AS AVGOVERTIME_$1#8]]
                \_TimeSeriesAggregate[[_tsid{m}#11, step{r}#1],[SUM(network.cost{f}#12,true[BOOLEAN],PT1H[TIME_DURATION],lossy[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$AVGOVERTIME_$3#9, COUNT(network.cost{f}#12,true[BOOLEAN],PT1H[TIME_DURATION]) AS $$COUNT$AVGOVERTIME_$4#10, VALUES(_timeseries{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#7, step{r}#1],BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]),@timestamp{f}#13,PROMQL_COMMAND]
                  \_Eval[[TIMESERIESUNSET(_timeseries{f}#14,__name__[KEYWORD]) AS _timeseries#15, TIMESERIESUNSET(_timeseries{r}#15,pod[KEYWORD],__name__[KEYWORD]) AS _timeseries#6, BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#13, client.ip{f}#16, cluster{f}#17, event{f}#18, event_city{f}#19, event_city_boundary{f}#20, event_location{f}#21, event_log{f}#22, event_shape{f}#23, events_received{f}#24, network.bytes_in{f}#25, network.cost{f}#12, network.eth0.currently_connected_clients{f}#26, network.eth0.firmware_version{f}#27, network.eth0.last_up{f}#28, network.eth0.rx{f}#29, network.eth0.tx{f}#30, network.eth0.up{f}#31, network.total_bytes_in{f}#32, network.total_bytes_out{f}#33, network.total_cost{f}#34, pod{f}#35, region{f}#36, _timeseries{f}#14, _tsid{m}#11]
Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[$$SUM$result$0{r$}#3 / $$COUNT$result$1{r$}#4 AS result#5, TODOUBLE(result{r}#5) AS result#0, TO_STRING(_timeseries{r}#6) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$result$0#3, COUNT(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$result$1#4, step{r}#1, _timeseries{r}#6]]
          \_UnpackDims[_$packed_grouping_dims{r}#8,[cluster{r}#9]]
            \_Aggregate[[step{r}#1, _timeseries{r}#10, _$packed_dims{r}#11],[SUM(LASTOVERTIME_$1{r}#12,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#7, step{r}#1 AS step#1, _timeseries{r}#10 AS _timeseries#6, _$packed_dims{r}#11 AS _$packed_grouping_dims#8]]
              \_TimeSeriesAggregate[[_tsid{m}#13, step{r}#1],[LASTOVERTIME(network.cost{f}#14,@timestamp{f}#15,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#12, DIMENSIONVALUES(_timeseries{f}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#10, PACKDIMSAGG(cluster{f}#16,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#11, step{r}#1],BUCKET(@timestamp{f}#15,PT1H[TIME_DURATION]),@timestamp{f}#15,PROMQL_COMMAND]
                \_Eval[[BUCKET(@timestamp{f}#15,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#15, client.ip{f}#17, cluster{f}#16, event{f}#18, event_city{f}#19, event_city_boundary{f}#20, event_location{f}#21, event_log{f}#22, event_shape{f}#23, events_received{f}#24, network.bytes_in{f}#25, network.cost{f}#14, network.eth0.currently_connected_clients{f}#26, network.eth0.firmware_version{f}#27, network.eth0.last_up{f}#28, network.eth0.rx{f}#29, network.eth0.tx{f}#30, network.eth0.up{f}#31, network.total_bytes_in{f}#32, network.total_bytes_out{f}#33, network.total_cost{f}#34, pod{f}#35, region{f}#36, _timeseries{f}#6, _tsid{m}#13]
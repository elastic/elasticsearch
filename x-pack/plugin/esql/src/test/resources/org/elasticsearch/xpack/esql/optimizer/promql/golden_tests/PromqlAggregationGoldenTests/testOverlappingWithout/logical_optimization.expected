Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[$$SUM$result$0{r$}#3 / $$COUNT$result$1{r$}#4 AS result#5, TODOUBLE(result{r}#5) AS result#0, TO_STRING(_timeseries{r}#6) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$result$0#3, COUNT(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$result$1#4, step{r}#1, _timeseries{r}#6]]
          \_UnpackDims[_$packed_grouping_dims{r}#8,[cluster{r}#9]]
            \_Aggregate[[step{r}#1, _timeseries{r}#10, _$packed_dims{f$}#11],[SUM(LASTOVERTIME_$1{r}#12,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#7, step{r}#1 AS step#1, _timeseries{r}#10 AS _timeseries#6, _$packed_dims{f$}#11 AS _$packed_grouping_dims#8]]
              \_PackDims[[cluster{r}#13],_$packed_dims{f$}#11,true]
                \_Eval[[TOTIMESERIESMETADATA($$_timeseries$series{r}#14) AS _timeseries#10]]
                  \_TimeSeriesAggregate[[_tsid{m}#15, step{r}#1],[LASTOVERTIME(network.cost{f}#16,@timestamp{f}#17,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#12, DIMENSIONVALUES(_timeseries{f$}#18,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$_timeseries$series#14, DIMENSIONVALUES(cluster{f}#19,true[BOOLEAN],PT0S[TIME_DURATION]) AS cluster#13, step{r}#1],BUCKET(@timestamp{f}#17,PT1H[TIME_DURATION]),@timestamp{f}#17,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#17,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#17, client.ip{f}#20, cluster{f}#19, event{f}#21, event_city{f}#22, event_city_boundary{f}#23, event_location{f}#24, event_log{f}#25, event_shape{f}#26, events_received{f}#27, network.bytes_in{f}#28, network.cost{f}#16, network.eth0.currently_connected_clients{f}#29, network.eth0.firmware_version{f}#30, network.eth0.last_up{f}#31, network.eth0.rx{f}#32, network.eth0.tx{f}#33, network.eth0.up{f}#34, network.total_bytes_in{f}#35, network.total_bytes_out{f}#36, network.total_cost{f}#37, pod{f}#38, region{f}#39, _timeseries{f$}#18, _tsid{m}#15]
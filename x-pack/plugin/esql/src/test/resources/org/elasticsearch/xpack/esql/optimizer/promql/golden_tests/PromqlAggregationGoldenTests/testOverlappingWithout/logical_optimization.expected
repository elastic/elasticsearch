Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[$$SUM$$$value$temp_name$1{r$}#3 / $$COUNT$$$value$temp_name$2{r$}#4 AS $$value$temp_name$3#5, TODOUBLE($$value$temp_name$3{r}#5) AS $$value$temp_name$0#0, TO_STRING(_timeseries{r}#6) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM($$value$temp_name$4{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$$$value$temp_name$1#3, COUNT($$value$temp_name$4{r}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$$$value$temp_name$2#4, step{r}#1, _timeseries{r}#6]]
          \_Eval[[TIMESERIESUNSET(_timeseries{r}#8,cluster[KEYWORD],region[KEYWORD],__name__[KEYWORD]) AS _timeseries#6]]
            \_Aggregate[[step{r}#1, _timeseries{r}#8],[SUM(LASTOVERTIME_$1{r}#9,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$4#7, step{r}#1, _timeseries{r}#8]]
              \_TimeSeriesAggregate[[_tsid{m}#10, step{r}#1],[LASTOVERTIME(network.cost{f}#11,@timestamp{f}#12,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#9, step{r}#1 AS step#1, VALUES(_timeseries{r}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#8],BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]),@timestamp{f}#12,PROMQL_COMMAND]
                \_Eval[[TIMESERIESUNSET(_timeseries{f}#13,pod[KEYWORD],region[KEYWORD],__name__[KEYWORD]) AS _timeseries#8, BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#12, client.ip{f}#14, cluster{f}#15, event{f}#16, event_city{f}#17, event_city_boundary{f}#18, event_location{f}#19, event_log{f}#20, event_shape{f}#21, events_received{f}#22, network.bytes_in{f}#23, network.cost{f}#11, network.eth0.currently_connected_clients{f}#24, network.eth0.firmware_version{f}#25, network.eth0.last_up{f}#26, network.eth0.rx{f}#27, network.eth0.tx{f}#28, network.eth0.up{f}#29, network.total_bytes_in{f}#30, network.total_bytes_out{f}#31, network.total_cost{f}#32, pod{f}#33, region{f}#34, _timeseries{f}#13, _tsid{m}#10]
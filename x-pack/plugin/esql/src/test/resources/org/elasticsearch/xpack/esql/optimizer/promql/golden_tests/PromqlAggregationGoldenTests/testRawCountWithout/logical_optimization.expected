Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[CASE($$COUNT$count_without(p>$1{r$}#3 == 0[LONG],null[NULL],$$COUNT$count_without(p>$1{r$}#3) AS $$value$temp_name$2#4, TODOUBLE($$value$temp_name$2{r}#4) AS $$value$temp_name$0#0, TO_STRING(_timeseries{r}#5) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#5],[COUNT(LASTOVERTIME_$1{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$count_without(p>$1#3, step{r}#1, _timeseries{r}#5]]
          \_TimeSeriesAggregate[[_tsid{m}#7, step{r}#1],[LASTOVERTIME(network.cost{f}#8,@timestamp{f}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#6, step{r}#1 AS step#1, VALUES(_timeseries{r}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#5],BUCKET(@timestamp{f}#9,PT1H[TIME_DURATION]),@timestamp{f}#9,PROMQL_COMMAND]
            \_Eval[[TIMESERIESUNSET(_timeseries{f}#10,pod[KEYWORD],__name__[KEYWORD]) AS _timeseries#5, BUCKET(@timestamp{f}#9,PT1H[TIME_DURATION]) AS step#1]]
              \_EsRelation[k8s][@timestamp{f}#9, client.ip{f}#11, cluster{f}#12, event{f}#13, event_city{f}#14, event_city_boundary{f}#15, event_location{f}#16, event_log{f}#17, event_shape{f}#18, events_received{f}#19, network.bytes_in{f}#20, network.cost{f}#8, network.eth0.currently_connected_clients{f}#21, network.eth0.firmware_version{f}#22, network.eth0.last_up{f}#23, network.eth0.rx{f}#24, network.eth0.tx{f}#25, network.eth0.up{f}#26, network.total_bytes_in{f}#27, network.total_bytes_out{f}#28, network.total_cost{f}#29, pod{f}#30, region{f}#31, _timeseries{f}#10, _tsid{m}#7]
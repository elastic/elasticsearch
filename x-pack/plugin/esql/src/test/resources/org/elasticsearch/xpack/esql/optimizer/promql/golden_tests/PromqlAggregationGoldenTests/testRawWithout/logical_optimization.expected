Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[TODOUBLE($$value$temp_name$1{r}#3) AS $$value$temp_name$0#0, TO_STRING(_timeseries{r}#4) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#4],[SUM(LASTOVERTIME_$1{r}#5,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$1#3, step{r}#1, _timeseries{r}#4]]
          \_TimeSeriesAggregate[[_tsid{m}#6, step{r}#1],[LASTOVERTIME(network.cost{f}#7,@timestamp{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#5, step{r}#1 AS step#1, VALUES(_timeseries{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#4],BUCKET(@timestamp{f}#8,PT1H[TIME_DURATION]),@timestamp{f}#8,PROMQL_COMMAND]
            \_Eval[[TIMESERIESUNSET(_timeseries{f}#9,pod[KEYWORD],__name__[KEYWORD]) AS _timeseries#4, BUCKET(@timestamp{f}#8,PT1H[TIME_DURATION]) AS step#1]]
              \_EsRelation[k8s][@timestamp{f}#8, client.ip{f}#10, cluster{f}#11, event{f}#12, event_city{f}#13, event_city_boundary{f}#14, event_location{f}#15, event_log{f}#16, event_shape{f}#17, events_received{f}#18, network.bytes_in{f}#19, network.cost{f}#7, network.eth0.currently_connected_clients{f}#20, network.eth0.firmware_version{f}#21, network.eth0.last_up{f}#22, network.eth0.rx{f}#23, network.eth0.tx{f}#24, network.eth0.up{f}#25, network.total_bytes_in{f}#26, network.total_bytes_out{f}#27, network.total_cost{f}#28, pod{f}#29, region{f}#30, _timeseries{f}#9, _tsid{m}#6]
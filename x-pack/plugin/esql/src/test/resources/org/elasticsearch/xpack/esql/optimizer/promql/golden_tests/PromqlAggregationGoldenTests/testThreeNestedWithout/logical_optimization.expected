Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[CASE($$COUNT$count_without(c>$1{r$}#3 == 0[LONG],null[NULL],$$COUNT$count_without(c>$1{r$}#3) AS $$value$temp_name$2#4, TODOUBLE($$value$temp_name$2{r}#4) AS $$value$temp_name$0#0, TO_STRING(_timeseries{r}#5) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#5],[COUNT($$value$temp_name$3{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$count_without(c>$1#3, step{r}#1, _timeseries{r}#5]]
          \_Eval[[TIMESERIESUNSET(_timeseries{r}#7,cluster[KEYWORD],__name__[KEYWORD]) AS _timeseries#5]]
            \_Aggregate[[step{r}#1, _timeseries{r}#7],[MAX($$value$temp_name$4{r}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$value$temp_name$3#6, step{r}#1, _timeseries{r}#7]]
              \_Eval[[TIMESERIESUNSET(_timeseries{r}#9,region[KEYWORD],__name__[KEYWORD]) AS _timeseries#7]]
                \_Aggregate[[step{r}#1, _timeseries{r}#9],[SUM(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$4#8, step{r}#1, _timeseries{r}#9]]
                  \_TimeSeriesAggregate[[_tsid{m}#11, step{r}#1],[LASTOVERTIME(network.cost{f}#12,@timestamp{f}#13,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#10, step{r}#1 AS step#1, VALUES(_timeseries{r}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#9],BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]),@timestamp{f}#13,PROMQL_COMMAND]
                    \_Eval[[TIMESERIESUNSET(_timeseries{f}#14,pod[KEYWORD],__name__[KEYWORD]) AS _timeseries#9, BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#13, client.ip{f}#15, cluster{f}#16, event{f}#17, event_city{f}#18, event_city_boundary{f}#19, event_location{f}#20, event_log{f}#21, event_shape{f}#22, events_received{f}#23, network.bytes_in{f}#24, network.cost{f}#12, network.eth0.currently_connected_clients{f}#25, network.eth0.firmware_version{f}#26, network.eth0.last_up{f}#27, network.eth0.rx{f}#28, network.eth0.tx{f}#29, network.eth0.up{f}#30, network.total_bytes_in{f}#31, network.total_bytes_out{f}#32, network.total_cost{f}#33, pod{f}#34, region{f}#35, _timeseries{f}#14, _tsid{m}#11]
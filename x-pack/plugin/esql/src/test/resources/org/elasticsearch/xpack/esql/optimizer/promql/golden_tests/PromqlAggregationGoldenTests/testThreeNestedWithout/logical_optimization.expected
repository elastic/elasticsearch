Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[CASE(result{r}#3 == 0[LONG],null[NULL],result{r}#3) AS result#4, TODOUBLE(result{r}#4) AS result#0, TO_STRING(_timeseries{r}#5) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#5],[COUNT(result{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#3, step{r}#1, _timeseries{r}#5]]
          \_Eval[[TIMESERIESMETADATAFILTER(_timeseries{r}#7,cluster[KEYWORD]) AS _timeseries#5]]
            \_Aggregate[[step{r}#1, _timeseries{r}#7],[MAX(result{r}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#6, step{r}#1, _timeseries{r}#7]]
              \_UnpackDims[_$packed_grouping_dims{r}#9,[region{r}#10]]
                \_Aggregate[[step{r}#1, _timeseries{r}#11, _$packed_dims{r}#12],[SUM(LASTOVERTIME_$1{r}#13,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#8, step{r}#1 AS step#1, _timeseries{r}#11 AS _timeseries#7, _$packed_dims{r}#12 AS _$packed_grouping_dims#9]]
                  \_TimeSeriesAggregate[[_tsid{m}#14, step{r}#1],[LASTOVERTIME(network.cost{f}#15,@timestamp{f}#16,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#13, DIMENSIONVALUES(_timeseries{f}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#11, PACKDIMSAGG(region{f}#17,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#12, step{r}#1],BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]),@timestamp{f}#16,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#16, client.ip{f}#18, cluster{f}#19, event{f}#20, event_city{f}#21, event_city_boundary{f}#22, event_location{f}#23, event_log{f}#24, event_shape{f}#25, events_received{f}#26, network.bytes_in{f}#27, network.cost{f}#15, network.eth0.currently_connected_clients{f}#28, network.eth0.firmware_version{f}#29, network.eth0.last_up{f}#30, network.eth0.rx{f}#31, network.eth0.tx{f}#32, network.eth0.up{f}#33, network.total_bytes_in{f}#34, network.total_bytes_out{f}#35, network.total_cost{f}#36, pod{f}#37, region{f}#17, _timeseries{f}#7, _tsid{m}#14]
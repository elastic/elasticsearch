                    \_TimeSeriesAggregate[[_tsid{m}#17, step{r}#1],[LASTOVERTIME(network.cost{f}#18,@timestamp{f}#19,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#16, DIMENSIONVALUES(_timeseries{f}#20,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#14, PACKDIMSAGG(cluster{f}#3,region{f}#21,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#15, step{r}#1],BUCKET(@timestamp{f}#19,PT1H[TIME_DURATION]),@timestamp{f}#19,PROMQL_COMMAND]

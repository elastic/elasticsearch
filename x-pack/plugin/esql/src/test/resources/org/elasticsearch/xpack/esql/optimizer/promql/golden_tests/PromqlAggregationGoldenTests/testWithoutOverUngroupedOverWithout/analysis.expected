Limit[10000[INTEGER],false,false]
\_Filter[step{r}#0 >= 0[DATETIME] AND step{r}#0 <= 253402300799999[DATETIME]]
  \_Filter[ISNOTNULL(result{r}#1)]
    \_Project[[result{r}#1, step{r}#0]]
      \_Eval[[TODOUBLE(result{r}#2) AS result#1]]
        \_Eval[[CASE(result{r}#3 == 0[LONG],null[NULL],result{r}#3) AS result#2]]
          \_Aggregate[[step{r}#0],[COUNT(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#3, step{r}#0]]
            \_Aggregate[[step{r}#0],[SUM(result{r}#5,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#4, step{r}#0]]
              \_Aggregate[[step{r}#0 AS step#0, _timeseries{r}#6 AS _timeseries#7],[SUM(LASTOVERTIME_$1{r}#8,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#5, step{r}#0, _timeseries{r}#7]]

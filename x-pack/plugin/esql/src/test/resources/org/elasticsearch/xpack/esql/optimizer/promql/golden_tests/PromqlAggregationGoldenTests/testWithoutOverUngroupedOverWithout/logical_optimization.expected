                \_PackDims[[_timeseries$__name__$pod{r}#10],_$packed_dims{f$}#8,true]
                  \_Eval[[TOTIMESERIES($$_timeseries$__name__$pod$series{r}#11) AS _timeseries$__name__$pod#10]]

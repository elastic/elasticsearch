Project[[$$value$temp_name$0{r}#0 AS result#0, step{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL($$value$temp_name$0{r}#0)]
    \_Eval[[CASE($$COUNT$count_without(c>$1{r$}#2 == 0[LONG],null[NULL],$$COUNT$count_without(c>$1{r$}#2) AS $$value$temp_name$2#3, TODOUBLE($$value$temp_name$2{r}#3) AS $$value$temp_name$0#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1],[COUNT($$value$temp_name$3{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$count_without(c>$1#2, step{r}#1]]
          \_Aggregate[[step{r}#1],[SUM($$value$temp_name$4{r}#5,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$3#4, step{r}#1]]
            \_Aggregate[[step{r}#1, _timeseries{r}#6],[SUM(LASTOVERTIME_$1{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$value$temp_name$4#5, step{r}#1]]
              \_TimeSeriesAggregate[[_tsid{m}#8, step{r}#1],[LASTOVERTIME(network.cost{f}#9,@timestamp{f}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#7, step{r}#1 AS step#1, VALUES(_timeseries{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#6],BUCKET(@timestamp{f}#10,PT1H[TIME_DURATION]),@timestamp{f}#10,PROMQL_COMMAND]
                \_Eval[[TIMESERIESUNSET(_timeseries{f}#11,pod[KEYWORD],__name__[KEYWORD]) AS _timeseries#6, BUCKET(@timestamp{f}#10,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#10, client.ip{f}#12, cluster{f}#13, event{f}#14, event_city{f}#15, event_city_boundary{f}#16, event_location{f}#17, event_log{f}#18, event_shape{f}#19, events_received{f}#20, network.bytes_in{f}#21, network.cost{f}#9, network.eth0.currently_connected_clients{f}#22, network.eth0.firmware_version{f}#23, network.eth0.last_up{f}#24, network.eth0.rx{f}#25, network.eth0.tx{f}#26, network.eth0.up{f}#27, network.total_bytes_in{f}#28, network.total_bytes_out{f}#29, network.total_cost{f}#30, pod{f}#31, region{f}#32, _timeseries{f}#11, _tsid{m}#8]
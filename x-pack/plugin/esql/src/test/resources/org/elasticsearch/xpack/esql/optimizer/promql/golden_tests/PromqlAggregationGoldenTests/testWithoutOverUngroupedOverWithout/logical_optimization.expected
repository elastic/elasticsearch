Project[[result{r}#0, step{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[CASE($$COUNT$count_without(c>$0{r$}#2 == 0[LONG],null[NULL],$$COUNT$count_without(c>$0{r$}#2) AS result#3, TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1],[COUNT(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$count_without(c>$0#2, step{r}#1]]
          \_Aggregate[[step{r}#1],[SUM(result{r}#5,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#4, step{r}#1]]
            \_UnpackDims[_$packed_grouping_dims{r}#6,[_timeseries$__name__$pod{r}#7]]
              \_Aggregate[[step{r}#1, _$packed_dims{r}#8],[SUM(LASTOVERTIME_$1{r}#9,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#5, step{r}#1 AS step#1, _$packed_dims{r}#8 AS _$packed_grouping_dims#6]]
                \_TimeSeriesAggregate[[_tsid{m}#10, step{r}#1],[LASTOVERTIME(network.cost{f}#11,@timestamp{f}#12,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#9, PACKDIMSAGG(_timeseries{f}#13,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#8, step{r}#1],BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]),@timestamp{f}#12,PROMQL_COMMAND]
                  \_Eval[[BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#12, client.ip{f}#14, cluster{f}#15, event{f}#16, event_city{f}#17, event_city_boundary{f}#18, event_location{f}#19, event_log{f}#20, event_shape{f}#21, events_received{f}#22, network.bytes_in{f}#23, network.cost{f}#11, network.eth0.currently_connected_clients{f}#24, network.eth0.firmware_version{f}#25, network.eth0.last_up{f}#26, network.eth0.rx{f}#27, network.eth0.tx{f}#28, network.eth0.up{f}#29, network.total_bytes_in{f}#30, network.total_bytes_out{f}#31, network.total_cost{f}#32, pod{f}#33, region{f}#34, _timeseries{f}#13, _tsid{m}#10]
Project[[result{r}#0, step{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[CASE($$COUNT$sum(avg_over_ti>$0{r$}#2 == 0[LONG],null[NULL],$$SUM$sum(avg_over_ti>$1{r$}#3) AS result#4, TODOUBLE(result{r}#4) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1],[COUNT($$sum(avg_over_ti>$COUNT$2{r$}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$sum(avg_over_ti>$0#2, SUM($$avg_over_time(n>$SUM$3{r$}#6,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$sum(avg_over_ti>$1#3, step{r}#1 AS step#1]]
          \_Eval[[$$SUM$AVGOVERTIME_$4{r$}#7 / $$COUNT$AVGOVERTIME_$5{r$}#8 AS AVGOVERTIME_$1#9, $$SUM$AVGOVERTIME_$6{r$}#10 / $$COUNT$AVGOVERTIME_$7{r$}#11 AS AVGOVERTIME_$2#12, CASE(ISNOTNULL(TODOUBLE(AVGOVERTIME_$1{r}#9) + TODOUBLE(AVGOVERTIME_$2{r}#12)),true[BOOLEAN],null[NULL]) AS $$sum(avg_over_ti>$COUNT$2#5, TODOUBLE(AVGOVERTIME_$1{r}#9) + TODOUBLE(AVGOVERTIME_$2{r}#12) AS $$avg_over_time(n>$SUM$3#6]]
            \_TimeSeriesAggregate[[_tsid{m}#13, step{r}#1],[SUM(network.cost{f}#14,true[BOOLEAN],PT1M[TIME_DURATION],lossy[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$AVGOVERTIME_$4#7, COUNT(network.cost{f}#14,true[BOOLEAN],PT1M[TIME_DURATION]) AS $$COUNT$AVGOVERTIME_$5#8, SUM(network.cost{f}#14,true[BOOLEAN],PT10M[TIME_DURATION],lossy[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$AVGOVERTIME_$6#10, COUNT(network.cost{f}#14,true[BOOLEAN],PT10M[TIME_DURATION]) AS $$COUNT$AVGOVERTIME_$7#11, step{r}#1],BUCKET(@timestamp{f}#15,PT1M[TIME_DURATION]),@timestamp{f}#15,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#15,PT1M[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#15, client.ip{f}#16, cluster{f}#17, event{f}#18, event_city{f}#19, event_city_boundary{f}#20, event_location{f}#21, event_log{f}#22, event_shape{f}#23, events_received{f}#24, network.bytes_in{f}#25, network.cost{f}#14, network.eth0.currently_connected_clients{f}#26, network.eth0.firmware_version{f}#27, network.eth0.last_up{f}#28, network.eth0.rx{f}#29, network.eth0.tx{f}#30, network.eth0.up{f}#31, network.total_bytes_in{f}#32, network.total_bytes_out{f}#33, network.total_cost{f}#34, pod{f}#35, region{f}#36, _tsid{m}#13]
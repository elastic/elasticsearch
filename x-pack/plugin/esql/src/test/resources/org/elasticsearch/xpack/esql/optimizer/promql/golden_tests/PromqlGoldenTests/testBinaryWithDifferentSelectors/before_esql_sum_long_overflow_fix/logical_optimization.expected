Project[[result{r}#0, step{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#2) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1],[SUM($$avg_over_time(n>$SUM$0{r$}#3,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#2, step{r}#1 AS step#1]]
          \_Eval[[TODOUBLE($$SUM$AVGOVERTIME_$1{r$}#4 / $$COUNT$AVGOVERTIME_$2{r$}#5) + TODOUBLE($$SUM$AVGOVERTIME_$3{r$}#6 / $$COUNT$AVGOVERTIME_$4{r$}#7) AS $$avg_over_time(n>$SUM$0#3]]
            \_TimeSeriesAggregate[[_tsid{m}#8, step{r}#1],[SUM(network.cost{f}#9,true[BOOLEAN],PT1M[TIME_DURATION],lossy[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$AVGOVERTIME_$1#4, COUNT(network.cost{f}#9,true[BOOLEAN],PT1M[TIME_DURATION]) AS $$COUNT$AVGOVERTIME_$2#5, SUM(network.cost{f}#9,true[BOOLEAN],PT10M[TIME_DURATION],lossy[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$AVGOVERTIME_$3#6, COUNT(network.cost{f}#9,true[BOOLEAN],PT10M[TIME_DURATION]) AS $$COUNT$AVGOVERTIME_$4#7, step{r}#1],BUCKET(@timestamp{f}#10,PT1M[TIME_DURATION]),@timestamp{f}#10,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#10,PT1M[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#10, client.ip{f}#11, cluster{f}#12, event{f}#13, event_city{f}#14, event_city_boundary{f}#15, event_location{f}#16, event_log{f}#17, event_shape{f}#18, events_received{f}#19, network.bytes_in{f}#20, network.cost{f}#9, network.eth0.currently_connected_clients{f}#21, network.eth0.firmware_version{f}#22, network.eth0.last_up{f}#23, network.eth0.rx{f}#24, network.eth0.tx{f}#25, network.eth0.up{f}#26, network.total_bytes_in{f}#27, network.total_bytes_out{f}#28, network.total_cost{f}#29, pod{f}#30, region{f}#31, _tsid{m}#8]
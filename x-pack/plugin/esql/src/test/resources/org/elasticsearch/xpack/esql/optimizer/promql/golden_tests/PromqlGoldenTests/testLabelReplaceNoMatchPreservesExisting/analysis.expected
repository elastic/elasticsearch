                        \_Aggregate[[step{r}#0 AS step#0, _$packed_dims{f$}#12 AS _$packed_grouping_dims#11],[VALUES(LASTOVERTIME_$1{r}#13,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#0, _$packed_grouping_dims{r}#11]]

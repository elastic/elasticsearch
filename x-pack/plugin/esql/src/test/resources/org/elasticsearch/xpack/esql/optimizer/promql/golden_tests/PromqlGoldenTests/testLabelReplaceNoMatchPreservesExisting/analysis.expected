      \_Eval[[TODOUBLE(result{r}#3) AS result#1]]
        \_Aggregate[[step{r}#0, pod{r}#2],[SUM(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#3, step{r}#0, pod{r}#2]]

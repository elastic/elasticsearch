            \_PackDims[[step{r}#0, _timeseries{r}#6, pod{r}#2, region{f}#7],$$_$packed_dims$temp_name$0{f$}#5]
              \_Eval[[TIMESERIESMETADATASET(_timeseries{r}#8,pod[KEYWORD],pod{r}#2) AS _timeseries#6]]
                \_Eval[[CASE(COALESCE(REGEXEXPAND(COALESCE(region{f}#7,[KEYWORD]),nomatch[KEYWORD],x[KEYWORD]),COALESCE(pod{f}#9,[KEYWORD])) == [KEYWORD],null[KEYWORD],COALESCE(REGEXEXPAND(COALESCE(region{f}#7,[KEYWORD]),nomatch[KEYWORD],x[KEYWORD]),COALESCE(pod{f}#9,[KEYWORD]))) AS pod#2]]
                  \_Project[[result{r}#4, step{r}#0, _timeseries{r}#8, pod{r}#9, region{r}#7]]
                    \_UnpackDims[_$packed_grouping_dims{r}#10,[_timeseries{r}#8, pod{r}#9, region{r}#7]]
                      \_Aggregate[[step{r}#0 AS step#0, _$packed_dims{f$}#11 AS _$packed_grouping_dims#10],[VALUES(LASTOVERTIME_$1{r}#12,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#0, _$packed_grouping_dims{r}#10]]
                        \_PackDims[[_timeseries{r}#13, pod{r}#14, region{r}#15],_$packed_dims{f$}#11]
                          \_TimeSeriesAggregate[[_tsid{m}#16, BUCKET(@timestamp{f}#17,PT1H[TIME_DURATION]) AS step#0],[LASTOVERTIME(network.bytes_in{f}#18,@timestamp{f}#17,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#12, VALUES(_timeseries{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#13, VALUES(pod{f}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS pod#14, VALUES(region{f}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS region#15, _tsid{m}#16, step{r}#0],BUCKET(@timestamp{f}#17,PT1H[TIME_DURATION]),@timestamp{f}#17,PROMQL_COMMAND]
                            \_EsRelation[k8s][@timestamp{f}#17, client.ip{f}#19, cluster{f}#20, event{f}#21, event_city{f}#22, event_city_boundary{f}#23, event_location{f}#24, event_log{f}#25, event_shape{f}#26, events_received{f}#27, network.bytes_in{f}#18, network.cost{f}#28, network.eth0.currently_connected_clients{f}#29, network.eth0.firmware_version{f}#30, network.eth0.last_up{f}#31, network.eth0.rx{f}#32, network.eth0.tx{f}#33, network.eth0.up{f}#34, network.total_bytes_in{f}#35, network.total_bytes_out{f}#36, network.total_cost{f}#37, pod{f}#9, region{f}#7, _timeseries{f}#8, _tsid{m}#16]
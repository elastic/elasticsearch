Project[[result{r}#0, step{r}#1, pod{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[CASE($$COUNT$sum_by_(pod)_(l>$0{r$}#3 == 0[LONG],null[NULL],$$SUM$sum_by_(pod)_(l>$1{r$}#4) AS result#5, TODOUBLE(result{r}#5) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, pod{r}#2],[COUNT($$sum_by_(pod)_(l>$COUNT$2{r$}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$sum_by_(pod)_(l>$0#3, SUM(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$sum_by_(pod)_(l>$1#4, step{r}#1, pod{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(region{f}#8,[KEYWORD]),nomatch[KEYWORD],x[KEYWORD]),COALESCE(pod{f}#9,[KEYWORD])) AS pod#2, CASE(ISNOTNULL(result{r}#7),true[BOOLEAN],null[NULL]) AS $$sum_by_(pod)_(l>$COUNT$2#6]]
            \_UnpackDims[_$packed_grouping_dims{r}#10,[pod{r}#9, region{r}#8]]
              \_Aggregate[[step{r}#1, _$packed_dims{f$}#11],[VALUES(LASTOVERTIME_$1{r}#12,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#7, step{r}#1 AS step#1, _$packed_dims{f$}#11 AS _$packed_grouping_dims#10]]
                \_PackDims[[pod{r}#13, region{r}#14],_$packed_dims{f$}#11]
                  \_TimeSeriesAggregate[[_tsid{m}#15, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#16,@timestamp{f}#17,WINDOWFILTER(PT5M[TIME_DURATION],@timestamp{f}#17),PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#12, DIMENSIONVALUES(pod{f}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS pod#13, DIMENSIONVALUES(region{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS region#14, step{r}#1],BUCKET(@timestamp{f}#17,PT1H[TIME_DURATION]),@timestamp{f}#17,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#17,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#17, client.ip{f}#18, cluster{f}#19, event{f}#20, event_city{f}#21, event_city_boundary{f}#22, event_location{f}#23, event_log{f}#24, event_shape{f}#25, events_received{f}#26, network.bytes_in{f}#16, network.cost{f}#27, network.eth0.currently_connected_clients{f}#28, network.eth0.firmware_version{f}#29, network.eth0.last_up{f}#30, network.eth0.rx{f}#31, network.eth0.tx{f}#32, network.eth0.up{f}#33, network.total_bytes_in{f}#34, network.total_bytes_out{f}#35, network.total_cost{f}#36, pod{f}#9, region{f}#8, _tsid{m}#15]
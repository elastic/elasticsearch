Project[[result{r}#0, step{r}#1, pod{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, pod{r}#2],[SUM(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#3, step{r}#1, pod{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(region{f}#5,[KEYWORD]),nomatch[KEYWORD],x[KEYWORD]),COALESCE(pod{f}#6,[KEYWORD])) AS pod#2]]
            \_UnpackDims[_$packed_grouping_dims{r}#7,[cluster{r}#8, pod{r}#6, region{r}#5]]
              \_Aggregate[[step{r}#1, _$packed_dims{r}#9],[VALUES(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#1 AS step#1, _$packed_dims{r}#9 AS _$packed_grouping_dims#7]]
                \_TimeSeriesAggregate[[_tsid{m}#11, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#12,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#13) AS LASTOVERTIME_$1#10, PACKDIMSAGG(cluster{f}#8,true[BOOLEAN],PT0S[TIME_DURATION],pod{f}#6,region{f}#5) AS _$packed_dims#9, step{r}#1],BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]),@timestamp{f}#13,PROMQL_COMMAND]
                  \_Eval[[BUCKET(@timestamp{f}#13,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#13, client.ip{f}#14, cluster{f}#8, event{f}#15, event_city{f}#16, event_city_boundary{f}#17, event_location{f}#18, event_log{f}#19, event_shape{f}#20, events_received{f}#21, network.bytes_in{f}#12, network.cost{f}#22, network.eth0.currently_connected_clients{f}#23, network.eth0.firmware_version{f}#24, network.eth0.last_up{f}#25, network.eth0.rx{f}#26, network.eth0.tx{f}#27, network.eth0.up{f}#28, network.total_bytes_in{f}#29, network.total_bytes_out{f}#30, network.total_cost{f}#31, pod{f}#6, region{f}#5, _tsid{m}#11]
Project[[result{r}#0, step{r}#1, pod{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, pod{r}#2],[SUM(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#3, step{r}#1, pod{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(pod{f}#5,[KEYWORD]),(.+)[KEYWORD],p-$1[KEYWORD]),COALESCE(pod{f}#5,[KEYWORD])) AS pod#2]]
            \_UnpackDims[_$packed_grouping_dims{r}#6,[pod{r}#5]]
              \_Aggregate[[step{r}#1, _$packed_dims{f$}#7],[VALUES(LASTOVERTIME_$1{r}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#1 AS step#1, _$packed_dims{f$}#7 AS _$packed_grouping_dims#6]]
                \_PackDims[[pod{r}#9],_$packed_dims{f$}#7]
                  \_TimeSeriesAggregate[[_tsid{m}#10, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#11,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#12) AS LASTOVERTIME_$1#8, VALUES(pod{f}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS pod#9, step{r}#1],BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]),@timestamp{f}#12,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#12,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#12, client.ip{f}#13, cluster{f}#14, event{f}#15, event_city{f}#16, event_city_boundary{f}#17, event_location{f}#18, event_log{f}#19, event_shape{f}#20, events_received{f}#21, network.bytes_in{f}#11, network.cost{f}#22, network.eth0.currently_connected_clients{f}#23, network.eth0.firmware_version{f}#24, network.eth0.last_up{f}#25, network.eth0.rx{f}#26, network.eth0.tx{f}#27, network.eth0.up{f}#28, network.total_bytes_in{f}#29, network.total_bytes_out{f}#30, network.total_cost{f}#31, pod{f}#5, region{f}#32, _tsid{m}#10]
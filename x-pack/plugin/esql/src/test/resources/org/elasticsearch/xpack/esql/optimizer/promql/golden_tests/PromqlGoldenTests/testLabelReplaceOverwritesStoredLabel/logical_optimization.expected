Project[[result{r}#0, step{r}#1, pod{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, pod{r}#2],[SUM(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS result#3, step{r}#1, pod{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(pod{f}#5,[KEYWORD]),(.+)[KEYWORD],p-$1[KEYWORD]),COALESCE(pod{f}#5,[KEYWORD])) AS pod#2]]
            \_UnpackDims[_$packed_grouping_dims{r}#6,[_timeseries{r}#7, pod{r}#5, cluster{r}#8, region{r}#9]]
              \_Aggregate[[step{r}#1, _$packed_dims{r}#10],[VALUES(LASTOVERTIME_$1{r}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#1 AS step#1, _$packed_dims{r}#10 AS _$packed_grouping_dims#6]]
                \_TimeSeriesAggregate[[_tsid{m}#12, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#13,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#14) AS LASTOVERTIME_$1#11, PACKDIMSAGG(_timeseries{f}#7,true[BOOLEAN],PT0S[TIME_DURATION],pod{f}#5,cluster{f}#8,region{f}#9) AS _$packed_dims#10, step{r}#1],BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]),@timestamp{f}#14,PROMQL_COMMAND]
                  \_Eval[[BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#14, client.ip{f}#15, cluster{f}#8, event{f}#16, event_city{f}#17, event_city_boundary{f}#18, event_location{f}#19, event_log{f}#20, event_shape{f}#21, events_received{f}#22, network.bytes_in{f}#13, network.cost{f}#23, network.eth0.currently_connected_clients{f}#24, network.eth0.firmware_version{f}#25, network.eth0.last_up{f}#26, network.eth0.rx{f}#27, network.eth0.tx{f}#28, network.eth0.up{f}#29, network.total_bytes_in{f}#30, network.total_bytes_out{f}#31, network.total_cost{f}#32, pod{f}#5, region{f}#9, _timeseries{f}#7, _tsid{m}#12]
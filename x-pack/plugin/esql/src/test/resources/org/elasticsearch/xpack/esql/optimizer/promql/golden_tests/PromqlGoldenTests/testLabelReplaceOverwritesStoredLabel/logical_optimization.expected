Project[[result{r}#0, step{r}#1, pod{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[CASE($$COUNT$sum_by_(pod)_(l>$0{r$}#3 == 0[LONG],null[NULL],$$SUM$sum_by_(pod)_(l>$1{r$}#4) AS result#5, TODOUBLE(result{r}#5) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, pod{r}#2],[COUNT($$sum_by_(pod)_(l>$COUNT$2{r$}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$sum_by_(pod)_(l>$0#3, SUM(result{r}#7,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_warn[KEYWORD]) AS $$SUM$sum_by_(pod)_(l>$1#4, step{r}#1, pod{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(pod{f}#8,[KEYWORD]),(.+)[KEYWORD],p-$1[KEYWORD]),COALESCE(pod{f}#8,[KEYWORD])) AS pod#2, CASE(ISNOTNULL(result{r}#7),true[BOOLEAN],null[NULL]) AS $$sum_by_(pod)_(l>$COUNT$2#6]]
            \_UnpackDims[_$packed_grouping_dims{r}#9,[pod{r}#8]]
              \_Aggregate[[step{r}#1, _$packed_dims{r}#10],[VALUES(LASTOVERTIME_$1{r}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#7, step{r}#1 AS step#1, _$packed_dims{r}#10 AS _$packed_grouping_dims#9]]
                \_TimeSeriesAggregate[[_tsid{m}#12, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#13,@timestamp{f}#14,WINDOWFILTER(PT5M[TIME_DURATION],@timestamp{f}#14),PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#11, PACKDIMSAGG(pod{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#10, step{r}#1],BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]),@timestamp{f}#14,PROMQL_COMMAND]
                  \_Eval[[BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#14, client.ip{f}#15, cluster{f}#16, event{f}#17, event_city{f}#18, event_city_boundary{f}#19, event_location{f}#20, event_log{f}#21, event_shape{f}#22, events_received{f}#23, network.bytes_in{f}#13, network.cost{f}#24, network.eth0.currently_connected_clients{f}#25, network.eth0.firmware_version{f}#26, network.eth0.last_up{f}#27, network.eth0.rx{f}#28, network.eth0.tx{f}#29, network.eth0.up{f}#30, network.total_bytes_in{f}#31, network.total_bytes_out{f}#32, network.total_cost{f}#33, pod{f}#8, region{f}#34, _tsid{m}#12]
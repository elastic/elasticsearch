Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0, TO_STRING(_timeseries{r}#4) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_TopNBy[[],3[INTEGER],[step{r}#1]]
          \_Aggregate[[step{r}#1, _timeseries{r}#5],[VALUES(LASTOVERTIME_$1{r}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#3, step{r}#1 AS step#1, _timeseries{r}#5 AS _timeseries#4]]
            \_Eval[[TOTIMESERIESMETADATA($$_timeseries$series{r}#7) AS _timeseries#5]]
              \_TimeSeriesAggregate[[_tsid{m}#8, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#9,@timestamp{f}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#6, DIMENSIONVALUES(_timeseries{f$}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$_timeseries$series#7, step{r}#1],BUCKET(@timestamp{f}#10,PT1H[TIME_DURATION]),@timestamp{f}#10,PROMQL_COMMAND]
                \_Eval[[BUCKET(@timestamp{f}#10,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#10, client.ip{f}#12, cluster{f}#13, event{f}#14, event_city{f}#15, event_city_boundary{f}#16, event_location{f}#17, event_log{f}#18, event_shape{f}#19, events_received{f}#20, network.bytes_in{f}#9, network.cost{f}#21, network.eth0.currently_connected_clients{f}#22, network.eth0.firmware_version{f}#23, network.eth0.last_up{f}#24, network.eth0.rx{f}#25, network.eth0.tx{f}#26, network.eth0.up{f}#27, network.total_bytes_in{f}#28, network.total_bytes_out{f}#29, network.total_cost{f}#30, pod{f}#31, region{f}#32, _timeseries{f$}#11, _tsid{m}#8]
Project[[result{r}#0, step{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[CASE($$COUNT$sum(network.eth>$0{r$}#2 == 0[LONG],null[NULL],$$SUM$sum(network.eth>$1{r$}#3) AS result_$1#4, CASE($$COUNT$sum(last_over_t>$2{r$}#5 == 0[LONG],null[NULL],$$SUM$sum(last_over_t>$3{r$}#6) AS result_$2#7, TODOUBLE(result{r}#4) + TODOUBLE(result{r}#7) AS result#8, TODOUBLE(result{r}#8) AS result#0]]
      \_Filter[step{r}#1 >= 1715300580000[DATETIME] AND step{r}#1 <= 1715301000000[DATETIME]]
        \_Aggregate[[step{r}#1],[COUNT($$sum(network.eth>$COUNT$4{r$}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$sum(network.eth>$0#2, SUM(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$sum(network.eth>$1#3, COUNT($$sum(last_over_t>$COUNT$5{r$}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$COUNT$sum(last_over_t>$2#5, SUM(LASTOVERTIME_$2{r}#12,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS $$SUM$sum(last_over_t>$3#6, step{r}#1 AS step#1]]
          \_Eval[[CASE(ISNOTNULL(LASTOVERTIME_$1{r}#10),true[BOOLEAN],null[NULL]) AS $$sum(network.eth>$COUNT$4#9, CASE(ISNOTNULL(LASTOVERTIME_$2{r}#12),true[BOOLEAN],null[NULL]) AS $$sum(last_over_t>$COUNT$5#11]]
            \_TimeSeriesAggregate[[_tsid{m}#13, step{r}#1],[LASTOVERTIME(network.eth0.tx{f}#14,@timestamp{f}#15,true[BOOLEAN],PT2M30S[TIME_DURATION]) AS LASTOVERTIME_$1#10, LASTOVERTIME(network.eth0.tx{f}#14,@timestamp{f}#15,true[BOOLEAN],PT10M[TIME_DURATION]) AS LASTOVERTIME_$2#12, step{r}#1],BUCKET(@timestamp{f}#15,PT1M[TIME_DURATION],1715300580000[DATETIME],1715301000000[DATETIME]),@timestamp{f}#15,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#15,PT1M[TIME_DURATION],1715300580000[DATETIME],1715301000000[DATETIME]) AS step#1]]
                \_Filter[@timestamp{f}#15 >= 1715299980000[DATETIME] AND @timestamp{f}#15 <= 1715301000000[DATETIME]]
                  \_EsRelation[k8s][@timestamp{f}#15, client.ip{f}#16, cluster{f}#17, event{f}#18, event_city{f}#19, event_city_boundary{f}#20, event_location{f}#21, event_log{f}#22, event_shape{f}#23, events_received{f}#24, network.bytes_in{f}#25, network.cost{f}#26, network.eth0.currently_connected_clients{f}#27, network.eth0.firmware_version{f}#28, network.eth0.last_up{f}#29, network.eth0.rx{f}#30, network.eth0.tx{f}#14, network.eth0.up{f}#31, network.total_bytes_in{f}#32, network.total_bytes_out{f}#33, network.total_cost{f}#34, pod{f}#35, region{f}#36, _tsid{m}#13]
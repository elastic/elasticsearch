Project[[max_bits{r}#0, step{r}#1]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(max_bits{r}#0)]
    \_Eval[[TODOUBLE(TODOUBLE(max_bits{r}#2) * 8.0[DOUBLE]) AS max_bits#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1],[MAX(LASTOVERTIME_$1{r}#3,true[BOOLEAN],PT0S[TIME_DURATION]) AS max_bits#2, step{r}#1]]
          \_TimeSeriesAggregate[[_tsid{m}#4, step{r}#1],[LASTOVERTIME(network.total_bytes_in{f}#5,@timestamp{f}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#3, step{r}#1 AS step#1],BUCKET(@timestamp{f}#6,PT1H[TIME_DURATION]),@timestamp{f}#6,PROMQL_COMMAND]
            \_Eval[[BUCKET(@timestamp{f}#6,PT1H[TIME_DURATION]) AS step#1]]
              \_EsRelation[k8s][@timestamp{f}#6, client.ip{f}#7, cluster{f}#8, event{f}#9, event_city{f}#10, event_city_boundary{f}#11, event_location{f}#12, event_log{f}#13, event_shape{f}#14, events_received{f}#15, network.bytes_in{f}#16, network.cost{f}#17, network.eth0.currently_connected_clients{f}#18, network.eth0.firmware_version{f}#19, network.eth0.last_up{f}#20, network.eth0.rx{f}#21, network.eth0.tx{f}#22, network.eth0.up{f}#23, network.total_bytes_in{f}#5, network.total_bytes_out{f}#24, network.total_cost{f}#25, pod{f}#26, region{f}#27, _tsid{m}#4]
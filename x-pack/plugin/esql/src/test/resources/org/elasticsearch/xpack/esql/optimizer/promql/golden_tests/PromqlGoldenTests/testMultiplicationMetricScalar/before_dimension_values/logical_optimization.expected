                  \_Eval[[BUCKET(@timestamp{f}#18,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#18, client.ip{f}#19, cluster{f}#6, event{f}#20, event_city{f}#21, event_city_boundary{f}#22, event_location{f}#23, event_log{f}#24, event_shape{f}#25, events_received{f}#26, network.bytes_in{f}#27, network.cost{f}#28, network.eth0.currently_connected_clients{f}#29, network.eth0.firmware_version{f}#30, network.eth0.last_up{f}#31, network.eth0.rx{f}#32, network.eth0.tx{f}#33, network.eth0.up{f}#34, network.total_bytes_in{f}#17, network.total_bytes_out{f}#35, network.total_cost{f}#36, pod{f}#7, region{f}#8, _timeseries{f}#2, _tsid{m}#16]
Project[[network_in_bits{r}#0, step{r}#1, _timeseries{r}#2 AS _timeseries#3]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(network_in_bits{r}#0)]
    \_Eval[[TODOUBLE(network_in_bits{r}#4) AS network_in_bits#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _tsid{m}#5, _timeseries{r}#6],[VALUES($$network.total_b>$VALUES$0{r$}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS network_in_bits#4, step{r}#1 AS step#1, _timeseries{r}#6 AS _timeseries#2]]
          \_Eval[[TODOUBLE(LASTOVERTIME_$1{r}#8) * 8.0[DOUBLE] AS $$network.total_b>$VALUES$0#7]]
            \_TimeSeriesAggregate[[_tsid{m}#5, step{r}#1],[LASTOVERTIME(network.total_bytes_in{f}#9,@timestamp{f}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#8, DIMENSIONVALUES(_timeseries{f}#2,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#6, _tsid{m}#5, step{r}#1],BUCKET(@timestamp{f}#10,PT1H[TIME_DURATION]),@timestamp{f}#10,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#10,PT1H[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#10, client.ip{f}#11, cluster{f}#12, event{f}#13, event_city{f}#14, event_city_boundary{f}#15, event_location{f}#16, event_log{f}#17, event_shape{f}#18, events_received{f}#19, network.bytes_in{f}#20, network.cost{f}#21, network.eth0.currently_connected_clients{f}#22, network.eth0.firmware_version{f}#23, network.eth0.last_up{f}#24, network.eth0.rx{f}#25, network.eth0.tx{f}#26, network.eth0.up{f}#27, network.total_bytes_in{f}#9, network.total_bytes_out{f}#28, network.total_cost{f}#29, pod{f}#30, region{f}#31, _tsid{m}#5, _timeseries{f}#2]
Project[[network_in_bits{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(network_in_bits{r}#0)]
    \_Eval[[TODOUBLE(network_in_bits{r}#3) AS network_in_bits#0, TO_STRING(_timeseries{r}#4) AS _timeseries#2]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#5],[VALUES($$network.total_b>$VALUES$0{r$}#6,true[BOOLEAN],PT0S[TIME_DURATION]) AS network_in_bits#3, step{r}#1 AS step#1, _timeseries{r}#5 AS _timeseries#4]]
          \_Eval[[TOTIMESERIESMETADATA($$_timeseries$series{r}#7) AS _timeseries#5, TODOUBLE(LASTOVERTIME_$1{r}#8) * 8.0[DOUBLE] AS $$network.total_b>$VALUES$0#6]]
            \_TimeSeriesAggregate[[_tsid{m}#9, step{r}#1],[LASTOVERTIME(network.total_bytes_in{f}#10,@timestamp{f}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#8, DIMENSIONVALUES(_timeseries{f$}#12,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$_timeseries$series#7, step{r}#1],BUCKET(@timestamp{f}#11,PT1H[TIME_DURATION]),@timestamp{f}#11,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#11,PT1H[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#11, client.ip{f}#13, cluster{f}#14, event{f}#15, event_city{f}#16, event_city_boundary{f}#17, event_location{f}#18, event_log{f}#19, event_shape{f}#20, events_received{f}#21, network.bytes_in{f}#22, network.cost{f}#23, network.eth0.currently_connected_clients{f}#24, network.eth0.firmware_version{f}#25, network.eth0.last_up{f}#26, network.eth0.rx{f}#27, network.eth0.tx{f}#28, network.eth0.up{f}#29, network.total_bytes_in{f}#10, network.total_bytes_out{f}#30, network.total_cost{f}#31, pod{f}#32, region{f}#33, _timeseries{f$}#12, _tsid{m}#9]
Project[[network_in_bits{r}#0, step{r}#1, _timeseries{r}#2 AS _timeseries#3]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(network_in_bits{r}#0)]
    \_Eval[[TODOUBLE(network_in_bits{r}#4) AS network_in_bits#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_UnpackDims[_$packed_grouping_dims{r}#5,[_timeseries{r}#2, cluster{r}#6, pod{r}#7, region{r}#8]]
          \_Aggregate[[step{r}#1, _$packed_dims{r}#9],[VALUES($$network.total_b>$VALUES$0{r$}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS network_in_bits#4, step{r}#1 AS step#1, _$packed_dims{r}#9 AS _$packed_grouping_dims#5]]
            \_Eval[[TODOUBLE(LASTOVERTIME_$1{r}#11) * 8.0[DOUBLE] AS $$network.total_b>$VALUES$0#10]]
              \_TimeSeriesAggregate[[_tsid{m}#12, step{r}#1],[LASTOVERTIME(network.total_bytes_in{f}#13,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#14) AS LASTOVERTIME_$1#11, PACKDIMSAGG(_timeseries{f}#2,true[BOOLEAN],PT0S[TIME_DURATION],cluster{f}#6,pod{f}#7,region{f}#8) AS _$packed_dims#9, step{r}#1],BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]),@timestamp{f}#14,PROMQL_COMMAND]
                \_Eval[[BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]) AS step#1]]
                  \_EsRelation[k8s][@timestamp{f}#14, client.ip{f}#15, cluster{f}#6, event{f}#16, event_city{f}#17, event_city_boundary{f}#18, event_location{f}#19, event_log{f}#20, event_shape{f}#21, events_received{f}#22, network.bytes_in{f}#23, network.cost{f}#24, network.eth0.currently_connected_clients{f}#25, network.eth0.firmware_version{f}#26, network.eth0.last_up{f}#27, network.eth0.rx{f}#28, network.eth0.tx{f}#29, network.eth0.up{f}#30, network.total_bytes_in{f}#13, network.total_bytes_out{f}#31, network.total_cost{f}#32, pod{f}#7, region{f}#8, _timeseries{f}#2, _tsid{m}#12]
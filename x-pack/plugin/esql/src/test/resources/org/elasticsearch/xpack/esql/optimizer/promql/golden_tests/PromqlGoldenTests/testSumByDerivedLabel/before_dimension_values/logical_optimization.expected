Project[[result{r}#0, step{r}#1, tier{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, tier{r}#2],[SUM(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#3, step{r}#1, tier{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(region{f}#5,[KEYWORD]),(.+)[KEYWORD],$1[KEYWORD]),[KEYWORD]) AS tier#2]]
            \_UnpackDims[_$packed_grouping_dims{r}#6,[cluster{r}#7, pod{r}#8, region{r}#5]]
              \_Aggregate[[step{r}#1, _$packed_dims{f$}#9],[VALUES(LASTOVERTIME_$1{r}#10,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#1 AS step#1, _$packed_dims{f$}#9 AS _$packed_grouping_dims#6]]
                \_PackDims[[cluster{r}#11, pod{r}#12, region{r}#13],_$packed_dims{f$}#9]
                  \_TimeSeriesAggregate[[_tsid{m}#14, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#15,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#16) AS LASTOVERTIME_$1#10, VALUES(cluster{f}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS cluster#11, VALUES(pod{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS pod#12, VALUES(region{f}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS region#13, step{r}#1],BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]),@timestamp{f}#16,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#16,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#16, client.ip{f}#17, cluster{f}#7, event{f}#18, event_city{f}#19, event_city_boundary{f}#20, event_location{f}#21, event_log{f}#22, event_shape{f}#23, events_received{f}#24, network.bytes_in{f}#15, network.cost{f}#25, network.eth0.currently_connected_clients{f}#26, network.eth0.firmware_version{f}#27, network.eth0.last_up{f}#28, network.eth0.rx{f}#29, network.eth0.tx{f}#30, network.eth0.up{f}#31, network.total_bytes_in{f}#32, network.total_bytes_out{f}#33, network.total_cost{f}#34, pod{f}#8, region{f}#5, _tsid{m}#14]
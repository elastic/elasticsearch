Project[[result{r}#0, step{r}#1, tier{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, tier{r}#2],[SUM(result{r}#4,true[BOOLEAN],PT0S[TIME_DURATION],compensated[KEYWORD],long_overflow_throw[KEYWORD]) AS result#3, step{r}#1, tier{r}#2]]
          \_Eval[[COALESCE(REGEXEXPAND(COALESCE(region{f}#5,[KEYWORD]),(.+)[KEYWORD],$1[KEYWORD]),[KEYWORD]) AS tier#2]]
            \_UnpackDims[_$packed_grouping_dims{r}#6,[_timeseries{r}#7, cluster{r}#8, pod{r}#9, region{r}#5]]
              \_Aggregate[[step{r}#1, _$packed_dims{f$}#10],[VALUES(LASTOVERTIME_$1{r}#11,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#4, step{r}#1 AS step#1, _$packed_dims{f$}#10 AS _$packed_grouping_dims#6]]
                \_PackDims[[_timeseries{r}#12, cluster{r}#13, pod{r}#14, region{r}#15],_$packed_dims{f$}#10]
                  \_TimeSeriesAggregate[[_tsid{m}#16, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#17,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#18) AS LASTOVERTIME_$1#11, DIMENSIONVALUES(_timeseries{f}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#12, DIMENSIONVALUES(cluster{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS cluster#13, DIMENSIONVALUES(pod{f}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS pod#14, DIMENSIONVALUES(region{f}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS region#15, step{r}#1],BUCKET(@timestamp{f}#18,PT1H[TIME_DURATION]),@timestamp{f}#18,PROMQL_COMMAND]
                    \_Eval[[BUCKET(@timestamp{f}#18,PT1H[TIME_DURATION]) AS step#1]]
                      \_EsRelation[k8s][@timestamp{f}#18, client.ip{f}#19, cluster{f}#8, event{f}#20, event_city{f}#21, event_city_boundary{f}#22, event_location{f}#23, event_log{f}#24, event_shape{f}#25, events_received{f}#26, network.bytes_in{f}#17, network.cost{f}#27, network.eth0.currently_connected_clients{f}#28, network.eth0.firmware_version{f}#29, network.eth0.last_up{f}#30, network.eth0.rx{f}#31, network.eth0.tx{f}#32, network.eth0.up{f}#33, network.total_bytes_in{f}#34, network.total_bytes_out{f}#35, network.total_cost{f}#36, pod{f}#9, region{f}#5, _timeseries{f}#7, _tsid{m}#16]
                \_TimeSeriesAggregate[[_tsid{m}#12, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#13,@timestamp{f}#14,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#11, DIMENSIONVALUES(_timeseries{f}#15,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#9, PACKDIMSAGG(region{f}#16,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#10, step{r}#1],BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]),@timestamp{f}#14,PROMQL_COMMAND]
                  \_Eval[[BUCKET(@timestamp{f}#14,PT1H[TIME_DURATION]) AS step#1]]
                    \_EsRelation[k8s][@timestamp{f}#14, client.ip{f}#17, cluster{f}#18, event{f}#19, event_city{f}#20, event_city_boundary{f}#21, event_location{f}#22, event_log{f}#23, event_shape{f}#24, events_received{f}#25, network.bytes_in{f}#13, network.cost{f}#26, network.eth0.currently_connected_clients{f}#27, network.eth0.firmware_version{f}#28, network.eth0.last_up{f}#29, network.eth0.rx{f}#30, network.eth0.tx{f}#31, network.eth0.up{f}#32, network.total_bytes_in{f}#33, network.total_bytes_out{f}#34, network.total_cost{f}#35, pod{f}#36, region{f}#16, _timeseries{f}#15, _tsid{m}#12]
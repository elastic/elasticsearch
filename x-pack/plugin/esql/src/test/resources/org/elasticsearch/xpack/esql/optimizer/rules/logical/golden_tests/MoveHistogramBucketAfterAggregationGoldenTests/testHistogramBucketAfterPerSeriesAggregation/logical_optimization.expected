Project[[count{r}#0, bucket{r}#1]]
\_Eval[[CASE(ISNOTNULL(bucket{r}#1),COALESCE(TOLONG(HISTOGRAMFRACTION($$HISTOGRAMMERGE$count$0{r$}#2,bucket{r}#1,0[INTEGER])),0[LONG])) AS count#0]]
  \_Limit[10000[INTEGER],true,false]
    \_MvExpand[bucket{r}#1,bucket{r}#1]
      \_Eval[[BUCKET($$HISTOGRAMMERGE$count$0{r$}#2,42[INTEGER]) AS bucket#1]]
        \_Limit[10000[INTEGER],false,false]
          \_Aggregate[[$$is_histogram_empty{r$}#3],[HISTOGRAMMERGE(HISTOGRAMMERGEOVERTIME_$1{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS $$HISTOGRAMMERGE$count$0#2]]
            \_Eval[[EXTRACTHISTOGRAMCOMPONENT(HISTOGRAMMERGEOVERTIME_$1{r}#4,3[INTEGER]) == 0.0[DOUBLE] OR ISNULL(HISTOGRAMMERGEOVERTIME_$1{r}#4) AS $$is_histogram_empty#3]]
              \_TimeSeriesAggregate[[_tsid{m}#5],[HISTOGRAMMERGEOVERTIME(responseTime{f}#6,true[BOOLEAN],PT0S[TIME_DURATION],@timestamp{f}#7) AS HISTOGRAMMERGEOVERTIME_$1#4],null,@timestamp{f}#7,TS_COMMAND]
                \_EsRelation[exp_histo_sample][TIME_SERIES][@timestamp{f}#7, responseTime{f}#6, _tsid{m}#5]